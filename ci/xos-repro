#!/bin/bash
# xos reproducibility tier -- the flagship claim, re-checked nightly.
#
# it used to run weekly, which is a seven-day blind window on the one thing a
# stranger is told to rely on. nightly, but GUARDED on the remote head having
# moved: many commits land on an active day and a per-push container rebuild
# would queue and burn the box re-verifying intermediate commits nobody will
# ever attest. the guard gives per-push semantics for the commit that matters
# at one rebuild per active day, and costs nothing at all on a quiet one.
#
# it also makes this machine a WITNESS. the chain head it saw is printed on
# every run, so journalctl ends up holding a timestamped record of the head
# this box was shown on each date -- independent of the git remote, and the
# cheapest mitigation there is for the split-view gap attestation cannot close
# from inside the repo (see docs/attestation.md).
#
# no signing key is touched, so it runs unattended. every step runs in a
# throwaway clone: no working tree, no installed checkout, is read or written.
# the building gates and the qemu self-test need the key and stay ci/xos-ci-full.
set -euo pipefail
REPO=${XOS_CI_REPO:-git@github.com:mellen9999/xos.git}
BRANCH=${XOS_CI_BRANCH:-main}
# per-machine fact, never a claim -- so it lives in the cache, never in the repo.
STATE=${XOS_CI_STATE:-$HOME/.cache/xos-ci/last-repro}

remote=$(git ls-remote "$REPO" "refs/heads/$BRANCH" | awk '{print $1}')
[ -n "$remote" ] || { echo "xos-repro: cannot read $BRANCH from $REPO"; exit 1; }
if [ "$remote" = "$(cat "$STATE" 2>/dev/null || true)" ]; then
  echo "xos-repro: ${remote:0:12} already verified -- nothing pushed since"
  exit 0
fi

d=$(mktemp -d /tmp/xos-repro.XXXXXX)
trap 'rm -rf "$d" 2>/dev/null || true' EXIT
echo "xos-repro: cloning $REPO ($BRANCH) at ${remote:0:12}"
# no --depth: vouch walks every commit back to the epoch, and a shallow clone
# cannot see them, so it would report unverified forever.
git clone -q --branch "$BRANCH" "$REPO" "$d/tree"
cd "$d/tree"

# whose tree is this. cheapest check here and the only one that answers "who".
# CI only ever VERIFIES signatures and never makes one -- no signing key of any
# kind reaches a runner.
./build.sh vouch
./build.sh ci
# the chain and the signatures first: they take a second, need no docker, and
# a broken chain is worth knowing about before spending half an hour compiling.
./build.sh verify_log
./build.sh verify_sigs
./build.sh crepro

# the witness line. one grep over the journal shows every head this machine has
# ever been served, with a date attached to each.
echo "xos-repro: WITNESS $(date -u +%Y-%m-%dT%H:%M:%SZ) head $(./build.sh verify_log | sed -n 's/.*head //p')"
mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$remote" > "$STATE"
echo "xos-repro: PASS $(git rev-parse --short HEAD)"
