#!/bin/bash
# pre-push -- the half of the gate suite that needs nothing but the tree, run
# before anything reaches origin. it does NOT build: the image gates, the qemu
# self-test and reproducibility need the toolchain + qemu, and belong in
# `./build.sh gates` / `./selftest.sh`, not in the push path. what it DOES catch
# is the class that is cheap to find and expensive to inherit -- a script the
# shell cannot parse, or a shellcheck error -- because the next clone pulls
# whatever lands on origin and runs it. build.sh points core.hooksPath here, so
# a fresh clone is covered from its first push.
#
# XOS_NOVERIFY=1 git push  -- skip these checks for a deliberate WIP branch.
set -uo pipefail
[ -n "${XOS_NOVERIFY:-}" ] && { echo "pre-push: XOS_NOVERIFY set -- skipping checks" >&2; exit 0; }
cd "$(git rev-parse --show-toplevel)" || exit 1

fail=0
say() { printf '\033[1;31mpre-push: %s\033[0m\n' "$*" >&2; fail=1; }

# 1. parse every first-party script under the shell its shebang names. the
#    shipped ash is the strict check (it also runs init and the learn tree on
#    the stick); bash for the two build scripts and the hooks. mirrors gates
#    G35/G38/G48 so a break is caught at push time, not at the next build.
bb=./busybox; [ -x "$bb" ] || bb=$(command -v busybox 2>/dev/null || true)
ash_ok=1; [ -n "$bb" ] || { echo "pre-push: no busybox -- ash parse skipped (build first for full cover)" >&2; ash_ok=0; }
parse() { # file
  local f="$1" chk
  case "$(head -1 "$f" 2>/dev/null)" in
    *bash) chk="bash -n" ;;
    *)     [ "$ash_ok" = 1 ] || return 0; chk="$bb ash -n" ;;
  esac
  $chk "$f" 2>/dev/null || say "does not parse: $f"
}
for f in build.sh selftest.sh init learn/learn learn/lib/* \
         overlay/usr/share/udhcpc/default.script \
         githooks/pre-commit githooks/pre-push learn/install.sh learn/push learn/wrapper \
         arsenal/*.sh arsenal/arsenal arsenal/xexec; do
  [ -f "$f" ] && parse "$f"
done
if [ "$ash_ok" = 1 ] && [ -f arsenal/build-arsenal-c.sh ]; then
  awk "/<<'INNER'/{f=1;next} /^INNER\$/{f=0} f" arsenal/build-arsenal-c.sh \
    | "$bb" ash -n /dev/stdin 2>/dev/null || say "build-arsenal-c.sh INNER block does not parse"
fi

# 2. shellcheck errors (host-optional, same policy as build.sh lint: only
#    error-severity blocks -- warnings are noise until someone decides).
if command -v shellcheck >/dev/null 2>&1; then
  out=$(shellcheck -S error build.sh selftest.sh init learn/learn 2>&1
        shellcheck -S error -s sh learn/lib/* 2>&1)
  [ -z "$out" ] || { printf '%s\n' "$out" >&2; say "shellcheck found errors"; }
else
  echo "pre-push: shellcheck not installed -- skipping (paru -S shellcheck)" >&2
fi

[ "$fail" -eq 0 ] || { printf '\033[1;31mpre-push: refusing to push -- fix the above or XOS_NOVERIFY=1 to override\033[0m\n' >&2; exit 1; }
exit 0
