#!/bin/bash
# pre-push -- run the buildless gate tier before anything reaches origin, where
# the next clone inherits it. that tier lives in one place, `./build.sh ci`
# (shellcheck + parse every first-party script + the learn authoring ledger):
# the hook and any self-hosted runner call the same command, so they cannot
# drift. ci needs no signing key and no image build, so it is fast enough to
# sit in the push path; the signed image gates and the qemu self-test stay a
# deliberate `./build.sh gates` / `./selftest.sh`.
#
# XOS_NOVERIFY=1 git push  -- skip for a deliberate WIP branch.
set -uo pipefail
[ -n "${XOS_NOVERIFY:-}" ] && { echo "pre-push: XOS_NOVERIFY set -- skipping checks" >&2; exit 0; }
cd "$(git rev-parse --show-toplevel)" || exit 1

# build.sh is what runs the checks, so it has to parse before it can be trusted
# to report its own breakage -- check that one file here, directly.
for _f in build.sh build/*.sh; do bash -n "$_f" || { echo "pre-push: $_f does not parse -- refusing to push" >&2; exit 1; }; done
./build.sh ci || { echo "pre-push: ci checks failed -- fix them or XOS_NOVERIFY=1 to override" >&2; exit 1; }

# push is the moment a commit stops being local and becomes a public claim, so
# it is the right place for the signature wall -- ci's vouch treats unverified
# as non-fatal (a stranger on a shallow clone must still be able to run it),
# but nothing unsigned may leave this machine. git feeds us one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
# a remote sha of all-zeroes means a new branch, so fall back to the epoch.
# fail CLOSED: every way this check can break -- no epoch, no signers file, a
# git log that errors -- used to read as "0 unsigned" and let the push through.
# the count that matters is commits in range vs commits verified good.
SIGN_EPOCH=$(sed -n 's/^SIGN_EPOCH=//p' build.sh)
git rev-parse --verify -q "$SIGN_EPOCH^{commit}" >/dev/null 2>&1 \
  || { echo "pre-push: SIGN_EPOCH in build.sh is not a commit here -- cannot check signatures, refusing" >&2; exit 1; }
[ -s signers ] || { echo "pre-push: no signers file -- cannot check signatures, refusing" >&2; exit 1; }
zero=0000000000000000000000000000000000000000
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue          # a delete pushes nothing
  [ "$rsha" = "$zero" ] && rsha="$SIGN_EPOCH~1"
  git rev-parse --verify -q "$rsha" >/dev/null 2>&1 || rsha="$SIGN_EPOCH~1"
  total=$(git rev-list --count "$rsha..$lsha" 2>/dev/null) \
    || { echo "pre-push: cannot list $rsha..$lsha -- refusing" >&2; exit 1; }
  good=$(git -c gpg.ssh.allowedSignersFile=signers \
           log --format='%G?' "$rsha..$lsha" 2>/dev/null | grep -c '^G$' || true)
  unsigned=$(( total - ${good:-0} ))
  if [ "$unsigned" -ne 0 ]; then
    echo "pre-push: $unsigned commit(s) are not signed by the pinned key -- refusing to publish them:" >&2
    git -c gpg.ssh.allowedSignersFile=signers \
        log --format='%G? %h %s' "$rsha..$lsha" 2>/dev/null | grep -v '^G ' | head -10 >&2
    echo "  sign them (git rebase --exec 'git commit --amend --no-edit -S') or XOS_NOVERIFY=1 to override" >&2
    exit 1
  fi
done
exit 0
