q: statgen.c -- one macro, many functions
spec: The file is given: four lines `DEFINE_STATS(int)`, `long`, `double`
spec: and `byte` stamp out functions, and `main` calls `min_int`, `max_int`
spec: and so on for each. The macro is a stub with the right names and
spec: wrong bodies. Fix it: `min_T` and `max_T` are static functions taking
spec: `const T *v` and `size_t n` (n at least 1), returning the smallest or
spec: largest element as T. The names are glued with `##`: that part is
spec: written for you. Do not change `main`.
spec:
spec: The program prints `int -2 9`, `long -5 100000`, `double -0.25 1000`
spec: and `byte 7 255` on four lines and exits 0. (`byte` is a typedef
spec: for unsigned char: `##` pastes ONE token, so `unsigned char` would
spec: not make a name.)
file: statgen.c
start: #include <stdio.h>
start: 
start: typedef unsigned char byte;
start: 
start: /* a stub: the right names and shapes, wrong bodies */
start: #define DEFINE_STATS(T)                         \
start: 	static T min_##T(const T *v, size_t n)      \
start: 	{                                           \
start: 		(void)n;                                \
start: 		return v[0];                            \
start: 	}                                           \
start: 	static T max_##T(const T *v, size_t n)      \
start: 	{                                           \
start: 		(void)n;                                \
start: 		return v[0];                            \
start: 	}
start: 
start: DEFINE_STATS(int)
start: DEFINE_STATS(long)
start: DEFINE_STATS(double)
start: DEFINE_STATS(byte)
start: 
start: int main(void)
start: {
start: 	int a[] = { 4, -2, 9, 0 };
start: 	long b[] = { 100000L, -5L, 70000L };
start: 	double c[] = { 2.5, -0.25, 1e3 };
start: 	byte d[] = { 200, 7, 64, 255 };
start: 
start: 	printf("int %d %d\n", min_int(a, 4), max_int(a, 4));
start: 	printf("long %ld %ld\n", min_long(b, 3), max_long(b, 3));
start: 	printf("double %g %g\n", min_double(c, 3), max_double(c, 3));
start: 	printf("byte %d %d\n", min_byte(d, 4), max_byte(d, 4));
start: 	return 0;
start: }
prog: #include <stdio.h>
prog: 
prog: typedef unsigned char byte;
prog: 
prog: /* one body, stamped out per type: min_##T glues the type onto the name */
prog: #define DEFINE_STATS(T)                         \
prog: 	static T min_##T(const T *v, size_t n)      \
prog: 	{                                           \
prog: 		T m = v[0];                             \
prog: 		for (size_t i = 1; i < n; i++)          \
prog: 			if (v[i] < m)                       \
prog: 				m = v[i];                       \
prog: 		return m;                               \
prog: 	}                                           \
prog: 	static T max_##T(const T *v, size_t n)      \
prog: 	{                                           \
prog: 		T m = v[0];                             \
prog: 		for (size_t i = 1; i < n; i++)          \
prog: 			if (v[i] > m)                       \
prog: 				m = v[i];                       \
prog: 		return m;                               \
prog: 	}
prog: 
prog: DEFINE_STATS(int)
prog: DEFINE_STATS(long)
prog: DEFINE_STATS(double)
prog: DEFINE_STATS(byte)
prog: 
prog: int main(void)
prog: {
prog: 	int a[] = { 4, -2, 9, 0 };
prog: 	long b[] = { 100000L, -5L, 70000L };
prog: 	double c[] = { 2.5, -0.25, 1e3 };
prog: 	byte d[] = { 200, 7, 64, 255 };
prog: 
prog: 	printf("int %d %d\n", min_int(a, 4), max_int(a, 4));
prog: 	printf("long %ld %ld\n", min_long(b, 3), max_long(b, 3));
prog: 	printf("double %g %g\n", min_double(c, 3), max_double(c, 3));
prog: 	printf("byte %d %d\n", min_byte(d, 4), max_byte(d, 4));
prog: 	return 0;
prog: }
case: statgen
case: statgen; echo $?
case: statgen | tail -n 2
hint: keep the best so far, starting at v[0], and loop from index 1; min keeps the smaller, max the larger
