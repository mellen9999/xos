q: xenum.c -- an enum and its names from one list
spec: The file is given with the list `LEVELS(X)`. Build from it, with no
spec: second copy of the names, an enum of levels (TRACE is 0 and they
spec: count up in list order) and an array of their names as strings. Add a
spec: `_Static_assert` that the array and the enum have the same size.
spec:
spec: With no argument print every level as `NUMBER NAME`, one per line.
spec: With one argument that is a level name, exactly as written (`WARN`,
spec: not `warn`), print its number. If it is a whole decimal number from 0
spec: to the last level, print its name. Anything else prints `xenum:
spec: unknown ARG` to standard error and exits 1. Two or more arguments
spec: print `usage: xenum [ARG]` to standard error and exit 2.
file: xenum.c
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: #define LEVELS(X) \
start: 	X(TRACE)      \
start: 	X(DEBUG)      \
start: 	X(INFO)       \
start: 	X(WARN)       \
start: 	X(ERROR)      \
start: 	X(FATAL)
start: 
start: /* make the enum and the name table from LEVELS: the list written once */
start: 
start: int main(int argc, char *argv[])
start: {
start: 	(void)argc;
start: 	(void)argv;
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define LEVELS(X) \
prog: 	X(TRACE)      \
prog: 	X(DEBUG)      \
prog: 	X(INFO)       \
prog: 	X(WARN)       \
prog: 	X(ERROR)      \
prog: 	X(FATAL)
prog: 
prog: #define AS_ENUM(name) LV_##name,
prog: #define AS_NAME(name) #name,
prog: 
prog: enum level { LEVELS(AS_ENUM) LV_COUNT };
prog: 
prog: static const char *const names[] = { LEVELS(AS_NAME) };
prog: 
prog: _Static_assert(sizeof names / sizeof *names == LV_COUNT, "table out of step");
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc > 2) {
prog: 		fprintf(stderr, "usage: xenum [ARG]\n");
prog: 		return 2;
prog: 	}
prog: 	if (argc == 1) {
prog: 		for (int i = 0; i < LV_COUNT; i++)
prog: 			printf("%d %s\n", i, names[i]);
prog: 		return 0;
prog: 	}
prog: 
prog: 	for (int i = 0; i < LV_COUNT; i++) {
prog: 		if (strcmp(argv[1], names[i]) == 0) {
prog: 			printf("%d\n", i);
prog: 			return 0;
prog: 		}
prog: 	}
prog: 	char *end;
prog: 	errno = 0;
prog: 	long n = strtol(argv[1], &end, 10);
prog: 	if (errno == 0 && end != argv[1] && *end == '\0' && n >= 0 && n < LV_COUNT) {
prog: 		puts(names[n]);
prog: 		return 0;
prog: 	}
prog: 	fprintf(stderr, "xenum: unknown %s\n", argv[1]);
prog: 	return 1;
prog: }
case: xenum
case: xenum WARN; xenum TRACE; xenum 0; xenum 4; xenum 5
case: xenum 6 2>&1; echo $?; xenum -1 2>&1; echo $?; xenum warn 2>&1; echo $?; xenum 2x 2>&1; echo $?
