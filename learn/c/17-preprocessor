q: chkmac.c -- an assert that says where it failed
spec: The file is given: it runs a list of checks in `main`, each written
spec: `CHECK(expression);`, and the stub `CHECK` above it counts but never
spec: reports. Rewrite the macro; do not add or remove lines inside `main`.
spec:
spec: `CHECK` counts the check in `checks`. If `cond` is false it also
spec: counts a failure in `failed` and prints to standard error:
spec: `FILE:LINE: check failed: TEXT` where FILE is `__FILE__`, LINE is
spec: `__LINE__` minus `base_line` (so the first check in `main` is line 1
spec: whatever you put above it), and TEXT is the expression as written,
spec: with `#cond`. It must be one statement (it is used as an unbraced
spec: `if` body) and must evaluate `cond` exactly once.
spec:
spec: The program then prints `9 checks, 2 failed` and exits 1, because
spec: two checks are written to fail: `chkmac.c:6: check failed:
spec: is_leap(2023)` and `chkmac.c:12: check failed: clamp(7, 8, 9) == 7`.
file: chkmac.c
start: #include <stdio.h>
start: 
start: static int checks, failed;
start: static int base_line;
start: static int counter;
start: 
start: static int bump(void)
start: {
start: 	return ++counter;
start: }
start: 
start: static int clamp(int v, int lo, int hi)
start: {
start: 	return v < lo ? lo : v > hi ? hi : v;
start: }
start: 
start: static int is_leap(int y)
start: {
start: 	return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0);
start: }
start: 
start: /* a stub: it counts, and never reports */
start: #define CHECK(cond)         \
start: 	do {                    \
start: 		checks++;           \
start: 		(void)(cond);       \
start: 		(void)base_line;    \
start: 	} while (0)
start: 
start: int main(void)
start: {
start: 	base_line = __LINE__;
start: 	CHECK(clamp(5, 0, 10) == 5);
start: 	CHECK(clamp(-3, 0, 10) == 0);
start: 	CHECK(clamp(99, 0, 10) == 10);
start: 	CHECK(is_leap(2000));
start: 	CHECK(!is_leap(1900));
start: 	CHECK(is_leap(2023));
start: 	CHECK(bump() == 1);
start: 	CHECK(bump() == 2);
start: 	if (failed == 0)
start: 		CHECK(0);
start: 	else
start: 		CHECK(clamp(7, 8, 9) == 7);
start: 	printf("%d checks, %d failed\n", checks, failed);
start: 	return failed != 0;
start: }
prog: #include <stdio.h>
prog: 
prog: static int checks, failed;
prog: static int base_line;
prog: static int counter;
prog: 
prog: static int bump(void)
prog: {
prog: 	return ++counter;
prog: }
prog: 
prog: static int clamp(int v, int lo, int hi)
prog: {
prog: 	return v < lo ? lo : v > hi ? hi : v;
prog: }
prog: 
prog: static int is_leap(int y)
prog: {
prog: 	return y % 4 == 0 && (y % 100 != 0 || y % 400 == 0);
prog: }
prog: 
prog: /* do { } while (0): one statement, so it is safe under an unbraced if/else;
prog:    cond is written once, so a side effect in it runs once */
prog: #define CHECK(cond)                                                    \
prog: 	do {                                                               \
prog: 		checks++;                                                      \
prog: 		if (!(cond)) {                                                 \
prog: 			failed++;                                                  \
prog: 			fprintf(stderr, "%s:%d: check failed: %s\n", __FILE__,     \
prog: 					__LINE__ - base_line, #cond);                      \
prog: 		}                                                              \
prog: 	} while (0)
prog: 
prog: int main(void)
prog: {
prog: 	base_line = __LINE__;
prog: 	CHECK(clamp(5, 0, 10) == 5);
prog: 	CHECK(clamp(-3, 0, 10) == 0);
prog: 	CHECK(clamp(99, 0, 10) == 10);
prog: 	CHECK(is_leap(2000));
prog: 	CHECK(!is_leap(1900));
prog: 	CHECK(is_leap(2023));
prog: 	CHECK(bump() == 1);
prog: 	CHECK(bump() == 2);
prog: 	if (failed == 0)
prog: 		CHECK(0);
prog: 	else
prog: 		CHECK(clamp(7, 8, 9) == 7);
prog: 	printf("%d checks, %d failed\n", checks, failed);
prog: 	return failed != 0;
prog: }
