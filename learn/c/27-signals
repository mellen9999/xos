q: sigcoalesce.c -- signals that arrive together
spec: Take one argument N, a whole number from 0 to 100. Install a
spec: `sigaction` handler for SIGUSR1 that counts its runs in a
spec: `volatile sig_atomic_t`. Then block SIGUSR1 with `sigprocmask`
spec: (remember the old mask), `raise` it N times, and print
spec: `blocked: pending=P caught=C`: P is 1 if SIGUSR1 is pending
spec: (`sigpending`, `sigismember`) and 0 if not, C the handler's count.
spec:
spec: Then put the old mask back, which lets any pending signal in, and
spec: print `unblocked: caught=C` with the count now. Exit 0.
spec:
spec: A blocked signal is pending, not queued: five raises leave one
spec: pending signal, so the handler runs once.
spec:
spec: Anything else prints `usage: sigcoalesce N` to standard error and
spec: exits 2. If the setup calls fail print the line
spec: `sigcoalesce: signal setup failed` to standard error and exit 1.
file: sigcoalesce.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <signal.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: static volatile sig_atomic_t count;
prog: 
prog: static void on_usr1(int sig)
prog: {
prog: 	(void)sig;
prog: 	count = count + 1;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	long n = -1;
prog: 	char *end = NULL;
prog: 	if (argc == 2) {
prog: 		errno = 0;
prog: 		n = strtol(argv[1], &end, 10);
prog: 		if (errno != 0 || end == argv[1] || *end != '\0')
prog: 			n = -1;
prog: 	}
prog: 	if (n < 0 || n > 100) {
prog: 		fprintf(stderr, "usage: sigcoalesce N\n");
prog: 		return 2;
prog: 	}
prog: 	struct sigaction sa;
prog: 	memset(&sa, 0, sizeof sa);
prog: 	sa.sa_handler = on_usr1;
prog: 	sigemptyset(&sa.sa_mask);
prog: 	sigset_t usr1, old, pending;
prog: 	sigemptyset(&usr1);
prog: 	sigaddset(&usr1, SIGUSR1);
prog: 	if (sigaction(SIGUSR1, &sa, NULL) != 0 || sigprocmask(SIG_BLOCK, &usr1, &old) != 0) {
prog: 		fprintf(stderr, "sigcoalesce: signal setup failed\n");
prog: 		return 1;
prog: 	}
prog: 	for (long i = 0; i < n; i++)
prog: 		raise(SIGUSR1);
prog: 	sigpending(&pending);
prog: 	printf("blocked: pending=%d caught=%d\n", sigismember(&pending, SIGUSR1), (int)count);
prog: 	sigprocmask(SIG_SETMASK, &old, NULL);
prog: 	printf("unblocked: caught=%d\n", (int)count);
prog: 	return 0;
prog: }
case: sigcoalesce 5
case: sigcoalesce 1
case: sigcoalesce 0
case: sigcoalesce 100
case: sigcoalesce -1; echo $?
case: sigcoalesce; echo $?
hint: sigprocmask(SIG_BLOCK, &set, &old) before the raises; ask sigpending while blocked; sigprocmask(SIG_SETMASK, &old, NULL) afterwards lets it through
