q: killkid.c -- kill your own child
spec: Take one argument, MODE: `default`, `handled` or `ignored`. Make two
spec: pipes and fork a child. The child sets itself up for its MODE, then
spec: writes one byte to the first pipe to say it is ready, then waits:
spec:
spec: `default`: leaves SIGTERM alone and blocks in `read` on the second
spec: pipe (nobody ever writes to it).
spec: `ignored`: sets SIGTERM to `SIG_IGN`, then blocks the same way.
spec: `handled`: blocks SIGTERM with `sigprocmask` first, installs a
spec: handler that sets a flag, then sleeps in `sigsuspend` until the flag
spec: is set and leaves with `_exit(42)`. (Block first, or a SIGTERM that
spec: lands between the check and the sleep is lost.)
spec:
spec: The parent reads the ready byte, then sends the child SIGTERM; in
spec: `ignored` mode it then also sends SIGKILL. It waits for the child,
spec: and prints `exit N` or `signal S` as the child really ended: that
spec: is `signal 15` for default, `exit 42` for handled, `signal 9` for
spec: ignored. Exit 0. Keep the parent's end of the second pipe open
spec: until the child has been collected.
spec:
spec: A missing or unknown MODE prints `usage: killkid MODE` to standard
spec: error and exits 2. Failures print `killkid: pipe failed`,
spec: `killkid: fork failed`, `killkid: child failed` (no ready byte
spec: arrived) or `killkid: wait failed`, and exit 1.
file: killkid.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <signal.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: static volatile sig_atomic_t got_term;
prog: 
prog: static void on_term(int sig)
prog: {
prog: 	(void)sig;
prog: 	got_term = 1;
prog: }
prog: 
prog: static void set_action(int sig, void (*handler)(int))
prog: {
prog: 	struct sigaction sa;
prog: 	memset(&sa, 0, sizeof sa);
prog: 	sa.sa_handler = handler;
prog: 	sigemptyset(&sa.sa_mask);
prog: 	if (sigaction(sig, &sa, NULL) != 0)
prog: 		_exit(1);
prog: }
prog: 
prog: /* runs in the child: set up, say so over ready_fd, then wait to be signalled */
prog: static void child(const char *mode, int ready_fd, int hold_fd)
prog: {
prog: 	sigset_t term, old;
prog: 	sigemptyset(&term);
prog: 	sigaddset(&term, SIGTERM);
prog: 	if (strcmp(mode, "handled") == 0) {
prog: 		sigprocmask(SIG_BLOCK, &term, &old);
prog: 		set_action(SIGTERM, on_term);
prog: 	} else if (strcmp(mode, "ignored") == 0) {
prog: 		set_action(SIGTERM, SIG_IGN);
prog: 	}
prog: 	if (write(ready_fd, "r", 1) != 1)
prog: 		_exit(1);
prog: 	if (strcmp(mode, "handled") == 0) {
prog: 		while (!got_term)
prog: 			sigsuspend(&old);
prog: 		_exit(42);
prog: 	}
prog: 	char c;
prog: 	if (read(hold_fd, &c, 1) < 0 && errno != EINTR)
prog: 		_exit(1);
prog: 	_exit(1);
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2 || (strcmp(argv[1], "default") != 0 && strcmp(argv[1], "handled") != 0 &&
prog: 			  strcmp(argv[1], "ignored") != 0)) {
prog: 		fprintf(stderr, "usage: killkid MODE\n");
prog: 		return 2;
prog: 	}
prog: 	int ready[2], hold[2];
prog: 	if (pipe(ready) != 0 || pipe(hold) != 0) {
prog: 		fprintf(stderr, "killkid: pipe failed\n");
prog: 		return 1;
prog: 	}
prog: 	pid_t pid = fork();
prog: 	if (pid < 0) {
prog: 		fprintf(stderr, "killkid: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (pid == 0) {
prog: 		close(ready[0]);
prog: 		close(hold[1]);
prog: 		child(argv[1], ready[1], hold[0]);
prog: 	}
prog: 	close(ready[1]);
prog: 	close(hold[0]);
prog: 	char c;
prog: 	ssize_t r;
prog: 	do {
prog: 		r = read(ready[0], &c, 1);
prog: 	} while (r < 0 && errno == EINTR);
prog: 	if (r != 1) {
prog: 		fprintf(stderr, "killkid: child failed\n");
prog: 		return 1;
prog: 	}
prog: 	kill(pid, SIGTERM);
prog: 	if (strcmp(argv[1], "ignored") == 0)
prog: 		kill(pid, SIGKILL);
prog: 	int status;
prog: 	if (waitpid(pid, &status, 0) < 0) {
prog: 		fprintf(stderr, "killkid: wait failed\n");
prog: 		return 1;
prog: 	}
prog: 	close(hold[1]);
prog: 	if (WIFEXITED(status))
prog: 		printf("exit %d\n", WEXITSTATUS(status));
prog: 	else if (WIFSIGNALED(status))
prog: 		printf("signal %d\n", WTERMSIG(status));
prog: 	return 0;
prog: }
case: killkid default
case: killkid handled
case: killkid ignored
case: killkid; echo $?
case: killkid other; echo $?
hint: child writes its ready byte only after its signal setup is done; in handled mode block SIGTERM, install the handler, then loop on sigsuspend(&old) until the flag is set
