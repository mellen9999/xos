q: sigpipe.c -- write to a pipe nobody reads
spec: Take one argument, MODE: `ignore` or `handle`. Set up SIGPIPE with
spec: `sigaction` -- `SIG_IGN` for ignore, a handler that sets a
spec: `volatile sig_atomic_t` flag for handle. Make a pipe, close its read
spec: end, and write one byte to the write end.
spec:
spec: That write fails with `EPIPE`, whichever MODE. Print
spec: `write failed: EPIPE` (your own words, not strerror's), then print
spec: `handler ran: yes` if the flag is set and `handler ran: no` if not.
spec: Exit 0. (If the write somehow did not fail, print
spec: `write did not fail` instead of the first line.)
spec:
spec: A missing or unknown MODE prints `usage: sigpipe MODE` to standard
spec: error and exits 2. If `sigaction` or `pipe` fails print
spec: `sigpipe: sigaction failed` or `sigpipe: pipe failed` to standard
spec: error and exit 1.
file: sigpipe.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <signal.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: #include <unistd.h>
prog: 
prog: static volatile sig_atomic_t seen;
prog: 
prog: static void on_pipe(int sig)
prog: {
prog: 	(void)sig;
prog: 	seen = 1;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2 || (strcmp(argv[1], "ignore") != 0 && strcmp(argv[1], "handle") != 0)) {
prog: 		fprintf(stderr, "usage: sigpipe MODE\n");
prog: 		return 2;
prog: 	}
prog: 	struct sigaction sa;
prog: 	memset(&sa, 0, sizeof sa);
prog: 	sigemptyset(&sa.sa_mask);
prog: 	sa.sa_handler = strcmp(argv[1], "ignore") == 0 ? SIG_IGN : on_pipe;
prog: 	if (sigaction(SIGPIPE, &sa, NULL) != 0) {
prog: 		fprintf(stderr, "sigpipe: sigaction failed\n");
prog: 		return 1;
prog: 	}
prog: 	int fd[2];
prog: 	if (pipe(fd) != 0) {
prog: 		fprintf(stderr, "sigpipe: pipe failed\n");
prog: 		return 1;
prog: 	}
prog: 	close(fd[0]);
prog: 	ssize_t w = write(fd[1], "x", 1);
prog: 	if (w < 0 && errno == EPIPE)
prog: 		printf("write failed: EPIPE\n");
prog: 	else
prog: 		printf("write did not fail\n");
prog: 	printf("handler ran: %s\n", seen ? "yes" : "no");
prog: 	close(fd[1]);
prog: 	return 0;
prog: }
case: sigpipe ignore
case: sigpipe handle
case: sigpipe; echo $?
case: sigpipe quiet; echo $?
hint: with the read end closed, write() returns -1 and errno is EPIPE; the signal is delivered before write returns, so the flag is already set by the time you look
