q: capture.c -- catch a command's output
spec: Run the command given as the arguments (`capture echo hi`) in a
spec: child whose standard output is a pipe to you. Read everything it
spec: writes into one growing buffer (it can be any size), wait for it,
spec: then print the captured text with `> ` in front of every line. If
spec: the last line has no newline, add one. No output at all prints no
spec: lines. Then print `exit N`, or `signal S` if a signal ended it.
spec: Exit 0. The command's standard error is not captured -- it goes
spec: straight through, so it shows up before anything you print.
spec:
spec: If the command cannot be run the child prints
spec: `capture: cannot run NAME` to standard error and exits 127.
spec: No arguments prints `usage: capture CMD [ARG...]` to standard error
spec: and exits 2. Failures of `pipe`, `fork`, `realloc` or `waitpid`
spec: print `capture: pipe failed`, `capture: fork failed`,
spec: `capture: out of memory` or `capture: wait failed` and exit 1.
file: capture.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc < 2) {
prog: 		fprintf(stderr, "usage: capture CMD [ARG...]\n");
prog: 		return 2;
prog: 	}
prog: 	int fd[2];
prog: 	if (pipe(fd) != 0) {
prog: 		fprintf(stderr, "capture: pipe failed\n");
prog: 		return 1;
prog: 	}
prog: 	pid_t pid = fork();
prog: 	if (pid < 0) {
prog: 		fprintf(stderr, "capture: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (pid == 0) {
prog: 		dup2(fd[1], STDOUT_FILENO);
prog: 		close(fd[0]);
prog: 		close(fd[1]);
prog: 		execvp(argv[1], argv + 1);
prog: 		fprintf(stderr, "capture: cannot run %s\n", argv[1]);
prog: 		_exit(127);
prog: 	}
prog: 	close(fd[1]);
prog: 	char *buf = NULL;
prog: 	size_t len = 0, cap = 0;
prog: 	for (;;) {
prog: 		if (len == cap) {
prog: 			size_t ncap = cap ? cap * 2 : 4096;
prog: 			char *bigger = realloc(buf, ncap);
prog: 			if (bigger == NULL) {
prog: 				fprintf(stderr, "capture: out of memory\n");
prog: 				free(buf);
prog: 				return 1;
prog: 			}
prog: 			buf = bigger;
prog: 			cap = ncap;
prog: 		}
prog: 		ssize_t r = read(fd[0], buf + len, cap - len);
prog: 		if (r < 0 && errno == EINTR)
prog: 			continue;
prog: 		if (r <= 0)
prog: 			break;
prog: 		len += (size_t)r;
prog: 	}
prog: 	close(fd[0]);
prog: 	int status;
prog: 	if (waitpid(pid, &status, 0) < 0) {
prog: 		fprintf(stderr, "capture: wait failed\n");
prog: 		free(buf);
prog: 		return 1;
prog: 	}
prog: 	bool bol = true;
prog: 	for (size_t i = 0; i < len; i++) {
prog: 		if (bol)
prog: 			fputs("> ", stdout);
prog: 		putchar(buf[i]);
prog: 		bol = buf[i] == '\n';
prog: 	}
prog: 	if (!bol)
prog: 		putchar('\n');
prog: 	free(buf);
prog: 	if (WIFEXITED(status))
prog: 		printf("exit %d\n", WEXITSTATUS(status));
prog: 	else if (WIFSIGNALED(status))
prog: 		printf("signal %d\n", WTERMSIG(status));
prog: 	return 0;
prog: }
case: capture echo hi
case: capture sh -c 'printf "a\nb"'
case: capture true
case: capture sh -c 'echo out; echo err >&2; exit 3'
case: capture sh -c 'i=0; while [ $i -lt 2000 ]; do echo line$i; i=$((i+1)); done' | wc -l
case: capture nosuchprogram
case: capture; echo $?
hint: realloc the buffer to double when it is full, read into the free part; print by walking the bytes and writing "> " whenever you are at the start of a line
