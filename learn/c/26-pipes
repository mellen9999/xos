q: twostage.c -- build a pipe by hand
spec: Do by hand what a shell does for a two-command pipeline. Take
spec: exactly two arguments, each a shell command line. Make one pipe and
spec: start two children, each running its argument with `sh -c` (via
spec: `execlp`): the left child's standard output is the pipe, the right
spec: child's standard input is the pipe. Both run at the same time.
spec:
spec: Close all four spare ends in the parent and the unused ends in each
spec: child -- otherwise the right side never sees end of file and hangs.
spec:
spec: Wait for both, then print `left A right B` where A and B are the
spec: exit statuses (a child ended by signal S counts as 128 plus S).
spec: Whatever the right side prints comes before that line. Exit 0.
spec:
spec: A wrong number of arguments prints `usage: twostage LEFT RIGHT` to
spec: standard error and exits 2. If `pipe` fails print
spec: `twostage: pipe failed` and exit 1; if a `fork` fails, still wait for
spec: the child that did start, print `twostage: fork failed` and exit 1.
file: twostage.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <stdio.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: /* the child's end of the pipe becomes descriptor 'target'; the rest close */
prog: static void child(const char *cmd, const int fd[2], int use, int target)
prog: {
prog: 	dup2(fd[use], target);
prog: 	close(fd[0]);
prog: 	close(fd[1]);
prog: 	execlp("sh", "sh", "-c", cmd, (char *)NULL);
prog: 	_exit(127);
prog: }
prog: 
prog: static int decode(int status)
prog: {
prog: 	return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 3) {
prog: 		fprintf(stderr, "usage: twostage LEFT RIGHT\n");
prog: 		return 2;
prog: 	}
prog: 	int fd[2];
prog: 	if (pipe(fd) != 0) {
prog: 		fprintf(stderr, "twostage: pipe failed\n");
prog: 		return 1;
prog: 	}
prog: 	pid_t left = fork();
prog: 	if (left == 0)
prog: 		child(argv[1], fd, 1, STDOUT_FILENO);
prog: 	pid_t right = left < 0 ? -1 : fork();
prog: 	if (right == 0)
prog: 		child(argv[2], fd, 0, STDIN_FILENO);
prog: 	close(fd[0]);
prog: 	close(fd[1]);
prog: 	int ls = 0, rs = 0;
prog: 	if (left > 0)
prog: 		waitpid(left, &ls, 0);
prog: 	if (right > 0)
prog: 		waitpid(right, &rs, 0);
prog: 	if (left < 0 || right < 0) {
prog: 		fprintf(stderr, "twostage: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	printf("left %d right %d\n", decode(ls), decode(rs));
prog: 	return 0;
prog: }
case: twostage 'echo hello' 'tr a-z A-Z'
case: twostage 'printf "b\na\nc\n"' sort
case: twostage 'echo x; exit 3' 'cat; exit 4'
case: twostage true 'wc -c'
case: twostage x; echo $?
hint: pipe once, fork twice; in the left child dup2(fd[1], 1), in the right dup2(fd[0], 0), each closes both fd afterwards; the parent closes both fd before it waits
