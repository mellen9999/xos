q: feedtr.c -- feed a child through its stdin
spec: Start the program `tr a-z A-Z` (found through PATH, so use
spec: `execlp` or `execvp`) as a child whose standard input is a pipe from
spec: you. Write each command-line argument to that pipe followed by a
spec: newline, in order, then close the write end so `tr` sees end of
spec: file. Wait for `tr`, then print `tr exited N` with its exit status.
spec: Exit 0. `tr` writes its own output (the arguments in capitals, one
spec: per line) straight to your standard output, so it appears before
spec: the last line. With no arguments `tr` gets an empty input.
spec:
spec: Use `dup2` in the child to make the pipe its standard input, and
spec: close every spare end of the pipe in both processes.
spec:
spec: If `pipe`, `fork` or `fdopen` fails print `feedtr: pipe failed`,
spec: `feedtr: fork failed` or `feedtr: fdopen failed` to standard error
spec: and exit 1. If `tr` did not exit normally print
spec: `feedtr: tr did not exit` to standard error and exit 1.
file: feedtr.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <stdio.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	int fd[2];
prog: 	if (pipe(fd) != 0) {
prog: 		fprintf(stderr, "feedtr: pipe failed\n");
prog: 		return 1;
prog: 	}
prog: 	pid_t pid = fork();
prog: 	if (pid < 0) {
prog: 		fprintf(stderr, "feedtr: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (pid == 0) {
prog: 		dup2(fd[0], STDIN_FILENO);
prog: 		close(fd[0]);
prog: 		close(fd[1]);
prog: 		execlp("tr", "tr", "a-z", "A-Z", (char *)NULL);
prog: 		_exit(127);
prog: 	}
prog: 	close(fd[0]);
prog: 	FILE *to = fdopen(fd[1], "w");
prog: 	if (to == NULL) {
prog: 		fprintf(stderr, "feedtr: fdopen failed\n");
prog: 		return 1;
prog: 	}
prog: 	for (int i = 1; i < argc; i++)
prog: 		fprintf(to, "%s\n", argv[i]);
prog: 	fclose(to);
prog: 	int status;
prog: 	if (waitpid(pid, &status, 0) < 0 || !WIFEXITED(status)) {
prog: 		fprintf(stderr, "feedtr: tr did not exit\n");
prog: 		return 1;
prog: 	}
prog: 	printf("tr exited %d\n", WEXITSTATUS(status));
prog: 	return 0;
prog: }
case: feedtr abc Def
case: feedtr
case: feedtr "hello world" "" 'MiXeD 123'
case: feedtr x; echo $?
hint: child: dup2(fd[0], STDIN_FILENO), close both fd, execlp("tr", "tr", "a-z", "A-Z", NULL); parent: close fd[0], write the lines, close fd[1] so tr can finish
