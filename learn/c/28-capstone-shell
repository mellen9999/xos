prog: static int do_cd(char **argv)
prog: {
prog: 	if (argv[1] == NULL || argv[2] != NULL) {
prog: 		fprintf(stderr, "shrun: cd: usage: cd DIR\n");
prog: 		return 2;
prog: 	}
prog: 	if (chdir(argv[1]) != 0) {
prog: 		fprintf(stderr, "shrun: cd: %s: cannot cd\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	return 0;
prog: }
prog: 
prog: /* returns the new status; sets *quit when the shell should leave */
prog: static int do_exit(char **argv, int status, bool *quit)
prog: {
prog: 	long code = status;
prog: 	if (argv[1] != NULL) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		code = strtol(argv[1], &end, 10);
prog: 		if (argv[2] != NULL || errno != 0 || end == argv[1] || *end != '\0' || code < 0) {
prog: 			fprintf(stderr, "shrun: exit: bad status\n");
prog: 			return 2;
prog: 		}
prog: 	}
prog: 	*quit = true;
prog: 	return (int)(code % 256);
prog: }
