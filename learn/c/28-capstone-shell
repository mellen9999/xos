name: capstone: a shell
intro: You now hold every piece of a shell. The shell on this box is a
intro: loop:
intro:
intro:     read a line, split it into words, run it, keep the status
intro:
intro: Reading: `getline(&line, &cap, stdin)` returns the length (or -1 at
intro: the end) and grows `line` as needed with `malloc` underneath, so no
intro: line is too long for it. Free the buffer once, at the end.
intro:
intro: Splitting is where the care goes. Blanks separate words, quotes
intro: group them, and `|`, `<`, `>` are operators even without blanks
intro: around them. Write it as one pass over the characters with a few
intro: flags, not as a pile of special cases.
intro:
intro: Running is what you learned in the last three units. `fork`, then
intro: `execvp(argv[0], argv)` in the child, then `waitpid`. The status the
intro: shell keeps is the exit code, or 128 plus the signal number: that is
intro: why a killed command shows 137, and why a missing command is 127
intro: (and one that exists but cannot run, 126). `$?` is that number.
intro:
intro: Some commands cannot be run by a child. `cd` changes the directory
intro: of the process that calls `chdir`; a child's `cd` would vanish with
intro: the child. So the shell handles `cd` and `exit` itself.
intro:
intro: A pipeline `a | b | c` is two pipes and three children, all started
intro: before any is waited for. In each child `dup2` puts the pipe on 0 or
intro: 1, then every pipe descriptor is closed: a spare write end anywhere
intro: keeps the reader waiting forever. A redirection is the same move
intro: with a file: in the child, `open` it, `dup2` it onto 0 or 1, `close`
intro: it.
intro:
intro: Four programs, each a complete shell a little bigger than the last.
intro: Each starts in vi as the previous one, so you grow it instead of
intro: retyping it: `shtok` splits lines, `shrun` runs them, `shpipe` joins
intro: them, `minish` redirects them. In vi, `:%s/old/new/g` renames every
intro: `old` in the file -- use it for the message prefix. Keep all four;
intro: the next unit builds an interpreter the same way.
---
q: shtok.c -- split command lines into words
spec: Read standard input a line at a time and split each line into
spec: tokens the way a shell does. For each line print the number of
spec: tokens, a colon, then every token preceded by one space. A word
spec: prints inside square brackets; an operator prints bare.
spec: `echo "a b" > f` gives `4: [echo] [a b] > [f]`. Exit 0.
spec:
spec: The rules:
spec: - Spaces and tabs separate tokens and are otherwise ignored.
spec: - A double quote starts a quoted stretch that ends at the next double
spec:   quote. Inside it, blanks and operators are plain characters. The
spec:   quote marks themselves are dropped. A stretch may touch other
spec:   text: `a"b c"d` is the single word `ab cd`, and `""` is one empty
spec:   word.
spec: - Outside quotes, each of the vertical bar, `<` and `>` is a token
spec:   of its own (an operator), with or without blanks around it.
spec: - The two characters `$?` anywhere in a word, quoted or not, become
spec:   `0` (nothing has run yet, so the last status is 0).
spec: - A line with no tokens prints `0:`.
spec: - A line whose quote is never closed prints the single line
spec:   `error: unterminated quote` instead, and reading goes on. Then
spec:   the exit status is 1 rather than 0.
spec:
spec: The last line counts even without a final newline. Lines may be any
spec: length. A failed read or allocation prints `shtok: read error` or
spec: `shtok: out of memory` to standard error and exits 1.
file: shtok.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: typedef struct {
prog: 	char *text;
prog: 	bool op;
prog: } tok;
prog: 
prog: static bool is_op(char c)
prog: {
prog: 	return c == '|' || c == '<' || c == '>';
prog: }
prog: 
prog: static bool is_blank(char c)
prog: {
prog: 	return c == ' ' || c == '\t';
prog: }
prog: 
prog: /*
prog:  * Split s into toks, copying each token's text into buf. Returns the token
prog:  * count, or -1 if a quote is never closed. buf needs 2 * strlen(s) + 1
prog:  * bytes and toks strlen(s) + 1 entries.
prog:  */
prog: static long tokenize(const char *s, int status, char *buf, tok *toks)
prog: {
prog: 	long n = 0;
prog: 	char *out = buf;
prog: 	while (*s != '\0') {
prog: 		if (is_blank(*s)) {
prog: 			s++;
prog: 			continue;
prog: 		}
prog: 		toks[n].text = out;
prog: 		if (is_op(*s)) {
prog: 			toks[n].op = true;
prog: 			*out++ = *s++;
prog: 		} else {
prog: 			toks[n].op = false;
prog: 			bool quoted = false;
prog: 			while (*s != '\0' && (quoted || (!is_blank(*s) && !is_op(*s)))) {
prog: 				if (*s == '"') {
prog: 					quoted = !quoted;
prog: 					s++;
prog: 				} else if (s[0] == '$' && s[1] == '?') {
prog: 					out += sprintf(out, "%d", status);
prog: 					s += 2;
prog: 				} else {
prog: 					*out++ = *s++;
prog: 				}
prog: 			}
prog: 			if (quoted)
prog: 				return -1;
prog: 		}
prog: 		*out++ = '\0';
prog: 		n++;
prog: 	}
prog: 	return n;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	while ((len = getline(&line, &cap, stdin)) != -1) {
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			line[--len] = '\0';
prog: 		char *buf = malloc(2 * (size_t)len + 1);
prog: 		tok *toks = malloc(((size_t)len + 1) * sizeof *toks);
prog: 		if (buf == NULL || toks == NULL) {
prog: 			fprintf(stderr, "shtok: out of memory\n");
prog: 			free(buf);
prog: 			free(toks);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		long n = tokenize(line, 0, buf, toks);
prog: 		if (n < 0) {
prog: 			printf("error: unterminated quote\n");
prog: 			status = 1;
prog: 		} else {
prog: 			printf("%ld:", n);
prog: 			for (long i = 0; i < n; i++) {
prog: 				if (toks[i].op)
prog: 					printf(" %s", toks[i].text);
prog: 				else
prog: 					printf(" [%s]", toks[i].text);
prog: 			}
prog: 			putchar('\n');
prog: 		}
prog: 		free(buf);
prog: 		free(toks);
prog: 	}
prog: 	free(line);
prog: 	if (ferror(stdin)) {
prog: 		fprintf(stderr, "shtok: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	return status;
prog: }
case: printf 'echo hello world\n' | shtok
case: printf 'echo "a   b" x\n' | shtok
case: printf 'ls|wc >out <in\n' | shtok
case: printf 'a"b c"d "" "|" x$?y\n' | shtok
case: printf '\n  \t \n' | shtok
case: printf 'echo "oops\nok $?\n' | shtok; echo $?
case: printf 'a b' | shtok
hint: one pass over the characters: skip blanks, a lone bar, < or > is its own token, otherwise build a word and flip a quoted flag at each double quote; getline reads a line of any length
