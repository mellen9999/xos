start: /* returns the new status; sets *quit when the shell should leave */
start: static int do_exit(char **argv, int status, bool *quit)
start: {
start: 	long code = status;
start: 	if (argv[1] != NULL) {
start: 		char *end;
start: 		errno = 0;
start: 		code = strtol(argv[1], &end, 10);
start: 		if (argv[2] != NULL || errno != 0 || end == argv[1] || *end != '\0' || code < 0) {
start: 			fprintf(stderr, "shpipe: exit: bad status\n");
start: 			return 2;
start: 		}
start: 	}
start: 	*quit = true;
start: 	return (int)(code % 256);
start: }
start: 
start: static int decode(int st)
start: {
start: 	return WIFEXITED(st) ? WEXITSTATUS(st) : 128 + WTERMSIG(st);
start: }
