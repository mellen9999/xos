prog: /* one line's tokens: run it, return the new status */
prog: static int command(tok *toks, long n, int status, bool *quit)
prog: {
prog: 	char **av = malloc((2 * (size_t)n + 2) * sizeof *av);
prog: 	cmd *cmds = malloc(((size_t)n + 1) * sizeof *cmds);
prog: 	if (av == NULL || cmds == NULL) {
prog: 		fprintf(stderr, "minish: out of memory\n");
prog: 		free(av);
prog: 		free(cmds);
prog: 		return 1;
prog: 	}
prog: 	int rc = 2;
prog: 	long k = parse(toks, n, av, cmds);
prog: 	bool builtin = k == 1 && (strcmp(cmds[0].argv[0], "cd") == 0 || strcmp(cmds[0].argv[0], "exit") == 0);
prog: 	if (builtin && (cmds[0].in != NULL || cmds[0].out != NULL))
prog: 		fprintf(stderr, "minish: builtins take no redirection\n");
prog: 	else if (builtin && strcmp(cmds[0].argv[0], "cd") == 0)
prog: 		rc = do_cd(cmds[0].argv);
prog: 	else if (builtin)
prog: 		rc = do_exit(cmds[0].argv, status, quit);
prog: 	else if (k > 0)
prog: 		rc = pipeline(cmds, k);
prog: 	free(av);
prog: 	free(cmds);
prog: 	return rc;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	bool quit = false;
prog: 	while (!quit && (len = getline(&line, &cap, stdin)) != -1) {
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			line[--len] = '\0';
prog: 		char *buf = malloc(2 * (size_t)len + 1);
prog: 		tok *toks = malloc(((size_t)len + 1) * sizeof *toks);
prog: 		if (buf == NULL || toks == NULL) {
prog: 			fprintf(stderr, "minish: out of memory\n");
prog: 			free(buf);
prog: 			free(toks);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		long n = tokenize(line, status, buf, toks);
prog: 		if (n < 0) {
prog: 			fprintf(stderr, "minish: unterminated quote\n");
prog: 			status = 2;
prog: 		} else if (n > 0) {
prog: 			status = command(toks, n, status, &quit);
prog: 		}
prog: 		free(buf);
prog: 		free(toks);
prog: 	}
prog: 	free(line);
prog: 	if (!quit && ferror(stdin)) {
prog: 		fprintf(stderr, "minish: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	return status;
prog: }
