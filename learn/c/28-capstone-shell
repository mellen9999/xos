start: /* start every command with its stdout feeding the next one's stdin */
start: static int pipeline(cmd *cmds, long k)
start: {
start: 	pid_t *pids = malloc((size_t)k * sizeof *pids);
start: 	if (pids == NULL) {
start: 		fprintf(stderr, "shpipe: out of memory\n");
start: 		return 1;
start: 	}
start: 	long started = 0;
start: 	int in = -1;
start: 	bool failed = false;
start: 	for (long i = 0; i < k; i++) {
start: 		int fd[2] = {-1, -1};
start: 		if (i + 1 < k && pipe(fd) != 0) {
start: 			fprintf(stderr, "shpipe: pipe failed\n");
start: 			failed = true;
start: 			break;
start: 		}
start: 		pid_t pid = fork();
start: 		if (pid < 0) {
start: 			fprintf(stderr, "shpipe: fork failed\n");
start: 			if (fd[0] != -1) {
start: 				close(fd[0]);
start: 				close(fd[1]);
start: 			}
start: 			failed = true;
start: 			break;
start: 		}
start: 		if (pid == 0) {
start: 			if (in != -1) {
start: 				dup2(in, STDIN_FILENO);
start: 				close(in);
start: 			}
start: 			if (fd[1] != -1) {
start: 				dup2(fd[1], STDOUT_FILENO);
start: 				close(fd[0]);
start: 				close(fd[1]);
start: 			}
start: 			exec_cmd(cmds[i].argv);
start: 		}
start: 		pids[started++] = pid;
start: 		if (in != -1)
start: 			close(in);
start: 		if (fd[1] != -1)
start: 			close(fd[1]);
start: 		in = fd[0];
start: 	}
start: 	if (in != -1)
start: 		close(in);
start: 	int rc = 0;
start: 	for (long i = 0; i < started; i++) {
start: 		int st;
