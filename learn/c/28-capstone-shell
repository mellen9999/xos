start: typedef struct {
start: 	char *text;
start: 	bool op;
start: } tok;
start: 
start: static bool is_op(char c)
start: {
start: 	return c == '|' || c == '<' || c == '>';
start: }
start: 
start: static bool is_blank(char c)
start: {
start: 	return c == ' ' || c == '\t';
start: }
start: 
start: /*
start:  * Split s into toks, copying each token's text into buf. Returns the token
start:  * count, or -1 if a quote is never closed. buf needs 2 * strlen(s) + 1
start:  * bytes and toks strlen(s) + 1 entries.
start:  */
start: static long tokenize(const char *s, int status, char *buf, tok *toks)
start: {
start: 	long n = 0;
start: 	char *out = buf;
start: 	while (*s != '\0') {
start: 		if (is_blank(*s)) {
start: 			s++;
start: 			continue;
start: 		}
start: 		toks[n].text = out;
start: 		if (is_op(*s)) {
start: 			toks[n].op = true;
start: 			*out++ = *s++;
start: 		} else {
start: 			toks[n].op = false;
start: 			bool quoted = false;
start: 			while (*s != '\0' && (quoted || (!is_blank(*s) && !is_op(*s)))) {
start: 				if (*s == '"') {
start: 					quoted = !quoted;
start: 					s++;
start: 				} else if (s[0] == '$' && s[1] == '?') {
start: 					out += sprintf(out, "%d", status);
start: 					s += 2;
start: 				} else {
start: 					*out++ = *s++;
start: 				}
start: 			}
start: 			if (quoted)
start: 				return -1;
start: 		}
start: 		*out++ = '\0';
start: 		n++;
start: 	}
start: 	return n;
start: }
