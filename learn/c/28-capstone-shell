prog: /*
prog:  * Split the tokens into commands at each vertical bar, setting aside each
prog:  * command's redirections. The words go into av, each command's list ending
prog:  * in NULL. Returns how many commands, or -1 after printing what is wrong.
prog:  */
prog: static long parse(tok *toks, long n, char **av, cmd *cmds)
prog: {
prog: 	long k = 1, a = 0;
prog: 	cmds[0] = (cmd){&av[0], NULL, NULL};
prog: 	for (long i = 0; i < n; i++) {
prog: 		if (!toks[i].op) {
prog: 			av[a++] = toks[i].text;
prog: 			continue;
prog: 		}
prog: 		char c = toks[i].text[0];
prog: 		if (c == '<' || c == '>') {
prog: 			if (i + 1 >= n || toks[i + 1].op) {
prog: 				fprintf(stderr, "minish: missing file name\n");
prog: 				return -1;
prog: 			}
prog: 			i++;
prog: 			if (c == '<')
prog: 				cmds[k - 1].in = toks[i].text;
prog: 			else
prog: 				cmds[k - 1].out = toks[i].text;
prog: 			continue;
prog: 		}
prog: 		if (&av[a] == cmds[k - 1].argv) {
prog: 			fprintf(stderr, "minish: empty command\n");
prog: 			return -1;
prog: 		}
prog: 		av[a++] = NULL;
prog: 		cmds[k++] = (cmd){&av[a], NULL, NULL};
prog: 	}
prog: 	if (&av[a] == cmds[k - 1].argv) {
prog: 		fprintf(stderr, "minish: empty command\n");
prog: 		return -1;
prog: 	}
prog: 	av[a] = NULL;
prog: 	return k;
prog: }
