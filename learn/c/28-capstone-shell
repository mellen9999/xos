start: static int do_cd(char **argv)
start: {
start: 	if (argv[1] == NULL || argv[2] != NULL) {
start: 		fprintf(stderr, "shpipe: cd: usage: cd DIR\n");
start: 		return 2;
start: 	}
start: 	if (chdir(argv[1]) != 0) {
start: 		fprintf(stderr, "shpipe: cd: %s: cannot cd\n", argv[1]);
start: 		return 1;
start: 	}
start: 	return 0;
start: }
