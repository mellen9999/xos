start: typedef struct {
start: 	char **argv;
start: } cmd;
start: 
start: static void exec_cmd(char **argv)
start: {
start: 	execvp(argv[0], argv);
start: 	int code = errno == ENOENT ? 127 : 126;
start: 	fprintf(stderr, "shpipe: %s: %s\n", argv[0], code == 127 ? "not found" : "cannot execute");
start: 	_exit(code);
start: }
