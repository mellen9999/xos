prog: 		fprintf(stderr, "shrun: %s: %s\n", argv[0], code == 127 ? "not found" : "cannot execute");
prog: 		_exit(code);
prog: 	}
prog: 	int st;
prog: 	pid_t got;
prog: 	do {
prog: 		got = waitpid(pid, &st, 0);
prog: 	} while (got < 0 && errno == EINTR);
prog: 	if (got < 0) {
prog: 		fprintf(stderr, "shrun: wait failed\n");
prog: 		return 1;
prog: 	}
prog: 	return decode(st);
prog: }
prog: 
prog: /* one line's tokens: run it, return the new status */
prog: static int command(tok *toks, long n, int status, bool *quit)
prog: {
prog: 	char **argv = malloc(((size_t)n + 1) * sizeof *argv);
prog: 	if (argv == NULL) {
prog: 		fprintf(stderr, "shrun: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 	for (long i = 0; i < n; i++) {
prog: 		if (toks[i].op) {
prog: 			fprintf(stderr, "shrun: operators not supported yet\n");
prog: 			free(argv);
prog: 			return 2;
prog: 		}
prog: 		argv[i] = toks[i].text;
prog: 	}
prog: 	argv[n] = NULL;
prog: 	int rc;
prog: 	if (strcmp(argv[0], "cd") == 0)
prog: 		rc = do_cd(argv);
prog: 	else if (strcmp(argv[0], "exit") == 0)
prog: 		rc = do_exit(argv, status, quit);
prog: 	else
prog: 		rc = run(argv);
prog: 	free(argv);
prog: 	return rc;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	bool quit = false;
prog: 	while (!quit && (len = getline(&line, &cap, stdin)) != -1) {
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			line[--len] = '\0';
prog: 		char *buf = malloc(2 * (size_t)len + 1);
prog: 		tok *toks = malloc(((size_t)len + 1) * sizeof *toks);
prog: 		if (buf == NULL || toks == NULL) {
prog: 			fprintf(stderr, "shrun: out of memory\n");
prog: 			free(buf);
prog: 			free(toks);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		long n = tokenize(line, status, buf, toks);
prog: 		if (n < 0) {
prog: 			fprintf(stderr, "shrun: unterminated quote\n");
prog: 			status = 2;
prog: 		} else if (n > 0) {
prog: 			status = command(toks, n, status, &quit);
prog: 		}
prog: 		free(buf);
prog: 		free(toks);
prog: 	}
prog: 	free(line);
prog: 	if (!quit && ferror(stdin)) {
prog: 		fprintf(stderr, "shrun: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	return status;
prog: }
