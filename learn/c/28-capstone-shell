start: 			fprintf(stderr, "shpipe: wait failed\n");
start: 			failed = true;
start: 		} else if (i == k - 1) {
start: 			rc = decode(st);
start: 		}
start: 	}
start: 	free(pids);
start: 	return failed ? 1 : rc;
start: }
