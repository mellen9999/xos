q: collatz.c -- follow the sequence
spec: Start at 27. While the number is not 1: if it is even halve it,
spec: otherwise triple it and add 1. Count the steps taken and track the
spec: largest value reached (27 itself counts). Print exactly:
spec:
spec: `start 27`
spec: `steps 111`
spec: `peak 9232`
spec:
spec: Use `uint64_t` and `PRIu64`.
file: collatz.c
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	uint64_t n = 27;
prog: 	uint64_t peak = n;
prog: 	unsigned steps = 0;
prog: 
prog: 	while (n != 1) {
prog: 		if (n % 2 == 0)
prog: 			n /= 2;
prog: 		else
prog: 			n = 3 * n + 1;
prog: 		if (n > peak)
prog: 			peak = n;
prog: 		steps++;
prog: 	}
prog: 	printf("start 27\n");
prog: 	printf("steps %u\n", steps);
prog: 	printf("peak %" PRIu64 "\n", peak);
prog: 	return 0;
prog: }
case: collatz
case: collatz | sed -n 2p
case: collatz; echo $?
hint: count a step each time you change n, so the final 1 is reached but never counted twice
