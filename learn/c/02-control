q: bucket.c -- switch with breaks
spec: For n from 0 to 5, print one line using a `switch`:
spec:
spec: n is 0: `0 none`
spec: n is 1, 2 or 3: `1 few` (with that n)
spec: anything else: `4 many` (with that n)
spec:
spec: So the six lines run from `0 none` to `5 many`.
file: bucket.c
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	for (int n = 0; n <= 5; n++) {
prog: 		switch (n) {
prog: 		case 0:
prog: 			printf("%d none\n", n);
prog: 			break;
prog: 		case 1:
prog: 		case 2:
prog: 		case 3:
prog: 			printf("%d few\n", n);
prog: 			break;
prog: 		default:
prog: 			printf("%d many\n", n);
prog: 			break;
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: bucket
case: bucket | head -n 2
case: bucket | tail -n 1
hint: each group of cases ends in break, or it runs on into the next one
