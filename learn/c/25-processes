q: trycmd.c -- run a command, no arguments
spec: Take exactly one argument, the name of a command. Print
spec: `trying NAME`, then run that command (found through PATH, given no
spec: arguments of its own) in a child process and wait for it. Then print
spec: one line: `ok` if it exited with status 0, `not found` if it exited
spec: with status 127, `failed` for anything else (including a signal).
spec: Exit 0 in every case that gets that far.
spec:
spec: If the exec fails the child must leave with `_exit(127)`: plain
spec: `exit` would flush a second copy of `trying NAME`.
spec:
spec: No argument or more than one prints `usage: trycmd NAME` to standard
spec: error and exits 2. If `fork` fails print `trycmd: fork failed` to
spec: standard error and exit 1.
file: trycmd.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <stdio.h>
prog: #include <unistd.h>
prog: #include <sys/wait.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: trycmd NAME\n");
prog: 		return 2;
prog: 	}
prog: 	printf("trying %s\n", argv[1]);
prog: 	pid_t pid = fork();
prog: 	if (pid < 0) {
prog: 		fprintf(stderr, "trycmd: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (pid == 0) {
prog: 		char *const cmd[] = {argv[1], NULL};
prog: 		execvp(cmd[0], cmd);
prog: 		_exit(127);
prog: 	}
prog: 	int status;
prog: 	if (waitpid(pid, &status, 0) < 0) {
prog: 		fprintf(stderr, "trycmd: wait failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (WIFEXITED(status) && WEXITSTATUS(status) == 0)
prog: 		printf("ok\n");
prog: 	else if (WIFEXITED(status) && WEXITSTATUS(status) == 127)
prog: 		printf("not found\n");
prog: 	else
prog: 		printf("failed\n");
prog: 	return 0;
prog: }
case: trycmd true
case: trycmd false
case: trycmd nosuchprogram
case: trycmd; echo $?
case: trycmd true; echo $?
hint: execvp takes the name and a NULL-ended array holding the name again; if it returns, the child must _exit(127)
