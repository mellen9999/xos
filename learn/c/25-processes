q: reapall.c -- start N children, reap them in order
spec: Take one argument N, a whole number from 1 to 20. Start N children.
spec: Child number I (counting from 1) exits at once with status I times
spec: 10. The parent starts them all first, then collects them one at a
spec: time in the order it started them -- by pid, with `waitpid` -- and
spec: prints `child I exit S` for each, S being the status that child
spec: really exited with. Last line: `reaped N`. Exit 0.
spec:
spec: Anything else (no argument, more than one, not a number, below 1 or
spec: above 20) prints `usage: reapall N` to standard error and exits 2.
spec: If a `fork` fails, stop starting more, still collect the ones that
spec: started, print `reapall: fork failed` to standard error, and exit 1.
file: reapall.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: #define MAXKIDS 20
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	long n = 0;
prog: 	char *end = NULL;
prog: 	if (argc == 2) {
prog: 		errno = 0;
prog: 		n = strtol(argv[1], &end, 10);
prog: 	}
prog: 	if (argc != 2 || errno != 0 || end == argv[1] || *end != '\0' || n < 1 || n > MAXKIDS) {
prog: 		fprintf(stderr, "usage: reapall N\n");
prog: 		return 2;
prog: 	}
prog: 	pid_t pids[MAXKIDS];
prog: 	long started = 0;
prog: 	int status = 0;
prog: 	for (long i = 1; i <= n; i++) {
prog: 		pid_t pid = fork();
prog: 		if (pid < 0) {
prog: 			fprintf(stderr, "reapall: fork failed\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (pid == 0)
prog: 			_exit((int)(i * 10));
prog: 		pids[started++] = pid;
prog: 	}
prog: 	for (long i = 0; i < started; i++) {
prog: 		int st;
prog: 		if (waitpid(pids[i], &st, 0) < 0 || !WIFEXITED(st)) {
prog: 			fprintf(stderr, "reapall: wait failed\n");
prog: 			status = 1;
prog: 			continue;
prog: 		}
prog: 		printf("child %ld exit %d\n", i + 1, WEXITSTATUS(st));
prog: 	}
prog: 	if (status == 0)
prog: 		printf("reaped %ld\n", started);
prog: 	return status;
prog: }
case: reapall 3
case: reapall 1
case: reapall 20 | wc -l
case: reapall 0; echo $?
case: reapall 21; echo $?
case: reapall x; echo $?
case: reapall; echo $?
hint: keep the pids in an array as you fork; the child does _exit(i * 10); then loop over the array calling waitpid on each pid
