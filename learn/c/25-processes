q: runcmd.c -- run a command and say how it ended
spec: Run the command given as the arguments: `runcmd echo hi there` runs
spec: `echo` with the arguments `hi` and `there`. Start it in a child with
spec: `execvp`, wait for it, then print one line: `exit N` if it exited
spec: with status N, or `signal S` if a signal S ended it. Exit 0 once it
spec: has reported. The command's own output comes first, as it runs.
spec:
spec: If the command cannot be run, the child prints
spec: `runcmd: cannot run NAME` to standard error and exits with status
spec: 127, so the parent reports `exit 127`.
spec:
spec: No arguments prints `usage: runcmd CMD [ARG...]` to standard error
spec: and exits 2. If `fork` fails print `runcmd: fork failed` and exit 1.
file: runcmd.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <sys/wait.h>
prog: #include <unistd.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc < 2) {
prog: 		fprintf(stderr, "usage: runcmd CMD [ARG...]\n");
prog: 		return 2;
prog: 	}
prog: 	pid_t pid = fork();
prog: 	if (pid < 0) {
prog: 		fprintf(stderr, "runcmd: fork failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (pid == 0) {
prog: 		execvp(argv[1], argv + 1);
prog: 		fprintf(stderr, "runcmd: cannot run %s\n", argv[1]);
prog: 		_exit(127);
prog: 	}
prog: 	int status;
prog: 	pid_t got;
prog: 	do {
prog: 		got = waitpid(pid, &status, 0);
prog: 	} while (got < 0 && errno == EINTR);
prog: 	if (got < 0) {
prog: 		fprintf(stderr, "runcmd: wait failed\n");
prog: 		return 1;
prog: 	}
prog: 	if (WIFEXITED(status))
prog: 		printf("exit %d\n", WEXITSTATUS(status));
prog: 	else if (WIFSIGNALED(status))
prog: 		printf("signal %d\n", WTERMSIG(status));
prog: 	return 0;
prog: }
case: runcmd echo hi there
case: runcmd sh -c 'exit 5'
case: runcmd sh -c 'kill -9 $$'
case: runcmd nosuchprogram
case: runcmd; echo $?
case: runcmd false; echo $?
hint: execvp(argv[1], argv + 1); then WIFEXITED/WEXITSTATUS or WIFSIGNALED/WTERMSIG on the status waitpid gave you
