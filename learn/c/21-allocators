q: poolfree.c -- a four-slot pool with a free list
spec: Keep a pool of 4 slots, numbered 0 to 3, and a free list threaded
spec: through the free slots (initially 0, 1, 2, 3 in that order). Read
spec: commands from standard input, one per line:
spec:
spec:   `alloc`    take the slot at the head of the free list and print
spec:              `slot N`; print `full` if none is free
spec:   `free N`   put slot N back at the head of the free list and print
spec:              `freed`; N is a whole number 0 to 1000000; `bad free` if it is
spec:              not 0 to 3 or not allocated (that catches a double free)
spec:
spec: Anything else, including a missing or non-numeric N, prints `?`.
spec: A freed slot is the next one handed out. Exit 0.
file: poolfree.c
need: - a union shares one spot between its members:
need:       union slot { int next; long value; };
need: - free list: head index, each free slot holds the next free index;
need:   -1 = end of list
need: - alloc: take the head, move head to its next
need: - free: put the slot back at the head
need: - check before you push: out of range or not in use = bad free
need:   (that catches a double free)
need: - strtol(s, &end, 10): bad if end == s or *end != '\0';
need:   set errno = 0 first, then errno == ERANGE means too big
need: - strcmp(a, b) == 0 means equal; strtok splits a line into words
start: #include <errno.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: #define SLOTS 4
start: 
start: union slot {
start: 	int next;
start: 	long value;
start: };
start: 
start: static union slot pool[SLOTS];
start: static bool in_use[SLOTS];
start: static int free_head = 0;
start: 
start: int main(void)
start: {
start: 	char line[64];
start: 	/* link the slots 0 -> 1 -> 2 -> 3 -> end */
start: 	(void)pool;
start: 	(void)in_use;
start: 	(void)free_head;
start: 	while (fgets(line, sizeof line, stdin) != NULL) {
start: 		/* alloc, free N, or ? */
start: 	}
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define SLOTS 4
prog: 
prog: /* a slot is either in use (holds a value) or free (holds the index of the
prog:    next free slot) -- the free list lives inside the free slots themselves */
prog: union slot {
prog: 	int next;
prog: 	long value;
prog: };
prog: 
prog: static union slot pool[SLOTS];
prog: static bool in_use[SLOTS];
prog: static int free_head = 0;
prog: 
prog: static void pool_init(void)
prog: {
prog: 	for (int i = 0; i < SLOTS; i++)
prog: 		pool[i].next = i + 1 < SLOTS ? i + 1 : -1;
prog: 	free_head = 0;
prog: }
prog: 
prog: static int pool_alloc(void)
prog: {
prog: 	int i = free_head;
prog: 	if (i < 0)
prog: 		return -1;
prog: 	free_head = pool[i].next;
prog: 	in_use[i] = true;
prog: 	pool[i].value = 0;
prog: 	return i;
prog: }
prog: 
prog: static bool pool_free(int i)
prog: {
prog: 	if (i < 0 || i >= SLOTS || !in_use[i])
prog: 		return false;
prog: 	in_use[i] = false;
prog: 	pool[i].next = free_head;
prog: 	free_head = i;
prog: 	return true;
prog: }
prog: 
prog: /* a whole decimal number inside lo..hi; sscanf cannot say "too big" safely */
prog: static bool num(const char *s, long lo, long hi, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (end == s || *end != '\0' || errno == ERANGE || v < lo || v > hi)
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: /* split a line into at most four words, in place; returns how many */
prog: static int words(char *line, char **w)
prog: {
prog: 	int n = 0;
prog: 	for (char *t = strtok(line, " \n"); t != NULL && n < 4; t = strtok(NULL, " \n"))
prog: 		w[n++] = t;
prog: 	return n;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char line[64];
prog: 	pool_init();
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		char *w[4];
prog: 		long i;
prog: 		int n = words(line, w);
prog: 		if (n == 1 && strcmp(w[0], "alloc") == 0) {
prog: 			int slot = pool_alloc();
prog: 			if (slot < 0)
prog: 				puts("full");
prog: 			else
prog: 				printf("slot %d\n", slot);
prog: 		} else if (n == 2 && strcmp(w[0], "free") == 0 && num(w[1], 0, 1000000, &i)) {
prog: 			puts(pool_free((int)i) ? "freed" : "bad free");
prog: 		} else {
prog: 			puts("?");
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: printf 'alloc\nalloc\nalloc\nalloc\nalloc\n' | poolfree
case: printf 'alloc\nalloc\nalloc\nfree 0\nfree 2\nalloc\nalloc\nalloc\n' | poolfree
case: printf 'alloc\nfree 0\nfree 0\nfree 9\nfree 1\nfree x\nbogus\nalloc\n' | poolfree
hint: new head = the freed slot; its link points at the old head -- last freed is first reused, not the lowest number
