q: arenarec.c -- parse records into an arena, free once
spec: Read lines of the form `NAME SCORE` from standard input: NAME up to 31
spec: characters with no spaces, SCORE a whole decimal number (-1000000000
spec: to 1000000000). Store each record, and its own copy of the name, in a
spec: single 65536-byte arena you get from one `malloc`, linked into a list
spec: with the newest first. Do not malloc each record.
spec:
spec: After the last line print the records from newest to oldest as
spec: `NAME: SCORE`, then `best: NAME (of N)` for the highest score (the
spec: first one read wins a tie), N being the record count. No lines at all
spec: prints just `no records`. Release the arena with one `free`. Exit 0.
spec:
spec: A line that does not have exactly a name and a valid score prints
spec: `arenarec: line L: bad record` to standard error, nothing to
spec: standard output, and exits 1 (L from 1). If the arena runs out, print
spec: `arenarec: arena full` instead and exit 1, likewise with no output.
file: arenarec.c
need: - one malloc(65536) is the arena; one free releases everything
need: - alloc: start = (used + align - 1) & ~(align - 1); NULL if
need:   size > cap - start; else used = start + size
need: - align a struct with _Alignof(struct rec); chars need align 1
need: - copy the name into the arena: strlen(name) + 1 bytes, strcpy
need: - newest first: new->next = head; head = new
need: - sscanf(line, "%31s %31s %1s", a, b, extra) returns how many
need:   fields it filled; a 3rd field means a bad line
need: - strtol(s, &end, 10): bad if end == s or *end != '\0';
need:   set errno = 0 first, then errno == ERANGE means too big
need: - on error: stderr only, nothing on stdout, exit 1, still free
start: #include <errno.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: #define ARENA_SIZE 65536
start: 
start: struct arena {
start: 	unsigned char *mem;
start: 	size_t used;
start: };
start: 
start: struct rec {
start: 	char *name;
start: 	long score;
start: 	struct rec *next;
start: };
start: 
start: int main(void)
start: {
start: 	struct arena a = { malloc(ARENA_SIZE), 0 };
start: 	if (a.mem == NULL) {
start: 		fprintf(stderr, "arenarec: out of memory\n");
start: 		return 1;
start: 	}
start: 	struct rec *head = NULL;
start: 	char line[128];
start: 	while (fgets(line, sizeof line, stdin) != NULL) {
start: 		/* parse, allocate record + name from the arena, link it */
start: 	}
start: 	(void)head;
start: 	free(a.mem);
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define ARENA_SIZE 65536
prog: 
prog: struct arena {
prog: 	unsigned char *mem;
prog: 	size_t used;
prog: };
prog: 
prog: static void *arena_alloc(struct arena *a, size_t size, size_t align)
prog: {
prog: 	size_t start = (a->used + align - 1) & ~(align - 1);
prog: 	if (start > ARENA_SIZE || size > ARENA_SIZE - start)
prog: 		return NULL;
prog: 	a->used = start + size;
prog: 	return a->mem + start;
prog: }
prog: 
prog: struct rec {
prog: 	char *name;
prog: 	long score;
prog: 	struct rec *next;
prog: };
prog: 
prog: /* a whole decimal number inside lo..hi; sscanf cannot say "too big" safely */
prog: static bool num(const char *s, long lo, long hi, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (end == s || *end != '\0' || errno == ERANGE || v < lo || v > hi)
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: 
prog: int main(void)
prog: {
prog: 	struct arena a = { malloc(ARENA_SIZE), 0 };
prog: 	if (a.mem == NULL) {
prog: 		fprintf(stderr, "arenarec: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 	struct rec *head = NULL, *best = NULL;
prog: 	long count = 0, lineno = 0;
prog: 	int status = 0;
prog: 	char line[128];
prog: 
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		lineno++;
prog: 		char name[32], num_s[32], extra[2];
prog: 		long score;
prog: 		if (sscanf(line, "%31s %31s %1s", name, num_s, extra) != 2
prog: 		    || !num(num_s, -1000000000L, 1000000000L, &score)) {
prog: 			fprintf(stderr, "arenarec: line %ld: bad record\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		struct rec *r = arena_alloc(&a, sizeof *r, _Alignof(struct rec));
prog: 		char *copy = arena_alloc(&a, strlen(name) + 1, 1);
prog: 		if (r == NULL || copy == NULL) {
prog: 			fprintf(stderr, "arenarec: arena full\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		strcpy(copy, name);
prog: 		*r = (struct rec){ copy, score, head };
prog: 		head = r; /* newest first */
prog: 		count++;
prog: 		if (best == NULL || r->score > best->score) /* ties keep the first */
prog: 			best = r;
prog: 	}
prog: 	if (status == 0) {
prog: 		for (const struct rec *r = head; r != NULL; r = r->next)
prog: 			printf("%s: %ld\n", r->name, r->score);
prog: 		if (best == NULL)
prog: 			puts("no records");
prog: 		else
prog: 			printf("best: %s (of %ld)\n", best->name, count);
prog: 	}
prog: 	free(a.mem); /* one free releases every record and every name */
prog: 	return status;
prog: }
