name: allocators
intro: `malloc` is a general tool: any size, any lifetime, free in any order.
intro: That generality costs. Each call finds a block, writes bookkeeping
intro: beside it, and may fragment the heap; each `free` has to undo that. A
intro: program that makes a hundred thousand tiny allocations spends more
intro: time in malloc than in its own work, and has a hundred thousand
intro: frees to forget one of.
intro:
intro: Most programs do not need that freedom. A whole parse, a whole
intro: request, a whole frame of a game: everything allocated lives until
intro: the same moment and dies together. That is a lifetime, and when many
intro: things share one, give them one owner.
intro:
intro: An arena (a bump allocator) is the plainest owner. Grab one big block.
intro: Keep a counter of how much is used. To allocate, hand out the next
intro: bytes and move the counter:
intro:
intro:     struct arena { unsigned char *mem; size_t used; };
intro:
intro:     start = (a->used + align - 1) & ~(align - 1);
intro:     if (start > cap || size > cap - start) return NULL;
intro:     a->used = start + size;
intro:     return a->mem + start;
intro:
intro: Alignment matters: a `long` must sit at an address that is a multiple
intro: of its alignment (`_Alignof(long)`), or the access is undefined and on
intro: some hardware crashes. Round `used` up to a power-of-two multiple with
intro: the mask above before handing out. To test that `a` is a power of
intro: two (and not 0): `a != 0 && (a & (a - 1)) == 0`. A power of two has
intro: one bit set; minus 1 turns it into all ones below that bit, so the
intro: two share no bit: 100000 & 011111 is 0, while 101000 & 100111 is not.
intro: Write the fit test as `size > cap - start`, never
intro: `start + size > cap` -- the sum can wrap.
intro:
intro: There is no per-object free. You release the whole arena with one
intro: `free`. That is the point: no leaks to track, no use-after-free of one
intro: node while another lives. The price: nothing is reclaimed early.
intro:
intro: A pool is the other small tool: many blocks of one size. Keep the free
intro: ones in a list -- inside the free blocks themselves, a `union` of the
intro: payload and a "next free" link (a union shares one spot between its
intro: members; see unit 11) -- so alloc and free are one step each.
intro: Freeing a block twice corrupts that list, so check before you push.
intro:
intro: Always ask who owns each thing, and when it ends.
intro:
intro: Memory you hand out must suit any type that is put in it. A static array
intro: of bytes promises only byte alignment; `_Alignas(16)` on its declaration
intro: puts it on a 16-byte boundary, enough for every basic type here:
intro:
intro:     _Alignas(16) static unsigned char mem[4096];
intro:
intro: Put it at file scope (outside every function) or inside a function.
intro: Inside a function `static` means the array is made once, keeps its
intro: contents between calls and lives as long as the program; without
intro: `static` it would be a normal local, gone when the function returns.
---
q: bumpoff.c -- hand out aligned bytes from a fixed arena
spec: Keep an arena of 256 bytes, starting empty and 16-byte aligned. Read
spec: lines of the form `SIZE ALIGN` from standard input. SIZE is a whole
spec: decimal number 0 to 1000000, ALIGN a power of two from 1 to 16.
spec:
spec: For each line, round the used count up to a multiple of ALIGN, give
spec: out SIZE bytes there, and print the offset where the block starts.
spec: If it does not fit in the 256 bytes print `full` and leave the arena
spec: as it was. A line that is not exactly two valid numbers, or has an
spec: ALIGN that is not allowed, prints `bad` and changes nothing.
spec: Exit 0.
file: bumpoff.c
need: - arena: one block + a used counter; alloc moves the counter
need: - round up to align: (used + align - 1) & ~(align - 1)
need: - fit test: size > cap - start, never start + size > cap
need: - align is ok only if a != 0 && (a & (a - 1)) == 0
need: - _Alignas(16) static unsigned char mem[N];  (file or function)
need: - strtol(s, &end, 10): bad if end == s or *end != '\0';
need:   set errno = 0 first, then errno == ERANGE means too big
need: - fgets(line, sizeof line, stdin) returns NULL at end of input
need: - strtok(line, " \n") then strtok(NULL, " \n") splits into words
start: #include <errno.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: #define CAP 256
start: 
start: struct arena {
start: 	unsigned char *base;
start: 	size_t used;
start: };
start: 
start: int main(void)
start: {
start: 	_Alignas(16) static unsigned char mem[CAP];
start: 	struct arena a = { mem, 0 };
start: 	char line[64];
start: 
start: 	while (fgets(line, sizeof line, stdin) != NULL) {
start: 		/* split into words, check both numbers, then allocate */
start: 	}
start: 	(void)a;
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define CAP 256
prog: 
prog: struct arena {
prog: 	unsigned char *base;
prog: 	size_t used;
prog: };
prog: 
prog: /* returns the offset of the new block, or CAP + 1 when it does not fit */
prog: static size_t arena_alloc(struct arena *a, size_t size, size_t align)
prog: {
prog: 	size_t start = (a->used + align - 1) & ~(align - 1);
prog: 	if (start > CAP || size > CAP - start)
prog: 		return CAP + 1;
prog: 	a->used = start + size;
prog: 	return start;
prog: }
prog: 
prog: /* a whole decimal number inside lo..hi; sscanf cannot say "too big" safely */
prog: static bool num(const char *s, long lo, long hi, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (end == s || *end != '\0' || errno == ERANGE || v < lo || v > hi)
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: /* split a line into at most four words, in place; returns how many */
prog: static int words(char *line, char **w)
prog: {
prog: 	int n = 0;
prog: 	for (char *t = strtok(line, " \n"); t != NULL && n < 4; t = strtok(NULL, " \n"))
prog: 		w[n++] = t;
prog: 	return n;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	_Alignas(16) static unsigned char mem[CAP];
prog: 	struct arena a = { mem, 0 };
prog: 	char line[64];
prog: 
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		char *w[4];
prog: 		long size, align;
prog: 		if (words(line, w) != 2 || !num(w[0], 0, 1000000, &size)
prog: 		    || !num(w[1], 1, 16, &align) || (align & (align - 1)) != 0) {
prog: 			puts("bad");
prog: 			continue;
prog: 		}
prog: 		size_t off = arena_alloc(&a, (size_t)size, (size_t)align);
prog: 		if (off > CAP)
prog: 			puts("full");
prog: 		else
prog: 			printf("%zu\n", off);
prog: 	}
prog: 	return 0;
prog: }
case: printf '10 1\n4 4\n1 1\n8 8\n' | bumpoff
case: printf '250 1\n6 1\n1 1\n' | bumpoff
case: printf '250 1\n100 1\n4 1\n' | bumpoff
case: printf '3 3\n5 1\n1 16\n99999999999999999999 1\n7\n' | bumpoff
case: printf '' | bumpoff
hint: start = round used up to ALIGN; refuse if start is past 256 or SIZE is more than 256 - start, and only then move used
