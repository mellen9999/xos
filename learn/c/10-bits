q: rotl32.c -- rotate bits left
spec: Usage `rotl32 N K`: N is an unsigned decimal number from 0 to
spec: 4294967295 (digits only), K a whole number from 0 to 31. Rotate the
spec: 32 bits of N left by K places -- bits shifted off the top come back
spec: in at the bottom -- and print the result as eight lowercase hex
spec: digits and a newline. `rotl32 1 1` prints `00000002`.
spec:
spec: A bad N prints `rotl32: bad number` and a bad K prints
spec: `rotl32: bad count`, both to standard error, exit 1. Any other
spec: number of arguments prints `usage: rotl32 N K` and exits 2.
spec:
spec: K of 0 must work. Shifting a 32-bit value by 32 is undefined.
file: rotl32.c
prog: #include <errno.h>
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static int parse(const char *s, unsigned long max, unsigned long *out)
prog: {
prog: 	if (s[0] < '0' || s[0] > '9')
prog: 		return -1;
prog: 	char *end;
prog: 	errno = 0;
prog: 	unsigned long v = strtoul(s, &end, 10);
prog: 	if (*end != '\0' || errno != 0 || v > max)
prog: 		return -1;
prog: 	*out = v;
prog: 	return 0;
prog: }
prog: 
prog: static uint32_t rotl32(uint32_t x, unsigned k)
prog: {
prog: 	return (x << k) | (x >> ((32u - k) & 31u));
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	unsigned long n, k;
prog: 	if (argc != 3) {
prog: 		fprintf(stderr, "usage: rotl32 N K\n");
prog: 		return 2;
prog: 	}
prog: 	if (parse(argv[1], UINT32_MAX, &n) != 0) {
prog: 		fprintf(stderr, "rotl32: bad number\n");
prog: 		return 1;
prog: 	}
prog: 	if (parse(argv[2], 31, &k) != 0) {
prog: 		fprintf(stderr, "rotl32: bad count\n");
prog: 		return 1;
prog: 	}
prog: 	printf("%08" PRIx32 "\n", rotl32((uint32_t)n, (unsigned)k));
prog: 	return 0;
prog: }
case: rotl32 1 1
case: rotl32 2147483649 1
case: rotl32 305419896 0
case: rotl32 305419896 8
case: rotl32 1 32; echo $?
case: rotl32 -1 3; echo $?
case: rotl32 5; echo $?
hint: the bits leaving the top are x >> (32 - k); the ones to put back are what you shifted off -- and k = 0 must not shift by 32
