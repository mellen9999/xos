q: perms.c -- permission bits, both directions
spec: Take exactly one argument and convert it, Unix file-mode style.
spec:
spec: A 9-character flag string such as `rwxr-x---` -- three groups of
spec: `rwx`, each position holding its letter or `-` -- prints the mode as
spec: three octal digits: `750`. A 3-digit octal mode such as `644` prints
spec: the flag string: `rw-r--r--`. Read is 4, write is 2, execute is 1,
spec: summed in each group.
spec:
spec: Anything else (wrong length, a letter in the wrong place, a digit
spec: above 7) prints `perms: bad flags` to standard error and exits 1. Any
spec: other number of arguments prints `usage: perms FLAGS` and exits 2.
file: perms.c
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: enum { P_R = 4, P_W = 2, P_X = 1 };
prog: 
prog: static const char SYM[3] = { 'r', 'w', 'x' };
prog: static const unsigned BIT[3] = { P_R, P_W, P_X };
prog: 
prog: static int from_flags(const char *s, unsigned *mode)
prog: {
prog: 	unsigned m = 0;
prog: 	for (int i = 0; i < 9; i++) {
prog: 		int k = i % 3;
prog: 		if (s[i] == SYM[k])
prog: 			m |= BIT[k] << (6 - 3 * (i / 3));
prog: 		else if (s[i] != '-')
prog: 			return -1;
prog: 	}
prog: 	*mode = m;
prog: 	return 0;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: perms FLAGS\n");
prog: 		return 2;
prog: 	}
prog: 	const char *s = argv[1];
prog: 	size_t len = strlen(s);
prog: 	unsigned mode = 0;
prog: 	if (len == 9 && from_flags(s, &mode) == 0) {
prog: 		printf("%03o\n", mode);
prog: 		return 0;
prog: 	}
prog: 	if (len == 3 && s[0] >= '0' && s[0] <= '7' && s[1] >= '0' && s[1] <= '7'
prog: 		&& s[2] >= '0' && s[2] <= '7') {
prog: 		mode = (unsigned)(s[0] - '0') << 6 | (unsigned)(s[1] - '0') << 3
prog: 			   | (unsigned)(s[2] - '0');
prog: 		char out[10];
prog: 		for (int i = 0; i < 9; i++) {
prog: 			int k = i % 3;
prog: 			unsigned shift = (unsigned)(6 - 3 * (i / 3));
prog: 			out[i] = (mode >> shift) & BIT[k] ? SYM[k] : '-';
prog: 		}
prog: 		out[9] = '\0';
prog: 		puts(out);
prog: 		return 0;
prog: 	}
prog: 	fprintf(stderr, "perms: bad flags\n");
prog: 	return 1;
prog: }
case: perms rwxr-x---
case: perms rw-r--r--
case: perms 750; perms 000; perms 777
case: perms ---------
case: perms rwxr-xr-q; echo $?
case: perms 789; perms rwxrwxrw; perms rwx; echo $?
case: perms; echo $?
hint: each group is one octal digit -- test the three bits with & 4, & 2, & 1, and shift the group into place
