q: bin8.c -- a byte in binary
spec: Take exactly one argument, a decimal number from 0 to 255 (digits
spec: only). Print it as eight binary digits, a space, then the same
spec: value as two lowercase hex digits, and a newline.
spec: `bin8 5` prints `00000101 05`.
spec:
spec: Any other argument prints `bin8: bad byte: ARG` to standard error and
spec: exits 1. Any other number of arguments prints `usage: bin8 N` and
spec: exits 2.
file: bin8.c
prog: #include <errno.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: bin8 N\n");
prog: 		return 2;
prog: 	}
prog: 	char *end;
prog: 	errno = 0;
prog: 	unsigned long v = strtoul(argv[1], &end, 10);
prog: 	if (argv[1][0] < '0' || argv[1][0] > '9' || *end != '\0'
prog: 		|| errno != 0 || v > 255) {
prog: 		fprintf(stderr, "bin8: bad byte: %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	uint8_t b = (uint8_t)v;
prog: 	for (int i = 7; i >= 0; i--)
prog: 		putchar(((b >> i) & 1u) ? '1' : '0');
prog: 	printf(" %02x\n", b);
prog: 	return 0;
prog: }
case: bin8 5
case: bin8 0
case: bin8 255
case: bin8 170
case: bin8 256; echo $?
case: bin8 -3; echo $?
case: bin8; echo $?
hint: test bit 7 first and walk down to bit 0 with (b >> i) & 1; %02x pads the hex
