q: rect.c -- area and perimeter
spec: Takes two arguments, width and height, each a whole number from 0
spec: to 1000. Prints `area A perimeter P` and a newline: `rect 3 4`
spec: prints `area 12 perimeter 14`.
spec:
spec: Keep them in a struct built with a designated initializer, and give
spec: area and perimeter functions that take `const struct rect *`.
spec:
spec: A bad or out-of-range number prints `rect: bad size` to standard
spec: error and exits 1. Any other argument count prints nothing and
spec: exits 2.
file: rect.c
need: - struct rect { long w; long h; };
need:   struct rect r = { .w = 3, .h = 4 };
need: - r.w on a value; p->w through a pointer
need: - static long area(const struct rect *r) -- const = read only;
need:   call it with area(&r)
need: - strtol(s, &end, 10): bad if end == s, *end != '\0', errno;
need:   here the range is 0 to 1000
need: - long prints with %ld
start: #include <errno.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: 
start: struct rect {
start: 	long w;
start: 	long h;
start: };
start: 
start: int main(int argc, char *argv[])
start: {
start: 	if (argc != 3)
start: 		return 2;
start: 	(void)argv;
start: 
start: 	struct rect r = { .w = 0, .h = 0 };
start: 
start: 	/* parse argv[1] and argv[2] (0..1000) into r */
start: 	printf("area %ld perimeter %ld\n", r.w, r.h);
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: struct rect {
prog: 	long w;
prog: 	long h;
prog: };
prog: 
prog: static bool parse_size(const char *s, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (errno != 0 || end == s || *end != '\0' || v < 0 || v > 1000)
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: static long area(const struct rect *r)
prog: {
prog: 	return r->w * r->h;
prog: }
prog: 
prog: static long perimeter(const struct rect *r)
prog: {
prog: 	return 2 * (r->w + r->h);
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 3)
prog: 		return 2;
prog: 
prog: 	long w, h;
prog: 	if (!parse_size(argv[1], &w) || !parse_size(argv[2], &h)) {
prog: 		fprintf(stderr, "rect: bad size\n");
prog: 		return 1;
prog: 	}
prog: 	struct rect r = { .w = w, .h = h };
prog: 	printf("area %ld perimeter %ld\n", area(&r), perimeter(&r));
prog: 	return 0;
prog: }
case: rect 3 4
case: rect 0 5
case: rect 1000 1000
case: rect -1 2 2>&1; echo $?
case: rect 1001 2 2>&1; echo $?
case: rect 3; echo $?
hint: a struct rect holds w and h, the helpers take a pointer and read r->w and r->h
