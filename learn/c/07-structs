q: scores.c -- score table from stdin
spec: Read lines of the form `NAME SCORE` -- a name (1 to 15 characters,
spec: no spaces), one space, a whole number -- at most 8 lines, each at
spec: most 60 characters. Print three lines:
spec: `players N`, `total T` (sum of scores), `best NAME SCORE` (highest
spec: score; on a tie the earlier line wins).
spec:
spec: Store the records in an array of structs. On a malformed line print
spec: `scores: line L: bad record` to standard error (L counts from 1) and
spec: exit 1. A ninth record prints `scores: too many records` and exits
spec: 1. Empty input prints `scores: no records` and exits 1. Nothing is
spec: printed to standard output when it exits 1.
file: scores.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define MAXREC 8
prog: #define NAMELEN 16
prog: 
prog: struct player {
prog: 	char name[NAMELEN];
prog: 	long score;
prog: };
prog: 
prog: static bool parse_line(const char *line, struct player *out)
prog: {
prog: 	const char *sp = strchr(line, ' ');
prog: 	if (sp == NULL || sp == line || (size_t)(sp - line) >= NAMELEN)
prog: 		return false;
prog: 
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(sp + 1, &end, 10);
prog: 	if (errno != 0 || end == sp + 1 || (*end != '\n' && *end != '\0'))
prog: 		return false;
prog: 
prog: 	*out = (struct player){ .score = v };
prog: 	memcpy(out->name, line, (size_t)(sp - line));
prog: 	return true;
prog: }
prog: 
prog: static void summarise(const struct player *rec, size_t n)
prog: {
prog: 	long total = 0;
prog: 	const struct player *best = &rec[0];
prog: 	for (size_t i = 0; i < n; i++) {
prog: 		total += rec[i].score;
prog: 		if (rec[i].score > best->score)
prog: 			best = &rec[i];
prog: 	}
prog: 	printf("players %zu\n", n);
prog: 	printf("total %ld\n", total);
prog: 	printf("best %s %ld\n", best->name, best->score);
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct player rec[MAXREC];
prog: 	size_t n = 0;
prog: 	char line[64];
prog: 
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		if (n == MAXREC) {
prog: 			fprintf(stderr, "scores: too many records\n");
prog: 			return 1;
prog: 		}
prog: 		if (!parse_line(line, &rec[n])) {
prog: 			fprintf(stderr, "scores: line %d: bad record\n", lineno);
prog: 			return 1;
prog: 		}
prog: 		n++;
prog: 	}
prog: 	if (n == 0) {
prog: 		fprintf(stderr, "scores: no records\n");
prog: 		return 1;
prog: 	}
prog: 	summarise(rec, n);
prog: 	return 0;
prog: }
case: printf 'ann 10\nbob 30\ncy 20\n' | scores
case: printf 'ann 30\nbob 30\n' | scores
case: printf 'solo -4\n' | scores
case: printf 'ann 10\nbob\n' | scores 2>&1; echo $?
case: printf 'a 1\nb 2\nc 3\nd 4\ne 5\nf 6\ng 7\nh 8\ni 9\n' | scores 2>&1; echo $?
case: scores < /dev/null 2>&1; echo $?
hint: split each line at the space with strchr, parse the number after it, and keep the best record by pointer
