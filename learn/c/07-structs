q: arith.c -- a tiny calculator
spec: Takes an operator word and two whole numbers: `arith add 2 3`
spec: prints `5`. The words are `add`, `sub` and `mul`.
spec:
spec: Look the word up in a table (an array of structs pairing each name
spec: with an enum value), then do the arithmetic in a switch over the
spec: enum with no default case. Numbers are `long`; assume the answer
spec: fits.
spec:
spec: An unknown operator prints `arith: unknown op` to standard error and
spec: exits 1. A bad number prints `arith: bad number` and exits 1. Any
spec: other argument count prints nothing and exits 2.
file: arith.c
need: - enum op { OP_ADD, OP_SUB, OP_MUL };
need:   struct entry { const char *name; enum op op; };
need: - a table: static const struct entry table[] = {
need:   { .name = "add", .op = OP_ADD }, ... };  count it with
need:   sizeof table / sizeof table[0]
need: - strcmp(a, b) == 0 means equal (<string.h>)
need: - switch (op) { case OP_ADD: return a + b; ... } with no
need:   default, then a return after it
start: #include <errno.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: enum op { OP_ADD, OP_SUB, OP_MUL };
start: 
start: struct entry {
start: 	const char *name;
start: 	enum op op;
start: };
start: 
start: int main(int argc, char *argv[])
start: {
start: 	if (argc != 4)
start: 		return 2;
start: 	(void)argv;
start: 	/* table of names, look up argv[1], parse the numbers, switch */
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: enum op { OP_ADD, OP_SUB, OP_MUL };
prog: 
prog: struct entry {
prog: 	const char *name;
prog: 	enum op op;
prog: };
prog: 
prog: static const struct entry table[] = {
prog: 	{ .name = "add", .op = OP_ADD },
prog: 	{ .name = "sub", .op = OP_SUB },
prog: 	{ .name = "mul", .op = OP_MUL },
prog: };
prog: 
prog: static bool lookup(const char *name, enum op *out)
prog: {
prog: 	for (size_t i = 0; i < sizeof table / sizeof table[0]; i++) {
prog: 		if (strcmp(table[i].name, name) == 0) {
prog: 			*out = table[i].op;
prog: 			return true;
prog: 		}
prog: 	}
prog: 	return false;
prog: }
prog: 
prog: static bool parse_long(const char *s, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (errno != 0 || end == s || *end != '\0')
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: static long apply(enum op op, long a, long b)
prog: {
prog: 	switch (op) {
prog: 	case OP_ADD: return a + b;
prog: 	case OP_SUB: return a - b;
prog: 	case OP_MUL: return a * b;
prog: 	}
prog: 	return 0;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 4)
prog: 		return 2;
prog: 
prog: 	enum op op;
prog: 	if (!lookup(argv[1], &op)) {
prog: 		fprintf(stderr, "arith: unknown op\n");
prog: 		return 1;
prog: 	}
prog: 	long a, b;
prog: 	if (!parse_long(argv[2], &a) || !parse_long(argv[3], &b)) {
prog: 		fprintf(stderr, "arith: bad number\n");
prog: 		return 1;
prog: 	}
prog: 	printf("%ld\n", apply(op, a, b));
prog: 	return 0;
prog: }
case: arith add 2 3
case: arith sub 2 5
case: arith mul 6 7
case: arith pow 2 3 2>&1; echo $?
case: arith add 2 x 2>&1; echo $?
case: arith add 2; echo $?
hint: table lookup with strcmp gives you the enum; the switch turns it into the arithmetic
