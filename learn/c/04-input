q: figures.c -- numbers from stdin, one per line
spec: Read integers from standard input, one per line (lines are under 60
spec: characters). Print, with a newline after each:
spec:
spec: `count N`
spec: `sum S`
spec: `min LOW`
spec: `max HIGH`
spec:
spec: A line that is not a whole number -- empty, `abc`, `5x` -- prints
spec: `figures: line N: bad number` (N counts from 1) to stderr and exits 1,
spec: printing nothing to stdout. The last line may have no trailing newline.
spec: No numbers at all: print `figures: no input` to stderr, exit 2. If the
spec: sum would overflow a `long`, print `figures: sum overflows` to stderr and
spec: exit 1.
file: figures.c
prog: #include <errno.h>
prog: #include <limits.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: int main(void)
prog: {
prog: 	char buf[64];
prog: 	long count = 0;
prog: 	long sum = 0;
prog: 	long min = 0;
prog: 	long max = 0;
prog: 	int line = 0;
prog: 
prog: 	while (fgets(buf, sizeof buf, stdin)) {
prog: 		char *end;
prog: 		long n;
prog: 
prog: 		line++;
prog: 		errno = 0;
prog: 		n = strtol(buf, &end, 10);
prog: 		if (end == buf || (*end != '\n' && *end != '\0') || errno == ERANGE) {
prog: 			fprintf(stderr, "figures: line %d: bad number\n", line);
prog: 			return 1;
prog: 		}
prog: 		if ((n > 0 && sum > LONG_MAX - n) || (n < 0 && sum < LONG_MIN - n)) {
prog: 			fprintf(stderr, "figures: sum overflows\n");
prog: 			return 1;
prog: 		}
prog: 		sum += n;
prog: 		if (count == 0 || n < min)
prog: 			min = n;
prog: 		if (count == 0 || n > max)
prog: 			max = n;
prog: 		count++;
prog: 	}
prog: 	if (count == 0) {
prog: 		fprintf(stderr, "figures: no input\n");
prog: 		return 2;
prog: 	}
prog: 	printf("count %ld\n", count);
prog: 	printf("sum %ld\n", sum);
prog: 	printf("min %ld\n", min);
prog: 	printf("max %ld\n", max);
prog: 	return 0;
prog: }
case: printf '3\n-4\n10\n' | figures
case: printf '3\n\n4\n' | figures 2>&1; echo $?
case: figures </dev/null 2>&1; echo $?
case: printf '7\nabc\n' | figures 2>&1; echo $?
case: printf '5' | figures
case: printf '-8\n' | figures
hint: strtol stops at the newline, so *end is either newline or the zero at the end of a last line without one
