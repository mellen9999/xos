q: cfgget.c -- read one setting from a config file
spec: Takes one argument, a KEY, and reads a config file from standard
spec: input. Prints the value of KEY, with a newline, exit 0. If KEY is set
spec: more than once the LAST one wins. If it is never set print
spec: `cfgget: KEY not set` to standard error and exit 1. No argument, or
spec: more than one, prints `usage: cfgget KEY` and exits 2.
spec:
spec: Every line is one of: blank (only blanks), a comment (first
spec: non-blank character is `#`), or `key = value`. Blanks are spaces,
spec: tabs and carriage returns. The key is the text before the FIRST `=`
spec: and the value is everything after it; both lose their leading and
spec: trailing blanks. Keys are letters, digits, `_`, `.` and `-`. A value
spec: may be empty and may hold `=`, `#` and blanks inside. Lines are at
spec: most 200 characters.
spec:
spec: The WHOLE input is checked, even after KEY is found. A bad line
spec: prints `cfgget: line L col C: MESSAGE` to standard error and exits
spec: 1, with C counted from 1 in the line as written: `expected key=value`
spec: (no `=`; C is the first non-blank), `empty key` (C is the `=`), or
spec: `bad character in key` (C is that character, a space inside the key
spec: included).
file: cfgget.c
prog: #include <ctype.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: static int fail(int lineno, size_t col, const char *msg)
prog: {
prog: 	fflush(stdout);
prog: 	fprintf(stderr, "cfgget: line %d col %zu: %s\n", lineno, col, msg);
prog: 	return 1;
prog: }
prog: 
prog: /* space, tab, and the CR left by a \r\n line ending */
prog: static int is_blank(char c)
prog: {
prog: 	return c == ' ' || c == '\t' || c == '\r';
prog: }
prog: 
prog: static int is_keychar(char c)
prog: {
prog: 	return isalnum((unsigned char)c) || c == '_' || c == '.' || c == '-';
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: cfgget KEY\n");
prog: 		return 2;
prog: 	}
prog: 	size_t want = strlen(argv[1]);
prog: 	char found[256];
prog: 	int have = 0;
prog: 
prog: 	char line[256];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 
prog: 		char *p = line;
prog: 		while (is_blank(*p))
prog: 			p++;
prog: 		if (*p == '\0' || *p == '#')
prog: 			continue;
prog: 
prog: 		char *eq = strchr(p, '=');
prog: 		if (eq == NULL)
prog: 			return fail(lineno, (size_t)(p - line) + 1, "expected key=value");
prog: 		if (eq == p)
prog: 			return fail(lineno, (size_t)(eq - line) + 1, "empty key");
prog: 
prog: 		char *kend = eq;
prog: 		while (is_blank(kend[-1]))
prog: 			kend--;
prog: 		for (const char *q = p; q < kend; q++)
prog: 			if (!is_keychar(*q))
prog: 				return fail(lineno, (size_t)(q - line) + 1, "bad character in key");
prog: 
prog: 		char *val = eq + 1;
prog: 		while (is_blank(*val))
prog: 			val++;
prog: 		char *vend = val + strlen(val);
prog: 		while (vend > val && is_blank(vend[-1]))
prog: 			vend--;
prog: 
prog: 		if ((size_t)(kend - p) == want && memcmp(p, argv[1], want) == 0) {
prog: 			memcpy(found, val, (size_t)(vend - val));
prog: 			found[vend - val] = '\0';
prog: 			have = 1;
prog: 		}
prog: 	}
prog: 
prog: 	if (!have) {
prog: 		fprintf(stderr, "cfgget: %s not set\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	puts(found);
prog: 	return 0;
prog: }
case: printf '# cfg\nname = demo\n\nport=8080\n' | cfgget port; printf '# cfg\nname = demo\n' | cfgget name
case: printf 'a=1\na = 2\n' | cfgget a
case: printf '  k  =   spaced out value  \r\nx=y\n' | cfgget k | od -c
case: printf 'url=http://x/?a=b#frag\n  # note\n' | cfgget url; printf 'e=\n' | cfgget e | wc -c
case: printf 'a=1\n' | cfgget zz 2>&1; echo $?; cfgget 2>&1; echo $?
case: for p in novalue '  =v' 'my key=1' '  x  y = 2' ' a.b-c_d=ok'; do printf '%s\n' "$p" | cfgget a 2>&1; echo $?; done
hint: find the first = with strchr; trim the key by stepping its end back, check each key character, then trim the value the same way
