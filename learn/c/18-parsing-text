q: wordsplit.c -- split lines into words
spec: Reads standard input and prints every word on every line, one per
spec: output line, as `LINE.INDEX [WORD]`: LINE counts input lines from 1,
spec: INDEX counts the words on that line from 1. Words are separated by
spec: any run of spaces and tabs; leading and trailing blanks are
spec: ignored; a line with no words prints nothing. Lines are at most 200
spec: characters.
spec:
spec: A word that STARTS with a double quote runs to the next double quote
spec: and may hold blanks; the quotes are not part of the word, and `""`
spec: is an empty word. After the closing quote there must be a blank or
spec: the end of the line. A quote anywhere else is an ordinary character.
spec:
spec: Walk the line with a pointer. Do not use `strtok`. Print a word with
spec: `%.*s` from its start and length.
spec:
spec: An opening quote with no closing one prints `wordsplit: line L col
spec: C: unterminated quote` (C is the column of the opening quote, from
spec: 1) and text right after a closing quote prints `wordsplit: line L
spec: col C: text after closing quote` (C is that text's column). Either
spec: goes to standard error, after flushing standard output, and exits 1;
spec: words of earlier lines stay printed.
file: wordsplit.c
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: static int fail(int lineno, size_t col, const char *msg)
prog: {
prog: 	fflush(stdout);
prog: 	fprintf(stderr, "wordsplit: line %d col %zu: %s\n", lineno, col, msg);
prog: 	return 1;
prog: }
prog: 
prog: static int is_blank(char c)
prog: {
prog: 	return c == ' ' || c == '\t';
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char line[256];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 
prog: 		const char *p = line;
prog: 		for (int idx = 1;; idx++) {
prog: 			while (is_blank(*p))
prog: 				p++;
prog: 			if (*p == '\0')
prog: 				break;
prog: 
prog: 			const char *start = p, *end;
prog: 			if (*p == '"') {
prog: 				start = ++p;
prog: 				while (*p != '"' && *p != '\0')
prog: 					p++;
prog: 				if (*p == '\0')
prog: 					return fail(lineno, (size_t)(start - line), "unterminated quote");
prog: 				end = p++;
prog: 				if (*p != '\0' && !is_blank(*p))
prog: 					return fail(lineno, (size_t)(p - line) + 1,
prog: 								"text after closing quote");
prog: 			} else {
prog: 				while (*p != '\0' && !is_blank(*p))
prog: 					p++;
prog: 				end = p;
prog: 			}
prog: 			printf("%d.%d [%.*s]\n", lineno, idx, (int)(end - start), start);
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: printf 'one two  three\n' | wordsplit
case: printf '  lead\ttab   trail  \n\n   \nx\n' | wordsplit
case: printf 'say "hello big world" now ""\n' | wordsplit; printf 'ab"cd ef\n' | wordsplit
case: printf 'ok\nbad "unclosed here\n' | wordsplit 2>&1; echo $?
case: printf '"a"b\n' | wordsplit 2>&1; echo $?
hint: skip blanks, then either run to the next quote or to the next blank, and print end minus start bytes from start
