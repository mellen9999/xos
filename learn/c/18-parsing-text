q: csvcol.c -- one column of a CSV file
spec: Takes one argument N (a whole number, at least 1) and prints the Nth
spec: field of every row of the CSV on standard input, one per line. A bad
spec: N or another argument count prints `usage: csvcol N` to standard
spec: error and exits 2.
spec:
spec: Fields are separated by commas. A field may be wrapped in double
spec: quotes, and then it may hold commas, and `""` inside means one
spec: quote; the wrapping quotes are not part of the value. A row ends at
spec: the line end; `\r\n` counts as one (the `\r` is not part of the last
spec: field). An empty line is a row with one empty field. Lines are at
spec: most 500 characters. Parse by walking a pointer: no `strtok`.
spec:
spec: Check every field of every row, not just the Nth. A problem prints
spec: `csvcol: line L col C: MESSAGE` to standard error after flushing
spec: standard output, and exits 1; rows before it stay printed.
spec: C counts bytes from 1. Messages: `unterminated quote` (C is the
spec: opening quote), `text after closing quote` (C is that text), and
spec: `quote inside unquoted field` (C is that quote). A row with fewer
spec: than N fields prints `csvcol: line L: no column N` and exits 1.
file: csvcol.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: /* Parse the field at *pp in place: unquote it, end it with a NUL, and leave
prog:    *pp on the next field (NULL after the last). Returns 0, or the 1-based
prog:    column of a syntax error with *why set. */
prog: static size_t field(const char *line, char **pp, char **out, const char **why)
prog: {
prog: 	char *p = *pp, *w = p;
prog: 	*out = p;
prog: 	if (*p == '"') {
prog: 		size_t open = (size_t)(p - line) + 1;
prog: 		p++;
prog: 		for (;;) {
prog: 			if (*p == '\0') {
prog: 				*why = "unterminated quote";
prog: 				return open;
prog: 			}
prog: 			if (*p == '"') {
prog: 				if (p[1] != '"')
prog: 					break;
prog: 				*w++ = '"';
prog: 				p += 2;
prog: 			} else {
prog: 				*w++ = *p++;
prog: 			}
prog: 		}
prog: 		p++;
prog: 		if (*p != ',' && *p != '\0') {
prog: 			*why = "text after closing quote";
prog: 			return (size_t)(p - line) + 1;
prog: 		}
prog: 	} else {
prog: 		while (*p != ',' && *p != '\0') {
prog: 			if (*p == '"') {
prog: 				*why = "quote inside unquoted field";
prog: 				return (size_t)(p - line) + 1;
prog: 			}
prog: 			*w++ = *p++;
prog: 		}
prog: 	}
prog: 	*pp = *p == ',' ? p + 1 : NULL;
prog: 	*w = '\0';
prog: 	return 0;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long n = argc == 2 ? strtol(argv[1], &end, 10) : 0;
prog: 	if (argc != 2 || errno != 0 || end == argv[1] || *end != '\0' || n < 1) {
prog: 		fprintf(stderr, "usage: csvcol N\n");
prog: 		return 2;
prog: 	}
prog: 
prog: 	char line[512];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\r\n")] = '\0';
prog: 
prog: 		char *rest = line, *f, *wanted = NULL;
prog: 		for (long i = 1; rest != NULL; i++) {
prog: 			const char *why;
prog: 			size_t col = field(line, &rest, &f, &why);
prog: 			if (col != 0) {
prog: 				fflush(stdout);
prog: 				fprintf(stderr, "csvcol: line %d col %zu: %s\n", lineno, col, why);
prog: 				return 1;
prog: 			}
prog: 			if (i == n)
prog: 				wanted = f;
prog: 		}
prog: 		if (wanted == NULL) {
prog: 			fflush(stdout);
prog: 			fprintf(stderr, "csvcol: line %d: no column %ld\n", lineno, n);
prog: 			return 1;
prog: 		}
prog: 		puts(wanted);
prog: 	}
prog: 	return 0;
prog: }
case: printf 'a,b,c\n1,2,3\n' | csvcol 2
case: printf 'name,note\nbob,"hi, there"\n"x ""q"" y",z\n' | csvcol 1; printf 'name,note\nbob,"hi, there"\n"x ""q"" y",z\n' | csvcol 2
case: printf 'a,,c\n\n,\n' | csvcol 1 | wc -l; printf 'a,b\r\nc,d\r\n' | csvcol 2 | od -c
case: for p in '"abc' 'a,"b"x' 'a,b"c' a; do printf '%s\n' "$p" | csvcol 2 2>&1; echo $?; done
case: csvcol 2>&1; echo $?; csvcol 0 2>&1; echo $?; printf 'x,y\nz\n' | csvcol 2 2>&1; echo $?
hint: a quoted field copies characters until a lone quote, turning each doubled quote into one; an unquoted one runs to the next comma
