q: exprcalc.c -- a calculator with real error messages
spec: Reads one arithmetic expression per line from standard input and
spec: prints its value, one per line. Whole numbers, `+`, `-`, `*`, `/`,
spec: parentheses, unary minus, and spaces or tabs anywhere between
spec: tokens. `*` and `/` bind tighter than `+` and `-`; each operator
spec: groups left to right (`2 - 3 - 4` is -5); division truncates toward
spec: zero (`-7 / 2` is -3). Lines that are only blanks are skipped. Lines
spec: are at most 200 characters.
spec:
spec: Every number and every intermediate result must lie between
spec: -1000000000 and 1000000000, so nothing can overflow (use `long
spec: long`). Parse with recursive descent: one function per precedence
spec: level, walking a pointer along the line; no `strtok`, no `sscanf`.
spec:
spec: The first bad line stops the run: print `exprcalc: line L col C:
spec: MESSAGE` to standard error after flushing standard output, and exit
spec: 1. C is the column, from 1, where the problem is found (one past the
spec: end of the line when it ran out). Messages: `expected number`,
spec: `expected )`, `unexpected text` (something is left after a complete
spec: expression), `division by zero` (C is the `/`) and `out of range`
spec: (C is the number, or the operator that made the result too big).
spec: Values of lines before it stay printed.
file: exprcalc.c
prog: #include <ctype.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: #define LIMIT 1000000000LL
prog: 
prog: struct parse {
prog: 	const char *start, *p;   /* the line, and the next byte to read */
prog: 	const char *err;         /* first error, or NULL */
prog: 	size_t col;              /* where it was */
prog: };
prog: 
prog: static void fail(struct parse *ps, const char *at, const char *msg)
prog: {
prog: 	if (ps->err == NULL) {
prog: 		ps->err = msg;
prog: 		ps->col = (size_t)(at - ps->start) + 1;
prog: 	}
prog: }
prog: 
prog: static void skip(struct parse *ps)
prog: {
prog: 	while (*ps->p == ' ' || *ps->p == '\t')
prog: 		ps->p++;
prog: }
prog: 
prog: static long long expr(struct parse *ps);
prog: 
prog: static long long primary(struct parse *ps)
prog: {
prog: 	skip(ps);
prog: 	if (isdigit((unsigned char)*ps->p)) {
prog: 		const char *at = ps->p;
prog: 		long long v = 0;
prog: 		while (isdigit((unsigned char)*ps->p)) {
prog: 			v = v * 10 + (*ps->p++ - '0');
prog: 			if (v > LIMIT) {
prog: 				fail(ps, at, "out of range");
prog: 				return 0;
prog: 			}
prog: 		}
prog: 		return v;
prog: 	}
prog: 	if (*ps->p == '(') {
prog: 		ps->p++;
prog: 		long long v = expr(ps);
prog: 		skip(ps);
prog: 		if (ps->err == NULL && *ps->p != ')')
prog: 			fail(ps, ps->p, "expected )");
prog: 		else if (ps->err == NULL)
prog: 			ps->p++;
prog: 		return v;
prog: 	}
prog: 	fail(ps, ps->p, "expected number");
prog: 	return 0;
prog: }
prog: 
prog: static long long unary(struct parse *ps)
prog: {
prog: 	skip(ps);
prog: 	if (*ps->p == '-') {
prog: 		ps->p++;
prog: 		return -unary(ps);
prog: 	}
prog: 	return primary(ps);
prog: }
prog: 
prog: static long long term(struct parse *ps)
prog: {
prog: 	long long v = unary(ps);
prog: 	for (;;) {
prog: 		skip(ps);
prog: 		const char *at = ps->p;
prog: 		char op = *ps->p;
prog: 		if (ps->err != NULL || (op != '*' && op != '/'))
prog: 			return v;
prog: 		ps->p++;
prog: 		long long r = unary(ps);
prog: 		if (ps->err != NULL)
prog: 			return 0;
prog: 		if (op == '/' && r == 0) {
prog: 			fail(ps, at, "division by zero");
prog: 			return 0;
prog: 		}
prog: 		v = op == '*' ? v * r : v / r;
prog: 		if (v > LIMIT || v < -LIMIT) {
prog: 			fail(ps, at, "out of range");
prog: 			return 0;
prog: 		}
prog: 	}
prog: }
prog: 
prog: static long long expr(struct parse *ps)
prog: {
prog: 	long long v = term(ps);
prog: 	for (;;) {
prog: 		skip(ps);
prog: 		const char *at = ps->p;
prog: 		char op = *ps->p;
prog: 		if (ps->err != NULL || (op != '+' && op != '-'))
prog: 			return v;
prog: 		ps->p++;
prog: 		long long r = term(ps);
prog: 		if (ps->err != NULL)
prog: 			return 0;
prog: 		v = op == '+' ? v + r : v - r;
prog: 		if (v > LIMIT || v < -LIMIT) {
prog: 			fail(ps, at, "out of range");
prog: 			return 0;
prog: 		}
prog: 	}
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char line[256];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 
prog: 		struct parse ps = { .start = line, .p = line };
prog: 		skip(&ps);
prog: 		if (*ps.p == '\0')
prog: 			continue;
prog: 		long long v = expr(&ps);
prog: 		skip(&ps);
prog: 		if (ps.err == NULL && *ps.p != '\0')
prog: 			fail(&ps, ps.p, "unexpected text");
prog: 		if (ps.err != NULL) {
prog: 			fflush(stdout);
prog: 			fprintf(stderr, "exprcalc: line %d col %zu: %s\n", lineno, ps.col,
prog: 					ps.err);
prog: 			return 1;
prog: 		}
prog: 		printf("%lld\n", v);
prog: 	}
prog: 	return 0;
prog: }
case: printf '1 + 2 * 3\n(1 + 2) * 3\n10 / 3\n-7 / 2\n' | exprcalc
case: printf '2 - 3 - 4\n100 / 10 / 5\n--5\n- (2 + 3)\n  42  \n' | exprcalc
case: printf '\n1+1\n\n' | exprcalc; printf '2 * -3\n' | exprcalc
case: printf '1 + \n' | exprcalc 2>&1; echo $?; printf '4\n(1 + 2\n' | exprcalc 2>&1; echo $?
case: for p in '7 / 0' '2 3' '1 + a' '3 )' 1000000001 '30000 * 40000 * 1000' '('; do printf '%s\n' "$p" | exprcalc 2>&1; echo $?; done
hint: expr handles plus and minus by calling term; term handles times and divide by calling unary; unary handles a minus sign; primary reads a number or a parenthesised expr
