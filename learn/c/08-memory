q: sortnums.c -- sort numbers from stdin
spec: Read whole numbers from standard input, one per line, any count,
spec: and print them sorted ascending, one per line. Empty input prints
spec: nothing. Values span the full `long` range.
spec:
spec: Store them in a heap array of long that grows by doubling, and sort
spec: with `qsort`. The comparator must not subtract (a - b overflows).
spec: Free the array before you exit.
spec:
spec: A line that is not a whole number (blank included) prints
spec: `sortnums: line L: bad number` to standard error (L counts from 1),
spec: prints nothing to standard output, and exits 1. Lines are at most
spec: 60 characters. Running out of memory prints `sortnums: out of
spec: memory` to standard error and exits 1.
file: sortnums.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static int cmp_long(const void *a, const void *b)
prog: {
prog: 	long x = *(const long *)a;
prog: 	long y = *(const long *)b;
prog: 	return (x > y) - (x < y);
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	size_t cap = 8, n = 0;
prog: 	long *v = malloc(cap * sizeof *v);
prog: 	if (v == NULL)
prog: 		goto oom;
prog: 
prog: 	char line[64];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "sortnums: line %d: bad number\n", lineno);
prog: 			free(v);
prog: 			return 1;
prog: 		}
prog: 		if (n == cap) {
prog: 			long *tmp = realloc(v, cap * 2 * sizeof *v);
prog: 			if (tmp == NULL)
prog: 				goto oom;
prog: 			v = tmp;
prog: 			cap *= 2;
prog: 		}
prog: 		v[n++] = x;
prog: 	}
prog: 	qsort(v, n, sizeof *v, cmp_long);
prog: 	for (size_t i = 0; i < n; i++)
prog: 		printf("%ld\n", v[i]);
prog: 	free(v);
prog: 	return 0;
prog: 
prog: oom:
prog: 	free(v);
prog: 	fprintf(stderr, "sortnums: out of memory\n");
prog: 	return 1;
prog: }
case: printf '3\n1\n2\n' | sortnums
case: printf '5\n-2\n5\n0\n' | sortnums
case: printf '9223372036854775807\n-9223372036854775808\n0\n' | sortnums
case: seq 30 -1 1 | sortnums
case: printf '1\nx\n3\n' | sortnums 2>&1; echo $?
case: sortnums < /dev/null; echo $?
hint: grow the array when n hits cap, compare with two greater-than tests instead of subtracting, and qsort it at the end
