q: revall.c -- all of stdin, backwards
spec: Read ALL of standard input -- any length -- and write its bytes
spec: back out in reverse order. `abc\n` goes in, `\ncba` comes out: no
spec: newline is added. Empty input writes nothing.
spec:
spec: Keep the input in a heap buffer that starts small and doubles with
spec: realloc (through a temporary) when full. If memory runs out, free
spec: what you hold, print `revall: out of memory` to standard error and
spec: exit 1. Free the buffer before you exit.
file: revall.c
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: int main(void)
prog: {
prog: 	size_t cap = 16, len = 0;
prog: 	char *buf = malloc(cap);
prog: 	if (buf == NULL)
prog: 		goto oom;
prog: 
prog: 	int c;
prog: 	while ((c = getchar()) != EOF) {
prog: 		if (len == cap) {
prog: 			if (cap > SIZE_MAX / 2)
prog: 				goto oom;
prog: 			char *tmp = realloc(buf, cap * 2);
prog: 			if (tmp == NULL)
prog: 				goto oom;
prog: 			buf = tmp;
prog: 			cap *= 2;
prog: 		}
prog: 		buf[len++] = (char)c;
prog: 	}
prog: 	while (len > 0)
prog: 		putchar(buf[--len]);
prog: 	free(buf);
prog: 	return 0;
prog: 
prog: oom:
prog: 	free(buf);
prog: 	fprintf(stderr, "revall: out of memory\n");
prog: 	return 1;
prog: }
case: printf 'abc\n' | revall
case: printf 'x' | revall
case: seq 1 100 | revall
case: revall < /dev/null; echo $?
hint: a char buffer with len and cap; when len reaches cap, realloc to double through a temp, then walk back from the end
