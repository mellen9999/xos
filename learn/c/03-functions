q: gcd.c -- small functions that build on each other
spec: Write `static unsigned gcd(unsigned a, unsigned b)` using Euclid's
spec: rule recursively (the gcd of a and 0 is a; otherwise gcd(b, a % b)),
spec: and `static unsigned lcm(unsigned a, unsigned b)` that uses gcd. Print:
spec:
spec: `gcd(48, 18) = 6`
spec: `gcd(17, 5) = 1`
spec: `gcd(0, 9) = 9`
spec: `lcm(4, 6) = 12`
spec: `lcm(21, 6) = 42`
spec:
spec: Divide before you multiply in lcm, so the product cannot overflow.
file: gcd.c
prog: #include <stdio.h>
prog: 
prog: static unsigned gcd(unsigned a, unsigned b)
prog: {
prog: 	if (b == 0)
prog: 		return a;
prog: 	return gcd(b, a % b);
prog: }
prog: 
prog: static unsigned lcm(unsigned a, unsigned b)
prog: {
prog: 	return a / gcd(a, b) * b;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	printf("gcd(48, 18) = %u\n", gcd(48, 18));
prog: 	printf("gcd(17, 5) = %u\n", gcd(17, 5));
prog: 	printf("gcd(0, 9) = %u\n", gcd(0, 9));
prog: 	printf("lcm(4, 6) = %u\n", lcm(4, 6));
prog: 	printf("lcm(21, 6) = %u\n", lcm(21, 6));
prog: 	return 0;
prog: }
case: gcd
case: gcd | sed -n 3p
case: gcd | tail -n 2
hint: the base case is b == 0, and the recursive call swaps to (b, a % b)
