q: numsum.c -- add up a file of numbers
spec: Take one argument, a file holding one whole number per line. Print
spec: the sum of them and a newline, and exit 0. An empty file sums to 0.
spec: A last line with no newline still counts. Each number is a plain
spec: decimal int, with an optional leading `-` or `+`.
spec:
spec: A line that is not exactly one int (blank, trailing junk, too big
spec: for an int) is an error: print `numsum: FILE:N: bad number` to
spec: standard error, N being the line number counted from 1, print no
spec: sum, and exit 1. A file that cannot be opened prints
spec: `numsum: cannot open FILE` and exits 2. Any other number of
spec: arguments prints `usage: numsum FILE` and exits 2.
spec:
spec: Lines are under 64 characters. Use `fgets` and `strtol` with an
spec: end pointer and `errno`.
file: numsum.c
prog: #include <errno.h>
prog: #include <limits.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: numsum FILE\n");
prog: 		return 2;
prog: 	}
prog: 	FILE *f = fopen(argv[1], "r");
prog: 	if (f == NULL) {
prog: 		fprintf(stderr, "numsum: cannot open %s\n", argv[1]);
prog: 		return 2;
prog: 	}
prog: 	long long sum = 0;
prog: 	unsigned long lineno = 0;
prog: 	char line[64];
prog: 	while (fgets(line, sizeof line, f) != NULL) {
prog: 		lineno++;
prog: 		char *end;
prog: 		errno = 0;
prog: 		long v = strtol(line, &end, 10);
prog: 		if (end == line || (*end != '\n' && *end != '\0')
prog: 			|| errno != 0 || v < INT_MIN || v > INT_MAX) {
prog: 			fprintf(stderr, "numsum: %s:%lu: bad number\n", argv[1], lineno);
prog: 			fclose(f);
prog: 			return 1;
prog: 		}
prog: 		sum += v;
prog: 	}
prog: 	fclose(f);
prog: 	printf("%lld\n", sum);
prog: 	return 0;
prog: }
case: printf '1\n2\n3\n' > n; numsum n
case: printf '10\n-4\n+1' > n; numsum n
case: printf '' > n; numsum n
case: printf '5\nabc\n7\n' > n; numsum n; echo $?
case: printf '1\n\n2\n' > n; numsum n; echo $?
case: printf '1\n3000000000\n' > n; numsum n; echo $?
case: printf '99999999999999999999\n' > n; numsum n; echo $?
case: numsum nothere; echo $?
hint: strtol gives back where it stopped -- that spot must be the newline or the end, and errno must still be 0
