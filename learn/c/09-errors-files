q: lastn.c -- the last few lines
spec: Usage `lastn N FILE`: print the last N lines of FILE, exactly as
spec: they are in the file, and exit 0. If the file has fewer than N lines
spec: print them all. A final line with no newline is printed without one.
spec:
spec: N must be a whole number from 1 to 1000. Anything else prints
spec: `lastn: bad count` to standard error and exits 2. Any other number of
spec: arguments prints `usage: lastn N FILE` and exits 2. If FILE cannot be
spec: opened print `lastn: cannot open FILE` and exit 1.
spec:
spec: Lines are under 255 characters. Keep only the last N lines in
spec: memory, in malloc'd copies, and release everything through a single
spec: `goto cleanup` exit -- the file and every line, on every path.
file: lastn.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: static char *copy(const char *s)
prog: {
prog: 	size_t n = strlen(s) + 1;
prog: 	char *p = malloc(n);
prog: 	if (p != NULL)
prog: 		memcpy(p, s, n);
prog: 	return p;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	int status = 1;
prog: 	FILE *f = NULL;
prog: 	char **ring = NULL;
prog: 	size_t n = 0, seen = 0, start;
prog: 	char line[256];
prog: 	char *end;
prog: 	long want;
prog: 
prog: 	if (argc != 3) {
prog: 		fprintf(stderr, "usage: lastn N FILE\n");
prog: 		return 2;
prog: 	}
prog: 	errno = 0;
prog: 	want = strtol(argv[1], &end, 10);
prog: 	if (end == argv[1] || *end != '\0' || errno != 0 || want < 1 || want > 1000) {
prog: 		fprintf(stderr, "lastn: bad count\n");
prog: 		return 2;
prog: 	}
prog: 	n = (size_t)want;
prog: 	f = fopen(argv[2], "r");
prog: 	if (f == NULL) {
prog: 		fprintf(stderr, "lastn: cannot open %s\n", argv[2]);
prog: 		goto cleanup;
prog: 	}
prog: 	ring = calloc(n, sizeof *ring);
prog: 	if (ring == NULL) {
prog: 		fprintf(stderr, "lastn: out of memory\n");
prog: 		goto cleanup;
prog: 	}
prog: 	while (fgets(line, sizeof line, f) != NULL) {
prog: 		char **slot = &ring[seen % n];
prog: 		free(*slot);
prog: 		*slot = copy(line);
prog: 		if (*slot == NULL) {
prog: 			fprintf(stderr, "lastn: out of memory\n");
prog: 			goto cleanup;
prog: 		}
prog: 		seen++;
prog: 	}
prog: 	if (ferror(f)) {
prog: 		fprintf(stderr, "lastn: read error on %s\n", argv[2]);
prog: 		goto cleanup;
prog: 	}
prog: 	start = seen > n ? seen - n : 0;
prog: 	for (size_t i = start; i < seen; i++)
prog: 		fputs(ring[i % n], stdout);
prog: 	status = 0;
prog: cleanup:
prog: 	if (ring != NULL) {
prog: 		for (size_t i = 0; i < n; i++)
prog: 			free(ring[i]);
prog: 	}
prog: 	free(ring);
prog: 	if (f != NULL)
prog: 		fclose(f);
prog: 	return status;
prog: }
case: printf '1\n2\n3\n4\n5\n' > f; lastn 2 f
case: printf '1\n2\n3\n4\n5\n' > f; lastn 10 f
case: printf '1\n2\n3\n4\n5\n6\n7\n' > f; lastn 3 f
case: printf 'a\nb' > g; lastn 1 g | wc -c
case: printf 'a\n' > f; lastn 0 f; echo $?
case: printf 'a\n' > f; lastn 2x f; echo $?
case: lastn 3 nothere; echo $?
hint: a ring of N slots -- line number modulo N picks the slot, free what the slot held before you overwrite it
