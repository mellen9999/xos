q: hexd.c -- hex dump
spec: With no argument read standard input; with one, read that file.
spec: Print one row per 8 bytes: the offset as 6 lowercase hex digits, two
spec: spaces, the 8 bytes as two lowercase hex digits each separated by one
spec: space (a short last row is padded with spaces so the next column
spec: lines up), two spaces, a vertical bar, the bytes as characters, and a
spec: vertical bar.
spec: Bytes 0x20 to 0x7e print as themselves, all others as `.`.
spec: Last, one line holding the total byte count as 6 hex digits.
spec:
spec: A short last row: `hi` is two bytes, so its row is the offset,
spec: two spaces, `68 69`, then 20 spaces (the 6 missing bytes plus the
spec: gap), then a vertical bar, `hi`, and a vertical bar. The hex column
spec: is always 23 characters wide.
spec:
spec: Empty input prints just `000000`. A missing file prints
spec: `hexd: cannot open NAME` to standard error and exits 1. More than
spec: one argument prints `usage: hexd [FILE]` and exits 2.
file: hexd.c
prog: #include <stdio.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc > 2) {
prog: 		fprintf(stderr, "usage: hexd [FILE]\n");
prog: 		return 2;
prog: 	}
prog: 	FILE *in = stdin;
prog: 	if (argc == 2) {
prog: 		in = fopen(argv[1], "rb");
prog: 		if (in == NULL) {
prog: 			fprintf(stderr, "hexd: cannot open %s\n", argv[1]);
prog: 			return 1;
prog: 		}
prog: 	}
prog: 	unsigned char row[8];
prog: 	size_t off = 0, n;
prog: 	while ((n = fread(row, 1, sizeof row, in)) > 0) {
prog: 		printf("%06zx  ", off);
prog: 		for (size_t i = 0; i < sizeof row; i++) {
prog: 			if (i < n)
prog: 				printf("%02x", row[i]);
prog: 			else
prog: 				printf("  ");
prog: 			if (i + 1 < sizeof row)
prog: 				putchar(' ');
prog: 		}
prog: 		printf("  |");
prog: 		for (size_t i = 0; i < n; i++)
prog: 			putchar(row[i] >= 0x20 && row[i] <= 0x7e ? row[i] : '.');
prog: 		printf("|\n");
prog: 		off += n;
prog: 	}
prog: 	int bad = ferror(in);
prog: 	if (in != stdin)
prog: 		fclose(in);
prog: 	if (bad) {
prog: 		fprintf(stderr, "hexd: read error\n");
prog: 		return 1;
prog: 	}
prog: 	printf("%06zx\n", off);
prog: 	return 0;
prog: }
case: printf 'hello, world\n' | hexd
case: printf 'ABCDEFGH' | hexd
case: printf 'hi' | hexd
case: printf '' | hexd
case: printf '\001\377 ~\177x' > f; hexd f
case: seq 1 5 | hexd
case: hexd nothere; echo $?
hint: fread 8 bytes at a time; a short count only ever happens at the end, and that is the row you pad
