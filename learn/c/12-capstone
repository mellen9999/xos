q: runs.c -- collapse repeated lines
spec: With no argument read standard input; with one, read that file. Group
spec: neighbouring identical lines and print each group as the count, one
spec: space, then the line: `3 apple`. Lines that match but are not next
spec: to each other are separate groups. A blank line is a line like any
spec: other (`2 ` for two of them). A last line with no newline counts as
spec: a line; every printed line ends in a newline.
spec:
spec: Empty input prints nothing. A missing file prints
spec: `runs: cannot open NAME` to standard error and exits 1. More than one
spec: argument prints `usage: runs [FILE]` and exits 2. Lines are under 1000
spec: characters.
file: runs.c
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: #define MAXLINE 1024
prog: 
prog: static void chomp(char *s)
prog: {
prog: 	s[strcspn(s, "\n")] = '\0';
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc > 2) {
prog: 		fprintf(stderr, "usage: runs [FILE]\n");
prog: 		return 2;
prog: 	}
prog: 	FILE *in = stdin;
prog: 	if (argc == 2) {
prog: 		in = fopen(argv[1], "r");
prog: 		if (in == NULL) {
prog: 			fprintf(stderr, "runs: cannot open %s\n", argv[1]);
prog: 			return 1;
prog: 		}
prog: 	}
prog: 	char prev[MAXLINE], cur[MAXLINE];
prog: 	size_t count = 0;
prog: 	while (fgets(cur, sizeof cur, in) != NULL) {
prog: 		chomp(cur);
prog: 		if (count > 0 && strcmp(cur, prev) == 0) {
prog: 			count++;
prog: 			continue;
prog: 		}
prog: 		if (count > 0)
prog: 			printf("%zu %s\n", count, prev);
prog: 		strcpy(prev, cur);
prog: 		count = 1;
prog: 	}
prog: 	if (count > 0)
prog: 		printf("%zu %s\n", count, prev);
prog: 	int bad = ferror(in);
prog: 	if (in != stdin)
prog: 		fclose(in);
prog: 	if (bad) {
prog: 		fprintf(stderr, "runs: read error\n");
prog: 		return 1;
prog: 	}
prog: 	return 0;
prog: }
case: printf 'a\na\nb\na\n' | runs
case: printf 'x' | runs
case: printf 'q\nq\nq' | runs
case: printf '' | runs
case: printf 'a\n\n\nb\n' | runs
case: printf 'one\none\n' > f; runs f
case: runs nothere; echo $?
hint: remember the previous line and a count; when the new line differs, print the old group and start again at 1 -- and do not forget the group still open at EOF
