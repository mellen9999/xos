q: flip.c -- last line first
spec: With no argument read standard input; with one, read that file. Print
spec: the lines in reverse order, each exactly as it was. If the last line
spec: has no newline, it still comes out as a full line ending in one.
spec: Empty input prints nothing.
spec:
spec: The input can be any size: read it all into a buffer that you grow
spec: with `realloc`, and free it. A missing file prints
spec: `flip: cannot open NAME` to standard error and exits 1. More than one
spec: argument prints `usage: flip [FILE]` and exits 2. If memory or reading
spec: fails print `flip: read error` and exit 1.
file: flip.c
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static int slurp(FILE *in, char **out, size_t *len)
prog: {
prog: 	size_t cap = 4096, n = 0, got;
prog: 	char *buf = malloc(cap);
prog: 	if (buf == NULL)
prog: 		return -1;
prog: 	while ((got = fread(buf + n, 1, cap - n, in)) > 0) {
prog: 		n += got;
prog: 		if (n == cap) {
prog: 			char *bigger = realloc(buf, cap * 2);
prog: 			if (bigger == NULL) {
prog: 				free(buf);
prog: 				return -1;
prog: 			}
prog: 			buf = bigger;
prog: 			cap *= 2;
prog: 		}
prog: 	}
prog: 	if (ferror(in)) {
prog: 		free(buf);
prog: 		return -1;
prog: 	}
prog: 	*out = buf;
prog: 	*len = n;
prog: 	return 0;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc > 2) {
prog: 		fprintf(stderr, "usage: flip [FILE]\n");
prog: 		return 2;
prog: 	}
prog: 	FILE *in = stdin;
prog: 	if (argc == 2) {
prog: 		in = fopen(argv[1], "rb");
prog: 		if (in == NULL) {
prog: 			fprintf(stderr, "flip: cannot open %s\n", argv[1]);
prog: 			return 1;
prog: 		}
prog: 	}
prog: 	char *buf = NULL;
prog: 	size_t len = 0;
prog: 	int rc = slurp(in, &buf, &len);
prog: 	if (in != stdin)
prog: 		fclose(in);
prog: 	if (rc != 0) {
prog: 		fprintf(stderr, "flip: read error\n");
prog: 		return 1;
prog: 	}
prog: 	if (len > 0 && buf[len - 1] != '\n')
prog: 		buf[len++] = '\n';
prog: 	size_t end = len;
prog: 	while (end > 0) {
prog: 		size_t start = end - 1;
prog: 		while (start > 0 && buf[start - 1] != '\n')
prog: 			start--;
prog: 		fwrite(buf + start, 1, end - start, stdout);
prog: 		end = start;
prog: 	}
prog: 	free(buf);
prog: 	return 0;
prog: }
case: printf '1\n2\n3\n' | flip
case: printf 'a\nb' | flip
case: printf '' | flip
case: printf '\n\nx\n' | flip
case: seq 1 3000 | flip | head -n 3
case: seq 1 3000 | flip | tail -n 1
case: printf 'one\ntwo\n' > f; flip f
case: flip nothere; echo $?
hint: find each line by walking back from the end to the previous newline; fwrite that slice, then step to the one before
