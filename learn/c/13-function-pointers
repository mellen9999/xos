q: cmdtab.c -- a stack machine with a command table
spec: Reads commands from standard input, one per line, and runs them on
spec: a stack of at most 16 numbers. A command is a name, then optionally
spec: one space-separated argument. Empty lines are skipped (they still
spec: count in line numbers).
spec:
spec: `push N` puts N on the stack. `pop` drops the top. `dup` copies it.
spec: `swap` exchanges the top two. `add`, `sub`, `mul`, `div` take the
spec: top two, A below B, and push A+B, A-B, A*B, A/B (C division, toward
spec: zero). `print` shows the top as a decimal and a newline, and leaves
spec: it there. Only `push` takes an argument.
spec:
spec: Find the command in a table of names and handler function pointers,
spec: not a chain of ifs. Every handler returns an error code from an
spec: enum, and a table of messages turns it into text.
spec:
spec: Stack values must stay between -1000000000 and 1000000000, so no
spec: arithmetic can overflow. The first failing command stops the run:
spec: print `cmdtab: line L: MESSAGE` to standard error and exit 1. The
spec: messages are `unknown command`, `stack empty` (too few items),
spec: `stack full`, `bad number` (push argument not a whole number, or
spec: too big for a long), `out of range`, `bad argument` (push without one, or any other
spec: command with one) and `divide by zero`. Check an argument first, then
spec: the stack depth, then the arithmetic. Spaces after a command with no
spec: argument change nothing (`pop ` is `pop`). End of input exits 0.
file: cmdtab.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define DEPTH 16
prog: #define LIMIT 1000000000L
prog: 
prog: enum err { OK, E_UNKNOWN, E_EMPTY, E_FULL, E_NUM, E_RANGE, E_ARG, E_DIV };
prog: 
prog: static const char *const errtext[] = {
prog: 	[OK] = "ok",
prog: 	[E_UNKNOWN] = "unknown command",
prog: 	[E_EMPTY] = "stack empty",
prog: 	[E_FULL] = "stack full",
prog: 	[E_NUM] = "bad number",
prog: 	[E_RANGE] = "out of range",
prog: 	[E_ARG] = "bad argument",
prog: 	[E_DIV] = "divide by zero",
prog: };
prog: 
prog: struct stack {
prog: 	long v[DEPTH];
prog: 	size_t n;
prog: };
prog: 
prog: typedef enum err (*handler)(struct stack *s, const char *arg);
prog: 
prog: static enum err put(struct stack *s, long x)
prog: {
prog: 	if (x > LIMIT || x < -LIMIT)
prog: 		return E_RANGE;
prog: 	if (s->n == DEPTH)
prog: 		return E_FULL;
prog: 	s->v[s->n++] = x;
prog: 	return OK;
prog: }
prog: 
prog: static enum err h_push(struct stack *s, const char *arg)
prog: {
prog: 	if (arg == NULL)
prog: 		return E_ARG;
prog: 	char *end;
prog: 	errno = 0;
prog: 	long x = strtol(arg, &end, 10);
prog: 	if (errno != 0 || end == arg || *end != '\0')
prog: 		return E_NUM;
prog: 	return put(s, x);
prog: }
prog: 
prog: static enum err h_pop(struct stack *s, const char *arg)
prog: {
prog: 	if (arg != NULL)
prog: 		return E_ARG;
prog: 	if (s->n < 1)
prog: 		return E_EMPTY;
prog: 	s->n--;
prog: 	return OK;
prog: }
prog: 
prog: static enum err h_dup(struct stack *s, const char *arg)
prog: {
prog: 	if (arg != NULL)
prog: 		return E_ARG;
prog: 	if (s->n < 1)
prog: 		return E_EMPTY;
prog: 	return put(s, s->v[s->n - 1]);
prog: }
prog: 
prog: static enum err h_swap(struct stack *s, const char *arg)
prog: {
prog: 	if (arg != NULL)
prog: 		return E_ARG;
prog: 	if (s->n < 2)
prog: 		return E_EMPTY;
prog: 	long t = s->v[s->n - 1];
prog: 	s->v[s->n - 1] = s->v[s->n - 2];
prog: 	s->v[s->n - 2] = t;
prog: 	return OK;
prog: }
prog: 
prog: static enum err h_print(struct stack *s, const char *arg)
prog: {
prog: 	if (arg != NULL)
prog: 		return E_ARG;
prog: 	if (s->n < 1)
prog: 		return E_EMPTY;
prog: 	printf("%ld\n", s->v[s->n - 1]);
prog: 	return OK;
prog: }
prog: 
prog: /* take two off, push one back: the shape shared by every operator */
prog: static enum err pop2(struct stack *s, const char *arg, long *a, long *b)
prog: {
prog: 	if (arg != NULL)
prog: 		return E_ARG;
prog: 	if (s->n < 2)
prog: 		return E_EMPTY;
prog: 	*b = s->v[--s->n];
prog: 	*a = s->v[--s->n];
prog: 	return OK;
prog: }
prog: 
prog: static enum err h_add(struct stack *s, const char *arg)
prog: {
prog: 	long a, b;
prog: 	enum err e = pop2(s, arg, &a, &b);
prog: 	return e != OK ? e : put(s, a + b);
prog: }
prog: 
prog: static enum err h_sub(struct stack *s, const char *arg)
prog: {
prog: 	long a, b;
prog: 	enum err e = pop2(s, arg, &a, &b);
prog: 	return e != OK ? e : put(s, a - b);
prog: }
prog: 
prog: static enum err h_mul(struct stack *s, const char *arg)
prog: {
prog: 	long a, b;
prog: 	enum err e = pop2(s, arg, &a, &b);
prog: 	return e != OK ? e : put(s, a * b);
prog: }
prog: 
prog: static enum err h_div(struct stack *s, const char *arg)
prog: {
prog: 	long a, b;
prog: 	enum err e = pop2(s, arg, &a, &b);
prog: 	if (e != OK)
prog: 		return e;
prog: 	return b == 0 ? E_DIV : put(s, a / b);
prog: }
prog: 
prog: static const struct {
prog: 	const char *name;
prog: 	handler fn;
prog: } table[] = {
prog: 	{ "push", h_push }, { "pop", h_pop },   { "dup", h_dup },
prog: 	{ "swap", h_swap }, { "add", h_add },   { "sub", h_sub },
prog: 	{ "mul", h_mul },   { "div", h_div },   { "print", h_print },
prog: };
prog: 
prog: int main(void)
prog: {
prog: 	struct stack st = { .n = 0 };
prog: 	char line[128];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 		if (line[0] == '\0')
prog: 			continue;
prog: 
prog: 		char *arg = strchr(line, ' ');
prog: 		if (arg != NULL) {
prog: 			*arg++ = '\0';
prog: 			while (*arg == ' ')
prog: 				arg++;
prog: 			if (*arg == '\0')
prog: 				arg = NULL;
prog: 		}
prog: 
prog: 		enum err e = E_UNKNOWN;
prog: 		for (size_t i = 0; i < sizeof table / sizeof *table; i++)
prog: 			if (strcmp(line, table[i].name) == 0)
prog: 				e = table[i].fn(&st, arg);
prog: 		if (e != OK) {
prog: 			fprintf(stderr, "cmdtab: line %d: %s\n", lineno, errtext[e]);
prog: 			return 1;
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: printf 'push 3\npush 4\nadd\nprint\n' | cmdtab
case: printf 'push 10\npush 3\ndiv\nprint\npush -10\npush 3\ndiv\nprint\n' | cmdtab
case: printf 'push 2\ndup\nmul\ndup\nmul\nprint\npush 5\nswap\nsub\nprint\n' | cmdtab
case: for p in frob pop push 'push 1x' 'add 3' 'push 2000000000'; do printf '%s\n' "$p" | cmdtab 2>&1; echo $?; done
case: printf 'push 1\n\npush 0\ndiv\n' | cmdtab 2>&1; echo $?; printf 'push 100000\ndup\nmul\n' | cmdtab 2>&1; echo $?
case: seq 1 17 | sed 's/^/push /' | cmdtab 2>&1; echo $?
hint: each handler gets the stack and the argument and returns an error code; main finds the row by name and prints the message for any code that is not OK
