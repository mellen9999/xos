q: ctxcount.c -- which lines mention each word
spec: Takes one or more WORD arguments. Reads standard input and, for each
spec: word, counts the LINES that contain it as a substring (`strstr` finds
spec: one; a line with the word twice counts once). Prints one line per word in argument
spec: order, `WORD: COUNT`, then `lines: TOTAL` for the number of input
spec: lines read. A last line with no newline still counts. Lines are at
spec: most 200 characters. No arguments prints `usage: ctxcount WORD...`
spec: to standard error and exits 2.
spec:
spec: Do the reading in a function that takes a callback and a `void *`
spec: context, and hand it a struct holding the words and the counts.
file: ctxcount.c
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define MAXLINE 256
prog: 
prog: typedef void (*line_fn)(const char *line, void *ctx);
prog: 
prog: struct counts {
prog: 	size_t nwords;
prog: 	char **words;
prog: 	size_t *hits;   /* hits[i]: lines containing words[i] */
prog: 	size_t lines;
prog: };
prog: 
prog: /* hand every line of f, newline stripped, to fn along with ctx */
prog: static void each_line(FILE *f, line_fn fn, void *ctx)
prog: {
prog: 	char buf[MAXLINE];
prog: 	while (fgets(buf, sizeof buf, f) != NULL) {
prog: 		buf[strcspn(buf, "\n")] = '\0';
prog: 		fn(buf, ctx);
prog: 	}
prog: }
prog: 
prog: static void count_line(const char *line, void *ctx)
prog: {
prog: 	struct counts *c = ctx;
prog: 	c->lines++;
prog: 	for (size_t i = 0; i < c->nwords; i++)
prog: 		if (strstr(line, c->words[i]) != NULL)
prog: 			c->hits[i]++;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc < 2) {
prog: 		fprintf(stderr, "usage: ctxcount WORD...\n");
prog: 		return 2;
prog: 	}
prog: 	struct counts c = { .nwords = (size_t)argc - 1, .words = argv + 1 };
prog: 	c.hits = calloc(c.nwords, sizeof *c.hits);
prog: 	if (c.hits == NULL) {
prog: 		fprintf(stderr, "ctxcount: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 
prog: 	each_line(stdin, count_line, &c);
prog: 
prog: 	for (size_t i = 0; i < c.nwords; i++)
prog: 		printf("%s: %zu\n", c.words[i], c.hits[i]);
prog: 	printf("lines: %zu\n", c.lines);
prog: 	free(c.hits);
prog: 	return 0;
prog: }
case: printf 'apple pie\nbanana\napple apple\n\n' | ctxcount apple an zzz
case: printf 'no newline' | ctxcount new x
case: ctxcount a </dev/null
case: ctxcount; echo $?
hint: the callback gets one line and the context; bump the line total, then for each word test strstr and bump that word's counter once
