q: mapfilter.c -- transform, then keep
spec: Takes two arguments, MAP and KEEP, and reads whole numbers from
spec: standard input, one per line. It applies MAP to every number, then
spec: keeps only the results KEEP accepts, and prints those, one per line,
spec: in input order. The filter sees the mapped values, not the originals.
spec:
spec: MAP is one of `double`, `square`, `negate`, `same`. KEEP is one of
spec: `even`, `odd`, `pos` (greater than 0), `all`. Look both up in tables
spec: of function pointers, and write one `apply` and one `filter` that
spec: know nothing about which function they were handed.
spec:
spec: Every input number must be between -30000 and 30000 so that
spec: squaring cannot overflow. A bad line (blank included) prints
spec: `mapfilter: line L: bad number`, one out of range prints
spec: `mapfilter: line L: out of range` (L counts from 1), and more than
spec: 1000 numbers prints `mapfilter: too many numbers`; all go to standard
spec: error, print nothing to standard output and exit 1. A wrong argument
spec: count prints `usage: mapfilter MAP KEEP`, an unknown name prints
spec: `mapfilter: unknown map NAME` or `mapfilter: unknown keep NAME` (the
spec: map is checked first); all exit 2 before any input is read.
spec: Empty input prints nothing and exits 0. Negative odd numbers are odd.
file: mapfilter.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define MAXN 1000
prog: #define LIMIT 30000
prog: 
prog: typedef long (*mapfn)(long);
prog: typedef bool (*keepfn)(long);
prog: 
prog: static long twice(long x) { return x * 2; }
prog: static long square(long x) { return x * x; }
prog: static long negate(long x) { return -x; }
prog: static long same(long x) { return x; }
prog: 
prog: static bool is_even(long x) { return x % 2 == 0; }
prog: static bool is_odd(long x) { return x % 2 != 0; }
prog: static bool is_pos(long x) { return x > 0; }
prog: static bool is_any(long x) { (void)x; return true; }
prog: 
prog: static const struct {
prog: 	const char *name;
prog: 	mapfn fn;
prog: } maps[] = {
prog: 	{ "double", twice }, { "square", square },
prog: 	{ "negate", negate }, { "same", same },
prog: };
prog: 
prog: static const struct {
prog: 	const char *name;
prog: 	keepfn fn;
prog: } keeps[] = {
prog: 	{ "even", is_even }, { "odd", is_odd },
prog: 	{ "pos", is_pos }, { "all", is_any },
prog: };
prog: 
prog: /* run map over v in place */
prog: static void apply(long *v, size_t n, mapfn fn)
prog: {
prog: 	for (size_t i = 0; i < n; i++)
prog: 		v[i] = fn(v[i]);
prog: }
prog: 
prog: /* move the elements fn accepts to the front; return how many */
prog: static size_t filter(long *v, size_t n, keepfn fn)
prog: {
prog: 	size_t kept = 0;
prog: 	for (size_t i = 0; i < n; i++)
prog: 		if (fn(v[i]))
prog: 			v[kept++] = v[i];
prog: 	return kept;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 3) {
prog: 		fprintf(stderr, "usage: mapfilter MAP KEEP\n");
prog: 		return 2;
prog: 	}
prog: 	mapfn map = NULL;
prog: 	for (size_t i = 0; i < sizeof maps / sizeof *maps; i++)
prog: 		if (strcmp(argv[1], maps[i].name) == 0)
prog: 			map = maps[i].fn;
prog: 	if (map == NULL) {
prog: 		fprintf(stderr, "mapfilter: unknown map %s\n", argv[1]);
prog: 		return 2;
prog: 	}
prog: 	keepfn keep = NULL;
prog: 	for (size_t i = 0; i < sizeof keeps / sizeof *keeps; i++)
prog: 		if (strcmp(argv[2], keeps[i].name) == 0)
prog: 			keep = keeps[i].fn;
prog: 	if (keep == NULL) {
prog: 		fprintf(stderr, "mapfilter: unknown keep %s\n", argv[2]);
prog: 		return 2;
prog: 	}
prog: 
prog: 	long v[MAXN];
prog: 	size_t n = 0;
prog: 	char line[64];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "mapfilter: line %d: bad number\n", lineno);
prog: 			return 1;
prog: 		}
prog: 		if (x > LIMIT || x < -LIMIT) {
prog: 			fprintf(stderr, "mapfilter: line %d: out of range\n", lineno);
prog: 			return 1;
prog: 		}
prog: 		if (n == MAXN) {
prog: 			fprintf(stderr, "mapfilter: too many numbers\n");
prog: 			return 1;
prog: 		}
prog: 		v[n++] = x;
prog: 	}
prog: 
prog: 	apply(v, n, map);
prog: 	n = filter(v, n, keep);
prog: 	for (size_t i = 0; i < n; i++)
prog: 		printf("%ld\n", v[i]);
prog: 	return 0;
prog: }
case: printf '1\n2\n3\n' | mapfilter double odd; echo $?
case: printf '1\n2\n-3\n' | mapfilter negate pos
case: printf '7\n-3\n-2\n' | mapfilter same odd
case: printf '5\n-7\n0\n' | mapfilter square all
case: printf '1\n40000\n' | mapfilter same all 2>&1; echo $?; printf '1\nx\n' | mapfilter same all 2>&1; echo $?
case: mapfilter a b c 2>&1; echo $?; mapfilter nope nope </dev/null 2>&1; echo $?; mapfilter same nope </dev/null 2>&1; echo $?
hint: map the whole array first, then compact the survivors to the front; odd means remainder is not 0, because -3 % 2 is -1
