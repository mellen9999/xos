name: function pointers
intro: A function has an address, like a variable. A pointer to one lets
intro: you pass behaviour as data: "sort with THIS comparison", "run THAT
intro: handler". The declaration is the return type, the pointer name in
intro: parentheses, then the parameters:
intro:
intro:     int (*cmp)(const void *, const void *);
intro:
intro: Drop the parentheses and it is a function returning a pointer, which
intro: is not what you meant. Nobody reads those twice, so use a typedef:
intro:
intro:     typedef int (*cmpfn)(const void *, const void *);
intro:     cmpfn f = by_len;     /* a function name is its address */
intro:     int r = f(a, b);      /* call through it like a function */
intro:
intro: `qsort` is the one you have met. It calls your comparator with
intro: pointers TO two array elements. For an array of `char *` those are
intro: `char **` hiding behind `const void *` -- cast once, at the top.
intro:
intro: A table pairs a name with a function and replaces a long if/else
intro: or switch chain. Adding a command is one new row:
intro:
intro:     static const struct { const char *name; handler fn; } tab[] = {
intro:         { "add", h_add }, { "pop", h_pop },
intro:     };
intro:
intro: Loop over `sizeof tab / sizeof *tab` rows, `strcmp` the name, call
intro: `tab[i].fn(...)`. A name that matches no row is an error to report.
intro:
intro: C has no closures, so a callback that needs state takes a `void *`
intro: context beside it. The caller passes the address of its own struct;
intro: the callback converts it back. The compiler cannot check this, so
intro: convert to exactly the type that was passed:
intro:
intro:     typedef void (*visit_fn)(const char *line, void *ctx);
intro:     struct tally *t = ctx;    /* void * converts without a cast */
intro:
intro: Calling a null or mistyped function pointer is undefined behaviour,
intro: usually a crash. A table row you forgot to fill in is a null.
---
q: sortby.c -- sort lines by a chosen rule
spec: Takes one argument, the MODE, and sorts the lines of standard input
spec: by it, printing one per line:
spec:
spec: `alpha` -- strcmp order. `ralpha` -- reverse strcmp order.
spec: `len` -- shortest first; lines of equal length in strcmp order.
spec: `num` -- by the number at the start of the line (strtol, base 10;
spec: text that is not a number counts as 0); equal numbers in strcmp order.
spec:
spec: Pick the comparator through a table of names and function pointers,
spec: and sort with `qsort`. Lines are at most 60 characters and there are
spec: at most 256 of them; a 257th prints `sortby: too many lines` to
spec: standard error, prints nothing to standard output, and exits 1.
spec: A wrong argument count prints `usage: sortby MODE` and a MODE not in
spec: the table prints `sortby: unknown mode NAME`, both to standard error,
spec: both exit 2. Empty input prints nothing and exits 0.
file: sortby.c
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define MAXLINES 256
prog: #define MAXLEN 64
prog: 
prog: typedef int (*cmpfn)(const void *, const void *);
prog: 
prog: /* qsort passes pointers TO the elements; the elements are char *, so each
prog:    argument is really a char ** hiding behind const void * */
prog: static const char *text(const void *p)
prog: {
prog: 	return *(const char *const *)p;
prog: }
prog: 
prog: static int by_alpha(const void *a, const void *b)
prog: {
prog: 	return strcmp(text(a), text(b));
prog: }
prog: 
prog: static int by_ralpha(const void *a, const void *b)
prog: {
prog: 	return by_alpha(b, a);
prog: }
prog: 
prog: static int by_len(const void *a, const void *b)
prog: {
prog: 	size_t x = strlen(text(a)), y = strlen(text(b));
prog: 	if (x != y)
prog: 		return x < y ? -1 : 1;
prog: 	return by_alpha(a, b);
prog: }
prog: 
prog: static int by_num(const void *a, const void *b)
prog: {
prog: 	long x = strtol(text(a), NULL, 10), y = strtol(text(b), NULL, 10);
prog: 	if (x != y)
prog: 		return x < y ? -1 : 1;
prog: 	return by_alpha(a, b);
prog: }
prog: 
prog: static const struct {
prog: 	const char *name;
prog: 	cmpfn cmp;
prog: } modes[] = {
prog: 	{ "alpha", by_alpha },
prog: 	{ "ralpha", by_ralpha },
prog: 	{ "len", by_len },
prog: 	{ "num", by_num },
prog: };
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: sortby MODE\n");
prog: 		return 2;
prog: 	}
prog: 	cmpfn cmp = NULL;
prog: 	for (size_t i = 0; i < sizeof modes / sizeof *modes; i++)
prog: 		if (strcmp(argv[1], modes[i].name) == 0)
prog: 			cmp = modes[i].cmp;
prog: 	if (cmp == NULL) {
prog: 		fprintf(stderr, "sortby: unknown mode %s\n", argv[1]);
prog: 		return 2;
prog: 	}
prog: 
prog: 	static char store[MAXLINES][MAXLEN];
prog: 	const char *ptrs[MAXLINES];
prog: 	size_t n = 0;
prog: 	while (n < MAXLINES && fgets(store[n], MAXLEN, stdin) != NULL) {
prog: 		store[n][strcspn(store[n], "\n")] = '\0';
prog: 		ptrs[n] = store[n];
prog: 		n++;
prog: 	}
prog: 	if (n == MAXLINES && getchar() != EOF) {
prog: 		fprintf(stderr, "sortby: too many lines\n");
prog: 		return 1;
prog: 	}
prog: 
prog: 	qsort(ptrs, n, sizeof *ptrs, cmp);
prog: 	for (size_t i = 0; i < n; i++)
prog: 		puts(ptrs[i]);
prog: 	return 0;
prog: }
case: printf 'pear\nfig\napple\n' | sortby alpha
case: printf 'pear\nfig\napple\n' | sortby ralpha
case: printf 'bb\naa\nc\ndddd\n' | sortby len
case: printf '10\n9\n-3\n100\n09\nabc\n' | sortby num
case: sortby; echo $?; sortby shuffle </dev/null 2>&1; echo $?; sortby alpha </dev/null; echo $?
case: seq 1 300 | sortby num 2>&1; echo $?
hint: qsort wants a function of two const void pointers; each really points at a char pointer, so read it as a pointer to const char pointer
