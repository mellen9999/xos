q: treecost.c -- what an unbalanced tree costs
spec: Reads whole numbers, one per line, and inserts them into a binary
spec: search tree with a LOOP (no recursion). A number already present is
spec: not added. Prints one line:
spec:
spec: `nodes N height H ideal I compares C`
spec:
spec: N is the node count; H the height (nodes on the longest path, 0
spec: for an empty tree); I the smallest height that could hold N nodes
spec: (0 for none, 1 for one, 2 for two or three, 3 for four to seven, and
spec: so on); C the total number of times an insert looked at an existing
spec: node's value to decide where to go, over ALL inserts, duplicates
spec: included (a duplicate counts every node it visits, up to and
spec: including the equal one).
spec:
spec: So `4 2 6 1 3 5 7` gives `nodes 7 height 3 ideal 3 compares 10`,
spec: while `1 2 3 4 5 6 7` gives height 7 and 21 compares. Free the tree.
spec:
spec: At most 3000 numbers (`treecost: too many numbers`); a bad line
spec: prints `treecost: line L: bad number`; both go to standard error,
spec: print nothing to standard output and exit 1.
file: treecost.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: #define MAXN 3000
prog: 
prog: struct tnode {
prog: 	long val;
prog: 	struct tnode *left, *right;
prog: };
prog: 
prog: static void free_tree(struct tnode *t)
prog: {
prog: 	if (t == NULL)
prog: 		return;
prog: 	free_tree(t->left);
prog: 	free_tree(t->right);
prog: 	free(t);
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct tnode *root = NULL;
prog: 	size_t nodes = 0, height = 0, compares = 0;
prog: 	int status = 0;
prog: 	char line[64];
prog: 	int lineno = 0;
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		lineno++;
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "treecost: line %d: bad number\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (lineno > MAXN) {
prog: 			fprintf(stderr, "treecost: too many numbers\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 
prog: 		struct tnode **pp = &root;
prog: 		size_t level = 1;
prog: 		while (*pp != NULL) {
prog: 			compares++;
prog: 			if (x == (*pp)->val)
prog: 				break;
prog: 			pp = x < (*pp)->val ? &(*pp)->left : &(*pp)->right;
prog: 			level++;
prog: 		}
prog: 		if (*pp != NULL)
prog: 			continue;
prog: 		struct tnode *n = malloc(sizeof *n);
prog: 		if (n == NULL) {
prog: 			fprintf(stderr, "treecost: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		*n = (struct tnode){ .val = x };
prog: 		*pp = n;
prog: 		nodes++;
prog: 		if (level > height)
prog: 			height = level;
prog: 	}
prog: 
prog: 	if (status == 0) {
prog: 		size_t ideal = 0;   /* fewest levels that could hold this many nodes */
prog: 		for (size_t room = 0; room < nodes; room = room * 2 + 1)
prog: 			ideal++;
prog: 		printf("nodes %zu height %zu ideal %zu compares %zu\n", nodes, height,
prog: 			   ideal, compares);
prog: 	}
prog: 	free_tree(root);
prog: 	return status;
prog: }
case: printf '4\n2\n6\n1\n3\n5\n7\n' | treecost
case: seq 1 1000 | treecost
case: seq 1000 -1 1 | treecost
case: i=1; while [ $i -le 1000 ]; do echo $((i*7919%1009)); i=$((i+1)); done | treecost
case: printf '1\n1\n1\n' | treecost; treecost </dev/null; seq 1 3001 | treecost 2>&1; echo $?
hint: walk down from the root counting each node you look at; if you reach NULL link the new node there, and its level is the number of nodes on the way down plus one
