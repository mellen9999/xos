q: bstwalk.c -- walk a tree without recursion
spec: Reads whole numbers, one per line, into a binary search tree
spec: (duplicates ignored). Prints two lines: `pre:` followed by every
spec: value in pre-order (node, left, right), then `in:` followed by every
spec: value in order. Each value is preceded by one space, so an empty tree
spec: gives just `pre:` and `in:`. For `5 3 8 1 4 9`:
spec:
spec: `pre: 5 3 1 4 8 9` and `in: 1 3 4 5 8 9`.
spec:
spec: Do NOT recurse: insert with a loop, walk with an explicit stack of
spec: node pointers that grows by doubling through `realloc` (a fixed
spec: size breaks on a tree 8000 deep), and free the tree without
spec: recursion too. Free the stack as well.
spec:
spec: At most 10000 numbers (`bstwalk: too many numbers`); a bad line
spec: prints `bstwalk: line L: bad number`; both go to standard error,
spec: print nothing to standard output and exit 1. Running out of memory
spec: prints `bstwalk: out of memory` and exits 1.
file: bstwalk.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: #define MAXN 10000
prog: 
prog: struct tnode {
prog: 	long val;
prog: 	struct tnode *left, *right;
prog: };
prog: 
prog: /* a stack of node pointers that grows by doubling */
prog: struct stack {
prog: 	const struct tnode **v;
prog: 	size_t n, cap;
prog: };
prog: 
prog: static int push(struct stack *s, const struct tnode *t)
prog: {
prog: 	if (s->n == s->cap) {
prog: 		size_t cap = s->cap == 0 ? 16 : s->cap * 2;
prog: 		const struct tnode **v = realloc(s->v, cap * sizeof *v);
prog: 		if (v == NULL)
prog: 			return -1;
prog: 		s->v = v;
prog: 		s->cap = cap;
prog: 	}
prog: 	s->v[s->n++] = t;
prog: 	return 0;
prog: }
prog: 
prog: static const struct tnode *pop(struct stack *s)
prog: {
prog: 	return s->v[--s->n];
prog: }
prog: 
prog: /* a loop, not recursion: walk down until a NULL link */
prog: static int insert(struct tnode **root, long val)
prog: {
prog: 	struct tnode **pp = root;
prog: 	while (*pp != NULL) {
prog: 		if (val < (*pp)->val)
prog: 			pp = &(*pp)->left;
prog: 		else if (val > (*pp)->val)
prog: 			pp = &(*pp)->right;
prog: 		else
prog: 			return 0;
prog: 	}
prog: 	struct tnode *n = malloc(sizeof *n);
prog: 	if (n == NULL)
prog: 		return -1;
prog: 	*n = (struct tnode){ .val = val };
prog: 	*pp = n;
prog: 	return 0;
prog: }
prog: 
prog: /* node, left, right -- pop one, push its right then its left */
prog: static int preorder(const struct tnode *root, struct stack *s)
prog: {
prog: 	printf("pre:");
prog: 	if (root != NULL && push(s, root) != 0)
prog: 		return -1;
prog: 	while (s->n > 0) {
prog: 		const struct tnode *t = pop(s);
prog: 		printf(" %ld", t->val);
prog: 		if ((t->right != NULL && push(s, t->right) != 0) ||
prog: 			(t->left != NULL && push(s, t->left) != 0))
prog: 			return -1;
prog: 	}
prog: 	putchar('\n');
prog: 	return 0;
prog: }
prog: 
prog: /* left, node, right -- go left as far as possible, remembering the way */
prog: static int inorder(const struct tnode *root, struct stack *s)
prog: {
prog: 	printf("in:");
prog: 	const struct tnode *cur = root;
prog: 	while (cur != NULL || s->n > 0) {
prog: 		while (cur != NULL) {
prog: 			if (push(s, cur) != 0)
prog: 				return -1;
prog: 			cur = cur->left;
prog: 		}
prog: 		cur = pop(s);
prog: 		printf(" %ld", cur->val);
prog: 		cur = cur->right;
prog: 	}
prog: 	putchar('\n');
prog: 	return 0;
prog: }
prog: 
prog: /* free without recursion or a stack: rotate each left child above its
prog:    parent until nothing is on the left, then free the node */
prog: static void free_tree(struct tnode *t)
prog: {
prog: 	while (t != NULL) {
prog: 		if (t->left != NULL) {
prog: 			struct tnode *l = t->left;
prog: 			t->left = l->right;
prog: 			l->right = t;
prog: 			t = l;
prog: 		} else {
prog: 			struct tnode *r = t->right;
prog: 			free(t);
prog: 			t = r;
prog: 		}
prog: 	}
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct tnode *root = NULL;
prog: 	struct stack st = { NULL, 0, 0 };
prog: 	int status = 0;
prog: 	char line[64];
prog: 	int lineno = 0;
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		lineno++;
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "bstwalk: line %d: bad number\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (lineno > MAXN) {
prog: 			fprintf(stderr, "bstwalk: too many numbers\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (insert(&root, x) != 0) {
prog: 			fprintf(stderr, "bstwalk: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 	}
prog: 	if (status == 0 && (preorder(root, &st) != 0 || inorder(root, &st) != 0)) {
prog: 		fprintf(stderr, "bstwalk: out of memory\n");
prog: 		status = 1;
prog: 	}
prog: 	free(st.v);
prog: 	free_tree(root);
prog: 	return status;
prog: }
case: printf '5\n3\n8\n1\n4\n9\n' | bstwalk
case: bstwalk </dev/null
case: seq 8000 -1 1 | bstwalk | wc -c
case: seq 1 8000 | bstwalk | tail -c 12
case: seq 1 10001 | bstwalk 2>&1; echo $?; printf '1\nx\n' | bstwalk 2>&1; echo $?
hint: in-order: while cur is not NULL push it and step left; then pop, print, and step to its right; stop when both cur and the stack are empty
