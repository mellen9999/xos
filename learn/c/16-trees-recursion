q: bstshape.c -- draw the tree sideways
spec: Reads whole numbers, one per line, into a binary search tree
spec: (duplicates ignored). Prints the tree turned on its side: one node
spec: per line, indented 4 spaces per level of depth (the root has none),
spec: the RIGHT subtree above its node and the LEFT below. So the largest
spec: number is the first line. Then one last line,
spec: `nodes N height H`: how many nodes, and the height (nodes on the
spec: longest root-to-leaf path: 1 for one node, 0 for none).
spec:
spec: For `5 3 8 1 4 9` it prints nine at 8 spaces, eight at 4, five
spec: at 0, four at 8, three at 4, one at 8, then `nodes 6 height 3`.
spec: With no input just the last line, `nodes 0 height 0`.
spec:
spec: At most 1000 numbers (`bstshape: too many numbers`); a bad line
spec: prints `bstshape: line L: bad number`; both go to standard error,
spec: print nothing to standard output and exit 1. Free the tree.
file: bstshape.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: #define MAXN 1000
prog: 
prog: struct tnode {
prog: 	long val;
prog: 	struct tnode *left, *right;
prog: };
prog: 
prog: static int insert(struct tnode **link, long val)
prog: {
prog: 	if (*link == NULL) {
prog: 		struct tnode *n = malloc(sizeof *n);
prog: 		if (n == NULL)
prog: 			return -1;
prog: 		*n = (struct tnode){ .val = val };
prog: 		*link = n;
prog: 		return 0;
prog: 	}
prog: 	if (val < (*link)->val)
prog: 		return insert(&(*link)->left, val);
prog: 	if (val > (*link)->val)
prog: 		return insert(&(*link)->right, val);
prog: 	return 0;
prog: }
prog: 
prog: /* sideways: right subtree above, left below, 4 columns per level */
prog: static void show(const struct tnode *t, int depth)
prog: {
prog: 	if (t == NULL)
prog: 		return;
prog: 	show(t->right, depth + 1);
prog: 	printf("%*s%ld\n", depth * 4, "", t->val);
prog: 	show(t->left, depth + 1);
prog: }
prog: 
prog: static size_t count(const struct tnode *t)
prog: {
prog: 	return t == NULL ? 0 : 1 + count(t->left) + count(t->right);
prog: }
prog: 
prog: static size_t height(const struct tnode *t)
prog: {
prog: 	if (t == NULL)
prog: 		return 0;
prog: 	size_t l = height(t->left), r = height(t->right);
prog: 	return 1 + (l > r ? l : r);
prog: }
prog: 
prog: static void free_tree(struct tnode *t)
prog: {
prog: 	if (t == NULL)
prog: 		return;
prog: 	free_tree(t->left);
prog: 	free_tree(t->right);
prog: 	free(t);
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct tnode *root = NULL;
prog: 	int status = 0;
prog: 	char line[64];
prog: 	int lineno = 0;
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		lineno++;
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "bstshape: line %d: bad number\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (lineno > MAXN) {
prog: 			fprintf(stderr, "bstshape: too many numbers\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (insert(&root, x) != 0) {
prog: 			fprintf(stderr, "bstshape: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 	}
prog: 	if (status == 0) {
prog: 		show(root, 0);
prog: 		printf("nodes %zu height %zu\n", count(root), height(root));
prog: 	}
prog: 	free_tree(root);
prog: 	return status;
prog: }
case: printf '5\n3\n8\n1\n4\n9\n' | bstshape
case: printf '1\n2\n3\n' | bstshape
case: printf '2\n2\n2\n' | bstshape; bstshape </dev/null
case: seq 1 1001 | bstshape 2>&1; echo $?; printf '3\n\n' | bstshape 2>&1; echo $?
hint: print the right child first with depth plus one, then the node with depth times four spaces, then the left; height is 1 plus the taller side
