q: mixout.c -- stdio and raw writes in order
spec: Print each command-line argument on its own line, in argument order,
spec: but alternate how: the first, third, fifth ... with `printf`, the
spec: second, fourth ... with `write(1, ...)`. When standard output is a
spec: pipe or a file the lines must still come out in argument order, not
spec: reordered. No arguments prints nothing. Exit 0.
file: mixout.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <stdio.h>
prog: #include <string.h>
prog: #include <unistd.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	for (int i = 1; i < argc; i++) {
prog: 		if (i % 2 == 1) {
prog: 			printf("%s\n", argv[i]);
prog: 		} else {
prog: 			/* the raw write jumps the queue unless stdio is flushed first */
prog: 			fflush(stdout);
prog: 			size_t n = strlen(argv[i]);
prog: 			if (write(1, argv[i], n) != (ssize_t)n || write(1, "\n", 1) != 1)
prog: 				return 1;
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: mixout a b c d | cat
case: mixout one | cat; mixout x y > mxo; cat mxo
case: mixout; echo $?
hint: printf only fills stdio buffer; push it out with fflush(stdout) before every raw write
