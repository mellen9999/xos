q: fdcopy.c -- copy a file to a new file
spec: `fdcopy SRC DST` copies SRC byte for byte to DST, using `open`, `read`,
spec: `write` and `close`. DST is created with mode 0644 (the umask may
spec: clear bits) or, if it exists, emptied first. Print
spec: `copied N bytes` (N the byte count) and exit 0.
spec:
spec: If SRC and DST are the same file, print `fdcopy: same file` to
spec: standard error and exit 1 before touching either (a truncating open
spec: would destroy it). Compare the device and inode from `stat`. If SRC
spec: cannot be opened print `fdcopy: cannot open SRC`, exit 1, and create
spec: nothing. If DST cannot be created print `fdcopy: cannot create DST`
spec: and exit 1. Any other failure, including a failing `close` of DST,
spec: prints `fdcopy: copy failed` and exits 1. Any other number of arguments
spec: prints `usage: fdcopy SRC DST` and exits 2.
file: fdcopy.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <fcntl.h>
prog: #include <stdio.h>
prog: #include <sys/stat.h>
prog: #include <unistd.h>
prog: 
prog: static int write_all(int fd, const char *buf, size_t n)
prog: {
prog: 	while (n > 0) {
prog: 		ssize_t w = write(fd, buf, n);
prog: 		if (w < 0) {
prog: 			if (errno == EINTR)
prog: 				continue;
prog: 			return -1;
prog: 		}
prog: 		buf += w;
prog: 		n -= (size_t)w;
prog: 	}
prog: 	return 0;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 3) {
prog: 		fprintf(stderr, "usage: fdcopy SRC DST\n");
prog: 		return 2;
prog: 	}
prog: 	int in = open(argv[1], O_RDONLY);
prog: 	if (in < 0) {
prog: 		fprintf(stderr, "fdcopy: cannot open %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	struct stat a, b;
prog: 	if (fstat(in, &a) == 0 && stat(argv[2], &b) == 0
prog: 	    && a.st_dev == b.st_dev && a.st_ino == b.st_ino) {
prog: 		fprintf(stderr, "fdcopy: same file\n");
prog: 		close(in);
prog: 		return 1;
prog: 	}
prog: 	int out = open(argv[2], O_WRONLY | O_CREAT | O_TRUNC, 0644);
prog: 	if (out < 0) {
prog: 		fprintf(stderr, "fdcopy: cannot create %s\n", argv[2]);
prog: 		close(in);
prog: 		return 1;
prog: 	}
prog: 	char buf[4096];
prog: 	size_t total = 0;
prog: 	int status = 1;
prog: 	for (;;) {
prog: 		ssize_t r = read(in, buf, sizeof buf);
prog: 		if (r < 0 && errno == EINTR)
prog: 			continue;
prog: 		if (r < 0)
prog: 			break;
prog: 		if (r == 0) {
prog: 			status = 0;
prog: 			break;
prog: 		}
prog: 		if (write_all(out, buf, (size_t)r) != 0)
prog: 			break;
prog: 		total += (size_t)r;
prog: 	}
prog: 	if (close(out) != 0)
prog: 		status = 1;
prog: 	close(in);
prog: 	if (status != 0) {
prog: 		fprintf(stderr, "fdcopy: copy failed\n");
prog: 		return 1;
prog: 	}
prog: 	printf("copied %zu bytes\n", total);
prog: 	return 0;
prog: }
case: printf 'hello\n' > fc1; fdcopy fc1 fc2; cat fc2
case: printf 'a long old line\n' > fc2; printf 'new\n' > fc1; fdcopy fc1 fc2; cat fc2
case: printf x > fc1; fdcopy fc1 fc1 2>&1; echo $?; cat fc1
case: printf x > fc1; umask 0; rm -f fc3; fdcopy fc1 fc3; stat -c %a fc3
case: awk 'BEGIN { for (i = 0; i < 5000; i++) print "y" }' > fc1; fdcopy fc1 fc2; cmp fc1 fc2 && echo same
case: fdcopy a 2>&1; echo $?; rm -f fc9; fdcopy nothere fc9 2>&1; echo $?; test -e fc9 || echo none
hint: open both, loop read then write-all until read returns 0, then close; compare st_dev and st_ino before the O_TRUNC open
