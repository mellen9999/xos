q: rawcat.c -- cat with raw file descriptors
spec: With no arguments copy standard input to standard output. Otherwise
spec: copy each named file, in order, to standard output. Use `open`,
spec: `read`, `write` and `close` with a 4096-byte buffer; no stdio for the
spec: data. A short `write` must be finished, and EINTR retried.
spec:
spec: A file that cannot be opened prints `rawcat: cannot open NAME` to
spec: standard error; carry on with the rest and exit 1 at the end. Any
spec: read or write failure prints `rawcat: error on NAME` (NAME is `stdin`
spec: when reading standard input) and counts the same way. Exit 0 if
spec: everything copied.
file: rawcat.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <errno.h>
prog: #include <fcntl.h>
prog: #include <stdio.h>
prog: #include <unistd.h>
prog: 
prog: static int write_all(int fd, const char *buf, size_t n)
prog: {
prog: 	while (n > 0) {
prog: 		ssize_t w = write(fd, buf, n);
prog: 		if (w < 0) {
prog: 			if (errno == EINTR)
prog: 				continue;
prog: 			return -1;
prog: 		}
prog: 		buf += w;
prog: 		n -= (size_t)w;
prog: 	}
prog: 	return 0;
prog: }
prog: 
prog: static int copy_fd(int in)
prog: {
prog: 	char buf[4096];
prog: 	for (;;) {
prog: 		ssize_t r = read(in, buf, sizeof buf);
prog: 		if (r < 0) {
prog: 			if (errno == EINTR)
prog: 				continue;
prog: 			return -1;
prog: 		}
prog: 		if (r == 0)
prog: 			return 0;
prog: 		if (write_all(1, buf, (size_t)r) != 0)
prog: 			return -1;
prog: 	}
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	int status = 0;
prog: 	if (argc == 1) {
prog: 		if (copy_fd(0) == 0)
prog: 			return 0;
prog: 		fprintf(stderr, "rawcat: error on stdin\n");
prog: 		return 1;
prog: 	}
prog: 	for (int i = 1; i < argc; i++) {
prog: 		int fd = open(argv[i], O_RDONLY);
prog: 		if (fd < 0) {
prog: 			fprintf(stderr, "rawcat: cannot open %s\n", argv[i]);
prog: 			status = 1;
prog: 			continue;
prog: 		}
prog: 		if (copy_fd(fd) != 0) {
prog: 			fprintf(stderr, "rawcat: error on %s\n", argv[i]);
prog: 			status = 1;
prog: 		}
prog: 		close(fd);
prog: 	}
prog: 	return status;
prog: }
case: printf 'one\ntwo\n' | rawcat
case: printf 'a\n' > rc1; printf 'b' > rc2; rawcat rc1 rc2 rc1
case: printf x > rc1; rawcat nothere rc1 2>&1; echo $?
case: awk 'BEGIN { for (i = 0; i < 5000; i++) print "y" }' > rcbig; rawcat rcbig | wc -c; rawcat rcbig rcbig | wc -c
hint: a copy loop of read into a buffer, then write the n bytes read -- not the buffer size -- inside a loop that handles a short write
