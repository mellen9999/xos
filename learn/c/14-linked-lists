name: linked lists
intro: An array is one block, so inserting in the middle moves everything
intro: after it. A linked list is many small blocks, each holding a value
intro: and a pointer to the next; adding or removing touches only the
intro: neighbours:
intro:
intro:     struct node {
intro:         long val;
intro:         struct node *next;      /* NULL marks the end */
intro:     };
intro:
intro: The list is a pointer to the first node, `head`; NULL is the empty
intro: list. Each node is its own malloc, so check each one and free each
intro: one. Read `next` BEFORE you free -- after free the node is gone:
intro:
intro:     while (n != NULL) {
intro:         struct node *next = n->next;
intro:         free(n);
intro:         n = next;
intro:     }
intro:
intro: A function that may change the head (push, delete the first node)
intro: cannot do it through a copy, so it takes `struct node **head`, the
intro: address of the caller's pointer. Better: walk with a pointer to the
intro: LINK you stand on, not to the node:
intro:
intro:     struct node **pp = head;
intro:     while (*pp != NULL && (*pp)->val < val)
intro:         pp = &(*pp)->next;
intro:     n->next = *pp;      /* new node points at what was there */
intro:     *pp = n;            /* and the link now points at it */
intro:
intro: `*pp` is whichever pointer holds the current node -- `head` itself
intro: or some node's `next` -- so insert and delete are the same code at
intro: the front, the middle and the end. No head special case.
intro: To delete: `struct node *gone = *pp; *pp = gone->next; free(gone);`
intro: and do NOT advance pp: the next node has slid into `*pp`.
intro:
intro: Reverse in place by turning each `next` around: keep prev, cur, and
intro: the next you saved before overwriting. A list costs a malloc per
intro: item and a cache miss per step; use one when you insert and remove
intro: a lot, not as plain storage.
---
q: listcmd.c -- a list you drive by commands
spec: Keeps a singly linked list of `long` values, one malloc per node,
spec: and runs commands from standard input, one per line. Empty lines are
spec: skipped (they still count in line numbers). Spaces after a command
spec: with no argument change nothing (`pop ` is `pop`).
spec:
spec: `push N` puts N at the front. `add N` puts it at the end. `pop`
spec: removes the front. `rev` reverses the list in place by relinking
spec: (no new nodes). `show` prints the values in order, separated by single
spec: spaces, inside square brackets, then a newline: `[2 1 3]`, and `[]`
spec: when empty. `count` prints how many nodes there are.
spec:
spec: The first failing command stops the run: print `listcmd: line L:
spec: MESSAGE` to standard error, free the list, exit 1. Messages:
spec: `unknown command`; `bad number` (N missing, not a whole number, or
spec: too big for a long); `bad argument` (pop, rev, show or count given
spec: an argument); `list empty` (pop on an empty list). End of input
spec: frees the list and exits 0. Take the head by `struct node **` so no
spec: function special-cases the first node.
file: listcmd.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: struct node {
prog: 	long val;
prog: 	struct node *next;
prog: };
prog: 
prog: static struct node *node_new(long val, struct node *next)
prog: {
prog: 	struct node *n = malloc(sizeof *n);
prog: 	if (n != NULL) {
prog: 		n->val = val;
prog: 		n->next = next;
prog: 	}
prog: 	return n;
prog: }
prog: 
prog: static int push(struct node **head, long val)
prog: {
prog: 	struct node *n = node_new(val, *head);
prog: 	if (n == NULL)
prog: 		return -1;
prog: 	*head = n;
prog: 	return 0;
prog: }
prog: 
prog: static int append(struct node **head, long val)
prog: {
prog: 	struct node **pp = head;
prog: 	while (*pp != NULL)
prog: 		pp = &(*pp)->next;
prog: 	struct node *n = node_new(val, NULL);
prog: 	if (n == NULL)
prog: 		return -1;
prog: 	*pp = n;
prog: 	return 0;
prog: }
prog: 
prog: static void pop(struct node **head)
prog: {
prog: 	struct node *gone = *head;
prog: 	*head = gone->next;
prog: 	free(gone);
prog: }
prog: 
prog: static void reverse(struct node **head)
prog: {
prog: 	struct node *prev = NULL, *cur = *head;
prog: 	while (cur != NULL) {
prog: 		struct node *next = cur->next;
prog: 		cur->next = prev;
prog: 		prev = cur;
prog: 		cur = next;
prog: 	}
prog: 	*head = prev;
prog: }
prog: 
prog: static void show(const struct node *n)
prog: {
prog: 	putchar('[');
prog: 	for (; n != NULL; n = n->next)
prog: 		printf(n->next != NULL ? "%ld " : "%ld", n->val);
prog: 	puts("]");
prog: }
prog: 
prog: static size_t count(const struct node *n)
prog: {
prog: 	size_t c = 0;
prog: 	for (; n != NULL; n = n->next)
prog: 		c++;
prog: 	return c;
prog: }
prog: 
prog: static void free_all(struct node *n)
prog: {
prog: 	while (n != NULL) {
prog: 		struct node *next = n->next;
prog: 		free(n);
prog: 		n = next;
prog: 	}
prog: }
prog: 
prog: static bool parse_num(const char *s, long *out)
prog: {
prog: 	if (s == NULL)
prog: 		return false;
prog: 	char *end;
prog: 	errno = 0;
prog: 	*out = strtol(s, &end, 10);
prog: 	return errno == 0 && end != s && *end == '\0';
prog: }
prog: 
prog: static bool is(const char *cmd, const char *name)
prog: {
prog: 	return strcmp(cmd, name) == 0;
prog: }
prog: 
prog: /* run one command; return NULL, or the error message */
prog: static const char *run(struct node **head, char *line)
prog: {
prog: 	char *arg = strchr(line, ' ');
prog: 	if (arg != NULL) {
prog: 		*arg++ = '\0';
prog: 		while (*arg == ' ')
prog: 			arg++;
prog: 		if (*arg == '\0')
prog: 			arg = NULL;
prog: 	}
prog: 
prog: 	if (is(line, "push") || is(line, "add")) {
prog: 		long x;
prog: 		if (!parse_num(arg, &x))
prog: 			return "bad number";
prog: 		int rc = is(line, "push") ? push(head, x) : append(head, x);
prog: 		return rc != 0 ? "out of memory" : NULL;
prog: 	}
prog: 	if (!is(line, "pop") && !is(line, "rev") && !is(line, "show") &&
prog: 		!is(line, "count"))
prog: 		return "unknown command";
prog: 	if (arg != NULL)
prog: 		return "bad argument";
prog: 
prog: 	if (is(line, "pop")) {
prog: 		if (*head == NULL)
prog: 			return "list empty";
prog: 		pop(head);
prog: 	} else if (is(line, "rev")) {
prog: 		reverse(head);
prog: 	} else if (is(line, "show")) {
prog: 		show(*head);
prog: 	} else {
prog: 		printf("%zu\n", count(*head));
prog: 	}
prog: 	return NULL;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct node *head = NULL;
prog: 	int status = 0;
prog: 	char line[128];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 		if (line[0] == '\0')
prog: 			continue;
prog: 		const char *err = run(&head, line);
prog: 		if (err != NULL) {
prog: 			fprintf(stderr, "listcmd: line %d: %s\n", lineno, err);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 	}
prog: 	free_all(head);
prog: 	return status;
prog: }
case: printf 'push 1\npush 2\nadd 3\nshow\n' | listcmd
case: printf 'add 1\nadd 2\nadd 3\nrev\nshow\npop\nshow\ncount\n' | listcmd
case: printf 'show\nrev\ncount\n' | listcmd
case: printf 'push 1\npop\npop\n' | listcmd 2>&1; echo $?
case: for p in push 'push x' 'push 9999999999999999999999' 'show 1' jump; do printf '%s\n' "$p" | listcmd 2>&1; echo $?; done
hint: append walks a pointer to the link, starting at head, until the link holds NULL, then stores the new node there
