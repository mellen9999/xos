q: lprune.c -- delete nodes by rule
spec: Takes one argument, RULE. Reads whole numbers from standard input,
spec: one per line, into a linked list in input order, deletes the nodes
spec: the rule names, and prints what is left, one per line.
spec:
spec: `even` deletes even numbers, `odd` odd ones (a negative odd number
spec: is odd), `neg` numbers below 0, and `dup` any node whose value
spec: already appears in an EARLIER node: it keeps the first of each.
spec:
spec: Look the rule up in a table of function pointers, and delete with a
spec: pointer to the link so that the first node, a run of adjacent
spec: matches and the last node need no special cases. Free every node,
spec: kept or deleted, before you exit.
spec:
spec: A bad line prints `lprune: line L: bad number` to standard error,
spec: nothing to standard output, exit 1. Not exactly one argument prints
spec: `usage: lprune RULE`, an unknown RULE prints `lprune: unknown rule
spec: NAME`, both to standard error, exit 2. If nothing is left print
spec: nothing and exit 0.
file: lprune.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: struct node {
prog: 	long val;
prog: 	struct node *next;
prog: };
prog: 
prog: typedef bool (*dropfn)(const struct node *head, const struct node *n);
prog: 
prog: static bool drop_even(const struct node *head, const struct node *n)
prog: {
prog: 	(void)head;
prog: 	return n->val % 2 == 0;
prog: }
prog: 
prog: static bool drop_odd(const struct node *head, const struct node *n)
prog: {
prog: 	(void)head;
prog: 	return n->val % 2 != 0;
prog: }
prog: 
prog: static bool drop_neg(const struct node *head, const struct node *n)
prog: {
prog: 	(void)head;
prog: 	return n->val < 0;
prog: }
prog: 
prog: /* true when an earlier node already holds this value */
prog: static bool drop_dup(const struct node *head, const struct node *n)
prog: {
prog: 	for (const struct node *p = head; p != n; p = p->next)
prog: 		if (p->val == n->val)
prog: 			return true;
prog: 	return false;
prog: }
prog: 
prog: static const struct {
prog: 	const char *name;
prog: 	dropfn fn;
prog: } rules[] = {
prog: 	{ "even", drop_even }, { "odd", drop_odd },
prog: 	{ "neg", drop_neg },   { "dup", drop_dup },
prog: };
prog: 
prog: static void prune(struct node **head, dropfn drop)
prog: {
prog: 	struct node **pp = head;
prog: 	while (*pp != NULL) {
prog: 		if (drop(*head, *pp)) {
prog: 			struct node *gone = *pp;
prog: 			*pp = gone->next;       /* the next node slides into *pp */
prog: 			free(gone);
prog: 		} else {
prog: 			pp = &(*pp)->next;
prog: 		}
prog: 	}
prog: }
prog: 
prog: static void free_all(struct node *n)
prog: {
prog: 	while (n != NULL) {
prog: 		struct node *next = n->next;
prog: 		free(n);
prog: 		n = next;
prog: 	}
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: lprune RULE\n");
prog: 		return 2;
prog: 	}
prog: 	dropfn drop = NULL;
prog: 	for (size_t i = 0; i < sizeof rules / sizeof *rules; i++)
prog: 		if (strcmp(argv[1], rules[i].name) == 0)
prog: 			drop = rules[i].fn;
prog: 	if (drop == NULL) {
prog: 		fprintf(stderr, "lprune: unknown rule %s\n", argv[1]);
prog: 		return 2;
prog: 	}
prog: 
prog: 	struct node *head = NULL, **tail = &head;
prog: 	int status = 0;
prog: 	char line[64];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "lprune: line %d: bad number\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		struct node *n = malloc(sizeof *n);
prog: 		if (n == NULL) {
prog: 			fprintf(stderr, "lprune: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		*n = (struct node){ .val = x };
prog: 		*tail = n;
prog: 		tail = &n->next;
prog: 	}
prog: 
prog: 	if (status == 0) {
prog: 		prune(&head, drop);
prog: 		for (const struct node *n = head; n != NULL; n = n->next)
prog: 			printf("%ld\n", n->val);
prog: 	}
prog: 	free_all(head);
prog: 	return status;
prog: }
case: printf '1\n2\n3\n4\n' | lprune even
case: printf '2\n4\n5\n6\n' | lprune even
case: printf '5\n3\n5\n5\n7\n3\n' | lprune dup
case: printf '3\n-1\n-2\n0\n' | lprune neg; printf '1\n-3\n5\n' | lprune odd; echo $?
case: lprune 2>&1; echo $?; lprune bogus </dev/null 2>&1; echo $?; printf '1\nz\n' | lprune dup 2>&1; echo $?
hint: after a delete leave the walking pointer where it is, since the next node has slid into the link; only step forward when you keep a node
