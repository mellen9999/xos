q: sortins.c -- sorted insertion, with counts
spec: Reads whole numbers from standard input, one per line, and keeps
spec: them in a sorted singly linked list: each new number is inserted at
spec: its place, not sorted afterwards. A number already in the list does
spec: not get a second node; its node counts how many times it was seen.
spec:
spec: With no argument print every number, ascending, one per line,
spec: repeated as often as it was read. With `-u` print each distinct
spec: number once. With `-c` print `COUNT VALUE` for each distinct number
spec: (like `uniq -c`, but sorted and without padding). Values span the
spec: full `long` range. Free the list before you exit.
spec:
spec: A bad line (blank included) prints `sortins: line L: bad number`
spec: to standard error, nothing to standard output, exit 1. Any other
spec: arguments print `usage: sortins [OPTION]` to standard error and
spec: exit 2. Empty input prints nothing and exits 0.
file: sortins.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: struct node {
prog: 	long val;
prog: 	size_t count;
prog: 	struct node *next;
prog: };
prog: 
prog: /* keep the list sorted; an equal value bumps the count of its node */
prog: static int insert(struct node **head, long val)
prog: {
prog: 	struct node **pp = head;
prog: 	while (*pp != NULL && (*pp)->val < val)
prog: 		pp = &(*pp)->next;
prog: 	if (*pp != NULL && (*pp)->val == val) {
prog: 		(*pp)->count++;
prog: 		return 0;
prog: 	}
prog: 	struct node *n = malloc(sizeof *n);
prog: 	if (n == NULL)
prog: 		return -1;
prog: 	*n = (struct node){ .val = val, .count = 1, .next = *pp };
prog: 	*pp = n;
prog: 	return 0;
prog: }
prog: 
prog: static void free_all(struct node *n)
prog: {
prog: 	while (n != NULL) {
prog: 		struct node *next = n->next;
prog: 		free(n);
prog: 		n = next;
prog: 	}
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	bool uniq = false, counts = false;
prog: 	if (argc == 2 && strcmp(argv[1], "-u") == 0)
prog: 		uniq = true;
prog: 	else if (argc == 2 && strcmp(argv[1], "-c") == 0)
prog: 		counts = true;
prog: 	else if (argc != 1) {
prog: 		fprintf(stderr, "usage: sortins [OPTION]\n");
prog: 		return 2;
prog: 	}
prog: 
prog: 	struct node *head = NULL;
prog: 	int status = 0;
prog: 	char line[64];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			fprintf(stderr, "sortins: line %d: bad number\n", lineno);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (insert(&head, x) != 0) {
prog: 			fprintf(stderr, "sortins: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 	}
prog: 
prog: 	if (status == 0) {
prog: 		for (const struct node *n = head; n != NULL; n = n->next) {
prog: 			if (counts)
prog: 				printf("%zu %ld\n", n->count, n->val);
prog: 			else
prog: 				for (size_t i = 0; i < (uniq ? 1 : n->count); i++)
prog: 					printf("%ld\n", n->val);
prog: 		}
prog: 	}
prog: 	free_all(head);
prog: 	return status;
prog: }
case: printf '3\n1\n2\n1\n' | sortins
case: printf '3\n1\n2\n1\n3\n3\n' | sortins -u
case: printf '3\n1\n2\n1\n3\n3\n' | sortins -c
case: printf '5\n9223372036854775807\n-9223372036854775808\n0\n' | sortins
case: sortins </dev/null; echo $?; sortins -x 2>&1; echo $?; printf '1\nx\n' | sortins 2>&1; echo $?
hint: walk with a pointer to the link while the node's value is smaller; if the node there is equal bump its count, else link a new node in front of it
