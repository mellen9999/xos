q: lmerge.c -- merge two sorted lists
spec: Standard input holds two lists of whole numbers, one per line, each
spec: ascending (equal neighbours are fine). A single empty line separates
spec: them. With no empty line the whole input is the first list and the
spec: second is empty; a leading empty line makes the first list empty.
spec:
spec: Build each list as a linked list, then merge by RELINKING the
spec: existing nodes into one ascending list -- the merge step of merge
spec: sort, with no new allocation. Print the result one number per line,
spec: and free the nodes before you exit. Empty input prints nothing.
spec:
spec: A line that is not a whole number, or a second empty line, prints
spec: `lmerge: line L: bad number`; a number smaller than the one before
spec: it in the same list prints `lmerge: line L: not ascending` (L counts
spec: from 1). Either way: standard error, nothing to standard output,
spec: free what you built, exit 1.
file: lmerge.c
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: struct node {
prog: 	long val;
prog: 	struct node *next;
prog: };
prog: 
prog: /* relink the nodes of two ascending lists into one; no allocation */
prog: static struct node *merge(struct node *a, struct node *b)
prog: {
prog: 	struct node *head = NULL, **tail = &head;
prog: 	while (a != NULL && b != NULL) {
prog: 		struct node **from = b->val < a->val ? &b : &a;
prog: 		*tail = *from;
prog: 		*from = (*from)->next;
prog: 		tail = &(*tail)->next;
prog: 	}
prog: 	*tail = a != NULL ? a : b;
prog: 	return head;
prog: }
prog: 
prog: static void free_all(struct node *n)
prog: {
prog: 	while (n != NULL) {
prog: 		struct node *next = n->next;
prog: 		free(n);
prog: 		n = next;
prog: 	}
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct node *list[2] = { NULL, NULL };
prog: 	struct node **tail[2] = { &list[0], &list[1] };
prog: 	int cur = 0;
prog: 	long last = 0;
prog: 	const char *err = NULL;
prog: 	int lineno = 0;
prog: 	char line[64];
prog: 
prog: 	while (err == NULL && fgets(line, sizeof line, stdin) != NULL) {
prog: 		lineno++;
prog: 		if (strcmp(line, "\n") == 0 && cur == 0) {
prog: 			cur = 1;
prog: 			continue;
prog: 		}
prog: 		char *end;
prog: 		errno = 0;
prog: 		long x = strtol(line, &end, 10);
prog: 		if (errno != 0 || end == line || (*end != '\n' && *end != '\0')) {
prog: 			err = "bad number";
prog: 		} else if (list[cur] != NULL && x < last) {
prog: 			err = "not ascending";
prog: 		} else {
prog: 			struct node *n = malloc(sizeof *n);
prog: 			if (n == NULL) {
prog: 				err = "out of memory";
prog: 			} else {
prog: 				*n = (struct node){ .val = x };
prog: 				*tail[cur] = n;
prog: 				tail[cur] = &n->next;
prog: 				last = x;
prog: 			}
prog: 		}
prog: 	}
prog: 
prog: 	int status = 0;
prog: 	if (err != NULL) {
prog: 		fprintf(stderr, "lmerge: line %d: %s\n", lineno, err);
prog: 		status = 1;
prog: 		free_all(list[0]);
prog: 		free_all(list[1]);
prog: 	} else {
prog: 		struct node *all = merge(list[0], list[1]);
prog: 		for (const struct node *n = all; n != NULL; n = n->next)
prog: 			printf("%ld\n", n->val);
prog: 		free_all(all);
prog: 	}
prog: 	return status;
prog: }
case: printf '1\n4\n9\n\n2\n3\n10\n' | lmerge
case: printf '1\n1\n\n1\n' | lmerge; printf '1\n2\n' | lmerge; printf '\n5\n6\n' | lmerge; printf '5\n\n' | lmerge
case: printf '1\n3\n2\n' | lmerge 2>&1; echo $?
case: printf '1\n\n2\n\n3\n' | lmerge 2>&1; echo $?; printf '1\n\n3\n2\n' | lmerge 2>&1; echo $?
case: lmerge </dev/null; echo $?; printf '1\nx\n' | lmerge 2>&1; echo $?
hint: keep a pointer to the last link of the result; each step moves the smaller front node of the two lists onto it, and at the end the link takes whichever list still has nodes
