q: big.c -- when int is too small
spec: Print exactly these six lines. Use `int32_t`, `uint32_t`, `int64_t`
spec: and `uint64_t` with the matching `PRI` macros, taking `INT32_MAX`,
spec: `INT32_MIN`, `UINT32_MAX`, `INT64_MAX` and `UINT64_MAX` from
spec: `stdint.h` rather than typing them:
spec:
spec: `int32 max 2147483647`
spec: `int32 min -2147483648`
spec: `uint32 max 4294967295`
spec: `int64 max 9223372036854775807`
spec: `uint64 max 18446744073709551615`
spec: `3000000000 * 3 = 9000000000`
spec:
spec: The last product must be computed in an `int64_t`; written with plain
spec: ints it overflows, which is undefined behaviour.
file: big.c
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	int64_t product = INT64_C(3000000000) * 3;
prog: 
prog: 	printf("int32 max %" PRId32 "\n", INT32_MAX);
prog: 	printf("int32 min %" PRId32 "\n", INT32_MIN);
prog: 	printf("uint32 max %" PRIu32 "\n", UINT32_MAX);
prog: 	printf("int64 max %" PRId64 "\n", INT64_MAX);
prog: 	printf("uint64 max %" PRIu64 "\n", UINT64_MAX);
prog: 	printf("3000000000 * 3 = %" PRId64 "\n", product);
prog: 	return 0;
prog: }
case: big
case: big | head -n 3
case: big | tail -n 1
case: big; echo $?
hint: the PRI macros sit between two string pieces: "%" PRId64 "\n"
