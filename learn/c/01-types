q: rollover.c -- where numbers wrap
spec: Print exactly these four lines, each computed by the program from
spec: variables, not typed as text:
spec:
spec: `250 + 10 = 4`
spec: `0 - 1 = 4294967295`
spec: `-7 / 2 = -3`
spec: `-7 % 2 = -1`
spec:
spec: The first sum is a `uint8_t` 250 plus 10, stored back into a `uint8_t`.
spec: The second is a `uint32_t` 0 minus 1. The last two use an `int` -7.
spec: Print the `uint32_t` with `PRIu32`.
file: rollover.c
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	uint8_t a = 250;
prog: 	uint8_t b = (uint8_t)(a + 10);
prog: 	uint32_t zero = 0;
prog: 	uint32_t below = zero - 1;
prog: 	int x = -7;
prog: 
prog: 	printf("250 + 10 = %d\n", b);
prog: 	printf("0 - 1 = %" PRIu32 "\n", below);
prog: 	printf("-7 / 2 = %d\n", x / 2);
prog: 	printf("-7 %% 2 = %d\n", x % 2);
prog: 	return 0;
prog: }
case: rollover
case: rollover | head -n 1
case: rollover; echo $?
hint: a + 10 is an int and reads 260 -- store it back into a uint8_t before printing
