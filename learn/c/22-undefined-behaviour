q: bbuf.c -- a buffer that checks every index
spec: Keep a buffer of 8 ints, empty at first, behind functions that
spec: check every access. Read commands from standard input, one per line:
spec:
spec:   `push V`   append V; print `ok`, or `full` if 8 are already stored
spec:   `get I`    print the int at index I; `range` if I is below 0 or not
spec:              less than the count stored
spec:   `set I V`  overwrite index I and print `ok`; `range` likewise
spec:   `len`      print how many are stored
spec:
spec: I is a whole decimal number from -1000000 to 1000000; V is a whole
spec: decimal number that fits in an int. Anything else -- a missing or bad
spec: number, extra words, an unknown command -- prints `?`. Exit 0.
file: bbuf.c
prog: #include <errno.h>
prog: #include <limits.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define CAP 8
prog: 
prog: struct buf {
prog: 	int data[CAP];
prog: 	size_t len;
prog: };
prog: 
prog: static bool buf_push(struct buf *b, int v)
prog: {
prog: 	if (b->len == CAP)
prog: 		return false;
prog: 	b->data[b->len++] = v;
prog: 	return true;
prog: }
prog: 
prog: static bool buf_get(const struct buf *b, long i, int *out)
prog: {
prog: 	if (i < 0 || (unsigned long)i >= b->len)
prog: 		return false;
prog: 	*out = b->data[i];
prog: 	return true;
prog: }
prog: 
prog: static bool buf_set(struct buf *b, long i, int v)
prog: {
prog: 	if (i < 0 || (unsigned long)i >= b->len)
prog: 		return false;
prog: 	b->data[i] = v;
prog: 	return true;
prog: }
prog: 
prog: /* a whole decimal number inside lo..hi; sscanf cannot say "too big" safely */
prog: static bool num(const char *s, long lo, long hi, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (end == s || *end != '\0' || errno == ERANGE || v < lo || v > hi)
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: /* split a line into at most four words, in place; returns how many */
prog: static int words(char *line, char **w)
prog: {
prog: 	int n = 0;
prog: 	for (char *t = strtok(line, " \n"); t != NULL && n < 4; t = strtok(NULL, " \n"))
prog: 		w[n++] = t;
prog: 	return n;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct buf b = { .len = 0 };
prog: 	char line[64];
prog: 
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		char *w[4];
prog: 		long i, v;
prog: 		int n = words(line, w);
prog: 		if (n == 2 && strcmp(w[0], "push") == 0 && num(w[1], INT_MIN, INT_MAX, &v)) {
prog: 			puts(buf_push(&b, (int)v) ? "ok" : "full");
prog: 		} else if (n == 2 && strcmp(w[0], "get") == 0 && num(w[1], -1000000, 1000000, &i)) {
prog: 			int out;
prog: 			if (buf_get(&b, i, &out))
prog: 				printf("%d\n", out);
prog: 			else
prog: 				puts("range");
prog: 		} else if (n == 3 && strcmp(w[0], "set") == 0 && num(w[1], -1000000, 1000000, &i)
prog: 		    && num(w[2], INT_MIN, INT_MAX, &v)) {
prog: 			puts(buf_set(&b, i, (int)v) ? "ok" : "range");
prog: 		} else if (n == 1 && strcmp(w[0], "len") == 0) {
prog: 			printf("%zu\n", b.len);
prog: 		} else {
prog: 			puts("?");
prog: 		}
prog: 	}
prog: 	return 0;
prog: }
case: printf 'push 5\npush 7\nlen\nget 0\nget 1\nget 2\nget -1\n' | bbuf
case: printf 'push 1\nset 0 9\nset 1 9\nget 0\nset -1 2\nset 0 -4\nget 0\n' | bbuf
case: awk 'BEGIN { for (i = 0; i < 10; i++) print "push 3" }' | bbuf
case: printf 'push\npush x\nget\nfoo 1\nlen extra\npush 2147483648\nget 5000000\n' | bbuf
hint: a struct with the array and a length; one function per operation that tests the index against the length first and reports failure instead of touching memory
