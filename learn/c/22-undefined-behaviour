q: chk64.c -- add, subtract and multiply without overflow
spec: `chk64 OP A B` where OP is `add`, `sub` or `mul` and A and B are whole
spec: decimal numbers that fit in a signed 64-bit integer. Print the result
spec: in decimal and exit 0. If the true result does not fit in 64 bits,
spec: print `overflow` and exit 1. Decide before computing: never let a
spec: signed operation overflow.
spec:
spec: A wrong argument count or an OP that is not one of the three prints
spec: `usage: chk64 OP A B` to standard error and exits 2. A number that is
spec: not whole, or does not fit in 64 bits, prints `chk64: bad number` to
spec: standard error and exits 2.
file: chk64.c
prog: #include <errno.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: static int parse(const char *s, int64_t *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long long v = strtoll(s, &end, 10);
prog: 	if (end == s || *end != '\0' || errno == ERANGE)
prog: 		return -1;
prog: 	*out = v;
prog: 	return 0;
prog: }
prog: 
prog: /* each returns 1 and fills *r when the result fits, 0 when it would overflow */
prog: static int add_ok(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b))
prog: 		return 0;
prog: 	*r = a + b;
prog: 	return 1;
prog: }
prog: 
prog: static int sub_ok(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if ((b > 0 && a < INT64_MIN + b) || (b < 0 && a > INT64_MAX + b))
prog: 		return 0;
prog: 	*r = a - b;
prog: 	return 1;
prog: }
prog: 
prog: static int mul_ok(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if (a > 0) {
prog: 		if (b > 0 ? a > INT64_MAX / b : b < INT64_MIN / a)
prog: 			return 0;
prog: 	} else {
prog: 		if (b > 0 ? a < INT64_MIN / b : (a != 0 && b < INT64_MAX / a))
prog: 			return 0;
prog: 	}
prog: 	*r = a * b;
prog: 	return 1;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	int64_t a, b, r;
prog: 	if (argc != 4 || (strcmp(argv[1], "add") != 0 && strcmp(argv[1], "sub") != 0
prog: 	    && strcmp(argv[1], "mul") != 0)) {
prog: 		fprintf(stderr, "usage: chk64 OP A B\n");
prog: 		return 2;
prog: 	}
prog: 	if (parse(argv[2], &a) != 0 || parse(argv[3], &b) != 0) {
prog: 		fprintf(stderr, "chk64: bad number\n");
prog: 		return 2;
prog: 	}
prog: 	int ok;
prog: 	switch (argv[1][0]) {
prog: 	case 'a': ok = add_ok(a, b, &r); break;
prog: 	case 's': ok = sub_ok(a, b, &r); break;
prog: 	default:  ok = mul_ok(a, b, &r); break;
prog: 	}
prog: 	if (!ok) {
prog: 		puts("overflow");
prog: 		return 1;
prog: 	}
prog: 	printf("%lld\n", (long long)r);
prog: 	return 0;
prog: }
case: chk64 add 9223372036854775807 1; echo $?; chk64 add 9223372036854775806 1; chk64 add -9223372036854775808 -1; echo $?
case: chk64 sub -9223372036854775808 1; echo $?; chk64 sub 0 -9223372036854775808; echo $?; chk64 sub -1 -9223372036854775808
case: chk64 mul 4294967296 2147483648; echo $?; chk64 mul 4294967296 2147483647; chk64 mul -3 4
case: chk64 mul -9223372036854775808 -1; echo $?; chk64 mul -9223372036854775808 1; chk64 mul 0 -9223372036854775808
case: chk64 add 1 x 2>&1; echo $?; chk64 add 99999999999999999999 1 2>&1; echo $?; chk64 div 1 2 2>&1; echo $?
hint: for add, compare a against INT64_MAX - b when b is positive and INT64_MIN - b when negative; for mul split on the signs of a and b and divide the limit by one of them
