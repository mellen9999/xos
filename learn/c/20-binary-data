q: recread.c -- read a checked binary record file
spec: Standard input holds a file in this format, all in bytes:
spec:
spec:   4 bytes   the text XREC
spec:   1 byte    version, must be 1
spec:   2 bytes   count of records, big-endian (at most 100)
spec:   count x 6 each record: 4 bytes id (little-endian), then 2 bytes
spec:             score (little-endian)
spec:   4 bytes   CRC-32 of every byte before it, big-endian
spec:
spec: For a good file print one line per record, `record I: id=ID score=S`
spec: (I counts from 0, both numbers in decimal), then `ok COUNT`, and exit
spec: 0. Otherwise print `recread: WHY` to standard error, nothing to
spec: standard output, and exit 1. Check in this order: `bad magic` (fewer
spec: than 4 bytes, or not XREC), `truncated` (fewer than 7 bytes), then
spec: `unsupported version`, `too many records`, `truncated` (shorter than
spec: the header and count say), `trailing bytes` (longer), `bad checksum`.
spec:
spec: The CRC-32 is the one zip and png use. Start with 0xffffffff; for each
spec: byte xor it into the low bits, then 8 times: if the lowest bit is 1,
spec: shift right one and xor 0xedb88320, else just shift right. The final
spec: value is the complement (~) of what is left.
file: recread.c
need: - fread the whole input into one buffer; make it 1 byte bigger
need:   than the largest good file, so extra bytes show up
need: - memcmp(buf, "XREC", 4) == 0 checks the magic bytes
need: - big-endian: first byte high; little-endian: first byte low
need: - widen before shifting: (uint32_t)b[0] << 24
need: - check the length before you trust the count
need: - per byte, 8 times: crc & 1 ? crc >> 1 ^ 0xedb88320u : crc >> 1
need: - errors: fprintf(stderr, ...), nothing on stdout, return 1
need: - print a uint32_t as (unsigned long) with %lu
start: #include <inttypes.h>
start: #include <stdint.h>
start: #include <stdio.h>
start: #include <string.h>
start: 
start: #define MAXREC 100
start: #define RECSIZE 6
start: 
start: static int fail(const char *why)
start: {
start: 	fprintf(stderr, "recread: %s\n", why);
start: 	return 1;
start: }
start: 
start: int main(void)
start: {
start: 	unsigned char buf[7 + MAXREC * RECSIZE + 4 + 1];
start: 	size_t n = fread(buf, 1, sizeof buf, stdin);
start: 	if (n < 4 || memcmp(buf, "XREC", 4) != 0)
start: 		return fail("bad magic");
start: 	/* the other checks, in the order the spec gives */
start: 	return 0;
start: }
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: #define MAXREC 100
prog: #define RECSIZE 6
prog: 
prog: static uint32_t crc32_bits(const unsigned char *p, size_t n)
prog: {
prog: 	uint32_t crc = 0xffffffffu;
prog: 	for (size_t i = 0; i < n; i++) {
prog: 		crc ^= p[i];
prog: 		for (int k = 0; k < 8; k++)
prog: 			crc = crc & 1 ? crc >> 1 ^ 0xedb88320u : crc >> 1;
prog: 	}
prog: 	return ~crc;
prog: }
prog: 
prog: static int fail(const char *why)
prog: {
prog: 	fprintf(stderr, "recread: %s\n", why);
prog: 	return 1;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	unsigned char buf[7 + MAXREC * RECSIZE + 4 + 1]; /* one spare byte to see trailing junk */
prog: 	size_t n = fread(buf, 1, sizeof buf, stdin);
prog: 
prog: 	if (n < 4 || memcmp(buf, "XREC", 4) != 0)
prog: 		return fail("bad magic");
prog: 	if (n < 7)
prog: 		return fail("truncated");
prog: 	if (buf[4] != 1)
prog: 		return fail("unsupported version");
prog: 	unsigned count = (unsigned)buf[5] << 8 | buf[6];
prog: 	if (count > MAXREC)
prog: 		return fail("too many records");
prog: 	size_t body = 7 + (size_t)count * RECSIZE;
prog: 	if (n < body + 4)
prog: 		return fail("truncated");
prog: 	if (n > body + 4)
prog: 		return fail("trailing bytes");
prog: 
prog: 	uint32_t want = (uint32_t)buf[body] << 24 | (uint32_t)buf[body + 1] << 16
prog: 	    | (uint32_t)buf[body + 2] << 8 | buf[body + 3];
prog: 	if (crc32_bits(buf, body) != want)
prog: 		return fail("bad checksum");
prog: 
prog: 	for (unsigned i = 0; i < count; i++) {
prog: 		const unsigned char *r = buf + 7 + (size_t)i * RECSIZE;
prog: 		uint32_t id = (uint32_t)r[3] << 24 | (uint32_t)r[2] << 16 | (uint32_t)r[1] << 8 | r[0];
prog: 		unsigned score = (unsigned)r[5] << 8 | r[4];
prog: 		printf("record %u: id=%lu score=%u\n", i, (unsigned long)id, score);
prog: 	}
prog: 	printf("ok %u\n", count);
prog: 	return 0;
prog: }
