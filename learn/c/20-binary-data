q: adlersum.c -- the Adler-32 checksum
spec: Read every byte of standard input and print its Adler-32 checksum as 8
spec: lowercase hex digits, then exit 0.
spec:
spec: Adler-32 keeps two 16-bit sums, a starting at 1 and b at 0. For each
spec: byte: a = (a + byte) mod 65521, then b = (b + a) mod 65521. The result
spec: is b in the high 16 bits and a in the low 16: b shifted left 16 bits, ORed with a. Empty
spec: input is `00000001`. For `abc` it is `024d0127`.
file: adlersum.c
need: - getchar() gives an int: a byte 0-255, or EOF; keep it in an int
need: - uint32_t a = 1, b = 0;  % is the remainder
need: - take the remainder after EACH addition, not once at the end
need: - b << 16 | a puts b in the high 16 bits
need: - print 8 hex digits: "%08" PRIx32 "\n"  (needs <inttypes.h>)
start: #include <inttypes.h>
start: #include <stdint.h>
start: #include <stdio.h>
start: 
start: int main(void)
start: {
start: 	uint32_t a = 1, b = 0;
start: 	/* for every byte: update a, then b */
start: 	/* print b << 16 | a as 8 hex digits */
start: 	(void)a;
start: 	(void)b;
start: 	return 0;
start: }
prog: #include <inttypes.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	uint32_t a = 1, b = 0;
prog: 	int c;
prog: 	while ((c = getchar()) != EOF) {
prog: 		a = (a + (uint32_t)c) % 65521;
prog: 		b = (b + a) % 65521;
prog: 	}
prog: 	printf("%08" PRIx32 "\n", b << 16 | a);
prog: 	return 0;
prog: }
case: printf 'abc' | adlersum
case: printf '' | adlersum
case: printf '\377\376\375' | adlersum
case: awk 'BEGIN { for (i = 0; i < 10000; i++) print "y" }' | adlersum
hint: read bytes with getchar into an int; take the remainder after each addition, not once at the end
