q: sniff.c -- tell what a file is from its first bytes
spec: Read up to the first 512 bytes of standard input and print one word
spec: for what it is, then exit 0. In this order, the first that matches:
spec:
spec:   `empty`  no bytes at all
spec:   `png`    starts with the bytes 89 50 4e 47 0d 0a 1a 0a
spec:   `gzip`   starts with 1f 8b
spec:   `elf`    starts with 7f 45 4c 46
spec:   `zip`    starts with 50 4b 03 04
spec:   `pdf`    starts with the text %PDF-
spec:   `text`   every byte is printable ASCII (0x20 to 0x7e), tab,
spec:            newline or carriage return
spec:   `data`   anything else
spec:
spec: A file shorter than a signature cannot match it.
file: sniff.c
need: - fread returns how many bytes it got: check n before comparing
need: - memcmp(a, b, len) == 0 means the bytes match
need: - a signature is bytes, not text: 0x89, 'P', 'N', 'G'
need: - table of structs: name, length, bytes; loop over it
need: - sizeof table / sizeof *table is the entry count
need: - text: bytes 0x20-0x7e, tab, newline, return (unsigned char)
start: #include <stdio.h>
start: #include <string.h>
start: 
start: struct magic {
start: 	const char *name;
start: 	size_t len;
start: 	unsigned char bytes[8];
start: };
start: 
start: static const struct magic table[] = {
start: 	{ "png", 8, { 0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a } },
start: 	/* gzip, elf, zip, pdf */
start: };
start: 
start: int main(void)
start: {
start: 	unsigned char buf[512];
start: 	size_t n = fread(buf, 1, sizeof buf, stdin);
start: 	(void)n;
start: 	(void)table;
start: 	/* empty? then each signature, then text, else data */
start: 	return 0;
start: }
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: struct magic {
prog: 	const char *name;
prog: 	size_t len;
prog: 	unsigned char bytes[8];
prog: };
prog: 
prog: static const struct magic table[] = {
prog: 	{ "png", 8, { 0x89, 'P', 'N', 'G', 0x0d, 0x0a, 0x1a, 0x0a } },
prog: 	{ "gzip", 2, { 0x1f, 0x8b } },
prog: 	{ "elf", 4, { 0x7f, 'E', 'L', 'F' } },
prog: 	{ "zip", 4, { 'P', 'K', 3, 4 } },
prog: 	{ "pdf", 5, { '%', 'P', 'D', 'F', '-' } },
prog: };
prog: 
prog: int main(void)
prog: {
prog: 	unsigned char buf[512];
prog: 	size_t n = fread(buf, 1, sizeof buf, stdin);
prog: 	if (n == 0) {
prog: 		puts("empty");
prog: 		return 0;
prog: 	}
prog: 	for (size_t i = 0; i < sizeof table / sizeof *table; i++) {
prog: 		if (n >= table[i].len && memcmp(buf, table[i].bytes, table[i].len) == 0) {
prog: 			puts(table[i].name);
prog: 			return 0;
prog: 		}
prog: 	}
prog: 	for (size_t i = 0; i < n; i++) {
prog: 		unsigned char c = buf[i];
prog: 		int text = (c >= 0x20 && c <= 0x7e) || c == '\n' || c == '\t' || c == '\r';
prog: 		if (!text) {
prog: 			puts("data");
prog: 			return 0;
prog: 		}
prog: 	}
prog: 	puts("text");
prog: 	return 0;
prog: }
case: printf '\211PNG\r\n\032\n\000\000' | sniff
case: printf '\037\213\010\000' | sniff; printf '\177ELF\002\001' | sniff; printf 'PK\003\004zz' | sniff
case: printf '%%PDF-1.4\n' | sniff; printf 'hello\n\tworld\r\n' | sniff
case: printf '\211PNG\r\n' | sniff; printf 'ab\000cd' | sniff; printf '\037' | sniff; printf '\177ELX\n' | sniff
case: printf '' | sniff
hint: a table of name, length and bytes, compared with memcmp only when you have read at least that many bytes
