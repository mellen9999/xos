q: cclass.c -- count kinds of characters
spec: Read all of standard input and print five lines, in this order:
spec: `upper N`, `lower N`, `digit N`, `space N`, `other N`.
spec:
spec: upper is A-Z, lower is a-z, digit is 0-9, space is a blank, a tab
spec: or a newline, other is every remaining byte. Every byte counts in
spec: exactly one class. Empty input gives all zeros.
file: cclass.c
prog: #include <stdio.h>
prog: 
prog: int main(void)
prog: {
prog: 	enum { UPPER, LOWER, DIGIT, SPACE, OTHER, NCLASS };
prog: 	static const char *const names[NCLASS] = {
prog: 		[UPPER] = "upper", [LOWER] = "lower", [DIGIT] = "digit",
prog: 		[SPACE] = "space", [OTHER] = "other",
prog: 	};
prog: 	unsigned long count[NCLASS] = {0};
prog: 	int c;
prog: 
prog: 	while ((c = getchar()) != EOF) {
prog: 		if (c >= 'A' && c <= 'Z')
prog: 			count[UPPER]++;
prog: 		else if (c >= 'a' && c <= 'z')
prog: 			count[LOWER]++;
prog: 		else if (c >= '0' && c <= '9')
prog: 			count[DIGIT]++;
prog: 		else if (c == ' ' || c == '\t' || c == '\n')
prog: 			count[SPACE]++;
prog: 		else
prog: 			count[OTHER]++;
prog: 	}
prog: 	for (int i = 0; i < NCLASS; i++)
prog: 		printf("%s %lu\n", names[i], count[i]);
prog: 	return 0;
prog: }
case: printf 'Hello, World 42\n' | cclass
case: printf '\t-_~' | cclass
case: cclass < /dev/null
hint: one getchar loop, an if/else chain that puts each byte in exactly one class; keep c an int so EOF is not confused with a byte
