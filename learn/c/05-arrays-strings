q: joinargs.c -- join words with a separator
spec: The first argument is a separator, the rest are words. Print the
spec: words joined by the separator, then a newline: `joinargs , a b c`
spec: prints `a,b,c`. No words prints an empty line.
spec:
spec: Append with `snprintf(buf + len, sizeof buf - len, ...)`: `buf + len` is
spec: the address len bytes in. Never pass buf as both the destination and a
spec: `%s` source.
spec:
spec: Build the result in a 32-byte buffer with snprintf (31 characters
spec: fit, the 32nd byte is the NUL). If the result does not fit, print
spec: nothing to standard output, `joinargs: too long` to standard error,
spec: and exit 1. No arguments at all: print `usage: joinargs SEP [WORD...]`
spec: to standard error and exit 2.
file: joinargs.c
prog: #include <stdio.h>
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc < 2) {
prog: 		fprintf(stderr, "usage: joinargs SEP [WORD...]\n");
prog: 		return 2;
prog: 	}
prog: 
prog: 	char buf[32];
prog: 	size_t len = 0;
prog: 	buf[0] = '\0';
prog: 	for (int i = 2; i < argc; i++) {
prog: 		const char *sep = i > 2 ? argv[1] : "";
prog: 		size_t room = sizeof buf - len;
prog: 		int n = snprintf(buf + len, room, "%s%s", sep, argv[i]);
prog: 		if (n < 0 || (size_t)n >= room) {
prog: 			fprintf(stderr, "joinargs: too long\n");
prog: 			return 1;
prog: 		}
prog: 		len += (size_t)n;
prog: 	}
prog: 	printf("%s\n", buf);
prog: 	return 0;
prog: }
case: joinargs , a b c
case: joinargs -
case: joinargs , aaaaaaaaaaaaaaa bbbbbbbbbbbbbbb
case: joinargs , aaaaaaaaaaaaaaaa bbbbbbbbbbbbbbb 2>&1; echo $?
case: joinargs 2>&1; echo $?
hint: snprintf returns the length it wanted -- if that is not less than the room you gave it, it was cut
