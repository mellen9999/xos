q: revline.c -- every line backwards
spec: Read standard input line by line and print each line reversed,
spec: followed by a newline. `abc` becomes `cba`; an empty line stays an
spec: empty line. A last line with no newline at the end is still
spec: reversed and printed with one. Empty input prints nothing.
spec:
spec: Lines are at most 80 characters, not counting the newline.
file: revline.c
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: int main(void)
prog: {
prog: 	char line[82];
prog: 
prog: 	while (fgets(line, sizeof line, stdin) != NULL) {
prog: 		size_t len = strlen(line);
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			len--;
prog: 		for (size_t i = len; i > 0; i--)
prog: 			putchar(line[i - 1]);
prog: 		putchar('\n');
prog: 	}
prog: 	return 0;
prog: }
case: printf 'abc\nhello world\n' | revline
case: printf 'ab' | revline
case: printf 'x\n\ny\n' | revline
case: revline < /dev/null; echo $?
hint: fgets keeps the newline in the buffer -- drop it from the length before you walk backwards
