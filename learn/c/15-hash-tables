q: kvstore.c -- a key-value store on a hash table
spec: Reads commands from standard input, one per line, and keeps keys and
spec: values in a chained hash table you write: FNV-1a on the key, bucket
spec: = hash mod bucket count. Lines are at most 100 characters. Empty
spec: lines are skipped (they still count in line numbers).
spec:
spec: `set KEY VALUE` stores a value (everything after the key and its
spec: spaces, spaces inside included); an existing key is updated, not
spec: duplicated. `get KEY` prints its value. `del KEY` removes it.
spec: `count` prints the number of keys. `dump` prints every `KEY=VALUE`,
spec: sorted by key with strcmp, one per line. `stats` prints
spec: `buckets B items N longest L`, L being the longest chain.
spec:
spec: A key is one to 31 characters with no space; a value is one to 63
spec: characters. The table starts with 4 buckets. Before adding a NEW key
spec: it doubles the buckets (relinking every entry by its new index) if
spec: the new item count times 4 would exceed the bucket count times 3.
spec: Deleting never shrinks the table.
spec:
spec: The first failing command stops the run: `kvstore: line L: MESSAGE`
spec: on standard error, free everything, exit 1. Messages: `unknown
spec: command`; `bad argument` (missing or bad key or value, or an
spec: argument to count, dump or stats); `no such key` (get or del).
spec: End of input frees everything and exits 0.
file: kvstore.c
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define KEYMAX 31
prog: #define VALMAX 63
prog: 
prog: struct entry {
prog: 	struct entry *next;
prog: 	char key[KEYMAX + 1];
prog: 	char val[VALMAX + 1];
prog: };
prog: 
prog: struct table {
prog: 	struct entry **bucket;
prog: 	size_t nbuckets;
prog: 	size_t items;
prog: };
prog: 
prog: static uint32_t fnv1a(const char *s)
prog: {
prog: 	uint32_t h = 2166136261u;
prog: 	for (const unsigned char *p = (const unsigned char *)s; *p != '\0'; p++) {
prog: 		h ^= *p;
prog: 		h *= 16777619u;
prog: 	}
prog: 	return h;
prog: }
prog: 
prog: static struct entry **slot(const struct table *t, const char *key)
prog: {
prog: 	return &t->bucket[fnv1a(key) % t->nbuckets];
prog: }
prog: 
prog: /* the link that points at key's entry, or at the NULL that ends its chain */
prog: static struct entry **find(const struct table *t, const char *key)
prog: {
prog: 	struct entry **pp = slot(t, key);
prog: 	while (*pp != NULL && strcmp((*pp)->key, key) != 0)
prog: 		pp = &(*pp)->next;
prog: 	return pp;
prog: }
prog: 
prog: /* double the bucket array and relink every entry by its NEW index */
prog: static int grow(struct table *t)
prog: {
prog: 	size_t nb = t->nbuckets * 2;
prog: 	struct entry **nbk = calloc(nb, sizeof *nbk);
prog: 	if (nbk == NULL)
prog: 		return -1;
prog: 	for (size_t i = 0; i < t->nbuckets; i++) {
prog: 		struct entry *e = t->bucket[i];
prog: 		while (e != NULL) {
prog: 			struct entry *next = e->next;
prog: 			struct entry **to = &nbk[fnv1a(e->key) % nb];
prog: 			e->next = *to;
prog: 			*to = e;
prog: 			e = next;
prog: 		}
prog: 	}
prog: 	free(t->bucket);
prog: 	t->bucket = nbk;
prog: 	t->nbuckets = nb;
prog: 	return 0;
prog: }
prog: 
prog: static int set(struct table *t, const char *key, const char *val)
prog: {
prog: 	struct entry **pp = find(t, key);
prog: 	if (*pp != NULL) {
prog: 		strcpy((*pp)->val, val);
prog: 		return 0;
prog: 	}
prog: 	if ((t->items + 1) * 4 > t->nbuckets * 3 && grow(t) != 0)
prog: 		return -1;
prog: 	struct entry *e = malloc(sizeof *e);
prog: 	if (e == NULL)
prog: 		return -1;
prog: 	strcpy(e->key, key);
prog: 	strcpy(e->val, val);
prog: 	struct entry **head = slot(t, key);
prog: 	e->next = *head;
prog: 	*head = e;
prog: 	t->items++;
prog: 	return 0;
prog: }
prog: 
prog: static void del(struct table *t, struct entry **pp)
prog: {
prog: 	struct entry *gone = *pp;
prog: 	*pp = gone->next;
prog: 	free(gone);
prog: 	t->items--;
prog: }
prog: 
prog: static int by_key(const void *a, const void *b)
prog: {
prog: 	const struct entry *x = *(const struct entry *const *)a;
prog: 	const struct entry *y = *(const struct entry *const *)b;
prog: 	return strcmp(x->key, y->key);
prog: }
prog: 
prog: static int dump(const struct table *t)
prog: {
prog: 	struct entry **all = malloc((t->items + 1) * sizeof *all);
prog: 	if (all == NULL)
prog: 		return -1;
prog: 	size_t n = 0;
prog: 	for (size_t i = 0; i < t->nbuckets; i++)
prog: 		for (struct entry *e = t->bucket[i]; e != NULL; e = e->next)
prog: 			all[n++] = e;
prog: 	qsort(all, n, sizeof *all, by_key);
prog: 	for (size_t i = 0; i < n; i++)
prog: 		printf("%s=%s\n", all[i]->key, all[i]->val);
prog: 	free(all);
prog: 	return 0;
prog: }
prog: 
prog: static void stats(const struct table *t)
prog: {
prog: 	size_t longest = 0;
prog: 	for (size_t i = 0; i < t->nbuckets; i++) {
prog: 		size_t len = 0;
prog: 		for (const struct entry *e = t->bucket[i]; e != NULL; e = e->next)
prog: 			len++;
prog: 		if (len > longest)
prog: 			longest = len;
prog: 	}
prog: 	printf("buckets %zu items %zu longest %zu\n", t->nbuckets, t->items,
prog: 		   longest);
prog: }
prog: 
prog: /* one word, at most KEYMAX long, no spaces */
prog: static int is_key(const char *s)
prog: {
prog: 	return s[0] != '\0' && strlen(s) <= KEYMAX && strchr(s, ' ') == NULL;
prog: }
prog: 
prog: static const char *run(struct table *t, char *line)
prog: {
prog: 	char *arg = strchr(line, ' ');
prog: 	if (arg != NULL) {
prog: 		*arg++ = '\0';
prog: 		while (*arg == ' ')
prog: 			arg++;
prog: 	} else {
prog: 		arg = line + strlen(line);
prog: 	}
prog: 
prog: 	if (strcmp(line, "set") == 0) {
prog: 		char *val = strchr(arg, ' ');
prog: 		if (val == NULL)
prog: 			return "bad argument";
prog: 		*val++ = '\0';
prog: 		while (*val == ' ')
prog: 			val++;
prog: 		if (!is_key(arg) || *val == '\0' || strlen(val) > VALMAX)
prog: 			return "bad argument";
prog: 		return set(t, arg, val) != 0 ? "out of memory" : NULL;
prog: 	}
prog: 	if (strcmp(line, "get") == 0 || strcmp(line, "del") == 0) {
prog: 		if (!is_key(arg))
prog: 			return "bad argument";
prog: 		struct entry **pp = find(t, arg);
prog: 		if (*pp == NULL)
prog: 			return "no such key";
prog: 		if (line[0] == 'g')
prog: 			puts((*pp)->val);
prog: 		else
prog: 			del(t, pp);
prog: 		return NULL;
prog: 	}
prog: 	int is_count = strcmp(line, "count") == 0;
prog: 	int is_dump = strcmp(line, "dump") == 0;
prog: 	int is_stats = strcmp(line, "stats") == 0;
prog: 	if (!is_count && !is_dump && !is_stats)
prog: 		return "unknown command";
prog: 	if (*arg != '\0')
prog: 		return "bad argument";
prog: 	if (is_count)
prog: 		printf("%zu\n", t->items);
prog: 	else if (is_stats)
prog: 		stats(t);
prog: 	else if (dump(t) != 0)
prog: 		return "out of memory";
prog: 	return NULL;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	struct table t = { .nbuckets = 4 };
prog: 	t.bucket = calloc(t.nbuckets, sizeof *t.bucket);
prog: 	if (t.bucket == NULL) {
prog: 		fprintf(stderr, "kvstore: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 
prog: 	int status = 0;
prog: 	char line[128];
prog: 	for (int lineno = 1; fgets(line, sizeof line, stdin) != NULL; lineno++) {
prog: 		line[strcspn(line, "\n")] = '\0';
prog: 		if (line[0] == '\0')
prog: 			continue;
prog: 		const char *err = run(&t, line);
prog: 		if (err != NULL) {
prog: 			fprintf(stderr, "kvstore: line %d: %s\n", lineno, err);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 	}
prog: 
prog: 	for (size_t i = 0; i < t.nbuckets; i++) {
prog: 		struct entry *e = t.bucket[i];
prog: 		while (e != NULL) {
prog: 			struct entry *next = e->next;
prog: 			free(e);
prog: 			e = next;
prog: 		}
prog: 	}
prog: 	free(t.bucket);
prog: 	return status;
prog: }
case: printf 'set a 1\nset b hello world\nget b\nget a\ncount\n' | kvstore
case: printf 'set a 1\nset a 2\ncount\nget a\n' | kvstore
case: printf 'set pear 3\nset apple 1\nset fig 2\ndel pear\ndump\ncount\n' | kvstore
case: printf 'stats\nset a 1\nset b 1\nset c 1\nstats\nset d 1\nstats\n' | kvstore
case: seq 1 100 | sed 's/.*/set k& v/' | { cat; echo stats; } | kvstore
case: for p in frob set 'set k' 'get' 'get a b' 'get nokey' 'del nokey' 'count x'; do printf '%s\n' "$p" | kvstore 2>&1; echo $?; done
hint: find returns the link pointing at the entry (or at the NULL ending the chain), so get, set-update and del can all share it
