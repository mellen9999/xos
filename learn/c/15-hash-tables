q: wordfreq.c -- most common words
spec: Counts the words in standard input and prints the most common. A
spec: word is a maximal run of ASCII letters, lowercased: `Don't` is the
spec: words `don` and `t`. Takes an optional N (a whole number, at least
spec: 1; default 10): print the N most frequent words, one per line as
spec: `COUNT WORD`. Most frequent first; equal counts in strcmp order of the
spec: word. Fewer than N distinct words prints them all. No words prints
spec: nothing.
spec:
spec: Count with a chained hash table you write (FNV-1a, entries holding
spec: a counter) that starts at 8 buckets and doubles when it passes
spec: three quarters full. Sort an array of the entries to print; never
spec: print in table order. Free everything before you exit.
spec:
spec: A word longer than 31 letters prints `wordfreq: word too long` to
spec: standard error, nothing to standard output, exit 1. A bad N or more
spec: than one argument prints `usage: wordfreq [N]` and exits 2.
file: wordfreq.c
prog: #include <ctype.h>
prog: #include <errno.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: #define WORDMAX 31
prog: 
prog: struct entry {
prog: 	struct entry *next;
prog: 	size_t count;
prog: 	char word[];
prog: };
prog: 
prog: struct table {
prog: 	struct entry **bucket;
prog: 	size_t nbuckets;
prog: 	size_t items;
prog: };
prog: 
prog: static uint32_t fnv1a(const char *s)
prog: {
prog: 	uint32_t h = 2166136261u;
prog: 	for (const unsigned char *p = (const unsigned char *)s; *p != '\0'; p++) {
prog: 		h ^= *p;
prog: 		h *= 16777619u;
prog: 	}
prog: 	return h;
prog: }
prog: 
prog: static int grow(struct table *t)
prog: {
prog: 	size_t nb = t->nbuckets * 2;
prog: 	struct entry **nbk = calloc(nb, sizeof *nbk);
prog: 	if (nbk == NULL)
prog: 		return -1;
prog: 	for (size_t i = 0; i < t->nbuckets; i++) {
prog: 		struct entry *e = t->bucket[i];
prog: 		while (e != NULL) {
prog: 			struct entry *next = e->next;
prog: 			struct entry **to = &nbk[fnv1a(e->word) % nb];
prog: 			e->next = *to;
prog: 			*to = e;
prog: 			e = next;
prog: 		}
prog: 	}
prog: 	free(t->bucket);
prog: 	t->bucket = nbk;
prog: 	t->nbuckets = nb;
prog: 	return 0;
prog: }
prog: 
prog: /* count one more sighting of word */
prog: static int see(struct table *t, const char *word)
prog: {
prog: 	struct entry **pp = &t->bucket[fnv1a(word) % t->nbuckets];
prog: 	for (; *pp != NULL; pp = &(*pp)->next) {
prog: 		if (strcmp((*pp)->word, word) == 0) {
prog: 			(*pp)->count++;
prog: 			return 0;
prog: 		}
prog: 	}
prog: 	if ((t->items + 1) * 4 > t->nbuckets * 3) {
prog: 		if (grow(t) != 0)
prog: 			return -1;
prog: 		pp = &t->bucket[fnv1a(word) % t->nbuckets];
prog: 	}
prog: 	size_t len = strlen(word);
prog: 	struct entry *e = malloc(sizeof *e + len + 1);
prog: 	if (e == NULL)
prog: 		return -1;
prog: 	memcpy(e->word, word, len + 1);
prog: 	e->count = 1;
prog: 	e->next = *pp;
prog: 	*pp = e;
prog: 	t->items++;
prog: 	return 0;
prog: }
prog: 
prog: static int by_rank(const void *a, const void *b)
prog: {
prog: 	const struct entry *x = *(const struct entry *const *)a;
prog: 	const struct entry *y = *(const struct entry *const *)b;
prog: 	if (x->count != y->count)
prog: 		return x->count > y->count ? -1 : 1;
prog: 	return strcmp(x->word, y->word);
prog: }
prog: 
prog: static void free_table(struct table *t)
prog: {
prog: 	for (size_t i = 0; i < t->nbuckets; i++) {
prog: 		struct entry *e = t->bucket[i];
prog: 		while (e != NULL) {
prog: 			struct entry *next = e->next;
prog: 			free(e);
prog: 			e = next;
prog: 		}
prog: 	}
prog: 	free(t->bucket);
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	long top = 10;
prog: 	if (argc > 2) {
prog: 		fprintf(stderr, "usage: wordfreq [N]\n");
prog: 		return 2;
prog: 	}
prog: 	if (argc == 2) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		top = strtol(argv[1], &end, 10);
prog: 		if (errno != 0 || end == argv[1] || *end != '\0' || top < 1) {
prog: 			fprintf(stderr, "usage: wordfreq [N]\n");
prog: 			return 2;
prog: 		}
prog: 	}
prog: 
prog: 	struct table t = { .nbuckets = 8 };
prog: 	t.bucket = calloc(t.nbuckets, sizeof *t.bucket);
prog: 	if (t.bucket == NULL) {
prog: 		fprintf(stderr, "wordfreq: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 
prog: 	int status = 1;
prog: 	struct entry **all = NULL;
prog: 	char word[WORDMAX + 1];
prog: 	size_t len = 0;
prog: 	int c;
prog: 	do {
prog: 		c = getchar();
prog: 		if (c != EOF && isalpha(c)) {
prog: 			if (len == WORDMAX) {
prog: 				fprintf(stderr, "wordfreq: word too long\n");
prog: 				goto done;
prog: 			}
prog: 			word[len++] = (char)tolower(c);
prog: 		} else if (len > 0) {
prog: 			word[len] = '\0';
prog: 			len = 0;
prog: 			if (see(&t, word) != 0) {
prog: 				fprintf(stderr, "wordfreq: out of memory\n");
prog: 				goto done;
prog: 			}
prog: 		}
prog: 	} while (c != EOF);
prog: 
prog: 	all = malloc((t.items + 1) * sizeof *all);
prog: 	if (all == NULL) {
prog: 		fprintf(stderr, "wordfreq: out of memory\n");
prog: 		goto done;
prog: 	}
prog: 	size_t n = 0;
prog: 	for (size_t i = 0; i < t.nbuckets; i++)
prog: 		for (struct entry *e = t.bucket[i]; e != NULL; e = e->next)
prog: 			all[n++] = e;
prog: 	qsort(all, n, sizeof *all, by_rank);
prog: 	for (size_t i = 0; i < n && i < (size_t)top; i++)
prog: 		printf("%zu %s\n", all[i]->count, all[i]->word);
prog: 	status = 0;
prog: 
prog: done:
prog: 	free(all);
prog: 	free_table(&t);
prog: 	return status;
prog: }
case: printf 'the cat and the hat. The end\n' | wordfreq
case: printf 'the cat and the hat. The end\n' | wordfreq 2
case: printf "Don't stop\n" | wordfreq
case: { seq 1 150; seq 1 150; seq 1 5; } | tr '0-9' 'a-j' | wordfreq 4
case: wordfreq </dev/null; echo $?; wordfreq 0 2>&1; echo $?; wordfreq 1 2 2>&1; echo $?
