q: divmod.c -- quotient and remainder
spec: Takes two whole-number arguments A and B and prints `Q R` -- A / B
spec: and A % B -- then a newline. `divmod 17 5` prints `3 2`. Negative
spec: numbers divide toward zero, so `divmod -17 5` prints `-3 -2`.
spec:
spec: B of 0 prints `divmod: divide by zero` to standard error and exits
spec: 1. An argument that is not a whole number prints `divmod: bad
spec: number` to standard error and exits 1. Any other argument count
spec: prints nothing and exits 2.
spec:
spec: Write a function that hands back both Q and R through pointer
spec: parameters, and one that parses a number into a `long *`.
file: divmod.c
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static bool parse_long(const char *s, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (errno != 0 || end == s || *end != '\0')
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: static void divmod(long a, long b, long *q, long *r)
prog: {
prog: 	*q = a / b;
prog: 	*r = a % b;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 3)
prog: 		return 2;
prog: 
prog: 	long a, b;
prog: 	if (!parse_long(argv[1], &a) || !parse_long(argv[2], &b)) {
prog: 		fprintf(stderr, "divmod: bad number\n");
prog: 		return 1;
prog: 	}
prog: 	if (b == 0) {
prog: 		fprintf(stderr, "divmod: divide by zero\n");
prog: 		return 1;
prog: 	}
prog: 	long q, r;
prog: 	divmod(a, b, &q, &r);
prog: 	printf("%ld %ld\n", q, r);
prog: 	return 0;
prog: }
case: divmod 17 5
case: divmod -17 5
case: divmod 4 0 2>&1; echo $?
case: divmod 4 x 2>&1; echo $?
case: divmod 4; echo $?
hint: both results go out through q and r, the caller passes &q and &r; check b before you divide
