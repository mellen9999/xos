q: kvsplit.c -- split key=value
spec: Takes one argument of the form `key=value` and prints two lines,
spec: `key: KEY` and `value: VALUE`. Split at the FIRST `=`: `a=b=c` has
spec: key `a` and value `b=c`. Either side may be empty.
spec:
spec: An argument with no `=` prints `kvsplit: no =` to standard error and
spec: exits 1. Any other argument count prints nothing and exits 2.
spec:
spec: Use strchr, check what it returns, and print the key without
spec: copying it: `printf("%.*s", (int)(eq - arg), arg)` -- subtracting two
spec: pointers into the same string gives the distance between them, a
spec: `ptrdiff_t`; `.*` wants an int.
file: kvsplit.c
need: - strchr(s, '=') points at the first '=' in s, or NULL
need: - eq - arg = chars before it; eq + 1 = the text after it
need: - printf("%.*s", (int)(eq - arg), arg) prints just that many chars
need: - printf("%s", p) prints from p to the end of the string
need: - const char *: text you may read, not change
start: #include <stdio.h>
start: #include <string.h>
start: 
start: int main(int argc, char *argv[])
start: {
start: 	if (argc != 2)
start: 		return 2;
start: 
start: 	const char *arg = argv[1];
start: 
start: 	/* find the first '=' and print key: and value: */
start: 	printf("key: %s\n", arg);
start: 	return 0;
start: }
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 2)
prog: 		return 2;
prog: 
prog: 	const char *arg = argv[1];
prog: 	const char *eq = strchr(arg, '=');
prog: 	if (eq == NULL) {
prog: 		fprintf(stderr, "kvsplit: no =\n");
prog: 		return 1;
prog: 	}
prog: 	printf("key: %.*s\n", (int)(eq - arg), arg);
prog: 	printf("value: %s\n", eq + 1);
prog: 	return 0;
prog: }
case: kvsplit name=mellen
case: kvsplit a=b=c
case: kvsplit =v
case: kvsplit k=
case: kvsplit novalue 2>&1; echo $?
case: kvsplit; echo $?
hint: the key is everything before the pointer strchr gives you, the value starts one past it; NULL means no =
