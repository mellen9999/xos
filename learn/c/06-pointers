name: pointers
intro: A pointer is a variable that holds an address. `&x` is the address
intro: of x; `*p` is the thing p points at.
intro:
intro:     int x = 5;
intro:     int *p = &x;
intro:     *p = 9;            /* x is now 9 */
intro:
intro: C passes arguments by value: a function gets a copy. To let it
intro: change your variable, or hand back two results, pass an address:
intro:
intro:     static void swap(int *a, int *b)
intro:     {
intro:         int t = *a;
intro:         *a = *b;
intro:         *b = t;
intro:     }
intro:     /* swap(&x, &y); */
intro:
intro: A common shape: return success or failure, and hand the value back
intro: through a pointer. The caller passes the address of its variable:
intro:
intro:     static bool parse_pct(const char *s, long *out)
intro:     {
intro:         char *end;
intro:         errno = 0;
intro:         long v = strtol(s, &end, 10);
intro:         if (end == s || *end != '\0' || errno == ERANGE
intro:             || v < 0 || v > 100)
intro:             return false;      /* *out left alone */
intro:         *out = v;
intro:         return true;
intro:     }
intro:     /* long pct; if (!parse_pct(arg, &pct)) ... */
intro:
intro: An array name used in an expression turns into a pointer to its
intro: first element (it "decays"), so `f(arr)` hands over an address
intro: and the length is gone -- pass `n` alongside. Adding to a pointer
intro: steps by whole elements: `p + 1` is the next int, not the next
intro: byte. Walk an array with `for (const int *p = v; p < v + n; p++)`.
intro: Pointing one past the end is allowed; reading it is not. Subtracting
intro: two pointers into the same array or string gives how many elements
intro: apart they are (a `ptrdiff_t`): `end - start`.
intro:
intro: `const char *s` means "I only read through this". Mark every
intro: read-only pointer const; the compiler then catches the write you
intro: did not mean. String literals are read-only, so they belong in a
intro: `const char *`.
intro:
intro: NULL is the pointer to nothing. Dereferencing it is undefined
intro: behaviour (in practice, a crash). Functions like `strchr` return
intro: NULL for "not found" -- check before you use the result.
---
q: divmod.c -- quotient and remainder
spec: Takes two whole-number arguments A and B and prints `Q R` -- A / B
spec: and A % B -- then a newline. `divmod 17 5` prints `3 2`. Negative
spec: numbers divide toward zero, so `divmod -17 5` prints `-3 -2`.
spec:
spec: B of 0 prints `divmod: divide by zero` to standard error and exits
spec: 1. So does A of `LONG_MIN` (from <limits.h>) with B of -1, printing
spec: `divmod: overflow`: that quotient does not fit a `long`, and dividing
spec: it is undefined behaviour. An argument that is not a whole number
spec: prints `divmod: bad number` to standard error and exits 1.
spec: Any other argument count prints nothing and exits 2.
spec:
spec: Write a function that hands back both Q and R through pointer
spec: parameters, and one that parses a number into a `long *`.
file: divmod.c
need: - hand back two results through pointers:
need:   static void divmod(long a, long b, long *q, long *r)
need:   inside: *q = a / b;   caller: long q, r; divmod(a, b, &q, &r);
need: - success flag + value out: static bool parse_long(const char *s,
need:   long *out)  -- set *out only when good (<stdbool.h>)
need: - strtol(s, &end, 10): bad if end == s, *end != '\0', errno
need: - check b == 0 and LONG_MIN / -1 BEFORE dividing
start: #include <errno.h>
start: #include <limits.h>
start: #include <stdbool.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: 
start: int main(int argc, char *argv[])
start: {
start: 	long q = 0, r = 0;
start: 
start: 	if (argc != 3)
start: 		return 2;
start: 	(void)argv;
start: 	/* parse argv[1], argv[2]; check them; fill q and r */
start: 	printf("%ld %ld\n", q, r);
start: 	return 0;
start: }
prog: #include <errno.h>
prog: #include <limits.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static bool parse_long(const char *s, long *out)
prog: {
prog: 	char *end;
prog: 	errno = 0;
prog: 	long v = strtol(s, &end, 10);
prog: 	if (errno != 0 || end == s || *end != '\0')
prog: 		return false;
prog: 	*out = v;
prog: 	return true;
prog: }
prog: 
prog: static void divmod(long a, long b, long *q, long *r)
prog: {
prog: 	*q = a / b;
prog: 	*r = a % b;
prog: }
prog: 
prog: int main(int argc, char *argv[])
prog: {
prog: 	if (argc != 3)
prog: 		return 2;
prog: 
prog: 	long a, b;
prog: 	if (!parse_long(argv[1], &a) || !parse_long(argv[2], &b)) {
prog: 		fprintf(stderr, "divmod: bad number\n");
prog: 		return 1;
prog: 	}
prog: 	if (b == 0) {
prog: 		fprintf(stderr, "divmod: divide by zero\n");
prog: 		return 1;
prog: 	}
prog: 	if (a == LONG_MIN && b == -1) {
prog: 		fprintf(stderr, "divmod: overflow\n");
prog: 		return 1;
prog: 	}
prog: 	long q, r;
prog: 	divmod(a, b, &q, &r);
prog: 	printf("%ld %ld\n", q, r);
prog: 	return 0;
prog: }
case: divmod 17 5
case: divmod -17 5
case: divmod 4 0 2>&1; echo $?
case: divmod -9223372036854775808 -1 2>&1; echo $?
case: divmod -9223372036854775807 -1
case: divmod 4 x 2>&1; echo $?
case: divmod 4; echo $?
hint: both results go out through q and r, the caller passes &q and &r; check b before you divide
