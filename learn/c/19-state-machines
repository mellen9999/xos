q: cstrip.c -- strip the comments from C source
spec: Copy standard input to standard output with C comments removed.
spec: A block comment, from slash-star to star-slash, becomes one space
spec: (whatever it held, newlines included). A line comment, from two
spec: slashes up to but not including the newline, is removed; the newline
spec: stays.
spec:
spec: Comment markers inside a string "..." or a character constant '...'
spec: are not comments: copy those exactly. A backslash inside either
spec: protects the next character, so the quote in "x\"y" does not end the
spec: string. A lone slash that starts nothing, as in `a / b`, is copied.
spec:
spec: An unterminated block comment prints `cstrip: unterminated comment` to
spec: standard error after the output so far and exits 1. Otherwise exit 0.
spec: Use one enum state variable, not several flags.
file: cstrip.c
prog: #include <stdio.h>
prog: 
prog: enum state {
prog: 	CODE,
prog: 	SLASH,   /* saw one / in code */
prog: 	LINE,    /* inside // ... */
prog: 	BLOCK,   /* inside slash-star ... */
prog: 	STAR,    /* inside a block comment, just saw * */
prog: 	STR,     /* inside "..." */
prog: 	STR_ESC, /* inside "...", just saw a backslash */
prog: 	CHR,     /* inside '...' */
prog: 	CHR_ESC  /* inside '...', just saw a backslash */
prog: };
prog: 
prog: int main(void)
prog: {
prog: 	enum state s = CODE;
prog: 	int c;
prog: 	while ((c = getchar()) != EOF) {
prog: 		switch (s) {
prog: 		case CODE:
prog: 			if (c == '/') {
prog: 				s = SLASH;
prog: 			} else {
prog: 				putchar(c);
prog: 				if (c == '"')
prog: 					s = STR;
prog: 				else if (c == '\'')
prog: 					s = CHR;
prog: 			}
prog: 			break;
prog: 		case SLASH:
prog: 			if (c == '*') {
prog: 				s = BLOCK;
prog: 			} else if (c == '/') {
prog: 				s = LINE;
prog: 			} else {
prog: 				putchar('/');
prog: 				ungetc(c, stdin); /* look at it again as code */
prog: 				s = CODE;
prog: 			}
prog: 			break;
prog: 		case LINE:
prog: 			if (c == '\n') {
prog: 				putchar(c);
prog: 				s = CODE;
prog: 			}
prog: 			break;
prog: 		case BLOCK:
prog: 			if (c == '*')
prog: 				s = STAR;
prog: 			break;
prog: 		case STAR:
prog: 			if (c == '/') {
prog: 				putchar(' ');
prog: 				s = CODE;
prog: 			} else if (c != '*') {
prog: 				s = BLOCK;
prog: 			}
prog: 			break;
prog: 		case STR:
prog: 			putchar(c);
prog: 			if (c == '\\')
prog: 				s = STR_ESC;
prog: 			else if (c == '"')
prog: 				s = CODE;
prog: 			break;
prog: 		case STR_ESC:
prog: 			putchar(c);
prog: 			s = STR;
prog: 			break;
prog: 		case CHR:
prog: 			putchar(c);
prog: 			if (c == '\\')
prog: 				s = CHR_ESC;
prog: 			else if (c == '\'')
prog: 				s = CODE;
prog: 			break;
prog: 		case CHR_ESC:
prog: 			putchar(c);
prog: 			s = CHR;
prog: 			break;
prog: 		}
prog: 	}
prog: 	if (s == SLASH)
prog: 		putchar('/');
prog: 	if (s == BLOCK || s == STAR) {
prog: 		fprintf(stderr, "cstrip: unterminated comment\n");
prog: 		return 1;
prog: 	}
prog: 	return 0;
prog: }
case: printf 'int a; /* c */ int b; // x\nint c;\n' | cstrip
case: printf 'puts("/* not */ // nor"); /* gone */\n' | cstrip
case: printf 'c = \047"\047; /* x */ d\n' | cstrip
case: printf 's = "a\\"/*b"; /* z */\n/** doc **/x\n' | cstrip
case: printf 'a / b /' | cstrip; echo
case: printf 'a /* b\n' | cstrip 2>/dev/null; echo $?; printf 'a /* b' | cstrip 2>&1 >/dev/null
hint: states for code, after-a-slash, line comment, block comment, block comment after a star, string, string after a backslash, and the same two for character constants
