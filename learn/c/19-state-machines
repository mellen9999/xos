q: batchp.c -- a tiny line protocol
spec: Read commands from standard input, one per line. The program is IDLE
spec: until a batch starts:
spec:
spec:   `BEGIN name`  start a batch called name (1 to 31 characters, no
spec:                 spaces); only valid when idle
spec:   `ADD n`       add the whole decimal number n (-1000000 to 1000000) to
spec:                 the batch total; only valid inside a batch
spec:   `END`         print `name: total T from N` (T the sum, N how many
spec:                 ADDs) and go idle; only valid inside a batch
spec:
spec: Blank lines (empty or only spaces) are ignored. Each batch starts at
spec: total 0.
spec:
spec: Split each line at its FIRST space: the command is the text before
spec: it, the argument is everything after it, spaces included. The
spec: command must match exactly, so ` END` (leading space) is `unknown command`.
spec: `BEGIN` takes the argument as the name as is, so `BEGIN  a` (two
spec: spaces, name ` a`), `BEGIN a ` and a missing name are `bad name`.
spec: `ADD` hands the argument to strtol, which skips leading spaces:
spec: `ADD  5` is fine, `ADD 5 ` and a missing number are `bad number`.
spec: `END` ignores any argument: `END x` is accepted.
spec:
spec: The first problem stops everything: print `batchp: line L: WHY` to
spec: standard error and exit 1, L counting lines from 1. WHY is one of
spec: `line too long` (over 126 characters), `BEGIN inside a batch`,
spec: `bad name`, `ADD outside a batch`, `bad number`, `END without BEGIN`,
spec: `unknown command` (commands are exactly upper case), or, at end of
spec: input inside a batch, `batch never ended` (L is the last line read).
spec: Check the state first, then the argument: `BEGIN` inside a batch is
spec: `BEGIN inside a batch` even when its name is bad too.
spec: Exit 0 if all went well.
spec:
spec: With `fgets(buf, 128, stdin)` a longer line comes back in pieces and
spec: the first piece has no `\n`: a full buffer with no newline at the
spec: end means the line is too long.
file: batchp.c
need: - enum state { IDLE, IN_BATCH }; check state, then the argument
need: - fgets(buf, 128, stdin): a full buffer with no '\n' is too long
need: - strchr(buf, ' ') is the FIRST space; *arg++ = '\0' splits there
need: - strspn(buf, " ") == n means the line is all spaces
need: - strtol(arg, &end, 10): end == arg, *end != '\0', errno == ERANGE
need:   (errno.h), then the range
need: - strcmp(buf, "BEGIN") == 0; strcpy(name, arg) into char name[32]
start: #include <errno.h>
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: enum state { IDLE, IN_BATCH };
start: 
start: int main(void)
start: {
start: 		enum state s = IDLE;
start: 		char buf[128];
start: 		while (fgets(buf, sizeof buf, stdin) != NULL) {
start: 				/* too long? blank? split at the first space, then act on it */
start: 				(void)s;
start: 		}
start: 		return 0;
start: }
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: enum state { IDLE, IN_BATCH };
prog: 
prog: static int fail(long line, const char *why)
prog: {
prog: 	fprintf(stderr, "batchp: line %ld: %s\n", line, why);
prog: 	return 1;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	enum state s = IDLE;
prog: 	char buf[128];
prog: 	char name[32] = "";
prog: 	long total = 0;
prog: 	long count = 0;
prog: 	long line = 0;
prog: 
prog: 	while (fgets(buf, sizeof buf, stdin) != NULL) {
prog: 		line++;
prog: 		size_t n = strlen(buf);
prog: 		if (n > 0 && buf[n - 1] == '\n')
prog: 			buf[--n] = '\0';
prog: 		else if (n == sizeof buf - 1)
prog: 			return fail(line, "line too long");
prog: 		if (strspn(buf, " ") == n)
prog: 			continue;
prog: 
prog: 		char *arg = strchr(buf, ' ');
prog: 		if (arg != NULL)
prog: 			*arg++ = '\0';
prog: 
prog: 		if (strcmp(buf, "BEGIN") == 0) {
prog: 			if (s == IN_BATCH)
prog: 				return fail(line, "BEGIN inside a batch");
prog: 			if (arg == NULL || arg[0] == '\0' || strlen(arg) >= sizeof name
prog: 			    || strchr(arg, ' ') != NULL)
prog: 				return fail(line, "bad name");
prog: 			strcpy(name, arg);
prog: 			total = 0;
prog: 			count = 0;
