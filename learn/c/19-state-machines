q: lexdump.c -- split source text into tokens
spec: Read standard input and print one line per token, in order:
spec:
spec:   `NUM 42`   a run of digits
spec:   `ID name`  a letter or underscore, then letters, digits, underscores
spec:   `OP +`     one of + - * / ( ) , ;  and  = ! < >  and the two-character
spec:              == != <= >=  (print `OP ==`; a lone ! is an error)
spec:   `STR "hi"` a double-quoted string
spec:
spec: Whitespace separates tokens and is otherwise skipped. A number and a
spec: name touching are two tokens: `12ab` is `NUM 12` then `ID ab`.
spec:
spec: Inside a string the escapes \n \t \\ and \" stand for newline,
spec: tab, backslash and quote. Print STR with the decoded text re-escaped
spec: the same four ways, any other byte under 0x20 or over 0x7e as \xHH
spec: (two lowercase hex digits), and the rest as themselves. A string is
spec: at most 256 decoded bytes.
spec:
spec: Errors stop the program with exit 1 and a message on standard error,
spec: `lexdump: line L: WHY`, L counting from 1 and WHY one of
spec: `bad character`, `bad escape`, `unterminated string` (a newline or
spec: end of input before the closing quote) or `string too long`.
spec: Tokens before the error are still printed. Exit 0 otherwise.
file: lexdump.c
prog: #include <ctype.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: 
prog: enum state { START, NUM, ID, STR, ESC, OP };
prog: 
prog: static void put_escaped(const char *s, size_t n)
prog: {
prog: 	for (size_t i = 0; i < n; i++) {
prog: 		unsigned char c = (unsigned char)s[i];
prog: 		if (c == '\n')
prog: 			fputs("\\n", stdout);
prog: 		else if (c == '\t')
prog: 			fputs("\\t", stdout);
prog: 		else if (c == '\\' || c == '"')
prog: 			printf("\\%c", c);
prog: 		else if (c < 0x20 || c > 0x7e)
prog: 			printf("\\x%02x", c);
prog: 		else
prog: 			putchar(c);
prog: 	}
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	enum state s = START;
prog: 	char buf[256];
prog: 	size_t len = 0;
prog: 	int op = 0;
prog: 	long line = 1;
prog: 	int c;
prog: 
prog: 	for (;;) {
prog: 		c = getchar();
prog: 		switch (s) {
prog: 		case START:
prog: 			if (c == EOF)
prog: 				return 0;
prog: 			if (c == '\n') {
prog: 				line++;
prog: 			} else if (isspace(c)) {
prog: 				/* skip */
prog: 			} else if (isdigit(c)) {
prog: 				printf("NUM %c", c);
prog: 				s = NUM;
prog: 			} else if (isalpha(c) || c == '_') {
prog: 				printf("ID %c", c);
prog: 				s = ID;
prog: 			} else if (c == '"') {
prog: 				len = 0;
prog: 				s = STR;
prog: 			} else if (c == '=' || c == '!' || c == '<' || c == '>') {
prog: 				op = c;
prog: 				s = OP;
prog: 			} else if (c != '\0' && strchr("+-*/(),;", c) != NULL) {
prog: 				printf("OP %c\n", c);
prog: 			} else {
prog: 				fprintf(stderr, "lexdump: line %ld: bad character\n", line);
prog: 				return 1;
prog: 			}
prog: 			break;
prog: 		case NUM:
prog: 			if (isdigit(c)) {
prog: 				putchar(c);
prog: 			} else {
prog: 				putchar('\n');
prog: 				ungetc(c, stdin);
prog: 				s = START;
prog: 			}
prog: 			break;
prog: 		case ID:
prog: 			if (isalnum(c) || c == '_') {
prog: 				putchar(c);
prog: 			} else {
prog: 				putchar('\n');
prog: 				ungetc(c, stdin);
prog: 				s = START;
prog: 			}
prog: 			break;
prog: 		case OP:
prog: 			if (c == '=') {
prog: 				printf("OP %c=\n", op);
prog: 			} else if (op == '!') {
prog: 				fprintf(stderr, "lexdump: line %ld: bad character\n", line);
prog: 				return 1;
prog: 			} else {
prog: 				printf("OP %c\n", op);
prog: 				ungetc(c, stdin);
prog: 			}
prog: 			s = START;
prog: 			break;
prog: 		case STR:
prog: 			if (c == EOF || c == '\n') {
prog: 				fprintf(stderr, "lexdump: line %ld: unterminated string\n", line);
prog: 				return 1;
prog: 			}
prog: 			if (c == '"') {
prog: 				fputs("STR \"", stdout);
prog: 				put_escaped(buf, len);
prog: 				puts("\"");
prog: 				s = START;
prog: 			} else if (c == '\\') {
prog: 				s = ESC;
prog: 			} else if (len == sizeof buf) {
prog: 				fprintf(stderr, "lexdump: line %ld: string too long\n", line);
prog: 				return 1;
prog: 			} else {
prog: 				buf[len++] = (char)c;
prog: 			}
prog: 			break;
prog: 		case ESC: {
prog: 			const char *from = "nt\\\"";
prog: 			const char *to = "\n\t\\\"";
prog: 			const char *p = c == EOF ? NULL : strchr(from, c);
prog: 			if (p == NULL || c == '\0') {
prog: 				fprintf(stderr, "lexdump: line %ld: bad escape\n", line);
prog: 				return 1;
prog: 			}
prog: 			if (len == sizeof buf) {
prog: 				fprintf(stderr, "lexdump: line %ld: string too long\n", line);
prog: 				return 1;
prog: 			}
prog: 			buf[len++] = to[p - from];
prog: 			s = STR;
prog: 			break;
prog: 		}
prog: 		}
prog: 	}
prog: }
case: printf 'x1 = 42 + foo(7);\na<=b != c >= 3 < 4 == 5 = 6\n' | lexdump
case: printf 's = "a\\tb\\n\\"q\\\\";\n' | lexdump; printf '"\001\377"' | lexdump
case: printf '12ab' | lexdump
case: printf 'a\n"abc\n' | lexdump 2>&1 >/dev/null; echo $?
case: printf 'a\n  @' | lexdump 2>/dev/null; echo $?
case: printf '"\\q"' | lexdump 2>&1 >/dev/null; echo $?
hint: states START, NUM, ID, OP, STR and ESC; a number or name ends on any other byte, which you push back with ungetc so START sees it
