name: directories
intro: A directory is a file whose contents are names. `opendir` opens one,
intro: `readdir` returns the next entry on each call, `closedir` lets go.
intro: These are POSIX, not plain C11, so put this line before every
intro: include:
intro:
intro:     #define _POSIX_C_SOURCE 200809L
intro:
intro:     DIR *d = opendir(path);          /* NULL on failure */
intro:     struct dirent *e;
intro:     for (;;) {
intro:         errno = 0;
intro:         e = readdir(d);
intro:         if (e == NULL) break;
intro:         /* e->d_name is the name, nothing more */
intro:     }
intro:     if (errno != 0) { ...readdir failed... }
intro:     closedir(d);
intro:
intro: `readdir` returns NULL at the end and on error; setting errno to 0
intro: first is how you tell which. Two entries are always there, `.` (this
intro: directory) and `..` (its parent). Skip both with `strcmp`, or a walk
intro: goes in circles.
intro:
intro: The order is whatever the filesystem likes -- it can differ between
intro: two machines. Never print in that order. Collect the names (`strdup`
intro: each, grow the array with `realloc`), `qsort` them with a comparator
intro: that calls `strcmp`, then print. Same input, same output, every
intro: time.
intro:
intro: An entry has a name, not a path. To ask about it, build the path
intro: with `snprintf(buf, sizeof buf, "%s/%s", dir, name)` and check the
intro: result was not truncated. `lstat(path, &st)` fills a `struct stat`;
intro: test `st.st_mode` with `S_ISREG`, `S_ISDIR`, `S_ISLNK`. `st.st_size`
intro: is an `off_t`; cast it to `long long` for `%lld`. Use `lstat`, not
intro: `stat`: `stat` follows a symlink to what it points at, `lstat`
intro: reports the link itself -- and a walk that follows links can loop
intro: forever.
intro:
intro: To walk a tree, write a function that lists one directory and calls
intro: itself on each subdirectory. Collect and `closedir` before you
intro: recurse, so you hold one open directory at a time, not one per level
intro: of depth.
---
q: dircount.c -- count what is in a directory
spec: Take exactly one argument, a directory. Count its entries by kind,
spec: not counting `.` or `..`, and print one line:
spec: `files=F dirs=D other=O`, then exit 0.
spec:
spec: Regular files are files, directories are dirs, and everything else is
spec: other -- that includes a symlink, even one that points at a directory
spec: (use `lstat`, which looks at the link itself). Names starting with a
spec: dot count like any other. An empty directory prints
spec: `files=0 dirs=0 other=0`.
spec:
spec: A directory that cannot be opened prints `dircount: cannot open NAME`
spec: to standard error and exits 1. Any other number of arguments prints
spec: `usage: dircount DIR` and exits 2.
file: dircount.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <dirent.h>
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <string.h>
prog: #include <sys/stat.h>
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: dircount DIR\n");
prog: 		return 2;
prog: 	}
prog: 	DIR *d = opendir(argv[1]);
prog: 	if (d == NULL) {
prog: 		fprintf(stderr, "dircount: cannot open %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	size_t files = 0, dirs = 0, other = 0;
prog: 	int status = 0;
prog: 	for (;;) {
prog: 		errno = 0;
prog: 		struct dirent *e = readdir(d);
prog: 		if (e == NULL)
prog: 			break;
prog: 		if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
prog: 			continue;
prog: 		char path[4096];
prog: 		int n = snprintf(path, sizeof path, "%s/%s", argv[1], e->d_name);
prog: 		struct stat st;
prog: 		if (n < 0 || (size_t)n >= sizeof path || lstat(path, &st) != 0) {
prog: 			fprintf(stderr, "dircount: cannot stat %s\n", e->d_name);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (S_ISREG(st.st_mode))
prog: 			files++;
prog: 		else if (S_ISDIR(st.st_mode))
prog: 			dirs++;
prog: 		else
prog: 			other++;
prog: 	}
prog: 	if (errno != 0 && status == 0) {
prog: 		fprintf(stderr, "dircount: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	closedir(d);
prog: 	if (status != 0)
prog: 		return status;
prog: 	printf("files=%zu dirs=%zu other=%zu\n", files, dirs, other);
prog: 	return 0;
prog: }
case: mkdir d; : > d/a; : > d/b; mkdir d/s; dircount d
case: mkdir d; : > d/.hid; dircount d
case: mkdir d; : > d/f; mkdir d/e; ln -s e d/l; ln -s f d/m; dircount d
case: mkdir d; dircount d
case: dircount nothere; echo $?
case: dircount; echo $?
hint: opendir, then readdir until NULL; skip names equal to "." or ".."; lstat "dir/name" and test st_mode with S_ISREG and S_ISDIR
