q: dirsize.c -- sizes of a directory's files
spec: Take exactly one argument, a directory. Print one line per entry
spec: (not `.` or `..`), sorted by name in byte order: a kind letter, the
spec: size, the name, separated by single spaces.
spec:
spec: Kinds, judged with `lstat`: `f` regular file, `d` directory, `l`
spec: symlink, `o` anything else. Only a regular file has a size shown, in
spec: bytes as a decimal number; the others show `-` in its place:
spec: `f 12 notes`, then `d - sub`.
spec:
spec: Last line: `total N`, the sum of the sizes of the regular files.
spec: An empty directory prints just `total 0`.
spec:
spec: A directory that cannot be opened prints `dirsize: cannot open NAME`
spec: to standard error and exits 1. Any other number of arguments prints
spec: `usage: dirsize DIR` and exits 2.
file: dirsize.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <dirent.h>
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: #include <sys/stat.h>
prog: 
prog: typedef struct {
prog: 	char *name;
prog: 	char kind;
prog: 	long long size;
prog: } entry;
prog: 
prog: static int by_name(const void *a, const void *b)
prog: {
prog: 	const entry *x = a, *y = b;
prog: 	return strcmp(x->name, y->name);
prog: }
prog: 
prog: static void free_all(entry *list, size_t n)
prog: {
prog: 	for (size_t i = 0; i < n; i++)
prog: 		free(list[i].name);
prog: 	free(list);
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: dirsize DIR\n");
prog: 		return 2;
prog: 	}
prog: 	DIR *d = opendir(argv[1]);
prog: 	if (d == NULL) {
prog: 		fprintf(stderr, "dirsize: cannot open %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	entry *list = NULL;
prog: 	size_t n = 0, cap = 0;
prog: 	int status = 0;
prog: 	for (;;) {
prog: 		errno = 0;
prog: 		struct dirent *e = readdir(d);
prog: 		if (e == NULL)
prog: 			break;
prog: 		if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
prog: 			continue;
prog: 		char path[4096];
prog: 		struct stat st;
prog: 		int len = snprintf(path, sizeof path, "%s/%s", argv[1], e->d_name);
prog: 		if (len < 0 || (size_t)len >= sizeof path || lstat(path, &st) != 0) {
prog: 			fprintf(stderr, "dirsize: cannot stat %s\n", e->d_name);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (n == cap) {
prog: 			size_t ncap = cap ? cap * 2 : 8;
prog: 			entry *bigger = realloc(list, ncap * sizeof *list);
prog: 			if (bigger == NULL) {
prog: 				fprintf(stderr, "dirsize: out of memory\n");
prog: 				status = 1;
prog: 				break;
prog: 			}
prog: 			list = bigger;
prog: 			cap = ncap;
prog: 		}
prog: 		entry *cur = &list[n];
prog: 		cur->name = strdup(e->d_name);
prog: 		if (cur->name == NULL) {
prog: 			fprintf(stderr, "dirsize: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		cur->size = -1;
prog: 		if (S_ISREG(st.st_mode)) {
prog: 			cur->kind = 'f';
prog: 			cur->size = (long long)st.st_size;
prog: 		} else if (S_ISDIR(st.st_mode)) {
prog: 			cur->kind = 'd';
prog: 		} else if (S_ISLNK(st.st_mode)) {
prog: 			cur->kind = 'l';
prog: 		} else {
prog: 			cur->kind = 'o';
prog: 		}
prog: 		n++;
prog: 	}
prog: 	if (errno != 0 && status == 0) {
prog: 		fprintf(stderr, "dirsize: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	closedir(d);
prog: 	if (status == 0) {
prog: 		qsort(list, n, sizeof *list, by_name);
prog: 		long long total = 0;
prog: 		for (size_t i = 0; i < n; i++) {
prog: 			if (list[i].size >= 0) {
prog: 				printf("%c %lld %s\n", list[i].kind, list[i].size, list[i].name);
prog: 				total += list[i].size;
prog: 			} else {
prog: 				printf("%c - %s\n", list[i].kind, list[i].name);
prog: 			}
prog: 		}
prog: 		printf("total %lld\n", total);
prog: 	}
prog: 	free_all(list, n);
prog: 	return status;
prog: }
