q: dirsort.c -- list a directory in order
spec: Take exactly one argument, a directory. Print its entries one per
spec: line, sorted by name in plain byte order (`strcmp`, so `B` comes
spec: before `a`), not counting `.` or `..`. Names starting with a dot are
spec: included.
spec:
spec: Add a mark after the name: `/` for a directory, `~` for a symlink
spec: (judged with `lstat`, so a link to a directory is still `~`), nothing
spec: for anything else. An empty directory prints nothing and exits 0.
spec:
spec: A directory that cannot be opened prints `dirsort: cannot open NAME`
spec: to standard error and exits 1. Any other number of arguments prints
spec: `usage: dirsort DIR` and exits 2.
file: dirsort.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <dirent.h>
prog: #include <errno.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: #include <sys/stat.h>
prog: 
prog: typedef struct {
prog: 	char *name;
prog: 	char mark;
prog: } entry;
prog: 
prog: static int by_name(const void *a, const void *b)
prog: {
prog: 	const entry *x = a, *y = b;
prog: 	return strcmp(x->name, y->name);
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: dirsort DIR\n");
prog: 		return 2;
prog: 	}
prog: 	DIR *d = opendir(argv[1]);
prog: 	if (d == NULL) {
prog: 		fprintf(stderr, "dirsort: cannot open %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	entry *list = NULL;
prog: 	size_t n = 0, cap = 0;
prog: 	int status = 0;
prog: 	for (;;) {
prog: 		errno = 0;
prog: 		struct dirent *e = readdir(d);
prog: 		if (e == NULL)
prog: 			break;
prog: 		if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
prog: 			continue;
prog: 		char path[4096];
prog: 		struct stat st;
prog: 		int len = snprintf(path, sizeof path, "%s/%s", argv[1], e->d_name);
prog: 		if (len < 0 || (size_t)len >= sizeof path || lstat(path, &st) != 0) {
prog: 			fprintf(stderr, "dirsort: cannot stat %s\n", e->d_name);
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		if (n == cap) {
prog: 			size_t ncap = cap ? cap * 2 : 8;
prog: 			entry *bigger = realloc(list, ncap * sizeof *list);
prog: 			if (bigger == NULL) {
prog: 				fprintf(stderr, "dirsort: out of memory\n");
prog: 				status = 1;
prog: 				break;
prog: 			}
prog: 			list = bigger;
prog: 			cap = ncap;
prog: 		}
prog: 		list[n].name = strdup(e->d_name);
prog: 		if (list[n].name == NULL) {
prog: 			fprintf(stderr, "dirsort: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		list[n].mark = '\0';
prog: 		if (S_ISDIR(st.st_mode))
prog: 			list[n].mark = '/';
prog: 		else if (S_ISLNK(st.st_mode))
prog: 			list[n].mark = '~';
prog: 		n++;
prog: 	}
prog: 	if (errno != 0 && status == 0) {
prog: 		fprintf(stderr, "dirsort: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	closedir(d);
prog: 	if (status == 0) {
prog: 		qsort(list, n, sizeof *list, by_name);
prog: 		for (size_t i = 0; i < n; i++) {
prog: 			printf("%s", list[i].name);
prog: 			if (list[i].mark != '\0')
prog: 				putchar(list[i].mark);
prog: 			putchar('\n');
prog: 		}
prog: 	}
prog: 	for (size_t i = 0; i < n; i++)
prog: 		free(list[i].name);
prog: 	free(list);
prog: 	return status;
prog: }
case: mkdir d; : > d/b; : > d/B; : > d/a; mkdir d/c; dirsort d
case: mkdir d; : > d/.x; : > d/10; : > d/9; : > d/_z; dirsort d
case: mkdir d; mkdir d/e; : > d/f; ln -s e d/l; ln -s nowhere d/dead; dirsort d
case: mkdir d; dirsort d; echo $?
case: dirsort nothere; echo $?
case: dirsort a b; echo $?
