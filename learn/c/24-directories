q: treewalk.c -- walk a directory tree
spec: Take a directory and an optional maximum depth: `treewalk DIR` or
spec: `treewalk DIR N`. Print DIR exactly as given, then everything under
spec: it, one name per line, each directory's entries sorted by name in byte
spec: order. Indent every name by two spaces per level below DIR, and put a
spec: `/` after the name of a directory. Directly inside DIR is level 1.
spec:
spec: Judge each entry with `lstat` and never follow symlinks: a link is
spec: listed like a file, whatever it points at. N, when given, is how many
spec: levels to list: a directory at level N is shown but not entered.
spec: N is a whole number from 1 to 1000.
spec:
spec: Last line: `dirs=D files=F`, how many directories and how many
spec: other entries were listed (the root is not counted).
spec:
spec: If DIR does not exist or is not a directory print
spec: `treewalk: cannot open DIR` to standard error and exit 1, with
spec: nothing at all on standard output. A bad argument count or a bad N
spec: prints `usage: treewalk DIR [MAXDEPTH]` and exits 2.
file: treewalk.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <dirent.h>
prog: #include <errno.h>
prog: #include <stdbool.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: #include <sys/stat.h>
prog: 
prog: typedef struct {
prog: 	char *name;
prog: 	bool isdir;
prog: } entry;
prog: 
prog: typedef struct {
prog: 	size_t dirs;
prog: 	size_t files;
prog: } totals;
prog: 
prog: static int by_name(const void *a, const void *b)
prog: {
prog: 	const entry *x = a, *y = b;
prog: 	return strcmp(x->name, y->name);
prog: }
prog: 
prog: static void free_list(entry *list, size_t n)
prog: {
prog: 	for (size_t i = 0; i < n; i++)
prog: 		free(list[i].name);
prog: 	free(list);
prog: }
prog: 
prog: static char *join(const char *dir, const char *name)
prog: {
prog: 	size_t size = strlen(dir) + 1 + strlen(name) + 1;
prog: 	char *p = malloc(size);
prog: 	if (p != NULL)
prog: 		snprintf(p, size, "%s/%s", dir, name);
prog: 	return p;
prog: }
prog: 
prog: /* read one directory into a name-sorted list; 0 on success */
prog: static int load(const char *path, entry **out, size_t *count)
prog: {
prog: 	DIR *d = opendir(path);
prog: 	if (d == NULL) {
prog: 		fprintf(stderr, "treewalk: cannot open %s\n", path);
prog: 		return -1;
prog: 	}
prog: 	entry *list = NULL;
prog: 	size_t n = 0, cap = 0;
prog: 	int rc = 0;
prog: 	for (;;) {
prog: 		errno = 0;
prog: 		struct dirent *e = readdir(d);
prog: 		if (e == NULL)
prog: 			break;
prog: 		if (strcmp(e->d_name, ".") == 0 || strcmp(e->d_name, "..") == 0)
prog: 			continue;
prog: 		char *full = join(path, e->d_name);
prog: 		struct stat st;
prog: 		if (full == NULL || lstat(full, &st) != 0) {
prog: 			fprintf(stderr, "treewalk: cannot stat %s\n", e->d_name);
prog: 			free(full);
prog: 			rc = -1;
prog: 			break;
prog: 		}
prog: 		free(full);
prog: 		if (n == cap) {
prog: 			size_t ncap = cap ? cap * 2 : 8;
prog: 			entry *bigger = realloc(list, ncap * sizeof *list);
prog: 			if (bigger == NULL) {
prog: 				fprintf(stderr, "treewalk: out of memory\n");
prog: 				rc = -1;
prog: 				break;
prog: 			}
prog: 			list = bigger;
prog: 			cap = ncap;
prog: 		}
prog: 		list[n].name = strdup(e->d_name);
prog: 		if (list[n].name == NULL) {
prog: 			fprintf(stderr, "treewalk: out of memory\n");
prog: 			rc = -1;
prog: 			break;
prog: 		}
prog: 		list[n].isdir = S_ISDIR(st.st_mode);
prog: 		n++;
prog: 	}
prog: 	if (rc == 0 && errno != 0) {
prog: 		fprintf(stderr, "treewalk: read error in %s\n", path);
prog: 		rc = -1;
prog: 	}
prog: 	closedir(d);
prog: 	if (rc != 0) {
prog: 		free_list(list, n);
prog: 		return rc;
prog: 	}
prog: 	qsort(list, n, sizeof *list, by_name);
prog: 	*out = list;
prog: 	*count = n;
prog: 	return 0;
prog: }
prog: 
prog: /* list path, then each subdirectory one level deeper; maxdepth 0 = no limit */
prog: static int walk(const char *path, int depth, int maxdepth, totals *t)
prog: {
prog: 	entry *list;
prog: 	size_t n;
prog: 	if (load(path, &list, &n) != 0)
prog: 		return -1;
prog: 	int rc = 0;
prog: 	for (size_t i = 0; i < n && rc == 0; i++) {
prog: 		printf("%*s%s%s\n", depth * 2, "", list[i].name, list[i].isdir ? "/" : "");
prog: 		if (!list[i].isdir) {
prog: 			t->files++;
prog: 			continue;
prog: 		}
prog: 		t->dirs++;
prog: 		if (maxdepth != 0 && depth >= maxdepth)
prog: 			continue;
prog: 		char *sub = join(path, list[i].name);
prog: 		if (sub == NULL) {
prog: 			fprintf(stderr, "treewalk: out of memory\n");
prog: 			rc = -1;
prog: 			break;
prog: 		}
prog: 		rc = walk(sub, depth + 1, maxdepth, t);
prog: 		free(sub);
prog: 	}
prog: 	free_list(list, n);
prog: 	return rc;
prog: }
prog: 
prog: static int usage(void)
prog: {
prog: 	fprintf(stderr, "usage: treewalk DIR [MAXDEPTH]\n");
prog: 	return 2;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2 && argc != 3)
prog: 		return usage();
prog: 	long maxdepth = 0;
prog: 	if (argc == 3) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		maxdepth = strtol(argv[2], &end, 10);
prog: 		if (errno != 0 || end == argv[2] || *end != '\0' || maxdepth < 1 || maxdepth > 1000)
prog: 			return usage();
prog: 	}
prog: 	struct stat st;
prog: 	if (stat(argv[1], &st) != 0 || !S_ISDIR(st.st_mode)) {
prog: 		fprintf(stderr, "treewalk: cannot open %s\n", argv[1]);
prog: 		return 1;
prog: 	}
prog: 	printf("%s\n", argv[1]);
prog: 	totals t = {0, 0};
prog: 	if (walk(argv[1], 1, (int)maxdepth, &t) != 0)
prog: 		return 1;
prog: 	printf("dirs=%zu files=%zu\n", t.dirs, t.files);
prog: 	return 0;
prog: }
