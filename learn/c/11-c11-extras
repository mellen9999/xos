q: revmsg.c -- one allocation, header and data
spec: Take exactly one argument. Build a `struct msg` holding its length
spec: and a reversed copy of the text, using a flexible array member and
spec: ONE malloc for the whole thing. Print the length, a colon and the
spec: reversed text with a newline: `revmsg hello` prints `5:olleh`, and
spec: `revmsg ''` prints `0:`. Free it. Exit 0.
spec:
spec: Any other number of arguments prints `usage: revmsg TEXT` to
spec: standard error and exits 2. If malloc fails print
spec: `revmsg: out of memory` and exit 1.
file: revmsg.c
start: #include <stdio.h>
start: #include <stdlib.h>
start: #include <string.h>
start: 
start: struct msg {
start: 	size_t len;
start: 	char data[];
start: };
start: 
start: int main(int argc, char **argv)
start: {
start: 	(void)argc; /* delete these two once you use them */
start: 	(void)argv;
start: 	return 0;
start: }
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: struct msg {
prog: 	size_t len;
prog: 	char data[];
prog: };
prog: 
prog: static struct msg *msg_reversed(const char *text)
prog: {
prog: 	size_t n = strlen(text);
prog: 	struct msg *m = malloc(sizeof *m + n + 1);
prog: 	if (m == NULL)
prog: 		return NULL;
prog: 	m->len = n;
prog: 	for (size_t i = 0; i < n; i++)
prog: 		m->data[i] = text[n - 1 - i];
prog: 	m->data[n] = '\0';
prog: 	return m;
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc != 2) {
prog: 		fprintf(stderr, "usage: revmsg TEXT\n");
prog: 		return 2;
prog: 	}
prog: 	struct msg *m = msg_reversed(argv[1]);
prog: 	if (m == NULL) {
prog: 		fprintf(stderr, "revmsg: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 	printf("%zu:%s\n", m->len, m->data);
prog: 	free(m);
prog: 	return 0;
prog: }
case: revmsg hello
case: revmsg ''
case: revmsg 'ab cd'
case: revmsg; echo $?
case: revmsg a b; echo $?
hint: malloc(sizeof *m + n + 1) holds the header plus the characters plus the NUL; write data[n] = 0 yourself
