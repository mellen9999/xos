q: addv.c -- add two vectors
spec: Take an even number of arguments, at least two, all whole numbers that
spec: fit an int. The first half is vector A, the second half is vector B.
spec: Print the element-wise sums as one line, separated by single spaces,
spec: ending with a newline: `addv 1 2 3 10 20 30` prints `11 22 33`.
spec: The sums must not wrap -- `addv 2147483647 2147483647` prints
spec: `4294967294`.
spec:
spec: An odd count or no arguments prints `usage: addv A... B...` to
spec: standard error and exits 2. An argument that is not such a number
spec: prints `addv: bad number: ARG` and exits 1. If malloc fails print
spec: `addv: out of memory` and exit 1.
spec:
spec: Do the adding in a `static inline` function whose three pointers are
spec: `restrict`, one malloc'd block holding A, B and the result.
file: addv.c
prog: #include <errno.h>
prog: #include <limits.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: 
prog: static inline void vadd(long *restrict dst, const long *restrict a,
prog: 						const long *restrict b, size_t n)
prog: {
prog: 	for (size_t i = 0; i < n; i++)
prog: 		dst[i] = a[i] + b[i];
prog: }
prog: 
prog: int main(int argc, char **argv)
prog: {
prog: 	if (argc < 3 || argc % 2 != 1) {
prog: 		fprintf(stderr, "usage: addv A... B...\n");
prog: 		return 2;
prog: 	}
prog: 	size_t n = (size_t)(argc - 1) / 2;
prog: 	long *block = malloc(3 * n * sizeof *block);
prog: 	if (block == NULL) {
prog: 		fprintf(stderr, "addv: out of memory\n");
prog: 		return 1;
prog: 	}
prog: 	long *a = block, *b = block + n, *sum = block + 2 * n;
prog: 	for (size_t k = 0; k < 2 * n; k++) {
prog: 		char *end;
prog: 		errno = 0;
prog: 		long v = strtol(argv[k + 1], &end, 10);
prog: 		if (end == argv[k + 1] || *end != '\0' || errno != 0
prog: 			|| v < INT_MIN || v > INT_MAX) {
prog: 			fprintf(stderr, "addv: bad number: %s\n", argv[k + 1]);
prog: 			free(block);
prog: 			return 1;
prog: 		}
prog: 		block[k] = v;
prog: 	}
prog: 	vadd(sum, a, b, n);
prog: 	for (size_t i = 0; i < n; i++) {
prog: 		if (i > 0)
prog: 			putchar(' ');
prog: 		printf("%ld", sum[i]);
prog: 	}
prog: 	printf("\n");
prog: 	free(block);
prog: 	return 0;
prog: }
case: addv 1 2 3 10 20 30
case: addv 5 -5
case: addv 2147483647 2147483647
case: addv 1 2 3; echo $?
case: addv; echo $?
case: addv 1 x; echo $?
hint: parse every argument into a long first, then let a small restrict function add halves that cannot overlap
