prog: #define MAXDEPTH 100
prog: 
prog: typedef struct {
prog: 	char name[MAXNAME + 1];
prog: 	int64_t value;
prog: } var;
prog: 
prog: typedef struct {
prog: 	var v[MAXVARS];
prog: 	size_t n;
prog: } vars;
prog: 
prog: static var *find(vars *vt, const char *name, size_t len)
prog: {
prog: 	for (size_t i = 0; i < vt->n; i++)
prog: 		if (strlen(vt->v[i].name) == len && memcmp(vt->v[i].name, name, len) == 0)
prog: 			return &vt->v[i];
prog: 	return NULL;
prog: }
prog: 
prog: /* set name to value, adding it if new; false (and err) if the table is full */
prog: static bool store(vars *vt, const tok *name, int64_t value, err *e)
prog: {
prog: 	var *v = find(vt, name->name, name->len);
prog: 	if (v == NULL) {
prog: 		if (vt->n == MAXVARS)
prog: 			return fail(e, name->col, "too many variables");
prog: 		v = &vt->v[vt->n++];
prog: 		memcpy(v->name, name->name, name->len);
prog: 		v->name[name->len] = '\0';
prog: 	}
prog: 	v->value = value;
prog: 	return true;
prog: }
prog: 
prog: typedef struct {
prog: 	const tok *t;
prog: 	vars *vt;
prog: 	err *e;
prog: 	int depth;
prog: } parser;
prog: 
prog: static bool add(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if ((b > 0 && a > INT64_MAX - b) || (b < 0 && a < INT64_MIN - b))
prog: 		return false;
prog: 	*r = a + b;
prog: 	return true;
prog: }
prog: 
prog: static bool sub(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if ((b < 0 && a > INT64_MAX + b) || (b > 0 && a < INT64_MIN + b))
prog: 		return false;
prog: 	*r = a - b;
prog: 	return true;
prog: }
prog: 
prog: static bool mul(int64_t a, int64_t b, int64_t *r)
prog: {
prog: 	if (a > 0) {
prog: 		if (b > 0 ? a > INT64_MAX / b : b < INT64_MIN / a)
prog: 			return false;
prog: 	} else {
prog: 		if (b > 0 ? a < INT64_MIN / b : (a != 0 && b < INT64_MAX / a))
prog: 			return false;
prog: 	}
prog: 	*r = a * b;
prog: 	return true;
prog: }
prog: 
prog: static bool expr(parser *p, int64_t *out);
prog: 
prog: static bool enter(parser *p)
prog: {
prog: 	if (++p->depth > MAXDEPTH)
prog: 		return fail(p->e, p->t->col, "nested too deeply");
prog: 	return true;
prog: }
prog: 
prog: static bool primary(parser *p, int64_t *out)
prog: {
prog: 	const tok *t = p->t;
prog: 	if (t->kind == T_NUM) {
prog: 		p->t++;
prog: 		*out = t->value;
prog: 		return true;
prog: 	}
prog: 	if (t->kind == T_NAME) {
prog: 		var *v = find(p->vt, t->name, t->len);
prog: 		if (v == NULL) {
prog: 			p->e->col = t->col;
prog: 			snprintf(p->e->msg, sizeof p->e->msg, "undefined name '%.*s'", (int)t->len, t->name);
prog: 			return false;
prog: 		}
prog: 		p->t++;
prog: 		*out = v->value;
prog: 		return true;
prog: 	}
prog: 	if (t->kind != T_OPEN)
prog: 		return fail(p->e, t->col, "expected a value");
prog: 	if (!enter(p))
prog: 		return false;
prog: 	p->t++;
prog: 	if (!expr(p, out))
prog: 		return false;
prog: 	if (p->t->kind != T_CLOSE)
prog: 		return fail(p->e, p->t->col, "expected )");
prog: 	p->t++;
prog: 	p->depth--;
prog: 	return true;
prog: }
prog: 
prog: static bool unary(parser *p, int64_t *out)
prog: {
prog: 	const tok *t = p->t;
prog: 	if (t->kind != T_OP || t->op != '-')
prog: 		return primary(p, out);
prog: 	if (!enter(p))
prog: 		return false;
prog: 	p->t++;
prog: 	if (!unary(p, out))
prog: 		return false;
prog: 	if (*out == INT64_MIN)
prog: 		return fail(p->e, t->col, "overflow");
prog: 	*out = -*out;
prog: 	p->depth--;
prog: 	return true;
prog: }
prog: 
prog: static bool term(parser *p, int64_t *out)
prog: {
prog: 	if (!unary(p, out))
prog: 		return false;
prog: 	while (p->t->kind == T_OP && strchr("*/%", p->t->op) != NULL) {
prog: 		const tok *op = p->t++;
prog: 		int64_t rhs;
prog: 		if (!unary(p, &rhs))
prog: 			return false;
prog: 		if (op->op == '*') {
prog: 			if (!mul(*out, rhs, out))
prog: 				return fail(p->e, op->col, "overflow");
prog: 		} else if (rhs == 0) {
prog: 			return fail(p->e, op->col, "division by zero");
prog: 		} else if (op->op == '/') {
prog: 			if (*out == INT64_MIN && rhs == -1)
prog: 				return fail(p->e, op->col, "overflow");
prog: 			*out /= rhs;
prog: 		} else {
prog: 			*out = rhs == -1 ? 0 : *out % rhs;
prog: 		}
prog: 	}
prog: 	return true;
prog: }
prog: 
prog: static bool expr(parser *p, int64_t *out)
prog: {
prog: 	if (!term(p, out))
prog: 		return false;
prog: 	while (p->t->kind == T_OP && (p->t->op == '+' || p->t->op == '-')) {
prog: 		const tok *op = p->t++;
prog: 		int64_t rhs;
prog: 		if (!term(p, &rhs))
prog: 			return false;
prog: 		bool ok = op->op == '+' ? add(*out, rhs, out) : sub(*out, rhs, out);
prog: 		if (!ok)
prog: 			return fail(p->e, op->col, "overflow");
prog: 	}
prog: 	return true;
prog: }
prog: 
prog: /* run one line: an assignment stores a value, print shows one */
prog: static bool statement(const tok *toks, vars *vt, err *e)
prog: {
prog: 	bool print = toks[0].kind == T_NAME && toks[0].len == 5 && memcmp(toks[0].name, "print", 5) == 0;
prog: 	bool assign = toks[0].kind == T_NAME && toks[1].kind == T_ASSIGN;
prog: 	if (print && assign)
prog: 		return fail(e, toks[0].col, "print is reserved");
prog: 	if (!print && !assign)
prog: 		return fail(e, toks[0].col, "not a statement");
prog: 	parser p = {toks + (print ? 1 : 2), vt, e, 0};
prog: 	int64_t value;
prog: 	if (!expr(&p, &value))
prog: 		return false;
prog: 	if (p.t->kind != T_END)
prog: 		return fail(e, p.t->col, "unexpected input");
prog: 	if (print) {
prog: 		printf("%lld\n", (long long)value);
prog: 		return true;
prog: 	}
prog: 	return store(vt, &toks[0], value, e);
prog: }
