prog: /* split s into toks, the last one T_END; toks needs strlen(s) + 1 entries */
prog: static bool tokenize(const char *s, tok *toks, err *e)
prog: {
prog: 	size_t n = 0;
prog: 	const char *p = s;
prog: 	while (*p != '\0') {
prog: 		int col = (int)(p - s) + 1;
prog: 		if (*p == ' ' || *p == '\t') {
prog: 			p++;
prog: 			continue;
prog: 		}
prog: 		tok *t = &toks[n++];
prog: 		*t = (tok){T_END, col, 0, '\0', NULL, 0};
prog: 		if (isdigit((unsigned char)*p)) {
prog: 			int64_t v = 0;
prog: 			while (isdigit((unsigned char)*p)) {
prog: 				int digit = *p++ - '0';
prog: 				if (v > (INT64_MAX - digit) / 10)
prog: 					return fail(e, col, "number too large");
prog: 				v = v * 10 + digit;
prog: 			}
prog: 			t->kind = T_NUM;
prog: 			t->value = v;
prog: 		} else if (isalpha((unsigned char)*p) || *p == '_') {
prog: 			t->kind = T_NAME;
prog: 			t->name = p;
prog: 			while (isalnum((unsigned char)*p) || *p == '_')
prog: 				p++;
prog: 			t->len = (size_t)(p - t->name);
prog: 			if (t->len > MAXNAME)
prog: 				return fail(e, col, "name too long");
prog: 		} else if (*p == '=') {
prog: 			t->kind = T_ASSIGN;
prog: 			p++;
prog: 		} else if (strchr("+-*/%", *p) != NULL) {
prog: 			t->kind = T_OP;
prog: 			t->op = *p++;
prog: 		} else if (*p == '(' || *p == ')') {
prog: 			t->kind = *p == '(' ? T_OPEN : T_CLOSE;
prog: 			p++;
prog: 		} else {
prog: 			e->col = col;
prog: 			snprintf(e->msg, sizeof e->msg, "unexpected character '%c'", *p);
prog: 			return false;
prog: 		}
prog: 	}
prog: 	toks[n] = (tok){T_END, (int)(p - s) + 1, 0, '\0', NULL, 0};
prog: 	return true;
prog: }
