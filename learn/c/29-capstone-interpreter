prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	int lineno = 0;
prog: 	vars vt = {.n = 0};
prog: 	while (status == 0 && (len = getline(&line, &cap, stdin)) != -1) {
prog: 		lineno++;
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			line[--len] = '\0';
prog: 		tok *toks = malloc(((size_t)len + 1) * sizeof *toks);
prog: 		if (toks == NULL) {
prog: 			fprintf(stderr, "calcrun: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		err e;
prog: 		if (!tokenize(line, toks, &e) || (toks[0].kind != T_END && !statement(toks, &vt, &e))) {
prog: 			printf("error: line %d, col %d: %s\n", lineno, e.col, e.msg);
prog: 			status = 1;
prog: 		}
prog: 		free(toks);
prog: 	}
prog: 	free(line);
prog: 	if (ferror(stdin)) {
prog: 		fprintf(stderr, "calcrun: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	return status;
prog: }
