prog: typedef struct {
prog: 	int col;
prog: 	char msg[64];
prog: } err;
prog: 
prog: static bool fail(err *e, int col, const char *msg)
prog: {
prog: 	e->col = col;
prog: 	snprintf(e->msg, sizeof e->msg, "%s", msg);
prog: 	return false;
prog: }
