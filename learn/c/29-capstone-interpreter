name: capstone: an interpreter
intro: Every language you have used is a program like this one: it reads
intro: text, splits it into tokens, works out the structure, and acts on
intro: it. This unit builds the smallest honest one -- a calculator you can
intro: program.
intro:
intro: The tokenizer turns characters into tokens and remembers the column
intro: of each, so every later complaint can point at the exact spot. The
intro: parser gives the tokens their shape. For arithmetic it is one
intro: function per precedence level, each calling the next-tighter one:
intro:
intro:     expr    = term    { (+ or -)     term    }
intro:     term    = unary   { (* or / or %) unary  }
intro:     unary   = - unary | primary
intro:     primary = number | ( expr )
intro:
intro: The braces mean "repeat", and a loop is what makes `10 - 3 - 2` come
intro: out as `(10 - 3) - 2`: keep the running value, and fold in each new
intro: operand as it arrives. Parentheses make the grammar call itself,
intro: which is how `((1 + 2) * 3)` nests. Evaluating while you parse means
intro: no tree to build and free.
intro:
intro: Three habits make an interpreter trustworthy. Check signed overflow
intro: before you do the arithmetic -- afterwards it is too late, since
intro: signed overflow is undefined behaviour and the compiler may assume
intro: it never happens. Handle `INT64_MIN` as a real edge: it cannot be
intro: negated, and `INT64_MIN / -1` overflows. And put a limit on
intro: recursion, because a line of a million parentheses would otherwise
intro: run the stack out and crash; a crash is not an error message.
intro:
intro: As with the shell, each program starts in vi as the last one.
intro:
intro: That is the track. You can write C that is checked, portable and
intro: does not crash, and you can drive the system under it: files,
intro: directories, processes, pipes, signals. Where next? Build a text
intro: editor: put the terminal in raw mode and redraw the screen yourself
intro: -- you already have `read`, `write` and a buffer. Build a
intro: compressor: Huffman or LZ77 is bit-twiddling plus a table. Or read:
intro: on xos the tools are busybox, real C written to be small.
intro: Start with `true`, `echo`, `cat`, `wc`, then its `sh` -- a bigger
intro: sibling of the one you just wrote.
intro:
intro: One limit to know: the track compiles with `-std=c11`, not C23. Newer keywords
intro: (`nullptr`, `constexpr`, `typeof`) and `#embed` are beyond it, even
intro: where the compiler knows newer C (clang on a phone does); with a
intro: newer gcc or clang you can add `-std=c23` yourself and learn them.
---
q: calctok.c -- tokens with columns
spec: The first step of a calculator language: read standard input a line
spec: at a time and split each line into tokens, remembering where each
spec: one started. Columns count bytes from 1.
spec:
spec: The tokens: a number (one or more decimal digits; leading zeros are
spec: fine), an operator (one of `+ - * / %`), an open parenthesis and a
spec: close parenthesis. Spaces and tabs separate tokens and are skipped.
spec:
spec: For each line print one output line per token, in order: its
spec: column, a space, its kind, and for numbers and operators a space
spec: and the value. The kinds are `num` (the value in decimal, so `007`
spec: shows as 7), `op` (the operator character), `open` and `close`.
spec: Every line ends with one more token, `end`, whose column is one past
spec: the last byte of the line; a blank line is just `1 end`.
spec: Example, for `12+(3)`:
spec: `1 num 12`, `3 op +`, `4 open`, `5 num 3`, `6 close`, `7 end`.
spec:
spec: Two mistakes are reported instead of the tokens, as a single line,
spec: and reading goes on with the next line:
spec: `error: col C: unexpected character 'X'` for any other byte, and
spec: `error: col C: number too large` for a number above
spec: 9223372036854775807 (the largest 64-bit signed integer). C is where
spec: the character or number starts. The exit status is 1 if any line
spec: had an error, otherwise 0.
file: calctok.c
prog: #define _POSIX_C_SOURCE 200809L
prog: #include <ctype.h>
prog: #include <stdbool.h>
prog: #include <stdint.h>
prog: #include <stdio.h>
prog: #include <stdlib.h>
prog: #include <string.h>
prog: 
prog: enum kind { T_NUM, T_OP, T_OPEN, T_CLOSE, T_END };
prog: 
prog: typedef struct {
prog: 	enum kind kind;
prog: 	int col;
prog: 	int64_t value;
prog: 	char op;
prog: } tok;
prog: 
prog: typedef struct {
prog: 	int col;
prog: 	char msg[64];
prog: } err;
prog: 
prog: static bool fail(err *e, int col, const char *msg)
prog: {
prog: 	e->col = col;
prog: 	snprintf(e->msg, sizeof e->msg, "%s", msg);
prog: 	return false;
prog: }
prog: 
prog: /* split s into toks, the last one T_END; toks needs strlen(s) + 1 entries */
prog: static bool tokenize(const char *s, tok *toks, err *e)
prog: {
prog: 	size_t n = 0;
prog: 	const char *p = s;
prog: 	while (*p != '\0') {
prog: 		int col = (int)(p - s) + 1;
prog: 		if (*p == ' ' || *p == '\t') {
prog: 			p++;
prog: 			continue;
prog: 		}
prog: 		tok *t = &toks[n++];
prog: 		*t = (tok){T_END, col, 0, '\0'};
prog: 		if (isdigit((unsigned char)*p)) {
prog: 			int64_t v = 0;
prog: 			while (isdigit((unsigned char)*p)) {
prog: 				int digit = *p++ - '0';
prog: 				if (v > (INT64_MAX - digit) / 10)
prog: 					return fail(e, col, "number too large");
prog: 				v = v * 10 + digit;
prog: 			}
prog: 			t->kind = T_NUM;
prog: 			t->value = v;
prog: 		} else if (strchr("+-*/%", *p) != NULL) {
prog: 			t->kind = T_OP;
prog: 			t->op = *p++;
prog: 		} else if (*p == '(' || *p == ')') {
prog: 			t->kind = *p == '(' ? T_OPEN : T_CLOSE;
prog: 			p++;
prog: 		} else {
prog: 			e->col = col;
prog: 			snprintf(e->msg, sizeof e->msg, "unexpected character '%c'", *p);
prog: 			return false;
prog: 		}
prog: 	}
prog: 	toks[n] = (tok){T_END, (int)(p - s) + 1, 0, '\0'};
prog: 	return true;
prog: }
prog: 
prog: static void dump(const tok *t)
prog: {
prog: 	for (;; t++) {
prog: 		switch (t->kind) {
prog: 		case T_NUM:
prog: 			printf("%d num %lld\n", t->col, (long long)t->value);
prog: 			break;
prog: 		case T_OP:
prog: 			printf("%d op %c\n", t->col, t->op);
prog: 			break;
prog: 		case T_OPEN:
prog: 			printf("%d open\n", t->col);
prog: 			break;
prog: 		case T_CLOSE:
prog: 			printf("%d close\n", t->col);
prog: 			break;
prog: 		case T_END:
prog: 			printf("%d end\n", t->col);
prog: 			return;
prog: 		}
prog: 	}
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	while ((len = getline(&line, &cap, stdin)) != -1) {
prog: 		if (len > 0 && line[len - 1] == '\n')
prog: 			line[--len] = '\0';
prog: 		tok *toks = malloc(((size_t)len + 1) * sizeof *toks);
prog: 		if (toks == NULL) {
prog: 			fprintf(stderr, "calctok: out of memory\n");
prog: 			status = 1;
prog: 			break;
prog: 		}
prog: 		err e;
prog: 		if (tokenize(line, toks, &e)) {
prog: 			dump(toks);
prog: 		} else {
prog: 			printf("error: col %d: %s\n", e.col, e.msg);
prog: 			status = 1;
prog: 		}
prog: 		free(toks);
prog: 	}
prog: 	free(line);
prog: 	if (ferror(stdin)) {
prog: 		fprintf(stderr, "calctok: read error\n");
prog: 		status = 1;
prog: 	}
prog: 	return status;
prog: }
case: printf '12+(3)\n' | calctok
case: printf '  007 *\t10\n' | calctok
case: printf '\n' | calctok
case: printf '9223372036854775807\n9223372036854775808\n' | calctok; echo $?
