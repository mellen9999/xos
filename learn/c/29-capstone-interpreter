prog: 		return true;
prog: 	}
prog: 	if (!store(vt, &toks[0], value, e))
prog: 		return false;
prog: 	printf("%.*s = %lld\n", (int)toks[0].len, toks[0].name, (long long)value);
prog: 	return true;
prog: }
prog: 
prog: int main(void)
prog: {
prog: 	char *line = NULL;
prog: 	size_t cap = 0;
prog: 	ssize_t len;
prog: 	int status = 0;
prog: 	vars vt = {.n = 0};
