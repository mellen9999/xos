name: test and logic
boss: TestCase
flavor: Every question I ask has exactly two answers.
syntax: [ ]
brief: [ is a command, not syntax. That is why it needs spaces around it and a
brief: closing ] as its last argument -- it is reading arguments like anything
brief: else. test is the same command without the bracket.
brief:
brief: It answers by exit status, so it slots straight into if, && and ||.
brief:
brief: Quote your variables. [ -n $x ] with x empty becomes [ -n ], which is
brief: true, which is the opposite of what you asked. [ -n "$x" ] is correct.
---
q: {test whether @txt@ exists|check that @txt@ is there|confirm @txt@ exists on disk}
a: [ -e @txt@ ]
status: 0
ref: [
teach: [ -e
hint: -e is true for any kind of existing thing, file or directory
---
q: {test whether @txt@ is a regular file|check that @txt@ is an ordinary file|confirm @txt@ is a regular file rather than a directory}
a: [ -f @txt@ ]
status: 0
ref: [
teach: [ -f
hint: -f is true only for a regular file, not a directory or link
---
q: {test whether @dir@ is a directory|check that @dir@ is actually a directory|confirm @dir@ names a directory}
a: [ -d @dir@ ]
status: 0
ref: [
teach: [ -d
hint: -d is true only when the path is a directory
---
q: {test whether @txt@ exists and is not empty|check that @txt@ is there and has content|confirm @txt@ both exists and isn't zero bytes}
a: [ -s @txt@ ]
status: 0
ref: [
teach: [ -s
hint: -s checks existence AND that the size is greater than zero
---
q: {test whether @txt@ is readable|check that you have read permission on @txt@|confirm @txt@ can be read}
a: [ -r @txt@ ]
status: 0
ref: [
teach: [ -r
hint: -r checks the read permission bit, not just that the file exists
---
q: {test whether @script@ is writable|check that you can write to @script@|confirm write permission on @script@}
a: [ -w @script@ ]
status: 0
ref: [
teach: [ -w
hint: -w checks the write permission bit
---
q: {test whether @script@ is executable|check that @script@ has the execute bit set|confirm @script@ can be run}
a: [ -x @script@ ]
status: 0
ref: [
teach: [ -x
hint: -x checks the execute permission bit
---
q: {test whether link.txt is a symbolic link|check that link.txt is a symlink rather than a real file|confirm link.txt is a link, not the file itself}
a: [ -L link.txt ]
status: 0
ref: [
teach: [ -L
hint: -L is true for a symlink even if what it points to is missing
---
q: {test whether the variable @var@ is empty|check that @var@ holds nothing|confirm @var@ is empty}
a: [ -z "$@var@" ]
status: 0
ref: [
teach: [ -z
hint: -z is true when the string's length is zero
---
q: {test whether the variable @var@ is NOT empty|check that @var@ actually holds something|confirm @var@ is set to a nonempty value}
a: [ -n "$@var@" ]
status: 1
ref: [
teach: [ -n
hint: -n is true when the string's length is nonzero
---
q: %show% yes if @txt@ exists
a: [ -f @txt@ ] && echo yes
cmp: ref
ref: [
teach: [ -f
hint: -f is true only for a regular file
---
q: %show% missing if @word@-nope.txt does not exist
a: [ -f @word@-nope.txt ] || echo missing
out: ^missing$
ref: [
teach: [ -f
hint: || only runs echo when the test in front of it fails
---
q: {use test rather than brackets to check that @dir@ is a directory, printing ok|check @dir@ is a directory with the test command instead of [ ], printing ok|run test -d on @dir@, printing ok, without using square brackets}
a: test -d @dir@ && echo ok
cmp: ref
ref: test
teach: test -d
hint: test and [ are the same command; test just skips the closing bracket
---
q: {compare two copies of @word@ for equality as strings, printing same when they match|use = to test that two copies of @word@ match as strings, printing same|check whether two copies of @word@ are equal as strings, printing same}
a: [ @word@ = @word@ ] && echo same
out: ^same$
ref: [
teach: [
hint: = compares strings; use -eq for numbers instead
---
q: {check that @word@ and the string other differ, printing differ|use != to confirm @word@ and other aren't equal, printing differ|test that @word@ and other are different strings, printing differ}
a: [ @word@ != other ] && echo differ
out: ^differ$
ref: [
teach: [
hint: != is the string inequality operator, the opposite of =
---
q: {print seven if @cfg@ has exactly 7 lines, otherwise other|test whether the line count of @cfg@ equals 7: seven if so, other if not|check @cfg@ for exactly 7 lines, printing seven or other}
a: [ "$(wc -l < @cfg@)" -eq 7 ] && echo seven || echo other
cmp: ref
ref: [
teach: [ -eq
hint: -eq is numeric equality; use = for strings instead
---
q: {print more if @log@ has over 14 lines, otherwise few|test whether @log@'s line count exceeds 14: more if so, few if not|check @log@ for more than 14 lines, printing more or few}
a: [ "$(wc -l < @log@)" -gt 14 ] && echo more || echo few
cmp: ref
ref: [
teach: [ -gt
hint: -gt is numeric greater-than
---
q: {print fewer if @log@ has under 14 lines, otherwise many|test whether @log@'s line count is below 14: fewer if so, many if not|check @log@ for fewer than 14 lines, printing fewer or many}
a: [ "$(wc -l < @log@)" -lt 14 ] && echo fewer || echo many
cmp: ref
ref: [
teach: [ -lt
hint: -lt is numeric less-than
---
q: {negate a test -- print gone when @word@-nope.txt does NOT exist|use ! to invert a test, printing gone when @word@-nope.txt is missing|print gone only when @word@-nope.txt does NOT exist, negating the test}
a: [ ! -f @word@-nope.txt ] && echo gone
out: ^gone$
ref: [
teach: [
hint: ! in front of a test negates its result
---
q: {require both that @txt@ exists and @dir@ is a directory, printing both|test that @txt@ exists AND @dir@ is a directory, printing both|combine two conditions with -a, printing both when @txt@ exists and @dir@ is a directory}
a: [ -f @txt@ -a -d @dir@ ] && echo both
out: ^both$
ref: [
teach: [ -a
hint: -a inside [ ] means logical AND between two conditions
---
q: {accept either @txt@ existing or @word@-nope.txt existing, printing either|test that @txt@ exists OR @word@-nope.txt exists, printing either|combine two conditions with -o, printing either when one of the files exists}
a: [ -f @txt@ -o -f @word@-nope.txt ] && echo either
out: ^either$
ref: [
teach: [ -o
hint: -o inside [ ] means logical OR between two conditions
