name: test and logic
boss: TestCase
flavor: Every question I ask has exactly two answers.
syntax: [ ]
brief: [ is a command, not syntax. That is why it needs spaces around it and a
brief: closing ] as its last argument -- it is reading arguments like anything
brief: else. test is the same command without the bracket.
brief:
brief: It answers by exit status, so it slots straight into if, && and ||.
brief:
brief: Quote your variables. [ -n $x ] with x empty becomes [ -n ], which is
brief: true, which is the opposite of what you asked. [ -n "$x" ] is correct.
---
q: {make sure @txt@ is actually there before you read it|check that @txt@ exists before you rely on it|confirm @txt@ is really on disk}
a: [ -e @txt@ ]
status: 0
ref: [
teach: [ -e
hint: -e is true for any kind of existing thing, file or directory
---
q: {check @txt@ is a plain file before you try to read it|@txt@ should be an ordinary file, not a directory|verify @txt@ is a regular file, not something else}
a: [ -f @txt@ ]
status: 0
ref: [
teach: [ -f
hint: -f is true only for a regular file, not a directory or link
---
q: {make sure @dir@ is really a directory before you cd into it|check that @dir@ is actually a directory, not a file|confirm @dir@ names a directory you can work in}
a: [ -d @dir@ ]
status: 0
ref: [
teach: [ -d
hint: -d is true only when the path is a directory
---
q: {make sure @txt@ isn't empty before you use it as input|check that @txt@ exists and actually has content|confirm @txt@ is there and isn't a zero-byte file}
a: [ -s @txt@ ]
status: 0
ref: [
teach: [ -s
hint: -s checks existence AND that the size is greater than zero
---
q: {make sure you can actually read @txt@ before you try|check that you have read permission on @txt@|confirm @txt@ isn't locked away from you}
a: [ -r @txt@ ]
status: 0
ref: [
teach: [ -r
hint: -r checks the read permission bit, not just that the file exists
---
q: {make sure you can actually edit @script@ before you try|check that you have write permission on @script@|confirm @script@ isn't locked read-only}
a: [ -w @script@ ]
status: 0
ref: [
teach: [ -w
hint: -w checks the write permission bit
---
q: {make sure @script@ is actually runnable before you try ./@script@|check that @script@ has the execute bit set|confirm @script@ can be run, not just read}
a: [ -x @script@ ]
status: 0
ref: [
teach: [ -x
hint: -x checks the execute permission bit
---
q: {check whether link.txt is a symlink before you overwrite what it points to|confirm link.txt is a symlink rather than the real file|make sure link.txt is a link, not the file itself}
a: [ -L link.txt ]
status: 0
ref: [
teach: [ -L
hint: -L is true for a symlink even if what it points to is missing
---
q: {test whether the variable @var@ is empty|check that @var@ holds nothing|confirm @var@ is empty}
a: [ -z "$@var@" ]
status: 0
ref: [
teach: [ -z
hint: -z is true when the string's length is zero
---
q: {test whether the variable @var@ is NOT empty|check that @var@ actually holds something|confirm @var@ is set to a nonempty value}
a: [ -n "$@var@" ]
status: 1
ref: [
teach: [ -n
hint: -n is true when the string's length is nonzero
---
q: %show% yes if @txt@ exists
a: [ -f @txt@ ] && echo yes
cmp: ref
ref: [
teach: [ -f
hint: -f is true only for a regular file
---
q: %show% missing if @word@-nope.txt does not exist
a: [ -f @word@-nope.txt ] || echo missing
out: ^missing$
ref: [
teach: [ -f
hint: || only runs echo when the test in front of it fails
---
q: {use test, not [ ], to check @dir@ is a directory, printing ok|check @dir@ is a directory with the test command, printing ok|run test -d on @dir@, printing ok, no square brackets}
a: test -d @dir@ && echo ok
cmp: ref
ref: test
teach: test -d
hint: test and [ are the same command; test just skips the closing bracket
---
q: {compare two copies of @word@ as strings, printing same if they match|use = to test that two copies of @word@ match, printing same|check whether two copies of @word@ are equal, printing same}
a: [ @word@ = @word@ ] && echo same
out: ^same$
ref: [
teach: [
hint: = compares strings; use -eq for numbers instead
---
q: {check that @word@ and the string other differ, printing differ|use != to confirm @word@ and other aren't equal, printing differ|test that @word@ and other are different strings, printing differ}
a: [ @word@ != other ] && echo differ
out: ^differ$
ref: [
teach: [
hint: != is the string inequality operator, the opposite of =
---
q: {check @cfg@ has exactly 7 lines, printing seven or other|make sure @cfg@ still has 7 lines, printing seven or other|verify @cfg@'s line count is 7, printing seven or other}
a: [ "$(wc -l < @cfg@)" -eq 7 ] && echo seven || echo other
cmp: ref
ref: [
teach: [ -eq
hint: -eq is numeric equality; use = for strings instead
---
q: {flag @log@ as too big past 14 lines, printing more or few|check whether @log@ has grown past 14 lines, printing more or few|watch for @log@ passing 14 lines, printing more or few}
a: [ "$(wc -l < @log@)" -gt 14 ] && echo more || echo few
cmp: ref
ref: [
teach: [ -gt
hint: -gt is numeric greater-than
---
q: {flag @log@ as too short, under 14 lines, printing fewer or many|check whether @log@ is under 14 lines, printing fewer or many|watch for @log@ under 14 lines, printing fewer or many}
a: [ "$(wc -l < @log@)" -lt 14 ] && echo fewer || echo many
cmp: ref
ref: [
teach: [ -lt
hint: -lt is numeric less-than
---
q: {confirm @word@-nope.txt is really gone, printing gone if so|check that @word@-nope.txt was actually removed, printing gone|print gone only when @word@-nope.txt is missing, using ! to invert the test}
a: [ ! -f @word@-nope.txt ] && echo gone
out: ^gone$
ref: [
teach: [
hint: ! in front of a test negates its result
---
q: {require both @txt@ and @dir@ to check out, printing both|test that @txt@ exists AND @dir@ is a directory, printing both|@txt@ and @dir@ both need to check out first, printing both}
a: [ -f @txt@ -a -d @dir@ ] && echo both
out: ^both$
ref: [
teach: [ -a
hint: -a inside [ ] means logical AND between two conditions
---
q: {accept either @txt@ or @word@-nope.txt existing, printing either|test that @txt@ exists OR @word@-nope.txt exists, printing either|check for @txt@ or @word@-nope.txt, printing either if one exists}
a: [ -f @txt@ -o -f @word@-nope.txt ] && echo either
out: ^either$
ref: [
teach: [ -o
hint: -o inside [ ] means logical OR between two conditions
