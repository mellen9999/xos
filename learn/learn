#!/bin/sh
# learn -- xos's curriculum. teaches the whole shipped command surface, in
# order, and grades you by running what you type.
#
# two properties this has that a quiz on a general-purpose distro cannot:
#
#   the surface is CLOSED. xos's programs are fixed at build time, so "teach
#   everything" is a finite claim the build checks (G24, G26) rather than an
#   aspiration. a busybox bump that adds a flag breaks the build until someone
#   decides whether to teach it.
#
#   the root filesystem is READ-ONLY. that is what makes it safe to execute a
#   learner's answer and grade the output instead of string-matching it, with
#   no sandbox library involved -- the isolation is the operating system.
#
# no arrays, no namerefs, no bashisms: the filesystem is the lookup table.
#
# glossary: a CARD is one memorised prompt+answer, tracked and decayed on its
# own. a QUESTION (also STEP in a mission, STAGE in the gauntlet) is one card
# rendered and asked, in whichever mode is running it. a BOSS is the gate at
# the end of a level -- five of that level's own questions, no hints, timed.
set -u

ROOT="${LEARN_ROOT:-/usr/share/learn}"
REF="$ROOT/ref"
LEVELS="$ROOT/levels"
VS="$ROOT/vs"
SHELLBIN="${LEARN_SH:-/bin/sh}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/learn"
TMP="${TMPDIR:-/tmp}/learn.$$"

die() { echo "learn: $*" >&2; exit 1; }
[ -d "$REF" ] || die "no corpus at $REF"

mkdir -p "$TMP" 2>/dev/null || die "cannot create $TMP"
# the INT/TERM handlers EXIT. the old one only removed $TMP and let the script
# run on -- every block load after a ctrl-c failed, every remaining question
# was graded wrong against a blank reveal. the tty is put back too: a kill
# mid-keystroke leaves it in the editor's raw read.
cleanup() {
	# the boss clock is a child: a ctrl-c that left it running would go on
	# writing seconds over whatever the shell drew next.
	[ -n "${CLOCK_PID:-}" ] && kill "$CLOCK_PID" 2>/dev/null
	rm -rf "$TMP" "${SANDBOX:-}" 2>/dev/null
}
trap cleanup EXIT
trap '[ -t 0 ] && stty sane 2>/dev/null; cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM

for _l in ui ctx grade fixtures cards coach chal edit scenarios projects ctrack autopsy fumble panel explain lint corpus selftest; do
	[ -f "$ROOT/lib/$_l" ] || die "missing lib/$_l"
	. "$ROOT/lib/$_l"
done

# ---- reference ------------------------------------------------------------

# refname CMD -- the file a command's page is stored under.
# "." can never be a filename: that name always means the directory itself.
# it is the one command in the surface that needs translating, and doing it in
# one place keeps every caller -- ref, coverage, selftest -- agreeing.
refname() { [ "$1" = "." ] && echo dot || echo "$1"; }

# vs_of CMD -- the one sentence separating a command from the one it is
# mistaken for, or nothing. a card row is expensive, so learn/vs lists only
# pairs a learner actually reaches into the wrong half of.
vs_of() { awk -F'\t' -v c="$1" '$1 == c { print $2; exit }' "$VS" 2>/dev/null; }

# summary_of CMD -- the one line saying what the command is for. every page
# carries one: the first prose line after the usage block, its own sentence,
# short enough that a card prints it whole. the synopsis and its continuation
# lines sit above the blank, so no half of a "or: cp [-arPLHpfinlsu]..." can
# be read as the summary. the three callers -- the card, the panel and -k --
# all come through here, so what a command is said to be is said once.
summary_of() {
	awk 'blank && NF && $0 !~ /^\t/ { print; exit } /^$/ { blank = 1 }' \
		"$REF/$(refname "$1")" 2>/dev/null
}

ref() {
	[ $# -ge 1 ] || die "usage: learn ref COMMAND"
	_r=$(refname "$1")
	if [ ! -f "$REF/$_r" ]; then
		echo "learn: no entry for '$1'" >&2
		echo "try: learn -k $1" >&2
		return 1
	fi
	ref_page "$REF/$_r" "$(vs_of "$1")"
}

surface() { ls -1 "$REF" 2>/dev/null | sed 's/^dot$/./' | sort; }

search() {
	[ $# -ge 1 ] || die "usage: learn -k KEYWORD"
	grep -rl -i -- "$1" "$REF" 2>/dev/null | sed "s|^$REF/||" | sort | while read -r c; do
		printf '  %-14s %s\n' "$c" "$(summary_of "$c")"
	done
}

# ---- levels ---------------------------------------------------------------

level_ids()   { ls -1 "$LEVELS" 2>/dev/null | sort; }
level_path()  { echo "$LEVELS/$1"; }

# the two shapes every corpus file shares -- a header of `key: value` lines
# and `---`-separated blocks -- read in one place. levels, scenarios and the
# chain file all go through these.
blk_field() { sed -n "/^---$/q; s/^$2: \{0,1\}//p" "$1" 2>/dev/null; }   # FILE KEY
blocks_nq() { awk '/^---$/ { c++ } END { print c + 0 }' "$1" 2>/dev/null; } # FILE

level_field() { blk_field "$(level_path "$1")" "$2"; }
level_nq()    { blocks_nq "$(level_path "$1")"; }
# the human-facing level number: files are zero-padded (00-hello, 01-...) so they
# sort, but a learner reads "level 0", "level 1", not "level 00". 00-hello is
# level 0 on purpose -- the rung before level 1, where you are not doing the shell
# yet, just meeting it. one leading zero off; 10-30 keep both digits.
level_no() { local n=${1%%-*}; echo "${n#0}"; }

# blk_index DIR CACHE -- "<id>\t<after>\t<nq>\t<name>", one row per file in
# DIR, one pass, built once per run.
#
# a menu asks the same four things of every mission and every project it draws,
# and asking them a file at a time cost three forks per field: the missions row
# alone redrew in over a second on the stick, every keypress, because the menu
# loop re-asked. the corpus is on a read-only rootfs and cannot change while
# learn runs, so one pass answers for the whole session.
#
# name goes last: it is prose, and a field that might hold a tab has to be the
# one `read` gives the remainder of the line to.
blk_index() {
	[ -s "$2" ] || awk -v OFS='\t' '
		# an ungated file prints "-": an empty field between two tabs is lost
		# to `read`, which treats a tab run as one separator, and every field
		# after it slides left -- nq read as the gate, the name as nq.
		function flush() { if (id != "") print id, (after == "" ? "-" : after), nq + 0, name }
		FNR == 1  { flush(); n = split(FILENAME, p, "/"); id = p[n]
		            after = ""; name = ""; nq = 0; head = 1 }
		/^---$/   { nq++; head = 0; next }
		!head     { next }
		/^after:/ { if (after == "") { v = $0; sub(/^after: ?/, "", v); after = v } }
		/^name:/  { if (name  == "") { v = $0; sub(/^name: ?/, "", v);  name  = v } }
		END       { flush() }
	' "$1"/* > "$2" 2>/dev/null
	return 0
}

# level id as a plain number. ids are zero-padded ("08-cutting"), and ash reads
# a leading zero in $(( )) as octal -- $((08)) is a FATAL arithmetic error, not
# 8. every id that enters arithmetic goes through here.
level_num() { _n=${1%%-*}; echo "${_n#0}"; }

# the boss clock grows with the level, the way it always has: the questions
# get longer to type, not easier to remember.
boss_limit() { echo $(( 30 + $(level_num "$1") / 3 )); }

# the passed ledger -- which bosses have actually fallen. the gauntlet gate
# reads ONLY this file: a boss-fall is the one thing that may ever write it.
PASSED="$STATE/passed"
# the daily streak ledger -- one line "lastdaynum streak best", keyed on the
# same UTC day number the daily seed uses. showing up correctly on consecutive
# days is the one number the daily was shaped to earn and never kept.
DAILY="$STATE/daily"
# every ledger write is a same-directory rename: `cp` into place was a
# truncate followed by a write, and the tether can cut power between them --
# a half-written passed file re-locks the gauntlet with no message.
_ledger_add() { # FILE ID
	mkdir -p "$STATE" 2>/dev/null || return 0
	{ cat "$1" 2>/dev/null; echo "$2"; } | sort -u > "$1.tmp.$$" 2>/dev/null \
		&& mv "$1.tmp.$$" "$1" 2>/dev/null || rm -f "$1.tmp.$$" 2>/dev/null
	return 0
}
level_passed()    { _ledger_add "$PASSED" "$1"; inprog_clear "$1"; }
level_is_passed() { grep -qxF -- "$1" "$PASSED" 2>/dev/null; }

# passed_set -- the whole ledger as one space-padded string, and gate_open the
# test against it. a menu draw asks "has this level fallen" once per mission and
# once per project; as a grep apiece that was a fork apiece, and the answer is
# the same file every time. level ids hold no spaces, so the padding makes an
# exact match a substring match.
passed_set() { _p=$(tr '\n' ' ' 2>/dev/null < "$PASSED"); echo " $_p "; }
gate_open() { # GATE SET -- an ungated item is open; otherwise its level must have fallen
	case "$1" in ''|-) return 0 ;; esac
	case "$2" in *" $1 "*) return 0 ;; esac
	return 1
}

# the placed ledger -- levels a placement run skipped past. resume treats
# these the same as passed (don't re-teach them), but the gauntlet gate does
# not: a placement guess is not a boss fought, so it must never unlock the
# endgame the way a real fall does.
PLACED="$STATE/placed"
level_placed()    { _ledger_add "$PLACED" "$1"; inprog_clear "$1"; }
level_is_placed() { grep -qxF -- "$1" "$PLACED" 2>/dev/null; }

# the briefed ledger -- a level's brief is a teaching paragraph, worth reading
# once. after that it is a wall of text between you and the questions, so every
# later run prints only the one-line header and drops you straight in.
BRIEFED="$STATE/briefed"
level_briefed()    { _ledger_add "$BRIEFED" "$1"; }
level_is_briefed() { grep -qxF -- "$1" "$BRIEFED" 2>/dev/null; }

# the acts overlay -- learn/acts groups the flat levels into named parts so the
# climb reads as a journey. display only: no ordering, no unlock, no gate looks
# at it. act_row NN prints "from<TAB>name<TAB>intro" for the act that holds level
# number NN, or nothing if none does. the seen-ledger fires each act's intro once.
ACTS="$ROOT/acts"
ACTS_SEEN="$STATE/acts_seen"
act_row() { awk -F'\t' -v n="$1" 'NF>=4 && n+0>=$1+0 && n+0<=$2+0 { print $1 "\t" $3 "\t" $4; exit }' "$ACTS" 2>/dev/null; }
act_seen()  { grep -qxF -- "$1" "$ACTS_SEEN" 2>/dev/null; }
act_marked() { _ledger_add "$ACTS_SEEN" "$1"; }

# the schema ledger -- which state migrations have been applied. a plain
# integer, absent on a fresh install, so a first run stamps the current
# version and rewrites nothing.
SCHEMA="$STATE/schema"

# migrate -- rename level ids in saved state, once. runs before cards_decay,
# so decay never reads a key filed under a name that no longer exists.
migrate() {
	local cur want v old new f
	[ -f "$ROOT/migrations" ] || return 0
	want=$(awk '$1 ~ /^[0-9]+$/ { if ($1 > m) m = $1 } END { print m + 0 }' \
		"$ROOT/migrations" 2>/dev/null)
	cur=$(cat "$SCHEMA" 2>/dev/null); cur=${cur:-0}
	case "$cur" in *[!0-9]*) cur=0 ;; esac
	[ "$want" -gt "$cur" ] 2>/dev/null || return 0
	mkdir -p "$STATE" 2>/dev/null || return 0
	while read -r v old new; do
		case "$v" in ''|\#*) continue ;; *[!0-9]*) continue ;; esac
		[ -n "$new" ] || continue
		[ "$v" -gt "$cur" ] || continue
		case "$old" in *[!0-9a-z-]*|'') continue ;; esac
		if [ "$new" = - ]; then
			for f in "$PASSED" "$PLACED" "$BRIEFED"; do
				[ -f "$f" ] || continue
				{ grep -vxF -- "$old" "$f" || :; } > "$f.tmp.$$" 2>/dev/null \
					&& mv "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$" 2>/dev/null
			done
			if [ -f "$CARDS" ]; then
				{ grep -v "^$old/" "$CARDS" || :; } > "$CARDS.tmp.$$" 2>/dev/null \
					&& mv "$CARDS.tmp.$$" "$CARDS" 2>/dev/null \
					|| rm -f "$CARDS.tmp.$$" 2>/dev/null
			fi
			rm -f "$(_inprog_file "$old")" 2>/dev/null
			continue
		fi
		case "$new" in *[!0-9a-z-]*) continue ;; esac
		for f in "$PASSED" "$PLACED" "$BRIEFED"; do
			[ -f "$f" ] || continue
			sed "s|^$old\$|$new|" "$f" > "$f.tmp.$$" 2>/dev/null \
				&& mv "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$" 2>/dev/null
		done
		if [ -f "$CARDS" ]; then
			sed "s|^$old/|$new/|" "$CARDS" > "$CARDS.tmp.$$" 2>/dev/null \
				&& mv "$CARDS.tmp.$$" "$CARDS" 2>/dev/null \
				|| rm -f "$CARDS.tmp.$$" 2>/dev/null
		fi
		rm -f "$(_inprog_file "$old")" 2>/dev/null
	done < "$ROOT/migrations"
	printf '%s\n' "$want" > "$SCHEMA.tmp.$$" 2>/dev/null \
		&& mv "$SCHEMA.tmp.$$" "$SCHEMA" 2>/dev/null \
		|| rm -f "$SCHEMA.tmp.$$" 2>/dev/null
	return 0
}

# the in-progress ledger -- one file per level, holding the cards it still
# owes you. quitting a 33-card level at card 20 used to throw the place away:
# the next run reshuffled and asked all 33 again, so a level was something you
# had to finish in one sitting or repeat. one line, rewritten after each
# answer: <fingerprint> <right> <answered> <cards still to ask>...
INPROG="$STATE/inprogress"
_inprog_file() { printf '%s.%s\n' "$INPROG" "$1"; }
# the level's CONTENT, not its name. an edited level renumbers its questions,
# and resuming into the old numbering would ask card 7 of a file that no
# longer has one -- or, worse, a different card 7.
level_fp() { md5sum 2>/dev/null < "$(level_path "$1")" | cut -d' ' -f1; }
inprog_save() { # ID FP RIGHT ANSWERED REMAINING...
	local f; f=$(_inprog_file "$1"); shift
	mkdir -p "$STATE" 2>/dev/null || return 0
	# same-directory rename, like every other ledger: power can cut between a
	# truncate and a write, and a half-written place is worse than none.
	printf '%s\n' "$*" > "$f.tmp.$$" 2>/dev/null \
		&& mv "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$" 2>/dev/null
	return 0
}
inprog_clear() { rm -f "$(_inprog_file "$1")" 2>/dev/null; return 0; }
# sets INPROG_LEFT/RIGHT/DONE, or returns 1 with nothing to resume. every
# field is proved before any of it is believed -- a truncated, stale or
# hand-edited file starts the level over rather than indexing past its end.
inprog_load() { # ID FP NQ
	INPROG_LEFT=""; INPROG_RIGHT=0; INPROG_DONE=0
	local id=$1 fp=$2 nq=$3 f line n
	f=$(_inprog_file "$id")
	[ -f "$f" ] || return 1
	IFS= read -r line < "$f" 2>/dev/null || line=""
	set -f; set -- $line; set +f
	# three fields is a whole record: fingerprint, right, answered, and
	# nothing owed. that is the place a learner standing at the boss is in,
	# and it has to load or walking away from a boss costs the level.
	[ $# -ge 3 ] && [ "$1" = "$fp" ] || { inprog_clear "$id"; return 1; }
	case "$2$3" in *[!0-9]*) inprog_clear "$id"; return 1 ;; esac
	INPROG_RIGHT=$2; INPROG_DONE=$3
	shift 3
	# answered + still owed must be the whole level, and every card must be
	# one this level actually has.
	[ $(($# + INPROG_DONE)) -eq "$nq" ] && [ "$INPROG_RIGHT" -le "$INPROG_DONE" ] \
		|| { inprog_clear "$id"; return 1; }
	for n; do
		case "$n" in *[!0-9]*) inprog_clear "$id"; return 1 ;; esac
		[ "$n" -ge 1 ] && [ "$n" -le "$nq" ] || { inprog_clear "$id"; return 1; }
	done
	INPROG_LEFT="$*"
	return 0
}

# is there anything here to lose? asked by the menu, so a blank install is
# never offered "where you left off", and by the new-game key, so it does not
# put up a wipe warning over an empty directory. the rule is a rule and not a
# list of ledgers -- anything learn files under $STATE counts, bar the two
# files a first launch writes on its own.
progress_any() {
	local f
	for f in "$STATE"/*; do
		case "${f##*/}" in schema|cards.lock|'*') continue ;; esac
		[ -s "$f" ] && return 0
	done
	return 1
}

# a new game clears learn's whole state directory rather than a list of
# ledgers: a ledger added later must not survive the wipe and seed the next
# game with the last one's progress. this is the only rm -rf in the tree, so
# an unset or stray STATE takes nothing with it: the path must be absolute, at
# least two components deep, and named learn -- the directory learn builds for
# itself. anything else is a bug or an env var pointing somewhere real.
state_wipe() {
	case "$STATE" in /*/learn) : ;; *) return 1 ;; esac
	rm -rf "$STATE" 2>/dev/null || return 1
	mkdir -p "$STATE" 2>/dev/null || return 1
	return 0
}

# blk_load FILE INDEX -- fills Q_PROMPT, Q_ANSWERS, Q_OUT, Q_REF, Q_HINT, Q_ID
# from block INDEX of any question file -- the levels and the challenge chains
# share one parser. the roll happens here, once, and the SAME rolled script
# renders the prompt and every answer. rolling twice would ask about app.log
# and accept an answer about server.log.
blk_load() {
	local blk seed
	roll
	seed=$(( RANDOM + $2 ))

	blk="$TMP/blk"
	awk -v n="$2" 'BEGIN { c = 0 } /^---$/ { c++; next } c == n' "$1" > "$blk"

	Q_ID="$2"
	# which block this is, in the same shape the example index uses: a card
	# must never offer the answer on screen as an "example" of the command
	Q_SRC="${1##*/}:$2"
	Q_TPL=$(sed -n 's/^q: \{0,1\}//p' "$blk")
	# what the learner reads is rendered once, fenced, and the plain copy is
	# taken from it by stripping -- not rendered a second time. two renders
	# would be two rolls of the same alternations and the prompt on screen
	# could name one file while everything measured against it named another.
	#
	# both marks, because a prompt has both kinds of thing in it. a rolled
	# name is fenced by sub() and comes out reversed; a literal the card
	# hardcodes -- empty-dir, missing.txt, src/[mu]*.c, the command itself --
	# is backticked by the author and comes out underlined, the same mark the
	# brief pages use for the same reason. backticks are fenced BEFORE the
	# roll, so a pool value can never be read as markup.
	Q_PROMPT_HI=$(printf '%s\n' "$Q_TPL" | fence | render_named "$seed")
	Q_PROMPT=$(printf '%s\n' "$Q_PROMPT_HI" | hi_strip | lit_strip)
	Q_ANSWERS=$(sed -n 's/^a: \{0,1\}//p' "$blk" | render "$seed")
	Q_OUT=$(sed -n 's/^out: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	Q_STATE=$(sed -n 's/^state: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	Q_STATUS=$(sed -n 's/^status: \{0,1\}//p' "$blk" | head -1)
	Q_PRE=$(sed -n 's/^pre: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	# Q_REF is the ONE command the grader demands (tier 2 checks the typed
	# line names it) and stays the first. Q_REFS is every page the card
	# wants open: a chain that answers `sort -u f | wc -l` used to show
	# sort's flags and nothing at all for wc, which is half the line.
	Q_REF=$(sed -n 's/^ref: \{0,1\}//p' "$blk" | head -1)
	Q_REFS=$(sed -n 's/^ref: \{0,1\}//p' "$blk")
	Q_CMP=$(sed -n 's/^cmp: \{0,1\}//p' "$blk" | head -1)
	Q_HINT=$(sed -n 's/^hint: \{0,1\}//p' "$blk" | render_named "$seed" | head -1)
	Q_SETUP=$(sed -n 's/^setup: \{0,1\}//p' "$blk" | render_named "$seed")
	# predict: a line the learner READS instead of writes. the card asks what
	# it prints, and the answer is that output -- the one card kind that
	# cannot be passed by finding another route to the same result, because
	# there is no route to find. it is how ${f%.log} against ${f#*.}, "$@"
	# against "$*", and > f 2>&1 against 2>&1 > f become testable at all:
	# produce-the-command cannot tell those pairs apart, which is exactly why
	# 04-redirection graded its own lesson wrong for so long.
	Q_PREDICT=$(sed -n 's/^predict: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	# a project block: the spec you read, the file you write, the reference
	# program and the cases both are run against. read only for a file under
	# projects/ -- every other card would pay four sed passes a question for
	# four fields it never has. the bodies go through render_tokens, not
	# render: they are code, and code has braces and pipes in it that the
	# {a|b|c} pass would read as a choice and throw half of away.
	Q_SPEC= Q_FILE= Q_PROG= Q_CASES= Q_START=
	case "$1" in
		"$PROJECTS"/*)
			Q_SPEC=$(sed -n 's/^spec: \{0,1\}//p' "$blk" | render_named "$seed")
			Q_FILE=$(sed -n 's/^file: \{0,1\}//p' "$blk" | head -1)
			Q_PROG=$(sed -n 's/^prog: \{0,1\}//p' "$blk" | render_tokens)
			Q_START=$(sed -n 's/^start: \{0,1\}//p' "$blk" | render_tokens)
			Q_CASES=$(sed -n 's/^case: \{0,1\}//p' "$blk" | render_tokens) ;;
	esac
	[ -n "$Q_PROMPT" ]
}

# a level id (08-cutting) resolves under levels/; a path with a slash
# (as scenarios pass it) is read as-is, so scenarios reuse this loader.
q_load() {
	case "$1" in
		*/*) blk_load "$1" "$2" ;;
		*)   blk_load "$(level_path "$1")" "$2" ;;
	esac
}

# ---- the question loop ----------------------------------------------------

ask() {                      # ask LEVEL INDEX ; returns 0 right, 1 wrong, 2 quit
	local key tier input tries=0 _said _crc
	q_load "$1" "$2" || return 1
	ED_OPEN= Q_WHY=           # every question starts with no panel open, no miss
	# a meta reply (?, blank, the man/tab words) re-asks the same line: wipe its
	# echo first so the prompt keeps its place instead of walking down the screen
	# one row per press. only on a real terminal, and only for the vi editor's
	# own line -- the piped fallback has no cursor to move.
	# CUU and ED, so it asks _csi like every other cursor write does. it also
	# tested stdin while writing to stdout; both now have to be a terminal.
	_meta_clear() { [ -t 0 ] && [ -t 1 ] && [ "$_csi" = 1 ] \
		&& printf '\033[%dA\r\033[J' "${ED_ROWS_USED:-1}"; return 0; }
	# a scenario passes its own file path (q_load's */* case): key that on
	# "scn/<basename>", not the raw path, or review() has no level id to
	# resolve back to a file and stats has no bucket to count it under.
	case "$1" in
		"$SCENARIOS"/*) key=$(card_key "scn/$(basename "$1")" "$2" "$Q_TPL") ;;
		*)              key=$(card_key "$1" "$2" "$Q_TPL") ;;
	esac

	# the rows this block spends, counted as they are printed rather than
	# guessed at: the panel opens under the answer line and gets whatever is
	# left, so a question with a long setup must shrink the panel, not run it
	# off the bottom of the screen.
	Q_ROWS=3                  # status bar, its rule, the answer line itself
	if [ -n "$Q_SETUP" ]; then
		# wrapped while still fenced and expanded after: fold counts the two
		# fence bytes, which costs a name's line two columns of a 76-column
		# wrap, where expanding first would hand fold whole escape sequences to
		# count and tear the paragraph. the row count is taken from the same
		# text, and marks change no line's existence.
		_said=$(printf '%s\n' "$Q_SETUP" | say)
		printf '%s\n' "$_said" | hi_expand; echo
		Q_ROWS=$(( Q_ROWS + 1 + $(printf '%s\n' "$_said" | hi_strip | _prows "${COLS:-80}") ))
	fi
	# the prose keeps the terminal's own foreground: the mark is a reversal of
	# whatever is under it, so it says the most when what is under it is plain.
	# wrapped the way the setup is, still fenced, so a narrow terminal breaks
	# it between words and not wherever the edge falls.
	_said=$(printf '%s\n' "$Q_PROMPT_HI" | wrap $(( COLS < 78 ? COLS - 2 : 76 )) | sed -e 's/ *$//' -e '/./s/^/  /')
	printf '%s\n' "$_said" | hi_expand | lit_expand
	Q_ROWS=$(( Q_ROWS + $(printf '%s\n' "$_said" | hi_strip | lit_strip | _prows "${COLS:-80}") ))
	# a predict card shows the line rather than asking for it. it is set off
	# from the prose because it is the thing being read, not the question.
	if [ -n "${Q_PREDICT:-}" ]; then
		printf '\n    %s%s%s\n\n' "$W" "$Q_PREDICT" "$N"
		Q_ROWS=$(( Q_ROWS + 3 ))
	fi
	# the two panels you can open at a card: ? for the hint, Tab for the
	# reference, either key again closes it. there is no skip and no try
	# limit -- a wrong line is wiped and you type another, for as long as it
	# takes, because the card is only learned once you have written it.
	# leaving is the typed word `quit` or Ctrl-C / Ctrl-D -- in help, not here.
	[ "$MODE" = learn ] && { note "? hint${SEP}tab ref"; Q_ROWS=$(( Q_ROWS + 1 )); }

	case "$MODE" in
		boss) ED_DEADLINE=$(( $(date +%s) + BOSS_LIMIT )) ;;
		*)    ED_DEADLINE= ;;
	esac
	while :; do
		if [ "$MODE" = boss ]; then
			# tradition, and a real test: thirty seconds is long enough to type
			# what you know and far too short to go and look it up. the editor
			# is here -- fixing a typo is not looking something up -- but the
			# hint, the reference and the history are not.
			clock_read "$BOSS_LIMIT"; _crc=$?
			[ "$_crc" = 3 ] && return 2
			if [ "$_crc" != 0 ]; then
				# the editor's own exit printed the newline; only the
				# cooked fallback still owes one.
				[ -t 0 ] || echo
				no "out of time."
				reveal "$(printf '%s\n' "$Q_ANSWERS" | head -1)"
				card_grade "$key" 0; S_WRONG=$((S_WRONG + 1)); S_STREAK=0
				return 1
			fi
			# ED_DEADLINE IS NOT CLEARED HERE. it was, and that put the hole
			# it exists to close straight back: a blank line, ? or tab all
			# `continue` this loop a few lines down, and with the deadline
			# gone clock_read minted a whole fresh BOSS_LIMIT on the way back
			# in. pressing enter every twenty seconds held a boss question
			# open forever. the deadline belongs to the QUESTION -- ask() sets
			# it at the top of every call, so nothing can leak forward either.
			# the tty path cannot produce a tab any more (the editor swallows
			# it), but the cooked fallback still can, and a literal tab in an
			# answer is graded against bytes no learner meant to type.
			input=$(printf '%s' "$CLOCK_LINE" | tr -d '\t')
		else
			# full vi-mode line editing with history (falls back to a plain read
			# when stdin is not a terminal, e.g. the build's own checks).
			read_line || return 2   # the editor draws its own mode-coloured prompt
			input="$REPLY_LINE"
		fi
		case "$input" in
			quit)     return 2 ;;
			'')       _meta_clear; continue ;;
			'?'|hint)
				if [ "$MODE" != learn ]; then
					note "no hints under the clock."
				elif [ -t 0 ]; then
					# toggle the hint panel under the answer line, in place
					if [ "$ED_OPEN" = hint ]; then ED_OPEN=; else ED_OPEN=hint; fi
					_meta_clear
				elif [ -n "$Q_HINT" ]; then
					note "$(printf '%s' "$Q_HINT" | hi_expand "$D")"
				else
					note "no hint. try: learn ref $Q_REF"
				fi
				continue ;;
			man|tab)
				if [ "$MODE" != learn ]; then
					note "no hints under the clock."
				elif [ -t 0 ]; then
					if [ "$ED_OPEN" = ref ]; then ED_OPEN=; else ED_OPEN=ref; fi
					_meta_clear
				else
					ref_panel_text "$(printf '%s\n' "$Q_ANSWERS" | head -1)"
				fi
				continue ;;
		esac

		if correct "$input"; then
			# the miss is already banked; getting there afterwards still counts
			# as the miss it was, however many tries it took -- but it is still
			# the right line, and a card that answers a correct line with silence
			# reads as one more miss to whoever just typed it.
			[ "$tries" -gt 0 ] && { ok "correct${SEP}${D}counted as a miss${N}"; return 1; }
			card_grade "$key" 1
			tier=$(card_tier "$key")
			S_RIGHT=$((S_RIGHT + 1)); S_STREAK=$((S_STREAK + 1))
			[ "$S_STREAK" -gt "$S_BEST" ] && S_BEST=$S_STREAK
			_stk=""
			[ "$S_STREAK" -ge 3 ] && _stk="  ${G}${S_STREAK} in a row${N}"
			ok "correct${tier:+  ${D}tier $tier${N}}$_stk"
			# five straight lights the banner; it burns until a miss
			[ "$S_STREAK" -eq 5 ] && printf '  %s on fire -- five straight %s\n' "$V$G" "$N"
			[ "$MODE" = learn ] && coach_right "$input"
			return 0
		fi

		# the card demotes once per question, on the first miss -- not once
		# per try, or a card fought with for a while would drop several tiers
		if [ "$tries" = 0 ]; then
			card_grade "$key" 0
			S_WRONG=$((S_WRONG + 1)); S_STREAK=0
		fi
		tries=$((tries + 1))
		if [ "$MODE" != learn ]; then
			no "wrong"
			reveal "$(printf '%s\n' "$Q_ANSWERS" | head -1)"
			return 1
		fi
		# learn mode says nothing on a miss: the typed line is wiped and the
		# prompt keeps its place, so the screen stays where it was and you try
		# again. what the miss had to teach is not lost, it is just not shouted
		# -- the diagnosis is banked here and ? puts it under the hint, so a
		# learner who is stuck asks for it and one who is close is not
		# interrupted. banked once per wrong line, at the line it describes.
		Q_WHY=$(coach_miss "$input" 2>/dev/null)
		_meta_clear
	done
}

# pick COUNT distinct numbers from 1..MAX, in random order
shuffle_n() {
	seq 1 "$1" | awk -v s="$RANDOM" 'BEGIN { srand(s) } { print rand() "\t" $0 }' |
		sort -n | cut -f2 | head -n "$2"
}

# the boss. five questions from the level just finished, no hints, no reference
# panel, four to pass. the point is not difficulty -- the questions are ones you
# have already answered. the point is answering them with nothing to lean on,
# which is the only honest test of whether you learned it or looked it up.
boss_round() {
	local id=$1 bname nq n right=0 asked=0 rc
	bname=$(level_field "$id" boss)
	nq=$(level_nq "$id")
	# returning 0 here marked the level passed with no boss fought, and a
	# passed level counts toward the gauntlet unlock. loud instead.
	[ -n "$bname" ] || die "level $id has no boss: line"
	[ "$nq" -ge 5 ] || die "level $id has $nq questions -- a boss draws 5"

	BOSS_LIMIT=$(boss_limit "$id")

	# the splash gets its own screen -- the boss is an event, not another card.
	# red, because red is what red is everywhere else on this screen: the
	# thing that can go against you. it cannot be confused with a wrong
	# answer -- a miss is one dim character at the left margin, this is two
	# full-width bars -- and it frees magenta to mean contrast and nothing
	# else. on the mono tier both still reverse, as they always did.
	cls
	echo
	printf '%s%s%s\n' "$R$B" "$BANNER" "$N"
	printf '  %sBOSS%s  %s%s%s%s\n' "$R$B" "$N" "$B" "$bname" "$N" \
		"$(printf '%*s' $(( COLS > 40 ? COLS - 32 - ${#bname} : 1 )) '')${D}${BOSS_LIMIT}s  pass: 4 of 5${N}"
	level_field "$id" flavor | say
	printf '%s%s%s\n' "$R" "$BANNER" "$N"
	note "no hints. no reference. the clock does not stop."
	pause_card || { MODE=learn; return 2; }

	MODE=boss
	local k=0
	for n in $(shuffle_n "$nq" 5); do
		k=$((k + 1))
		cls
		statusbar "BOSS: $bname" "no hints" "$k" "5" "$right"
		ask "$id" "$n"; rc=$?
		[ "$rc" = 2 ] && { MODE=learn; return 2; }
		[ "$rc" = 0 ] && right=$((right + 1))
		asked=$((asked + 1))
		pause_card || { MODE=learn; return 2; }
	done
	MODE=learn

	cls
	if [ "$right" -ge 4 ]; then
		statusbar "BOSS: $bname" "defeated" "$right" "5" ""
		printf '\n  %s%s falls.%s  %s of %s.\n' "$G$B" "$bname" "$N" "$right" "$asked"
		return 0
	fi
	statusbar "BOSS: $bname" "held" "$right" "5" ""
	printf '\n'
	no "$bname holds. $right of 5 -- need 4."
	return 1
}

run_level() {
	local id=$1 nq i k=0 right=0 total=0 rc lname lsub fp order rest _was
	nq=$(level_nq "$id")
	[ "$nq" -gt 0 ] || { note "level $id has no questions yet"; return 0; }
	lname=$(level_field "$id" name)
	lsub="level $(level_no "$id")"
	fp=$(level_fp "$id")

	# crossing into a new act gets its own screen, once, before that act's first
	# brief -- the felt boundary between parts of the climb. a resume past the
	# opener never sees it again (the ledger), and a level in no act just skips it.
	local _an=${id%%-*} _arow _aname _aintro
	_arow=$(act_row "$_an")
	if [ -n "$_arow" ] && [ "$_an" = "${_arow%%	*}" ] && ! act_seen "$_an"; then
		_aname=${_arow#*	}; _aintro=${_aname#*	}; _aname=${_aname%%	*}
		cls
		hdr "$_aname" "a new part of the climb"
		printf '%s\n' "$_aintro" | say
		act_marked "$_an"
		pause_card || return 2
	fi

	# the brief teaches once, on its own screen; after that the header alone, so
	# a resume is the questions, not the lecture. `learn brief <n>` reprints it.
	if ! level_is_briefed "$id"; then
		cls
		hdr "$lname" "level $(level_no "$id")  ${nq} questions"
		level_field "$id" brief | say
		level_briefed "$id"
		pause_card || return 2
	fi

	# the order changes every run, so the level cannot be memorised as a
	# sequence -- only as a set of things you can do. one card per screen.
	# a level left unfinished keeps its order and its score: you come back to
	# the cards you had not answered, not to the whole level again.
	# the status bar carries the news -- "resumed  21/33" says it without
	# spending a screen and a keypress on saying it.
	if inprog_load "$id" "$fp" "$nq"; then
		order=$INPROG_LEFT; right=$INPROG_RIGHT; total=$INPROG_DONE; k=$total
		lsub="$lsub  resumed"
	else
		order=$(shuffle_n "$nq" "$nq")
	fi
	inprog_save "$id" "$fp" "$right" "$total" $order
	while :; do
		set -f; set -- $order; set +f
		[ $# -gt 0 ] || break
		i=$1; shift; rest="$*"
		k=$((k + 1))
		cls
		statusbar "$lname" "$lsub" "$k" "$nq" "$right"
		ask "$id" "$i"; rc=$?
		# quitting mid-card leaves that card owed: the place on disk still
		# has it at the head, because it was never answered.
		[ "$rc" = 2 ] && return 2
		[ "$rc" = 0 ] && right=$((right + 1))
		total=$((total + 1))
		order=$rest
		inprog_save "$id" "$fp" "$right" "$total" $order
		pause_card || return 2
	done
	# the questions are done and the boss is a fresh event -- but the place is
	# not. clearing it here meant a boss you walked away from cost you every
	# card in the level: the next run found no record and reshuffled all of
	# them to get back to the one fight that was left. keep the record in its
	# terminal shape -- everything answered, nothing owed -- so the next run
	# resumes AT the boss. an unbeaten boss still leaves the level unpassed;
	# that is level_passed's call, below, and it is the only one that clears.
	inprog_save "$id" "$fp" "$right" "$total"

	cls
	statusbar "$lname" "$lsub" "$total" "$total" "$right"
	printf '\n  %s%s/%s%s\n' "$B" "$right" "$total" "$N"
	echo
	while :; do
		boss_round "$id"; rc=$?
		# a fall that was already a fall announces nothing -- asked before the
		# write, because after it every level looks long since passed. the pause
		# only lands when something opened, so every other boss keeps its rhythm.
		if [ "$rc" = 0 ]; then
			level_is_passed "$id"; _was=$?
			level_passed "$id"
			[ "$_was" = 0 ] || { { scn_announce "$id"; prj_announce "$id"; } && pause_card; }
			return 0
		fi
		[ "$rc" = 2 ] && return 2
		# a fallen learner gets the choice a fallen boss never offers:
		# straight back in, or back to practice. EOF (the build's probes,
		# a closed pipe) declines, so nothing automated can hang here.
		printf '  %sretry the boss? [y/N]%s ' "$D" "$N"
		IFS= read -r _again 2>/dev/null || _again=""
		case "$_again" in y|Y|yes) echo; continue ;; esac
		return "$rc"
	done
}

# what is printed when ROOT falls. it names the one thing that is actually
# different about you now, and it is deliberately not a congratulation: the
# skill is the reward, and it is a skill that works on machines that have never
# heard of this one.
victory() {
	echo
	printf '%s%s%s\n' "$G$B" "$BANNER" "$N"
	printf '  %sROOT answers to you.%s\n' "$B" "$N"
	printf '%s%s%s\n' "$G" "$BANNER" "$N"
	# hand-wrapped, and printed rather than folded: say() would re-wrap prose
	# that is already the right width and break it in the wrong places.
	cat <<-'EOF'

	  Every level is behind you. What changed is not that you know more
	  commands. It is that you can walk up to a machine, ask what it is
	  running, and check the answer instead of believing it.

	  That is the whole point. You read the root hash off the kernel
	  command line, hashed the filesystem underneath you, and knew why
	  the comparison only means something when the number came from
	  somewhere else. No tool did that for you. You did it with sed,
	  sha256sum and a pipe.

	  None of it was specific to this operating system. These commands
	  are forty years old and will outlive it, and they are waiting on
	  every unix you will ever be handed -- including the ones you have
	  no reason to trust.

	  The base is yours. The other half is the toolkit -- the arsenal on
	  the encrypted side of the stick. When it is set up, `arsenal learn`
	  walks you through it the way this walked you through the shell.

	    learn stats    what you kept, not what you passed once
	    learn N        any level again. the questions are generated, so
	                   they will not be the ones you memorised
	EOF
	echo
}

# ---- review ---------------------------------------------------------------

# what you owe today, soonest-due first -- and when you owe nothing, the
# weakest cards instead, so review is never a closed door.
#
# the due queue is the point of the schedule: it is the tool telling you what
# to sit down to rather than you guessing. the weakest-first sort is kept for
# the fallback because "nothing is due" is the moment you most want a session
# aimed at where you are actually worst.
review() {
	local n=${1:-20} line key lvl rest idx tpl rc path sub=due
	[ -s "$CARDS" ] || { note "no cards yet -- answer some questions first"; return 0; }
	cards_due | head -n "$n" > "$TMP/rev"
	local nc k=0; nc=$(grep -c . "$TMP/rev")
	if [ "$nc" -eq 0 ]; then
		sub=weakest
		note "nothing due -- the weakest cards instead."
		cards_sort_weak < "$CARDS" | head -n "$n" > "$TMP/rev"
		nc=$(grep -c . "$TMP/rev")
	fi
	# the list is read on fd 3 because ask() owns stdin
	while IFS= read -r line <&3; do
		key=$(printf '%s\n' "$line" | cut -f1)
		lvl=${key%%/*}; rest=${key#*/}; idx=${rest%%#*}; tpl=${rest#*#}
		# a mission card keys as "scn/<basename>/<idx>" -- unwrap the basename
		# back into a scenario path; everything else is a plain level id.
		if [ "$lvl" = scn ]; then
			path=$(scn_path "${idx%%/*}"); idx=${idx#*/}
		else
			path=$(level_path "$lvl")
		fi
		[ -f "$path" ] || continue
		# a card whose template no longer matches its block is stale -- the
		# file was edited since. skip it rather than ask the wrong thing. the
		# stored tpl is card_key's backtick/tab-stripped form, so Q_TPL must be
		# stripped the same way before comparing -- a raw compare called every
		# ``name``-marked card stale and dropped it from every review.
		blk_load "$path" "$idx" >/dev/null 2>&1 || continue
		[ "$(printf '%s' "$Q_TPL" | tr -d '\t`')" = "$tpl" ] || continue
		k=$((k + 1))
		cls
		statusbar "review" "$sub" "$k" "$nc" ""
		# a level card is asked by its level ID, which is what ask() keys on.
		# passing the file path keyed a second, absolute-path card that stats
		# never counted and the next review could not resolve.
		if [ "$lvl" = scn ]; then ask "$path" "$idx"; else ask "$lvl" "$idx"; fi; rc=$?
		[ "$rc" = 2 ] && return 0
		pause_card || return 0
	done 3< "$TMP/rev"
}

# ---- placement ------------------------------------------------------------

# ten rungs up the curriculum, one question each. two misses in a row stops
# the climb; every level below the last rung cleared is marked placed, so a
# bare `learn` then starts where your knowledge actually stops. placed is NOT
# passed -- a ten-question guess is not a boss fought, and must never be able
# to unlock the gauntlet the way one actually beaten does.
place() {
	local rung rung_i lvl last=0 misses=0 nq idx rc
	cls
	hdr "placement" "one question per rung  no hints"
	note "two misses in a row stops the climb."
	pause_card || return 0
	MODE=daily   # the editor, no hints -- placement measures, it does not teach
	rung_i=0
	for rung in 03 06 09 12 15 18 21 24 27 30; do
		lvl=$(level_ids | grep "^$rung-" | head -1)
		[ -n "$lvl" ] || continue
		nq=$(level_nq "$lvl")
		[ "$nq" -gt 0 ] || continue
		rung_i=$((rung_i + 1))
		rnd "$nq"; idx=$((REPLY + 1))
		cls
		statusbar "placement" "rung $(level_num "$lvl")" "$rung_i" "10" ""
		ask "$lvl" "$idx"; rc=$?
		[ "$rc" = 2 ] && { MODE=learn; return 0; }
		pause_card || { MODE=learn; return 0; }
		if [ "$rc" = 0 ]; then
			last=$(level_num "$lvl"); misses=0
		else
			misses=$((misses + 1))
			[ "$misses" -ge 2 ] && break
		fi
	done
	MODE=learn
	rule
	if [ "$last" -gt 0 ]; then
		for lvl in $(level_ids); do
			[ "$(level_num "$lvl")" -lt "$last" ] && level_placed "$lvl"
		done
		ok "placed. everything below level $last is marked placed -- 'learn' picks up there."
	else
		note "starting from the top. that is where everyone starts."
	fi
}

# ---- daily ----------------------------------------------------------------

# one question a day, the same one for everyone on the same date, drawn from
# the top third of the curriculum and asked under boss rules: thirty seconds,
# no hints, no reference, no editor. the seed is the day number and the pinned
# busybox fixes the rand() stream, so one build asks one daily everywhere.
# (RANDOM is seedable -- ASH_RANDOM_SUPPORT is on for exactly this.)
daily() {
	local day nl lo lvl nq idx rc
	# the label and the seed must agree on what "today" is, or "the same one
	# everywhere" only holds until someone west of UTC opens it after 5pm --
	# date +%s is UTC seconds regardless of TZ, so the label goes UTC too
	day=$(date -u +%Y-%m-%d 2>/dev/null || echo today)
	RANDOM=$(( $(date +%s 2>/dev/null || echo 0) / 86400 ))
	nl=$(level_ids | grep -c .)
	lo=$(( nl * 2 / 3 ))
	# draw in THIS shell: a subshell re-seeds RANDOM from its own pid, which
	# would make the "same one everywhere" claim quietly false
	rnd $(( nl - lo )); lvl=$(level_ids | sed -n "$(( lo + REPLY + 1 ))p")
	nq=$(level_nq "$lvl")
	[ "$nq" -gt 0 ] || { no "no daily today: level $lvl has no questions."; return 1; }
	rnd "$nq"; idx=$((REPLY + 1))
	BOSS_LIMIT=$(boss_limit "$lvl")   # the clock that level's own boss runs
	cls
	statusbar "daily" "$day  no hints" 1 1 ""
	MODE=boss
	ask "$lvl" "$idx"; rc=$?
	MODE=learn
	[ "$rc" = 2 ] && return 0
	# a persistent day-streak: the daily is once a day by construction, so a
	# streak means showing up and getting it right on consecutive UTC days. the
	# first daily of a new day advances or breaks it; re-opening the same day
	# just shows what stands. keyed on the day NUMBER, so no date-string math.
	local dnum lastd dstreak dbest
	dnum=$(( $(date +%s 2>/dev/null || echo 0) / 86400 ))
	[ -f "$DAILY" ] && read -r lastd dstreak dbest < "$DAILY" 2>/dev/null || true
	lastd=${lastd:-0}; dstreak=${dstreak:-0}; dbest=${dbest:-0}
	if [ "$lastd" != "$dnum" ]; then
		if [ "$rc" = 0 ]; then
			[ "$lastd" = "$((dnum - 1))" ] && dstreak=$((dstreak + 1)) || dstreak=1
		else
			dstreak=0
		fi
		[ "$dstreak" -gt "$dbest" ] && dbest=$dstreak
		mkdir -p "$STATE" 2>/dev/null || true
		printf '%s %s %s\n' "$dnum" "$dstreak" "$dbest" > "$DAILY.tmp.$$" 2>/dev/null 			&& mv "$DAILY.tmp.$$" "$DAILY" 2>/dev/null || rm -f "$DAILY.tmp.$$" 2>/dev/null
	fi
	rule
	printf '  %sdaily %s%s  %s%s\n' "$B" "$day" "$N" \
		"$([ "$rc" = 0 ] && echo correct || echo wrong)" \
		"$([ "$dstreak" -ge 2 ] && printf '  %s%s-day streak%s' "$G" "$dstreak" "$N")"
	# every other mode holds the screen after a card; daily did not, so called
	# from the menu the verdict was wiped by the next redraw before it could be
	# read -- one card answered and back at the menu reads as an insta-exit.
	pause_card || return 0
}

# ---- stats ----------------------------------------------------------------

stats() {
	hdr "mastery" "$(grep -c . "$CARDS" 2>/dev/null || echo 0) cards"
	local id n m sn sm pn pm lk ln lkey lid lrest ltpl lname
	# one pass, and the same one held_ids uses: counting by key prefix here
	# and by rebuilt key there would be two answers to "have you still got
	# this level", which is the drift every shared walker in here exists to
	# avoid. it also stops an orphaned key reading as 35 of 33 mastered.
	held_scan > "$TMP/mastered"
	local _ar _af _lastact=
	for id in $(level_ids); do
		# an act header prints once, above its first level, so the mastery list
		# reads as the same journey the climb does. no acts file -> no headers.
		_ar=$(act_row "${id%%-*}")
		if [ -n "$_ar" ]; then
			_af=${_ar%%	*}
			if [ "$_af" != "$_lastact" ]; then
				_lastact=$_af; _ar=${_ar#*	}; _ar=${_ar%%	*}
				printf '\n  %s%s%s\n' "$D" "$_ar" "$N"
			fi
		fi
		n=$(level_nq "$id")
		m=$(awk -v id="$id" '$1 == id { print $2 }' "$TMP/mastered"); m=${m:-0}
		printf '  %s%-28s%s %s%s/%s%s\n' "$W" "$(level_field "$id" name)" "$N" \
			"$([ "$m" = "$n" ] && echo "$G" || echo "$D")" "$m" "$n" "$N"
	done
	# mission cards key on "scn/..." rather than a level id, so they earn
	# their own row instead of vanishing out of every level's count above.
	sn=$(awk -F'\t' '$1 ~ /^scn\// { c++ } END { print c + 0 }' "$CARDS" 2>/dev/null)
	if [ "$sn" -gt 0 ]; then
		sm=$(awk -F'\t' '$1 ~ /^scn\// && $2 == 2 { c++ } END { print c + 0 }' "$CARDS" 2>/dev/null)
		printf '  %s%-28s%s %s%s/%s%s\n' "$W" missions "$N" \
			"$([ "$sm" = "$sn" ] && echo "$G" || echo "$D")" "$sm" "$sn" "$N"
	fi
	# projects sit apart on purpose: they are not cards, they do not decay,
	# and a program you wrote is a thing you did rather than a thing you hold.
	pn=$(for id in $(project_ids); do prj_nq "$id"; done | awk '{ n += $1 } END { print n + 0 }')
	if [ "$pn" -gt 0 ]; then
		pm=$(for id in $(project_ids); do prj_ndone "$id"; done | awk '{ n += $1 } END { print n + 0 }')
		printf '  %s%-28s%s %s%s/%s%s\n' "$W" projects "$N" \
			"$([ "$pm" = "$pn" ] && echo "$G" || echo "$D")" "$pm" "$pn" "$N"
	fi
	# the cards that keep getting away. everything above this line says where
	# you are; this says which questions keep taking you back there -- and a
	# card you have lost four times is not one more card, it is the one to go
	# and read the reference for.
	# the daily's own streak: consecutive UTC days answered correctly, and the
	# best run so far. only shown once the daily has ever been played.
	if [ -f "$DAILY" ]; then
		local _dd _ds _db; read -r _dd _ds _db < "$DAILY" 2>/dev/null || true
		[ -n "${_ds:-}" ] && printf '  %s%-28s%s %s%s%s  %sbest %s%s\n' \
			"$W" "daily streak" "$N" "$G" "${_ds:-0}" "$N" "$D" "${_db:-0}" "$N"
	fi
	lk=$(cards_leeches 3 | head -5)
	if [ -n "$lk" ]; then
		rule
		note "keeps getting away"
		printf '%s\n' "$lk" | while IFS="$(printf '\t')" read -r ln lkey; do
			[ -n "$lkey" ] || continue
			lid=${lkey%%/*}; lrest=${lkey#*/}
			# the level's number, not its name: it is what you type to go back
			# to it, and it costs two columns instead of thirteen that still
			# truncate. a mission key is "scn/<file>/<idx>#..." -- one
			# component deeper, and it says scn rather than its own number,
			# which would read as a level.
			if [ "$lid" = scn ]; then lname=scn; lrest=${lrest#*/}
			else lname=${lid%%-*}; fi
			ltpl=${lrest#*#}
			# the stored key is the template, alternations and all. show the
			# first branch of each -- the card is one card however it rolled,
			# and "{print|show} the directory" reads as neither.
			printf '  %s%2sx%s %s%3s%s %s\n' "$R" "$ln" "$N" "$D" "$lname" "$N" \
				"$(printf '%s' "$ltpl" | sed 's/{\([^{}|]*\)|[^{}]*}/\1/g' | cut -c1-62)"
		done
	fi
	# what you got wrong at the real prompt. everything above this line is
	# the quiz grading itself; this is the machine grading you, on work you
	# chose to do, with the tool deciding nothing about which command came up.
	local fk fn fc
	fk=$(fum_top 5)
	if [ -n "$fk" ]; then
		rule
		note "fumbled at the prompt"
		printf '%s\n' "$fk" | while IFS="$(printf '\t')" read -r fn fc; do
			[ -n "$fc" ] || continue
			printf '  %s%3sx%s %s%-12s%s %s\n' "$R" "$fn" "$N" "$W" "$fc" "$N" \
				"$(summary_of "$fc" | cut -c1-48)"
		done
	fi
	rule
	if [ "${FUM_NEW:-0}" -gt 0 ]; then
		note "$FUM_NEW command(s) came in from the prompt -- ${FUM_PULLED:-0} card(s) came due."
	fi
	note "tier 2 is mastered. every card carries its own due date -- $(cards_ndue) due now."
	note "a card left more than $GRACE_DAYS days past due loses a rung."
	note "a level in green is HELD: the gauntlet wants all of them at once."
}

# ---- session summary ------------------------------------------------------

# shown when a session of questions ends -- a run you can try to beat. only
# printed when questions were actually attempted, so `learn ref ls` stays quiet.
session_summary() {
	[ $((S_RIGHT + S_WRONG)) -gt 0 ] || return 0
	local secs=0 mins
	[ "$S_START" -gt 0 ] && secs=$(( $(date +%s 2>/dev/null || echo "$S_START") - S_START ))
	mins=$((secs / 60))
	echo
	rule
	printf '  %ssession%s  %s%d correct%s  %s%d wrong%s  best streak %s%d%s' \
		"$B" "$N" "$G" "$S_RIGHT" "$N" "$R" "$S_WRONG" "$N" "$G" "$S_BEST" "$N"
	[ "$mins" -gt 0 ] && printf '  %s%dm%s' "$D" "$mins" "$N"
	echo
	# a line of encouragement scaled to how it went -- flavour, not a grade
	if [ "$S_WRONG" -eq 0 ] && [ "$S_RIGHT" -ge 5 ]; then
		note "clean run. nothing got past you."
	elif [ "$S_BEST" -ge 10 ]; then
		note "a ten-streak. that is muscle memory forming."
	fi
}

# ---- fumbles --------------------------------------------------------------

# the one screen that says what is recorded, in the same words whether it is
# on or off. a switch whose state you have to infer is a switch nobody trusts.
fumbles() {
	case "${1:-}" in
		on)    fum_on;  ok "recording on -- open a new shell for it to take effect."
		       note "only a command NAME, and only one this image teaches. never an argument." ;;
		off)   fum_off; ok "recording off -- takes effect at the next prompt, in every shell."
		       note "the counts already collected are kept. learn fumbles clear drops them too." ;;
		clear) fum_forget; ok "cleared -- the queue and the counts are gone, and recording is off." ;;
		'')    ;;
		*)     die "usage: learn fumbles [on|off|clear]" ;;
	esac
	hdr "fumbles" "$(fum_is_on && echo recording || echo "not recording")"
	echo "what you got wrong at the real prompt, not in the quiz. a command name is
kept only when this image ships a reference page for it, and nothing else is
kept at all -- no flag, no path, no argument, no time. a card whose answer
runs one of these comes due the next time learn opens." | say
	local n c
	if [ -s "$FUMBLED" ]; then
		rule
		fum_top 10 | while IFS="$(printf '\t')" read -r n c; do
			[ -n "$c" ] || continue
			printf '  %s%3sx%s %s%-12s%s %s\n' "$R" "$n" "$N" "$W" "$c" "$N" \
				"$(summary_of "$c" | cut -c1-48)"
		done
	fi
	rule
	if fum_is_on; then
		note "learn fumbles off stops it. learn fumbles clear also drops the counts."
	else
		note "learn fumbles on starts it. it is off until you say otherwise."
	fi
	note "the prompt hook lives in /etc/shrc, so this fills up on the stick itself."
}

# ---- dispatch -------------------------------------------------------------

MODE=learn
# session stats -- the game layer. streak is consecutive correct; the summary at
# the end turns a study session into a run you can beat next time.
S_RIGHT=0; S_WRONG=0; S_STREAK=0; S_BEST=0; S_START=$(date +%s 2>/dev/null || echo 0)
cards_init
migrate
cards_rehome
cards_decay
# the prompt loop, drained before anything reads the schedule. cards_decay has
# to have run first: it is what normalises a row an older build wrote, and
# fum_pull moves a due date, which a three-field row does not have yet.
FUM_NEW=0 FUM_PULLED=0
if fum_drain > "$TMP/fumnew" 2>/dev/null; then
	FUM_NEW=$(grep -c . "$TMP/fumnew" 2>/dev/null || echo 0)
	FUM_PULLED=$(fum_pull "$TMP/fumnew" 2>/dev/null || echo 0)
fi
ctx_init

usage() {
	cat <<-EOF
	learn                 the main menu (or resumes, when piped)
	learn N               practice level N
	learn brief N         reprint level N's teaching brief
	learn ref CMD         the reference entry for a command
	learn CMD             same, shorthand
	learn -k WORD         search the corpus
	learn list            every command xos ships
	learn place           placement: skip past the levels you already know
	learn review [N]      re-ask your weakest cards, weakest first
	learn daily           today's one -- a hard card under the clock, same everywhere
	learn challenge       the gauntlet: timed chains, one life, a best to beat
	learn scenario [NAME] missions -- narrative pipelines, or the list of unlocked ones
	learn project [NAME]  write a program against a spec, or the list of them
	learn c [N]           learn c: read a lesson, write it in vi, it compiles and runs
	learn shell [SEED]    a shell in the tree the cards run against
	learn autopsy [FILE]  your own shell history, held up to the curriculum
	learn explain LINE    every command's summary plus the shell syntax in it
	learn stats           what you have mastered
	learn fumbles [on|off] what you got wrong at the real prompt
	learn reset           forget all progress

	at a question: type your answer with full vi editing -- Esc for normal
	mode, then h l w b e x dd i a, and the up-arrow recalls what you typed.
	?  hint    Tab  the reference, Tab again to close
	type quit, or press Ctrl-C / Ctrl-D, to leave.
	EOF
}

# ---- playground -----------------------------------------------------------

# a shell in the tree the cards are graded against.
#
# every other way into that tree is a graded answer, so there was nowhere to
# just try a thing and watch what it did -- which is how anyone has ever
# actually learned a shell. the isolation is the one grading already trusts:
# a tmpfs tree built by and owned by nobody, under a read-only root, thrown
# away when the shell exits. so this costs nothing to hand over.
#
# the seed is printed and accepted back. a tree is a function of its seed, so
# "the file I was just looking at" is reachable again tomorrow -- without it
# the fixtures would be a different set of bytes every time and nothing you
# noticed in here could be shown to anyone.
playground() {
	local seed=${1:-} tty_
	case "$seed" in
		''|*[!0-9]*) rnd 32768; seed=$REPLY ;;
	esac
	FX_SEED=$seed
	sandbox_build || die "cannot build the sandbox"
	cls
	hdr "playground" "seed $seed"
	note "the tree the cards run against. nothing in it survives the exit."
	[ -n "$DROP" ] && note "you are nobody here -- the rest of the machine is not yours to touch."
	note "exit, or ctrl-d, to come back."
	rule
	# the tty is put back the way learn found it either way: a shell left in
	# vi-insert with echo off would hand a wrecked terminal back to the menu.
	tty_=$(stty -g 2>/dev/null) || tty_=
	[ -n "$tty_" ] && stty sane 2>/dev/null
	# shellcheck disable=SC2086
	( cd "$SANDBOX" 2>/dev/null || exit 1
	  HOME="$SANDBOX" TMPDIR="$SANDBOX" exec $DROP "$SHELLBIN" -i )
	[ -n "$tty_" ] && stty "$tty_" 2>/dev/null
	# the next question rebuilds: the learner has been writing in here.
	SANDBOX_DIRTY=1
	cls
	note "tree discarded. 'learn shell $seed' builds that same one again."
}

# ---- resume + main menu ---------------------------------------------------

# the campaign: run every level not yet passed or placed, in order, until one
# is left unfinished or the last boss falls.
# a level `continue` still owes you: not beaten, not skipped at placement.
level_pending() { ! level_is_passed "$1" && ! level_is_placed "$1"; }

# the level continue would open, or 1 when the ladder is done. same predicate
# as the walk below, so the confirm can never name a level resume would skip.
resume_target() {
	local _id
	for _id in $(level_ids); do
		level_pending "$_id" && { printf '%s\n' "$_id"; return 0; }
	done
	return 1
}

resume() {
	local _all=1 _ran=0 _id _stale
	for _id in $(level_ids); do
		level_pending "$_id" || continue
		_ran=1
		run_level "$_id" || { _all=0; break; }
	done
	if [ "$_ran" = 0 ]; then
		# nothing left to sit is not the same as holding it all. this printed
		# "the gauntlet is open" after a pure placement run while the gauntlet
		# itself refused entry: the banner counted placed levels and the gate
		# did not. both ask the same question now.
		_stale=0
		for _id in $(level_ids); do
			level_is_passed "$_id" || { _stale=$((_stale + 1)); continue; }
			level_is_held "$_id"   || _stale=$((_stale + 1))
		done
		cls
		if [ "$_stale" = 0 ]; then
			hdr "learn" "every level held"
			note "the gauntlet is open."
		else
			hdr "learn" "nothing left to sit"
			note "$_stale level(s) not held -- a boss unfought, or cards gone stale."
			note "'learn review' is where they come back."
		fi
		pause_card || return 0
	elif [ "$_all" = 1 ]; then
		victory
	fi
}

# the one destructive key in the tree, so it asks twice and names what goes.
# it is reached only with something to lose: on a blank install n is the way
# back to the menu, because there is nothing there to warn about.
new_game() {
	local k
	printf '\n  %sa new game wipes every level, card and saved place%s\n' "$Y" "$N"
	printf '  %sthere is no undo -- y to wipe%s ' "$Y" "$N"
	IFS= read -rsn1 k 2>/dev/null || return 1
	echo
	case "$k" in y|Y) : ;; *) return 1 ;; esac
	state_wipe || { no "cannot clear $STATE"; pause_card; return 1; }
	# the card file and this session's seen-list are process state as much as
	# they are files: without this the first level of the new game skips every
	# card the old one had already shown.
	cards_init
	return 0
}

# continue was the one key that committed on press: a slipped c dropped you
# into a level mid-card, and a mid-level place can only be left by finishing
# or quitting it. it names the level and the place first now, and offers the
# one thing the menu had no way to do -- throw the whole run away and start
# over at level 0 (n).
resume_confirm() {
	local id k n nq fp lname held=0 fresh=0
	id=$(resume_target) || { resume; return 0; }
	progress_any || fresh=1
	n=${id%%-*}; n=${n#0}
	nq=$(level_nq "$id"); fp=$(level_fp "$id")
	lname=$(level_field "$id" name)
	inprog_load "$id" "$fp" "$nq" && held=1
	if [ "$held" = 1 ] && [ -z "$INPROG_LEFT" ]; then
		# nothing owed means the cards are done and the boss is what is left.
		# "37 of 37 answered" is true and says none of that.
		printf '  %slevel %s  %s%s %s-- at the boss, %s of %s correct%s\n' \
			"$W" "$n" "$lname" "$N" "$D" "$INPROG_RIGHT" "$nq" "$N"
	elif [ "$held" = 1 ]; then
		printf '  %slevel %s  %s%s %s-- %s of %s answered, %s correct%s\n' \
			"$W" "$n" "$lname" "$N" "$D" "$INPROG_DONE" "$nq" "$INPROG_RIGHT" "$N"
	else
		printf '  %slevel %s  %s%s %s-- %s questions, from the top%s\n' \
			"$W" "$n" "$lname" "$N" "$D" "$nq" "$N"
	fi
	if [ "$fresh" = 1 ]; then
		printf '  %snew game? (Y/n)%s ' "$W" "$N"
	else
		printf '  %scontinue? (Y/n)%s ' "$W" "$N"
	fi
	IFS= read -rsn1 k 2>/dev/null || return 0
	echo
	case "$k" in
		''|y|Y) resume ;;
		n|N)    [ "$fresh" = 1 ] || { new_game && resume; } ;;
	esac
	return 0
}

_mi() { printf '   %s%s%s   %s%-10s%s %s%s%s\n' "$C$B" "$1" "$N" "$W" "$2" "$N" "$D" "$3" "$N"; }
_mi_off() { printf '   %s%s   %-10s %s%s\n' "$D" "$1" "$2" "$3" "$N"; }

# the main menu: a full-screen home you steer with one key. every mode returns
# here rather than to the shell, so a session is a place you are in, not a
# series of commands you retype. non-interactive callers never reach it.
menu() {
	local k p t h id due unlocked=1
	level_ids > "$TMP/ids"
	t=$(grep -c . "$TMP/ids")
	while :; do
		# recount each loop: a boss fought from the menu can unlock the gauntlet.
		# one awk, not a grep per level on every keypress.
		p=$(awk 'NR == FNR { ids[$1] = 1; next } ($1 in ids) { c++ } END { print c + 0 }' \
			"$TMP/ids" "$PASSED" 2>/dev/null); p=${p:-0}
		# beaten is a record and never moves. held is whether you still have
		# it, and it is the one the endgame asks: a boss fought in january
		# proves nothing about a card that rotted in march.
		held_ids > "$TMP/held" 2>/dev/null
		h=$(awk 'NR == FNR { ids[$1] = 1; next } ($1 in ids) { c++ } END { print c + 0 }' \
			"$TMP/ids" "$TMP/held" 2>/dev/null); h=${h:-0}
		{ [ "$p" -eq "$t" ] && [ "$h" -eq "$t" ]; } && unlocked=1 || unlocked=0
		# recounted every loop for the same reason held is: a review just
		# taken has changed it, and a menu that says 17 due after you cleared
		# them is a menu nobody trusts twice.
		due=$(cards_ndue); due=${due:-0}

		cls
		hdr "learn" "the shell, one card at a time"
		printf '  '; bar "$h" "$t" 20
		printf ' %s%s/%s held%s  %s(%s beaten)%s\n\n' "$D" "$h" "$t" "$N" "$D" "$p" "$N"

		if progress_any; then _mi c continue "where you left off"
		else _mi c "new game" "start at level 0"; fi
		_mi p practice  "any level by number"
		_mi r review    "$([ "$due" -gt 0 ] && echo "$due due" || echo "weakest cards first")"
		_mi d daily     "one hard card, same for all"
		if [ "$unlocked" = 1 ]; then _mi g gauntlet "30s a stage, one life"
		elif [ "$p" -eq "$t" ]; then _mi_off g gauntlet "$((t - h)) level(s) gone stale -- review"
		else _mi_off g gauntlet "locked until every level is held"; fi
		_mi x placement "skip what you know"
		_mi f find      "any command's reference"
		if scenarios_any_unlocked; then _mi m missions "pipelines on real machine state"
		else _mi_off m missions "locked until a level unlocks one"; fi
		if projects_any_unlocked; then _mi w projects "write a program against a spec"
		else _mi_off w projects "locked until a level unlocks one"; fi
		_mi C c         "learn c: read a lesson, write it in vi"
		_mi t shell     "a shell in the tree the cards use"
		_mi s stats     "what you've mastered"
		_mi a autopsy   "your shell history vs the curriculum"
		_mi h help      "usage and every command"
		_mi q quit      ""
		rule
		printf '  %schoose%s ' "$D" "$N"
		IFS= read -rsn1 k 2>/dev/null || break
		echo
		case "$k" in
			c) resume_confirm ;;
			p) cls; printf '  %spractice which level? (0-%s)%s ' "$W" "$((t - 1))" "$N"
			   IFS= read -r k 2>/dev/null || continue
			   id=$(level_ids | grep "^0*$k-" | head -1)
			   if [ -n "$id" ]; then run_level "$id"; else no "no level $k"; pause_card; fi ;;
			r) review 20 ;;
			d) daily ;;
			g) if [ "$unlocked" = 1 ]; then challenge; else no "the gauntlet is locked."; pause_card; fi ;;
			x) place ;;
			f) cls; printf '  %swhich command?%s ' "$W" "$N"
			   IFS= read -r k 2>/dev/null || continue
			   [ -n "$k" ] && { cls; ref "$k"; pause_card; } ;;
			m) if scenarios_any_unlocked; then scenarios_menu; else no "no missions unlocked yet."; pause_card; fi ;;
			w) if projects_any_unlocked; then projects_menu; else no "no projects unlocked yet."; pause_card; fi ;;
			C) c_menu ;;
			t) playground "" ;;
			s) cls; stats; pause_card ;;
			a) cls; autopsy; pause_card ;;
			h|'?') cls; usage; pause_card ;;
			q|:q|Q|"$E_EOT") break ;;   # q or Ctrl-D leaves
		esac
	done
}

case "${1:-}" in
	'')       # interactive: the menu. piped (a build probe, a script): resume
	          # straight through, so nothing automated waits on a keypress.
	          if [ -t 0 ]; then menu; else resume; fi
	          session_summary ;;
	ref)      shift; ref "$@" ;;
	brief)    shift; _id=$(level_ids | grep "^0*${1:-}-" | head -1)
	          [ -n "$_id" ] || die "usage: learn brief N"
	          hdr "$(level_field "$_id" name)" "level $(level_no "$_id")"
	          level_field "$_id" brief | say ;;
	-k)       shift; search "$@" ;;
	list)     surface ;;
	stats)    stats ;;
	selftest) selftest ;;
	necessity) necessity ;;
	daily)    daily; session_summary ;;
	place)    place; session_summary ;;
	lint)     shift; lint "${1:-}" ;;
	challenge) shift
	          case "${1:-}" in
	          	check) chal_check ;;
	          	# challenge has its own end screen (chal.sh) -- session_summary
	          	# is card-based and chal never touches S_RIGHT/S_WRONG, so it
	          	# would print an empty summary after a real one
	          	*)     challenge ;;
	          esac ;;
	coverage) shift; coverage "${1:--q}" ;;
	refcheck) refcheck ;;
	order)    order ;;
	compose)  shift; compose "${1:-}" ;;
	review)   shift; review "${1:-20}"; session_summary ;;
	scenario) shift
	          if [ -z "${1:-}" ]; then
	          	scenarios_menu
	          else
	          	_sid=$(scenario_ids | grep "^0*$1-" | head -1)
	          	[ -n "$_sid" ] || _sid=$(scenario_ids | grep -xF -- "$1")
	          	if [ -z "$_sid" ]; then die "no scenario $1"
	          	elif scn_unlocked "$_sid"; then run_scenario "$_sid"
	          	else no "locked -- beat $(scn_after "$_sid") first."; fi
	          fi
	          session_summary ;;
	project)  shift
	          case "${1:-}" in
	          	check) prj_check && echo "learn: $(project_ids | grep -c .) project(s) check out" ;;
	          	'')    projects_menu ;;
	          	*)     _pid=$(project_ids | grep "^0*$1-" | head -1)
	          	       [ -n "$_pid" ] || _pid=$(project_ids | grep -xF -- "$1")
	          	       if [ -z "$_pid" ]; then die "no project $1"
	          	       elif prj_unlocked "$_pid"; then run_project "$_pid"
	          	       else no "locked -- beat $(prj_after "$_pid") first."; fi ;;
	          esac ;;
	c)        shift
	          case "${1:-}" in
	          	check) c_check && echo "learn: $(c_ids | grep -c .) c unit(s) check out" ;;
	          	lint)  c_lint && echo "learn: $(c_ids | grep -c .) c unit(s) lint clean" ;;
	          	'')    c_menu ;;
	          	*)     c_unit "$1" ;;
	          esac ;;
	shell)    shift; playground "${1:-}" ;;
	fumbles)  shift; fumbles "${1:-}" ;;
	autopsy)  shift; autopsy "$@" ;;
	explain)  shift; explain "$@" ;;
	reset)    shift
	          # everything, including the answer history -- and never on a
	          # slip of the finger: it is one letter from `review`.
	          if [ "${1:-}" = --yes ]; then _ok=1
	          elif [ -t 0 ]; then
	          	printf '  %serase all progress -- cards, passed levels, answer history? [y/N]%s ' "$Y" "$N"
	          	IFS= read -r _ok 2>/dev/null; case "$_ok" in y|Y|yes) _ok=1 ;; *) _ok=0 ;; esac
	          else _ok=0; fi
	          if [ "$_ok" = 1 ]; then
	          	rm -f "$CARDS" "$CARDS.lock" "$PASSED" "$PLACED" "$BRIEFED" "$CHAL_BEST" "$EDIT_HIST" "$INPROG".* "$C_DONE" 2>/dev/null
	          	fum_forget
	          	ok "progress cleared"
	          else note "nothing erased (learn reset --yes skips the question)"; fi ;;
	-h|--help|help) usage ;;
	[0-9]*)   _id=$(level_ids | grep "^0*$1-" | head -1)
	          [ -n "$_id" ] || die "no level $1"
	          run_level "$_id"; session_summary ;;
	*)        if [ -f "$REF/$(refname "$1")" ]; then ref "$1"; else usage; exit 1; fi ;;
esac
