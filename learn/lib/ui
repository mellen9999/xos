# ui -- terminal output. square, dense, the terminal's own 8 colours, no motion.
#
# colour is a courtesy, never information: every state that colour marks is
# also marked by a character, so NO_COLOR and a dumb terminal lose nothing.
#
#   R  wrong        G  right       Y  the answer      U  a heading
#   M  a banner     C  what you type (flags, operators, keys)
#   W  a name or a value            D  the frame, and everything quiet

# the palette is the terminal's own eight, not a 256-colour ramp: xos boots to
# a linux console and is read over ssh from whatever the far end is running, so
# the colours that always exist are the ones worth building on -- and they come
# out in the reader's own scheme rather than fighting it. each of 1..7 carries
# exactly one meaning; 0 only ever appears through V, which swaps fg and bg.
if [ -n "${NO_COLOR:-}" ] || [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
	N= B= D= R= G= Y= U= M= C= W= V=
else
	N=$(printf '\033[0m')  B=$(printf '\033[1m')  V=$(printf '\033[7m')
	R=$(printf '\033[31m')     # wrong, missing, broken
	G=$(printf '\033[32m')     # right, passed, covered
	Y=$(printf '\033[33m')     # the answer, and anything to be careful with
	U=$(printf '\033[1;34m')   # a heading within a page
	M=$(printf '\033[35m')     # a full-width banner -- the page's own title
	C=$(printf '\033[36m')     # what you type: flags, operators, keys
	W=$(printf '\033[37m')     # names and values -- commands, levels, the line
	# dim has to name a colour. a bare \033[2m keeps the terminal's DEFAULT
	# foreground, which under most schemes is brighter than the 37 live text
	# uses -- the quiet rows then read as the loudest thing on the screen. 90 is
	# a real grey; a terminal with only eight colours has none, so it gets faint
	# white instead, which is the same idea by the only means it has.
	case "${TERM:-}" in
		vt100|vt102|vt220|ansi|*-m|*-mono) D=$(printf '\033[2;37m') ;;
		*) D=$(printf '\033[90m') ;;
	esac
fi

# terminal width. ash does not export COLUMNS the way bash does, so trusting it
# alone pinned every session to 80 and made the rules wrap on any other size.
# ask the terminal itself, then fall back.
# synchronised output: the editor reprints the whole answer line on every
# keystroke, which can tear or flicker on a slow or remote terminal. wrapping a
# redraw in these markers tells the terminal to paint it in one frame. unknown
# to older terminals, which ignore the private mode -- so it is safe everywhere.
if [ "${TERM:-dumb}" = dumb ] || [ ! -t 1 ]; then
	SYNC_BEG= SYNC_END=
else
	SYNC_BEG=$(printf '\033[?2026h') SYNC_END=$(printf '\033[?2026l')
fi

# progress-bar cells: solid block filled, light shade empty on a real terminal;
# ascii where there is no colour to carry them (dumb/NO_COLOR).
if [ -z "$N" ] || [ "${TERM:-dumb}" = dumb ]; then
	BAR_F='#' BAR_E='-'
else
	BAR_F='█' BAR_E='░'
fi

# a literal newline. $(printf '\n') cannot produce one -- command substitution
# strips them -- so it is written out.
NL='
'

COLS=${COLUMNS:-}
[ -n "$COLS" ] || COLS=$(stty size 2>/dev/null | cut -d' ' -f2)
[ -n "$COLS" ] || COLS=$(tput cols 2>/dev/null)
[ "$COLS" -ge 40 ] 2>/dev/null || COLS=80
# never draw past 100 columns -- a full-width rule on an ultrawide terminal is
# noise, not structure.
[ "$COLS" -le 100 ] 2>/dev/null || COLS=100

# COLS above is a typography choice; the line editor needs the terminal's real
# size. it has to know where the terminal ACTUALLY wraps -- assuming 100 on a
# 160-column window made every climb-back land a row short and reprint the
# answer over the question -- and how much room is left below the prompt.
_sz=$(stty size 2>/dev/null)
TERM_LINES=${_sz%% *} TERM_COLS=${_sz##* }
[ "$TERM_COLS" -ge 20 ] 2>/dev/null || TERM_COLS=${COLUMNS:-80}
[ "$TERM_LINES" -ge 8 ] 2>/dev/null || TERM_LINES=${LINES:-24}
unset _sz

# the rules, built once. a rule is the same string every time it is drawn, so
# forking awk per call was a fork per header, per card, per panel open.
# RULE spans COLS -- the typography width. PANEL_RULE never exceeds the real
# terminal, because the editor counts the rows its panel fills and a rule that
# wrapped would put that count out and climb back over the question.
RULE=$(awk -v n="$COLS" 'BEGIN{while(n-->0)printf "-"}')
PANEL_RULE=$(awk -v n="$(( COLS < TERM_COLS ? COLS : TERM_COLS ))" \
	'BEGIN{while(n-->0)printf "-"}')
PANEL_RULE="$D$PANEL_RULE$N"

rule() { printf '%s%s%s\n' "$D" "$RULE" "$N"; }

# the answer prompt, cmdchamp-style: a bare $ at the far left, white while you
# type and red the moment you drop to vi normal mode. built here where the R/W
# colour globals are in scope -- inside the editor R is the right-of-cursor
# buffer, so it cannot see them.
PROMPT_INS=$(printf '%s$ %s' "$W" "$N")
PROMPT_NORM=$(printf '%s$ %s' "$R" "$N")

hdr() {
	printf '\n%s%s%s %s\n' "$B$M" "$1" "$N" "${D}$2$N"
	rule
}

# say -- prose, wrapped to the terminal, never past 76 columns. blank lines
# stay blank: indenting them left trailing-whitespace lines all through the text.
say() { fold -s -w $(( COLS < 78 ? COLS - 2 : 76 )) | sed '/./s/^/  /'; }

ok()   { printf '  %s+%s %s\n' "$G" "$N" "$1"; }
no()   { printf '  %s-%s %s\n' "$R" "$N" "$1"; }
note() { printf '  %s%s%s\n' "$D" "$1" "$N"; }

# the answer a miss or a skip reveals, shown the way you would have typed it:
# a dim $ at the far left, the command in yellow -- the same shape as the live
# prompt, so the eye reads it as "this is what belonged on that line".
reveal() { printf '%s$ %s%s%s%s\n' "$D" "$N" "$Y" "$1" "$N"; }

# ---- flashcard screen -----------------------------------------------------
#
# one card at a time: the screen clears, a status bar names where you are, the
# question runs, and a pause lets you read the result before the next clear.
# every one of these is a no-op when output is not a terminal, so the build's
# probes and any piped run stay linear and never block.

# clear the screen AND the scrollback, so you cannot scroll up to the last card
cls() { [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && printf '\033[H\033[2J\033[3J'; return 0; }

# a green fill bar: $1 done, $2 total, $3 cells wide. filled cells green, the
# rest dim -- the one moving element in the whole ui, and it does not animate,
# it just reflects where you are.
bar() {
	local d=$1 t=$2 w=${3:-16} f i
	[ "$t" -gt 0 ] 2>/dev/null || t=1
	[ "$d" -ge 0 ] 2>/dev/null || d=0
	f=$(( d * w / t )); [ "$f" -gt "$w" ] && f=$w
	printf '%s' "$G"; i=0
	while [ "$i" -lt "$f" ]; do printf '%s' "$BAR_F"; i=$((i + 1)); done
	printf '%s' "$D"
	while [ "$i" -lt "$w" ]; do printf '%s' "$BAR_E"; i=$((i + 1)); done
	printf '%s' "$N"
}

# the top bar: bold title, dim subtitle, then a green progress bar with its
# count and (optional) running score on the right, then a rule. every segment's
# visible width is known here, so the coloured escapes never shear the layout.
statusbar() {   # $1 title  $2 sub  $3 done  $4 total  $5 right(optional)
	[ -t 1 ] || return 0
	local title="$1" sub="$2" done="$3" tot="$4" right="$5" bw=16 lt rt padw
	lt="  $title  $sub"
	rt=" $done/$tot"
	[ -n "$right" ] && rt="$rt  +$right"
	padw=$(( COLS - ${#lt} - bw - ${#rt} ))
	[ "$padw" -ge 1 ] 2>/dev/null || padw=1
	printf '  %s%s%s  %s%s%s%*s' "$B$W" "$title" "$N" "$D" "$sub" "$N" "$padw" ''
	bar "$done" "$tot" "$bw"
	printf ' %s%s/%s%s' "$D" "$done" "$tot" "$N"
	[ -n "$right" ] && printf '  %s+%s%s' "$G" "$right" "$N"
	printf '\n'
	rule
}

# between cards: wait for Enter, or quit. non-interactive returns at once so
# nothing automated ever hangs here.
pause_card() {
	[ -t 0 ] || return 0
	printf '\n  %s[enter] next %s·%s quit%s ' "$D" "$D" "$D" "$N"
	IFS= read -r _pc 2>/dev/null || { echo; return 2; }
	case "$_pc" in quit) return 2 ;; esac
	return 0
}
