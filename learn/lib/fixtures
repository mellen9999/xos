# fixtures -- the tree answers run against.
#
# every path here is read out of learn/pools, not written twice. that is the
# invariant: the roll picks a filename from pools/logs, and the sandbox builds
# exactly what pools/logs names, so a generated question cannot ask about a
# file that does not exist -- sandbox_build verifies every pooled path after
# building and refuses to grade against a tree that is missing one.
#
# the content is generated from the roll's seed and deliberately shaped so the
# interesting answers have interesting output: repeated lines to dedupe, mixed
# severities to filter and count, a csv with a header row to skip, a binary
# with a string buried in it. the counts change with every roll, so an answer
# has to compute them -- there is no constant to memorise.

# privilege drop. on the image learn runs as root -- the only user -- so an
# answer that reached outside the sandbox could write p3, a block device,
# /proc/sys, or signal a process. the fence in grade catches the obvious
# shapes, but it is a denylist over a full shell and can never be complete.
# containment is by construction instead: when running as root and setuidgid
# ships, the sandbox is created by and owned by `nobody`, and every answer
# runs as nobody with HOME and TMPDIR inside it. plain file permissions then
# refuse everything root owns. on the build host (G25 runs as a normal user)
# there is nothing to drop and the tree is already that user's own.
DROP=""
if [ "$(id -u 2>/dev/null)" = 0 ] && command -v setuidgid >/dev/null 2>&1 \
   && id nobody >/dev/null 2>&1; then
	DROP="setuidgid nobody"
fi
# under the drop the tree cannot live inside $TMP (root's, 0700): it gets its
# own directory in the sticky tmpfs, made by nobody so nobody owns it.
if [ -n "$DROP" ]; then SANDBOX="${LEARN_SANDBOX:-${TMPDIR:-/tmp}/learn-sb.$$}"
else                    SANDBOX="${LEARN_SANDBOX:-$TMP/sandbox}"; fi
SANDBOX_OK=0
FX_BUILT=""

# the generators. each takes the roll's seed, so the same roll always builds
# the same bytes -- a learner's run and the grader's reference run must see
# one tree. the lines the corpus' out: patterns rely on are placed
# unconditionally (the first log line, the FATAL close, gateway's csv row,
# the exact repeat counts in the txts); randomness only pads around them.

_fx_log() {
	awk -v seed="$1" '
		function line(sev, msg) {
			t += 20 + int(rand() * 500)
			printf "2024-03-01 %02d:%02d:%02d %-5s %s\n", t/3600, t%3600/60, t%60, sev, msg
		}
		BEGIN {
			srand(seed)
			split("10.0.0.50 192.168.1.100 172.16.0.1 10.20.30.40 203.0.113.7 192.168.4.20", ip, " ")
			t = 32400 + int(rand() * 900)                 # a little past 09:00
			line("INFO", "service started")
			line("INFO", "listening on 0.0.0.0:8080")
			line("WARN", "slow query took " (900 + int(rand() * 2400)) "ms")
			# the repeated line uniq lessons lean on: byte-identical, adjacent
			t += 20 + int(rand() * 500)
			refused = ip[1 + int(rand() * 6)]
			for (i = 0; i < 2; i++)
				printf "2024-03-01 %02d:%02d:%02d ERROR connection refused %s\n", t/3600, t%3600/60, t%60, refused
			if (rand() < 0.7) line("INFO", "retry succeeded")
			for (i = int(rand() * 3); i > 0; i--)
				line("ERROR", "timeout talking to " ip[1 + int(rand() * 6)])
			line("DEBUG", "cache hit ratio 0." (70 + int(rand() * 29)))
			if (rand() < 0.6) line("WARN", "disk usage at " (75 + int(rand() * 24)) "%")
			# bare severity lines, one per pool value: every real line above
			# carries a timestamp too, so grep -x @sev@ (a whole-line match)
			# has nothing to land on without these -- unconditional, so
			# whichever @sev@ a roll happens to pick, one of these is it.
			printf "ERROR\n"; printf "WARN\n"; printf "INFO\n"; printf "DEBUG\n"; printf "FATAL\n"
			line("FATAL", "out of memory, aborting")
		}'
}

_fx_txt() {
	# exact multiset, order shuffled: "rotate" appears exactly twice (uniq -c
	# prints "2 rotate ..."), "ask" exactly once (uniq -u prints it), the
	# other two pad the file to a varying length.
	awk -v seed="$1" '
		BEGIN {
			srand(seed)
			n = 0
			l[++n] = "ask why the fan is loud"
			l[++n] = "rotate the logs before they fill the disk"
			l[++n] = "rotate the logs before they fill the disk"
			l[++n] = "check the certificate expiry"
			l[++n] = "verify the root hash after every build"
			if (rand() < 0.5) l[++n] = "check the certificate expiry"
			for (i = int(rand() * 3); i > 0; i--)
				l[++n] = "verify the root hash after every build"
			for (i = n; i > 1; i--) {                     # shuffle
				j = 1 + int(rand() * i)
				tmp = l[i]; l[i] = l[j]; l[j] = tmp
			}
			for (i = 1; i <= n; i++) print l[i]
		}'
}

_fx_csv() {
	# gateway,1,up,42 is fixed and 42 stays the column maximum (other counts
	# top out at 41) -- several questions read their answer off that row.
	# at least one row is down, and two rows share a count, for the
	# filtering and dedupe lessons.
	awk -v seed="$1" '
		BEGIN {
			srand(seed)
			nh = split("bastion router jump-host web01 db01 proxy cache01 mail edge01 node07", h, " ")
			print "name,id,status,count"
			print "gateway,1,up,42"
			rows = 3 + int(rand() * 3)                    # 3..5 more rows
			for (i = 1; i <= rows; i++) {                 # sample rows distinct hosts
				j = i + int(rand() * (nh - i + 1))
				tmp = h[i]; h[i] = h[j]; h[j] = tmp
			}
			dn = 2 + int(rand() * rows)                   # the forced down row
			for (i = 2; i <= rows + 1; i++) {
				c[i] = 1 + int(rand() * 41)
				if (i == 3) c[i] = c[2]                   # two rows share a count
				print h[i-1] "," i "," (i == dn ? "down" : (rand() < 0.75 ? "up" : "down")) "," c[i]
			}
		}'
}

_fx_cfg() {
	# key names and the port value are fixed -- the sed lessons extract 8080
	# by name. the other values change with the roll.
	awk -v seed="$1" '
		BEGIN {
			srand(seed)
			print "# generated -- do not edit by hand"
			print "listen = 0.0.0.0"
			print "port = 8080"
			print "debug = " (rand() < 0.5 ? "true" : "false")
			print "retries = " (1 + int(rand() * 9))
			# half the rolls carry one more key: a line count the [ -eq lesson
			# can be wrong about. nothing else reads it.
			if (rand() < 0.5) print "workers = " (1 + int(rand() * 8))
			print ""
			print "timeout = " (10 + int(rand() * 90))
		}'
}

# parent directory of every pooled path that has one. the grep comes BEFORE
# the strip: filtering after it drops samples/target.bin, whose parent is a
# single component and so no longer contains a slash to match.
_fx_dirs() { grep '/' | sed 's|/[^/]*$||' | sort -u; }

# _le16/_le32 N -- N as 2 or 4 raw little-endian bytes. printf builds the
# escape text (a string of literal backslash-digits), then a second printf
# with %b walks it and emits the actual bytes -- the only way busybox printf
# turns a computed byte value into output without a working %c for it.
_le16() {
	_n=$1
	printf '%b' "$(printf '\\%03o\\%03o' "$(( _n & 255 ))" "$(( (_n>>8) & 255 ))")"
}
_le32() {
	_n=$1
	printf '%b' "$(printf '\\%03o\\%03o\\%03o\\%03o' \
		"$(( _n & 255 ))" "$(( (_n>>8) & 255 ))" "$(( (_n>>16) & 255 ))" "$(( (_n>>24) & 255 ))")"
}

# _fx_crc_size FILE -- sets ZCRC/ZSIZE from FILE's own gzip trailer instead of
# reimplementing crc32: a gzip stream always ends in 4 bytes of crc32 then 4
# of length, and busybox's crc32 is the same one zip entries carry.
_fx_crc_size() {
	set -- $(gzip -c < "$1" | tail -c 8 | od -An -tu1)
	ZCRC=$(( $1 + $2*256 + $3*65536 + $4*16777216 ))
	ZSIZE=$(( $5 + $6*256 + $7*65536 + $8*16777216 ))
}

# _fx_zip OUT NAME FILE -- a one-entry, stored (uncompressed) pkzip archive.
# busybox ships unzip but no zip to build against, so this writes the local
# header, the file's raw bytes, the central directory and the end record by
# hand -- the only fields that vary are name/size/crc, and those come off the
# real file, so the archive round-trips through busybox unzip, GNU unzip and
# python's zipfile alike.
_fx_zip() {
	_out=$1; _name=$2; _file=$3
	_fx_crc_size "$_file"
	_nlen=${#_name}
	: > "$_out"
	{
		printf 'PK\003\004'; _le16 20; _le16 0; _le16 0; _le16 0; _le16 33
		_le32 "$ZCRC"; _le32 "$ZSIZE"; _le32 "$ZSIZE"; _le16 "$_nlen"; _le16 0
		printf '%s' "$_name"; cat "$_file"
	} >> "$_out"
	{
		printf 'PK\001\002'; _le16 20; _le16 20; _le16 0; _le16 0; _le16 0; _le16 33
		_le32 "$ZCRC"; _le32 "$ZSIZE"; _le32 "$ZSIZE"; _le16 "$_nlen"
		_le16 0; _le16 0; _le16 0; _le16 0; _le32 0; _le32 0
		printf '%s' "$_name"
	} >> "$_out"
	_cdsize=$(( 46 + _nlen ))
	_cdoff=$(( 30 + _nlen + ZSIZE ))
	{ printf 'PK\005\006'; _le16 0; _le16 0; _le16 1; _le16 1
	  _le32 "$_cdsize"; _le32 "$_cdoff"; _le16 0; } >> "$_out"
}

# sandbox_build -- (re)make the tree for the current roll. under the drop
# the filling runs as nobody in a child shell (so every byte is nobody's);
# the state flags are the parent's and are set here, after success.
sandbox_build() {
	if [ -n "$DROP" ]; then
		rm -rf "$SANDBOX" 2>/dev/null
		POOLS="$POOLS" SANDBOX="$SANDBOX" FX_SEED="${FX_SEED:-0}" \
			$DROP "$SHELLBIN" -c 'DROP=""; . "$1"; _sandbox_fill' _ "$ROOT/lib/fixtures" || return 1
	else
		_sandbox_fill || return 1
	fi
	SANDBOX_OK=1
	SANDBOX_DIRTY=0
	FX_BUILT="${FX_SEED:-0}"
}

_sandbox_fill() {
	rm -rf "$SANDBOX" 2>/dev/null
	mkdir -p "$SANDBOX" || return 1
	cd "$SANDBOX" || return 1

	# directories: the ones pools/dirs names, plus every parent implied by a
	# pooled file path (logs/access.log implies logs/).
	mkdir -p $(grep . "$POOLS/dirs") 2>/dev/null
	mkdir -p $(cat "$POOLS/logs" "$POOLS/bins" "$POOLS/archives" | _fx_dirs) 2>/dev/null

	local f fx=0
	for f in $(grep . "$POOLS/logs"); do
		fx=$((fx + 1)); _fx_log "$(( ${FX_SEED:-0} + fx ))" > "$f"
	done

	for f in $(grep . "$POOLS/txts"); do
		fx=$((fx + 1)); _fx_txt "$(( ${FX_SEED:-0} + fx ))" > "$f"
	done

	for f in $(grep . "$POOLS/csvs"); do
		fx=$((fx + 1)); _fx_csv "$(( ${FX_SEED:-0} + fx ))" > "$f"
	done

	for f in $(grep . "$POOLS/cfgs"); do
		fx=$((fx + 1)); _fx_cfg "$(( ${FX_SEED:-0} + fx ))" > "$f"
	done

	for f in $(grep . "$POOLS/scripts"); do
		printf '#!/bin/sh\n# %s\nset -eu\necho running %s\n' "$f" "$f" > "$f"
		chmod 0755 "$f"
	done

	for f in $(grep . "$POOLS/bins"); do
		{ printf '\177ELF\002\001\001\0'; printf '%s' "unlocked-by-strings"
		  dd if=/dev/zero bs=64 count=1 2>/dev/null; } > "$f"
	done

	# archives are built from the tree so their contents are real and listable
	tar czf "$(sed -n 1p "$POOLS/archives")" src data 2>/dev/null
	tar cf  "$(sed -n 2p "$POOLS/archives")" $(grep . "$POOLS/txts") 2>/dev/null

	# a couple of files that only exist to be found by the finding lessons
	printf 'staged\n' > src/main.c
	printf 'staged\n' > src/util.c
	printf 'old\n'    > backup/notes.txt.bak
	: > data/empty

	# an already-empty directory, and an already-nested one -- for the rmdir
	# lessons, which delete something rather than make it. a generated @word@
	# is not guaranteed to exist, so these are fixed names instead.
	mkdir -p empty-dir
	mkdir -p prune/mid/deep

	# fixed content sort -h and sort -V have something real to reorder --
	# @csv@ and @txt@ carry neither human sizes nor version numbers.
	printf '1M\n512\n64k\n2K\n1G\n' > sizes.txt
	printf '1.10\n1.2\n1.9\n1.1\n2.0\n' > versions.txt

	# a format string for hexdump -f -- a fixed name, referenced by name in
	# the question that reads it, the same file every build.
	printf '16/1 "%%02x " "\\n"\n' > fmt.txt

	# archive.zip -- a fixed name so unzip lessons don't clash with a @txt@
	# pool file this same tree already has (extracting over one, with no -o,
	# would block on the overwrite prompt busybox unzip reads from stdin).
	printf 'hello from the archive\n' > hello.txt
	_fx_zip archive.zip hello.txt hello.txt

	# names.txt -- tar -T reads archive member names from this, one per line;
	# it has to hold real paths, unlike @txt@'s prose, so it is not a pool.
	printf 'notes.txt\ntodo.txt\nreadme.txt\n' > names.txt

	# link.txt -- the one symlink in the tree, for -L and -type l lessons.
	# notes.txt always exists, so the link is never dangling.
	ln -sf notes.txt link.txt

	# a setuid file for the -perm -MODE lesson: "at least these bits" needs
	# a bit actually set to find.
	printf '#!/bin/sh\ntrue\n' > bin/suid-tool
	chmod 4755 bin/suid-tool

	# the pools are the manifest. if anything they name did not get built, a
	# generated question is about to ask after a file that is not there --
	# say so now rather than grading someone wrong for it.
	local missing="" p
	for p in $(cat "$POOLS/logs" "$POOLS/txts" "$POOLS/csvs" "$POOLS/cfgs" \
	               "$POOLS/scripts" "$POOLS/bins" "$POOLS/archives" \
	               "$POOLS/dirs" 2>/dev/null | grep .); do
		[ -e "$p" ] || missing="$missing $p"
	done
	cd - >/dev/null 2>&1 || :
	[ -z "$missing" ] || { echo "learn: sandbox missing:$missing" >&2; return 1; }
}

# rebuild after any executed answer, and when the roll moved on and the tree
# holds the previous question's content. whether an answer wrote is not
# knowable cheaply (a chmod leaves mtime alone), so every run marks it dirty:
# a stale tree grades the next question against the wrong bytes.
SANDBOX_DIRTY=0
sandbox_reset() {
	[ "$SANDBOX_OK" = 1 ] || { sandbox_build || return 1; return 0; }
	[ "$SANDBOX_DIRTY" = 1 ] || [ "$FX_BUILT" != "${FX_SEED:-0}" ] || return 0
	sandbox_build
}
