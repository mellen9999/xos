# explain -- break a command line into the pieces you need to run it: the
# manpage for each command it names, and a gloss for every shell operator and
# special variable around them. the operators are not commands and have no
# manpage of their own, but you still have to know them to build the line -- so
# the tab panel appends them to the command's ref, and `learn explain '<line>'`
# shows the whole breakdown on its own.

SYNTAX="$ROOT/syntax"
SYNALWAYS="$ROOT/syn"
BASHISMS="$ROOT/bashisms"

# syn_of CMD -- the syntax labels that belong to this command's page whatever
# the answer used, one per line. see learn/syn for why a glob is one of them
# and a pipe is not.
syn_of() {
	awk -F'\t' -v c="$1" '
		substr($1, 1, 1) == "#" { next }
		$1 == c { for (i = 2; i <= NF; i++) if ($i != "") print $i; exit }
	' "$SYNALWAYS" 2>/dev/null
}

# the panel's left column -- command names above, syntax labels below, one
# column through both. as wide as the widest label PRINTED IN IT, and nothing
# else: it was a hardcoded 9 that the first longer label sheared, then the
# widest label in the whole table, which is `${NAME:-WORD}` -- so a panel
# showing `[...]`, `*` and `?` stood them in a thirteen-wide column and paid
# for it twice, eight columns of gap on the left of every gloss and eight cut
# off the right of it. a column belongs to what is in it.
#
# _exp_w -- that width, from tab-separated rows on stdin, field one. two is the
# floor: a column of `*` alone still reads as a column.
_exp_w() {
	awk -F'\t' '{ if (length($1) > w) w = length($1) } END { print (w < 2 ? 2 : w) }'
}

# explain_syntax LINE -- print a gloss for each shell construct the line uses,
# longest form first. single-quoted spans (awk and sed scripts) are stripped
# first, so an awk $1 or $NF or a sed \1 inside a script is never mistaken for a
# shell positional parameter. returns 1 if the line used no shell syntax at all.
#
# quoting is three rows of the table like anything else. it was three cases
# hardcoded here, which kept it out of the grammar ledger entirely -- the one
# construct every shell bug is about was the one the build never checked was
# taught. the strip leaves ' ' behind now so a quoting row survives it, and a
# quote or backslash INSIDE a stripped span correctly stops counting: an awk
# body's own \t is not a backslash the shell ever saw.
#
# every table match is replaced with a SPACE, not deleted -- deleting would
# fuse the tokens on either side of it into one, and a later boundary-checked
# row (--, a lone -) reads the fused result as a single token and misses it.
# _syn_scan LINE -- label<TAB>gloss for each syntax-table row the line uses,
# consumed order, quoting excluded. the one shell-side detector: the panel
# formats its rows, and selftest checks it agrees with order_syntax's awk
# reading of the same table.
_syn_scan() {
	local work label ere gloss tab
	tab=$(printf '\t')
	work=$(printf '%s' "$1" | sed "s/'[^']*'/ '' /g")
	while IFS="$tab" read -r label ere gloss; do
		case "$label" in ''|'#'*) continue ;; esac
		# a row the command's page always carries counts as matched, and
		# counts here rather than in a second loop so the output stays in
		# table order -- the order the whole panel is read in.
		case "
${SYN_ALWAYS:-}
" in *"
$label
"*) printf '%s\t%s\n' "$label" "$gloss"; continue ;; esac
		if printf '%s' "$work" | grep -qE -- "$ere"; then
			printf '%s\t%s\n' "$label" "$gloss"
			# TAB delimits the s command: the table is tab-separated, so a
			# tab is the one character no ERE can contain. (/ dies on the
			# /dev/null row, @ died on $@ -- and that one shipped, caught
			# by selftest's two-engine battery.)
			work=$(printf '%s' "$work" | sed -E "s$tab$ere$tab $tab""g")
		fi
	done < "$SYNTAX"
}

# bashism_scan LINE -- label<TAB>gloss for every bash-only construct the line
# uses, consumed order, from learn/bashisms. the wrong-answer path calls it;
# nothing in the curriculum does, because none of this is taught here.
#
# the quote strip is _syn_scan's with one change: a span opened by $' survives,
# because that span IS one of the constructs. _syn_scan must not make the same
# exception -- there is no $'...' row in learn/syntax to find, and keeping the
# span would hand an awk body back to the rows below it.
bashism_scan() {
	local work label ere probe gloss tab
	tab=$(printf '\t')
	work=$(printf '%s' "$1" | sed -E "s/(^|[^\$])'[^']*'/\\1 '' /g")
	# probe is read and not used here: it is field 3 and the gloss is
	# field 4. selftest and G62 are what run it.
	# shellcheck disable=SC2034
	while IFS="$tab" read -r label ere probe gloss; do
		case "$label" in ''|'#'*) continue ;; esac
		if printf '%s' "$work" | grep -qE -- "$ere"; then
			printf '%s\t%s\n' "$label" "$gloss"
			# TAB delimits the s command, for the reason _syn_scan gives:
			# it is the one character a row's ERE cannot contain.
			work=$(printf '%s' "$work" | sed -E "s$tab$ere$tab $tab""g")
		fi
	done < "$BASHISMS"
}

# _exp_row LABEL GLOSS PAD -- one panel row: the label in a PAD-wide column,
# the gloss folded to what the terminal leaves and hanging under itself. two
# rows hold a construct that means two things (* is a glob and a quantifier
# both), and the tail of one used to wrap at column 0, under the label, where
# it read as a row of its own rather than the rest of one. _prows counts by raw
# length, so it is exact here as well: every line printed is already inside the
# width. PAD is the caller's, because only the caller knows every label the
# column will hold -- see _exp_w.
_exp_row() {
	local w=${TERM_COLS:-${COLS:-80}} gw pad=${3:-2}
	gw=$(( w - pad - 3 ))
	[ "$gw" -ge 24 ] || gw=24
	# one row per construct in the panel, cut with the same ".." the flag
	# rows use. the glosses that mean two things -- * is a glob and a
	# quantifier -- run to three rows each, and three of those is half the
	# reference gone to prose the learner has already read once. the whole
	# sentence is still on `learn explain` and on the page itself, which is
	# where you go when the one line was not enough.
	if [ "${SYN_ONEROW:-0}" = 1 ]; then
		EXP_LAB="$1" EXP_GLOSS="$2" awk -v c="$C" -v n="$N" -v pad="$pad" -v gw="$gw" '
			BEGIN {
				# both through the environment: awk reads escapes in a -v
				# value, and the gloss of the \; row lost its backslash to it
				lab = ENVIRON["EXP_LAB"]; g = ENVIRON["EXP_GLOSS"]
				if (length(g) > gw) {
					g = substr(g, 1, gw - 2)
					sub(/[ ,][^ ,]*$/, "", g); sub(/[ .,|]+$/, "", g)
					g = g ".."
				}
				printf "  %s%-" pad "s%s %s\n", c, lab, n, g
			}'
		return 0
	fi
	# the label rides in the environment, not in -v: awk processes escape
	# sequences in a -v assignment, so the row whose label IS a backslash
	# arrived as nothing and printed a nameless gloss.
	printf '%s' "$2" | wrap "$gw" | EXP_LAB="$1" awk -v c="$C" -v n="$N" -v pad="$pad" '
		BEGIN { lab = ENVIRON["EXP_LAB"] }
		{ sub(/[ \t]+$/, "") }
		NR == 1 { printf "  %s%-" pad "s%s %s\n", c, lab, n, $0; next }
		{ printf "  %" pad "s %s\n", "", $0 }'
}

# _exp_rows PAD -- label<TAB>gloss rows on stdin, one panel row each, in a
# PAD-wide column. returns 1 if there were none.
_exp_rows() {
	local found=0 label gloss tab
	tab=$(printf '\t')
	while IFS="$tab" read -r label gloss; do
		[ -n "$label" ] || continue
		found=1
		_exp_row "$label" "$gloss" "$1"
	done
	return $(( 1 - found ))
}

# explain_syntax LINE [CMD] [ONEROW] -- the gloss rows for this line, plus the
# ones CMD carries whatever you typed. the rows are scanned once and held,
# because the column has to be measured before the first of them prints.
explain_syntax() {
	local rows SYN_ALWAYS= SYN_ONEROW=${3:-0}
	[ -n "${2:-}" ] && SYN_ALWAYS=$(syn_of "$2")
	rows=$(_syn_scan "$1" | grep .) || return 1
	printf '%s\n' "$rows" | _exp_rows "$(printf '%s\n' "$rows" | _exp_w)"
}

# _ref_rows FILE -- the page with every flag row tab-separated. busybox writes
# most of them as "\t-n N\tdescription", but a dozen use a plain space instead
# ("-k N[,M] Sort by Nth field"), and a renderer that trusts the tab prints
# those as one long flag and lands the next column ragged. the split: the flag,
# then any following word carrying no lowercase letter (CMD, ARG, N[,M], +, ;)
# belongs to it -- the description starts at the first real word.
_ref_rows() {
	awk '
		/^\t/ && $0 !~ /\t.*\t/ {
			l = $0; sub(/^\t+/, "", l)
			n = split(l, t, " "); f = t[1]; i = 2
			while (i <= n && t[i] !~ /[a-z]/) { f = f " " t[i]; i++ }
			d = ""
			for (; i <= n; i++) d = d (d == "" ? "" : " ") t[i]
			print "\t" f (d == "" ? "" : "\t" d); next
		}
		{ print }' "$1"
}

# _prows WIDTH -- display rows the text on stdin takes at WIDTH, colour codes
# not counted. the panel budget is in rows, and a line that wraps costs two.
_prows() {
	awk -v w="${1:-80}" '
		{ t = $0; gsub(/\033\[[0-9;?]*[A-Za-z]/, "", t)
		  n = length(t); rows += int((n > 0 ? n - 1 : 0) / w) + 1 }
		END { print rows + 0 }'
}

# the example lines the corpus itself teaches for a command, cached once per
# process: real lines, already graded, so an example can never drift from what
# the trainer accepts. two sources per block. the FIRST answer, which is the
# line the card stands behind -- later answers are the grader being generous
# (`cp -R` is still right) and selftest lets them use a flag learn/skip retired,
# so they are no example of anything. and `eg:`, a line an author wrote to show
# the card's own flag somewhere its answer cannot: the card on screen must
# never offer its own answer, so without eg: the one flag a card is ABOUT was
# the one flag its examples could never show. built from the levels, the
# missions and the gauntlet alike.
examples_cached() {
	[ -s "$TMP/examples.all" ] || {
		# a sed script that fills every @token@ with the first value of its own
		# pool. most listed answers are templated, and an example is worth more
		# with a real filename in it than not shown at all -- these are the same
		# lines the grader accepts, only settled on one roll. a token the roll
		# fills some other way (@needle@ picks a severity in a case, not from a
		# pool) has no entry, so any line still holding one is dropped: a
		# literal @needle@ on a card would read as a typo in the trainer.
		{ token_pools | while read -r _t _p; do
			# the roll draws @x@ and @x2@ from one pool and guarantees they
			# differ; settle them on the first two values, or an example reads
			# "cp -i config.ini config.ini"
			case "$_t" in
				*2) _v=$(grep -v '^#' "$POOLS/$_p" 2>/dev/null | grep . | sed -n 2p) ;;
				*)  _v=$(grep -v '^#' "$POOLS/$_p" 2>/dev/null | grep . | head -1) ;;
			esac
			[ -n "$_v" ] && printf 's|@%s@|%s|g\n' "$_t" "$_v"
		  done
		  printf 's|@n@|3|g\ns|@n3@|5|g\n'; } > "$TMP/examples.sed"
		awk '
		function flush2(   i) {
			# verbatim: a listed answer is already the exact line the grader
			# accepts, braces and all. an awk program is not an alternation.
			# the third field is where the line came from, so the card can
			# refuse to show the very question it is open on top of; the
			# fourth says whether it IS that question (a) or was written to
			# stand beside it (eg), which the refusal lets through.
			if (r != "") for (i = 1; i <= n; i++) print r "\t" A[i] "\t" base ":" idx "\t" K[i]
			n = 0; r = ""; na = 0
		}
		FNR == 1 { if (NR > 1) flush2(); idx = 0; base = FILENAME; sub(/.*\//, "", base) }
		/^---/    { flush2(); idx++; next }
		/^a: /    { if (!na++) { l = $0; sub(/^a: /, "", l); A[++n] = l; K[n] = "a" }; next }
		/^eg: /   { l = $0; sub(/^eg: /, "", l); A[++n] = l; K[n] = "eg"; next }
		/^ref: /  { if (r == "") r = $2 }
		END       { flush2() }
		' "$LEVELS"/* "$SCENARIOS"/* "$CHAINS" 2>/dev/null \
		| sed -f "$TMP/examples.sed" \
		| grep -v '@[a-z0-9][a-z0-9]*@' \
		| sort -u \
		| awk -F'\t' '
			# a line two different blocks both list cannot be shown as an
			# example of either: whichever card is open, it would be handing
			# over the line the learner is being asked to type
			{ line[NR] = $0; seen[$2]++ }
			END { for (i = 1; i <= NR; i++) {
				split(line[i], f, "\t")
				if (seen[f[2]] == 1) print line[i]
			} }' > "$TMP/examples.all"
	}
	cat "$TMP/examples.all"
}

# paint -- an example line read the way the card reads a flag row. it was one
# dim colour end to end, which hid the one thing an example is for: seeing
# where the command stops and the arguments start. the split lib/ui draws
# everywhere else -- the command, its flags and its operators are what you
# TYPE (C); an argument is what they are pointed at and stays plain. a quoted
# span is left alone on purpose: an awk program is not a list of tokens, and
# painting inside one would be a lie about its structure.
_PAINT_AWK='
	function paint(l,   n, t, i, w, out, head) {
		n = split(l, t, " ")
		head = 1
		for (i = 1; i <= n; i++) {
			w = t[i]
			# a pipe or a separator starts a new command; a redirection does
			# not -- what follows > is a filename, and reading it as a
			# command name is the one thing an example must not get wrong.
			if (w ~ /^(\||;|&&|\|\|)$/) {
				out = out C w N " "; head = 1; continue
			}
			if (w ~ /^([0-9]?>>?&?[0-9]?|<)$/) { out = out C w N " "; continue }
			# the leading word is a command: syntax you type, the same as the
			# flags and operators beside it. it was W, which said a command
			# name is a NAME -- the thing syntax is pointed at -- and left
			# every example with its verb the one unmarked-looking word on it.
			if (head && w !~ /^-/ && w !~ /=/) { out = out C w N " "; head = 0; continue }
			if (w ~ /^-/) { out = out C w N " "; continue }
			out = out w " "
		}
		sub(/ $/, "", out)
		return out
	}'

# pin_keys CMD TOKEN... -- the flag rows of CMD's page that the tokens an
# answer typed stand for. an answer writes `-rn`, `-d:` and `-k2`; the page
# has rows -r, -n, -d and -k. a token the page documents whole (-maxdepth,
# --spider) is its own row; anything else is walked a letter at a time the way
# flag_ok walks it, and the walk stops at the first letter the page does not
# know, because what follows is a value stuck to the flag and not more flags.
pin_keys() {
	local cmd=$1 tok rest c
	shift
	for tok in "$@"; do
		if documented "$cmd" "$tok"; then printf '%s\n' "$tok"; continue; fi
		case "$tok" in --*) continue ;; -*) rest=${tok#-} ;; *) rest=$tok ;; esac
		while [ -n "$rest" ]; do
			c=${rest%"${rest#?}"}
			if documented "$cmd" "-$c"; then printf '%s\n' "-$c"
			elif documented "$cmd" "$c"; then printf '%s\n' "$c"
			else break
			fi
			rest=${rest#?}
		done
	done | awk '!seen[$0]++' | tr '\n' ' '
}

# ref_examples CMD [SKIP] [SRC] [PIN] -- up to two example lines for CMD, never
# the answer to the question on screen. every line must RUN the command -- as
# a pipeline's first word or after a | -- or it is an example of something
# else that happens to mention it. the first slot goes to a line that uses a
# flag the card is about (PIN, from pin_keys): the reference on a -c card that
# shows -d and -r and never -c has answered every question but the one asked.
# after that, one command beats a pipeline, a line with a flag beats a bare
# one, and the shorter of two beats the longer -- see score().
ref_examples() {
	local out src=${3:-${Q_SRC:-}}
	out=$(examples_cached | awk -F'\t' -v c="$1" -v skip="$2" -v src="$src" -v pin="${4:-}" \
	                            -v w="${COLS:-80}" -v N="$N" -v C="$C" "$_PAINT_AWK"'
		# the segments of a line that are this command running
		function runs(l,   s, k, i, f) {
			s = l; gsub(/\|\||&&|[|;`]|\$\(/, "\n", s)
			k = split(s, seg, "\n"); nseg = 0
			for (i = 1; i <= k; i++) {
				f = seg[i]; sub(/^[ !(]+/, "", f)
				if (index(f " ", c " ") == 1) segs[++nseg] = f
			}
			return nseg
		}
		# does the line pass CMD a pinned flag? short flags bundle, so -c
		# is used by -cf as well as by -c; a long or word flag is a whole token
		function pinned(l,   i, j, k, m, t, p, np) {
			if (pin == "" || !runs(l)) return 0
			np = split(pin, p, " ")
			for (i = 1; i <= nseg; i++) {
				m = split(segs[i], t, " ")
				for (j = 2; j <= m; j++) for (k = 1; k <= np; k++) {
					if (t[j] == p[k] || index(t[j], p[k] "=") == 1) return 1
					if (p[k] ~ /^-[A-Za-z0-9]$/ && t[j] ~ /^-[A-Za-z0-9]+$/ \
					    && index(substr(t[j], 2), substr(p[k], 2))) return 1
				}
			}
			return 0
		}
		# the flag a line leads with, for telling two examples apart
		function lead(l,   t, m, i) {
			m = split(l, t, " ")
			for (i = 2; i <= m; i++) if (t[i] ~ /^-/) return t[i]
			return ""
		}
		# a pinned flag first, then one command over a pipeline, then a line
		# that shows a flag at all over a bare invocation, then the shorter:
		# a forty-character regex is the pattern being taught, not the command
		function score(l, withpin) {
			return (withpin && pinned(l) ? 100 : 0) \
			     + (l !~ /\||;|&&|\$\(|`/ ? 10 : 0) + (lead(l) != "" ? 5 : 0) \
			     - length(l) / 1000
		}
		$1 == c && !($3 == src && $4 == "a") && index(skip, $2) == 0 \
		  && length($2) <= w - 4 && runs($2) { L[++n] = $2 }
		END {
			if (!n) exit
			best = 0
			for (i = 1; i <= n; i++) if (!best || score(L[i], 1) > score(L[best], 1)) best = i
			print "  " paint(L[best])
			# the second must disagree with the first somewhere in its first
			# three words, flag included -- two lines that differ in one
			# argument teach one thing twice
			split(L[best], a, " "); two = 0
			for (i = 1; i <= n; i++) {
				if (i == best) continue
				split(L[i], b, " "); same = 0
				for (f = 1; f <= 3; f++) if (a[f] == b[f]) same++
				if (same >= 2) continue
				# and a second flag, not the first one again
				sc = score(L[i], 0) + (lead(L[i]) != lead(L[best]) ? 3 : 0)
				if (!two || sc > sc2) { two = i; sc2 = sc }
			}
			if (two) print "  " paint(L[two])
		}')
	[ -n "$out" ] || return 1
	printf '  %sexamples%s\n%s\n' "$U" "$N" "$out"
}

# ref_card CMD head [NOVS] -- the name, the usage line and the one-line summary,
# and the `vs` row unless NOVS: a chain opens two pages, and the second
# command's quarrel with some third one is not what the card is asking.
#
# ref_card CMD pinned PIN -- the rows of the flags this card's own answer uses
# (pin_keys), one full row each, marked with a > in the gutter. they are never
# cut: the flag the prompt is asking for used to be listed in page order and
# cut to the budget like any other, so grep -w sat in "+14 more" on the very
# card that asks for it.
#
# ref_card CMD flags [MAXROWS] [PIN] -- the other flags the curriculum drills,
# the pinned ones left out; `learn ref CMD` is always the whole thing. two
# columns once there are enough of them, cut to MAXROWS, and a list that does
# not fit spends its last row saying so. the name column is measured over the
# pinned rows too, so the two lists line up as one.
ref_card() {
	local r taught pin=
	case "$2" in pinned) pin=${3:-} ;; flags) pin=${4:-} ;; esac
	r=$(refname "$1")
	[ -f "$REF/$r" ] || return 1
	taught=$(taught_cached | awk -v c="$1" '$1 == c { f = $2; sub(/\[.*/, "", f); printf " %s", f }')
	_ref_rows "$REF/$r" |
	awk -v c="$1" -v mode="$2" -v max="${3:-0}" -v pin=" $pin " -v taught="$taught " \
	    -v cols="${COLS:-80}" -v novs="$([ "$2" = head ] && printf '%s' "${3:-}")" \
	    -v vs="$(vs_of "$1")" -v summary="$(summary_of "$1")" \
	    -v B="$B" -v N="$N" -v D="$D" -v C="$C" -v M="$M" '
		function pad(s, w,   r) { r = s; while (length(r) < w) r = r " "; return r }
		# a panel that ran out of room says so. it used to just stop: flags
		# past the budget vanished with nothing on screen to say a page had
		# been cut, which is the one failure a reference cannot have.
		function more(k) {
			if (k > 0) printf "  %s+%d more -- learn ref %s%s\n", D, k, c, N
		}
		function clip(s, w) {
			if (w < 4 || length(s) <= w) return substr(s, 1, w < 1 ? 0 : w)
			s = substr(s, 1, w - 2); sub(/[ ,][^ ,]*$/, "", s)
			sub(/[ .,|]+$/, "", s); return s ".."
		}
		# the keys a row answers to. a row names its flag first (-c), after
		# an alias (-, -i), inside brackets ([-s] TIME), after an operand
		# (N1 -eq N2, ACT1 -o ACT2), or as a bare mode letter (tar c).
		# every dashed word in the flag field is a key; a field with none is
		# keyed by its first word, which is how a bare letter gets one.
		function keys(f,   t, n, i, k) {
			gsub(/[][]/, " ", f); n = split(f, t, /[ ,]+/); k = ""
			for (i = 1; i <= n; i++) if (t[i] ~ /^-./) k = k " " t[i]
			if (k == "" && n > 0) k = " " t[1]
			return k " "
		}
		function hit(k, set,   i, m, a) {
			m = split(k, a, " ")
			for (i = 1; i <= m; i++) if (index(set, " " a[i] " ")) return 1
			return 0
		}
		# the usage line comes from the binary, which offers everything it has:
		# "echo [-neE]" over a card whose only row is -n advertises two flags
		# the curriculum has decided not to teach. the letters in a bare cluster
		# are filtered to the taught ones, the cluster goes if none survive,
		# and a whole [-x ARG] or [--long] bracket is kept or dropped as one.
		# what nests is tidied after: [[-s] TIME] with -s gone is [TIME].
		function abridge(u,   out, i, cl, keep, ch, fl) {
			out = ""
			while (match(u, /\[-[A-Za-z0-9]+\]/)) {
				cl = substr(u, RSTART + 2, RLENGTH - 3); keep = ""
				for (i = 1; i <= length(cl); i++) {
					ch = substr(cl, i, 1)
					if (index(taught, " -" ch " ")) keep = keep ch
				}
				out = out substr(u, 1, RSTART - 1) (keep == "" ? "" : "[-" keep "]")
				u = substr(u, RSTART + RLENGTH)
			}
			out = out u
			u = out; out = ""
			while (match(u, /\[(-[A-Za-z0-9] [A-Za-z_0-9]+|--[A-Za-z0-9][A-Za-z0-9-]*( [A-Za-z_0-9]+)?)\]/)) {
				fl = substr(u, RSTART + 1, RLENGTH - 2); sub(/ .*/, "", fl)
				out = out substr(u, 1, RSTART - 1)
				if (index(taught, " " fl " ")) out = out substr(u, RSTART, RLENGTH)
				u = substr(u, RSTART + RLENGTH)
			}
			out = out u
			gsub(/\[ +/, "[", out)
			gsub(/  +/, " ", out); sub(/^ +| +$/, "", out)
			return out
		}
		# the usage line is syntax you type, so it wears the typed colour;
		# the placeholders in it -- FILE, DATE, URL -- are what you fill in,
		# and go dim so the flags stand out from them
		function typed(s) {
			gsub(/[A-Z][A-Z_0-9]+/, D "&" C, s)
			return C s N
		}
		{ line[NR] = $0 }
		END {
			n = 0; fw = 0; np = 0
			for (i = 2; i <= NR; i++) {
				l = line[i]
				if (l ~ /^Usage:/) {
					usage = substr(l, 8)
					# a synopsis busybox wraps continues on tab-indented
					# lines; wget lost everything after [--header STR]
					while (i < NR && line[i + 1] ~ /^\t/) {
						l = line[++i]; gsub(/\t/, " ", l); usage = usage " " l
					}
					continue
				}
				# only a row with ONE leading tab is a row. two or more is
				# the tail of the description above it (find, ping, kill),
				# and the rewritten glosses stand on their first line.
				if (l !~ /^\t[^\t]/) continue
				sub(/^\t/, "", l); f = l; d = ""
				if (match(l, /\t+/)) { f = substr(l, 1, RSTART - 1); d = substr(l, RSTART + RLENGTH) }
				k = keys(f)
				if (!hit(k, taught) && !hit(k, pin)) continue
				if (hit(k, pin)) { np++; PF[np] = f; PD[np] = d }
				else { n++; F[n] = f; Dd[n] = d }
				if (length(f) > fw) fw = length(f)
			}
			if (mode == "head") {
				# the usage line repeats the command name, and the header
				# already prints it -- "ls  ls [-1Aa...]" reads as a stutter.
				# a usage that is nothing BUT the name (pwd, clear) leaves the
				# header alone rather than a name and a run of spaces
				gsub(/[ \t]+/, " ", usage)
				if (usage == c) usage = ""
				else if (index(usage, c " ") == 1) usage = substr(usage, length(c) + 2)
				usage = abridge(usage)
				# bold, the one title style: hdr(), statusbar() and the full
				# ref page all draw their subject this way, and a card is the
				# same page in a panel.
				if (usage == "") printf "  %s%s%s\n", B, c, N
				else printf "  %s%s%s  %s\n", B, c, N, typed(clip(usage, cols - length(c) - 6))
				if (summary != "") print "  " clip(summary, cols - 4)
				# magenta: the row exists to hold this command against the
				# one you might have reached for instead, and dim said the
				# opposite -- that it was frame, not content.
				if (vs != "" && novs == "") printf "  %s%s%s\n", M, clip(vs, cols - 4), N
				exit
			}
			# a flag name is capped at 16 columns: --no-check-certificate
			# at full width pushed its row past 80 and wrapped it
			if (fw > 16) fw = 16
			col = fw + 2
			if (mode == "pinned") {
				# a pinned row has the whole width, so a name past the
				# column (--no-check-certificate) is printed whole and its
				# gloss starts after it, rather than cut to "--no-check-cer.."
				for (i = 1; i <= np; i++) {
					pw = (length(PF[i]) > fw ? length(PF[i]) + 2 : col)
					if (PD[i] == "") printf "> %s%s%s\n", C, PF[i], N
					else printf "> %s%s%s%s\n", C, pad(PF[i], pw), N, clip(PD[i], cols - pw - 4)
				}
				exit
			}
			# TWO COLUMNS, always, once there are enough flags to be worth
			# the halved description -- never as a function of the budget, or
			# the same page takes a different shape on every card and the
			# layout reads as a property of the level rather than the command.
			# one column below the threshold, and whenever the terminal is too
			# narrow to split.
			twocol = (n > 8 && cols >= 60)
			# the budget, and the row the footer costs. a card still never
			# spends a row it was not given: when the list does not fit, the
			# LAST row goes to saying so rather than to one more flag -- and
			# ONE row with more than one flag is spent on the count alone.
			budget = (max > 0 ? max : n)
			if (n == 0) exit
			if (!twocol) {
				shown = (n <= budget ? n : budget - 1)
				for (i = 1; i <= shown; i++)
					if (Dd[i] == "") printf "  %s%s%s\n", C, clip(F[i], fw), N
					else printf "  %s%s%s%s\n", C, pad(clip(F[i], fw), col), N, clip(Dd[i], cols - col - 4)
				more(n - shown)
				exit
			}
			shown = (n <= budget * 2 ? n : (budget - 1) * 2)
			half = int((shown + 1) / 2)
			# two cells and the gap between them, measured on the plain text --
			# the colour codes go on afterwards, or every row lands ragged
			cell = int((cols - 4) / 2); dw = cell - col
			for (i = 1; i <= half; i++) {
				j = i + half
				printf "  %s%s%s%s", C, pad(clip(F[i], fw), col), N, pad(clip(Dd[i], dw), dw)
				if (j <= shown) printf "  %s%s%s%s", C, pad(clip(F[j], fw), col), N, clip(Dd[j], dw)
				printf "\n"
			}
			more(n - shown)
		}'
}

# ref_panel_text ANSWER -- the tab/man panel: what the command is, the flags
# this card's answer uses (pinned, never cut), the other flags the curriculum
# drills, two real lines from the corpus, and the shell syntax the answer leans
# on. the one place both learn's word path and the editor's Tab key call into,
# so they can never drift apart. PANEL_ROWS, when set, is the room the caller
# has, given out in this order: the head and the pinned rows always, then the
# syntax, the examples, and whatever is left to the other flags -- a row per
# page held back for them come what may, so a cut list can always say so.
# unset or 0 is no limit: a piped `tab` prints the whole card.
ref_panel_text() {
	local head syn ex left budget=${PANEL_ROWS:-0} w=${TERM_COLS:-${COLS:-80}}
	local refs r n each rows novs pinned synall need
	if [ -z "${Q_REF:-}" ]; then
		note "no reference for this one"
		return 0
	fi
	# every page this card wants open, the declared one first. a card may
	# list more than one ref:; a chain lists one and means every command its
	# answer runs, so the rest are read off the answer itself.
	refs=$(_panel_refs "$1")
	# the declared ref always survives the filter (st_block proves it is a
	# shipped page), but the panel divides by this and a zero here would take
	# the card down rather than show it short.
	n=$(printf '%s\n' "$refs" | grep -c .)
	[ "${n:-0}" -ge 1 ] 2>/dev/null || { refs=$Q_REF; n=1; }
	# each page's pinned keys, read once off the answer: CMD<TAB>keys
	printf '%s\n' "$1" | answer_flags > "$TMP/panel.flags"
	for r in $refs; do
		# shellcheck disable=SC2046
		printf '%s\t%s\n' "$r" "$(pin_keys "$r" $(awk -v c="$r" '$1 == c { print $2 }' "$TMP/panel.flags"))"
	done > "$TMP/panel.pins"
	head=""; novs=""; pinned=""
	for r in $refs; do
		head="${head:+$head
}$(ref_card "$r" head "$novs")" || { note "no entry for $r"; return 0; }
		novs=1
		pinned="$pinned$(ref_card "$r" pinned "$(_pins "$r")")"
	done
	# the syntax this ANSWER uses. the rows a page carries whatever you typed
	# (learn/syn: * ? [...] on every ls card) are the last thing given room --
	# only once every other flag has fit
	syn=$(explain_syntax "$1" "" 1) || syn=
	synall=$(explain_syntax "$1" "$Q_REF" 1) || synall=
	ex=$(ref_examples "$Q_REF" "${Q_ANSWERS:-}" "" "$(_pins "$Q_REF")") || ex=
	if [ "$budget" -gt 0 ]; then
		left=$(( budget - $(printf '%s\n' "$head" | _prows "$w") ))
		[ -z "$pinned" ] || left=$(( left - $(printf '%s\n' "$pinned" | _prows "$w") ))
		# a row per page held back for its other flags, or at the least the
		# line saying how many there are
		left=$(( left - n ))
		rows=0; [ -z "$syn" ] || rows=$(( 1 + $(printf '%s\n' "$syn" | _prows "$w") ))
		if [ "$rows" -le "$left" ]; then left=$(( left - rows )); else syn=; fi
		if [ -n "$ex" ]; then
			rows=$(printf '%s\n' "$ex" | _prows "$w")
			if [ "$rows" -le "$left" ]; then left=$(( left - rows )); else ex=; fi
		fi
		# every other flag, whole, against what is left
		need=0
		for r in $refs; do
			need=$(( need + $(ref_card "$r" flags 0 "$(_pins "$r")" | _prows "$w") ))
		done
		if [ -n "$synall" ] && [ "$synall" != "$syn" ]; then
			rows=$(( 1 + $(printf '%s\n' "$synall" | _prows "$w") ))
			[ -n "$syn" ] && rows=$(( rows - 1 - $(printf '%s\n' "$syn" | _prows "$w") ))
			[ $(( need - n + rows )) -le "$left" ] && { syn=$synall; left=$(( left - rows )); }
		fi
		# the other flags split what is left between the pages, evenly: two
		# commands on one line are two things you have to know, and a panel
		# that shows all of one and none of the other has picked for you
		each=$(( (left + n) / n ))
		[ "$each" -ge 1 ] || each=1
	else
		syn=$synall
		each=0
	fi
	printf '%s\n' "$head"
	for r in $refs; do
		ref_card "$r" pinned "$(_pins "$r")"
		ref_card "$r" flags "$each" "$(_pins "$r")"
	done
	[ -n "$ex" ] && printf '%s\n' "$ex"
	[ -n "$syn" ] && printf '  %sshell syntax%s\n%s\n' "$U" "$N" "$syn"
	return 0
}

# _pins CMD -- the pinned keys ref_panel_text read off the answer for CMD
_pins() { awk -F'\t' -v c="$1" '$1 == c { print $2; exit }' "$TMP/panel.pins" 2>/dev/null; }

# _panel_refs ANSWER -- the pages the panel opens, declared first, then the
# commands the answer actually runs. deduplicated, and only ones we ship.
_panel_refs() {
	{ printf '%s\n' "${Q_REFS:-$Q_REF}"
	  printf '%s\n' "$1" | answer_cmds
	} | awk -v r="$REF" '
		NF && !seen[$1]++ {
			f = ($1 == "." ? "dot" : $1)
			if ((getline junk < (r "/" f)) >= 0) { close(r "/" f); print $1 }
		}'
}

# explain LINE... -- the one-line summary of every command in the line, then the
# shell syntax holding them together. `learn <cmd>` still prints a full page;
# this reads a whole pipeline at once.
explain() {
	[ $# -ge 1 ] || die "usage: learn explain 'COMMAND LINE'"
	local line="$*" c cmds rows pad
	cmds=$(printf '%s\n' "$line" | answer_cmds | awk 'NF' | sort -u \
		| while read -r c; do [ -f "$REF/$(refname "$c")" ] && printf '%s\n' "$c"; done)
	rows=$(_syn_scan "$line" | grep .)
	# one column through both halves, so it is measured across both at once:
	# the command names here and the syntax labels below. measuring them
	# separately would print two columns that only sometimes line up.
	pad=$(printf '%s\n%s\n' "$cmds" "$rows" | grep . | _exp_w)
	printf '%s\n' "$cmds" | grep . | while read -r c; do
		printf "  %s%-${pad}s%s %s\n" "$W" "$c" "$N" "$(summary_of "$c")"
	done
	echo
	printf '  %sshell syntax%s\n' "$U" "$N"
	printf '%s\n' "$rows" | _exp_rows "$pad" \
		|| printf '  %s(none -- a single command, no operators)%s\n' "$D" "$N"
}
