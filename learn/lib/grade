# grade -- decide whether an answer is right.
#
# three tiers, cheapest first:
#
#   1. text match against the listed answers, after normalisation
#   2. RUN IT. the answer executes in the sandbox and is judged on its output.
#
# tier 2 is the one that matters. a listed-answer quiz can only accept the
# phrasings its author happened to think of, which teaches you to guess the
# author instead of the machine. running the answer means `sort -u` and
# `sort | uniq` both pass because both are correct, and it means a question
# has no wrong-but-unlisted answers to apologise for.
#
# xos is the reason this is safe to do at all. root is a read-only squashfs,
# the sandbox is a directory in tmpfs, and on the image the answer runs as
# `nobody` (see fixtures: DROP), so the worst it can reach is a tree learn
# rebuilds on demand. upstream needs bubblewrap for this; here the isolation
# is the operating system.

# ---- normalisation --------------------------------------------------------
#
# upstream folds --ignore-case to -i, because GNU coreutils accepts both. this
# build does not: busybox rejects --ignore-case, --lines and --all outright.
# porting that table would accept answers that do not run on the machine the
# lesson is teaching, so there is no long-flag fold here. the 31 long options
# the corpus does document (--spider, --strip-components) are long-ONLY -- they
# have no short form to fold to.

# uncat -- `cat F | filter` is graded as the direct form the lesson teaches.
# two folds, by how the filter names its input:
#   filters that take a trailing filename (grep, sort, cut) -> `filter ... F`
#   filters that only read stdin, or that decorate output with the filename
#   (tr, wc) -> `filter ... < F`. wc from an argument prints "N file" but from
#   stdin prints "N", so the redirect form is the one that matches.
# and the other way for wc alone: `wc -l F` is graded as `wc -l < F`. the
# two differ only in the trailing filename wc prints, which is decoration;
# folding it lets a count question be reference-graded (cmp: ref) with one
# canonical output, while the form everyone actually types still passes.
uncat() {
	# # delimits these, not |: the pattern needs a literal pipe AND ERE
	# alternation, and | cannot be all three at once.
	sed -E '
	  s#^cat[[:space:]]+([^ |<>&;]+)[[:space:]]*[|][[:space:]]*(wc|tr)([[:space:]].*)?$#\2\3 < \1#
	  s#^cat[[:space:]]+([^ |<>&;]+)[[:space:]]*[|][[:space:]]*([a-z]+)([[:space:]].*)?$#\2\3 \1#
	  s#^wc((( |\t)-[a-zA-Z]+)*)( |\t)+([^ |<>&;-][^ |<>&;]*)$#wc\1 < \5#
	'
}

norm() {
	tr -s ' \t' ' ' | sed 's/^ //; s/ $//' | uncat |
		tr -s ' ' ' ' | sed 's/^ //; s/ $//'
}

# ---- running the answer ---------------------------------------------------

# unsafe -- should this answer be graded on its text instead of by running it?
#
# the first cut of this blacklisted rm/mv/dd, which was wrong: those are what
# the file lessons TEACH, and refusing to run them means the one command whose
# whole effect is a mutation is the one never judged on its mutation.
#
# the second cut refused every absolute path, which was also wrong: reading
# /proc/cmdline is most of what makes this xos's curriculum and not a generic
# shell quiz. reading out is harmless.
#
# what is actually unsafe is WRITING out. the answer runs with cwd inside a
# disposable tmpfs tree, so scribbling there is free; the rule is that nothing
# may modify anything outside it. reads go anywhere, writes stay home.
#
# this is a fence, not the wall. it is a token scan over a full shell language
# and can be talked past (a loop, a here-doc, a command name in a variable);
# what it buys is a fast, explained "no" for the shapes a learner types by
# accident. the wall is the privilege drop in fixtures: on the image the
# answer runs as nobody, and file permissions do the refusing.
unsafe() {
	awk '
		BEGIN {
			split("rm mv cp ln chmod chown tee touch mkdir rmdir dd shred truncate", w, " ")
			for (i in w) writer[w[i]] = 1
			# these run whatever follows them: the command they wrap is the
			# one to judge (xargs rm /x, sh -c "rm /x", timeout 5 rm /x)
			split("xargs env timeout nohup setsid sh ash nice", wr, " ")
			for (i in wr) wrapper[wr[i]] = 1
			split("mkfs mke2fs mkdosfs mkswap swapon swapoff cryptsetup fdisk losetup" \
			      " umount blockdev sync halt reboot poweroff udhcpc dropbearkey", b, " ")
			for (i in b) banned[b[i]] = 1
			# signal senders reach live processes; only their -l listing form
			# (read-only: names and numbers) may run
			split("kill pkill killall", s, " ")
			for (i in s) sig[s[i]] = 1
		}
		# a path that leaves the sandbox, however it is dressed: absolute,
		# home-relative, or through a variable that expands to home. the
		# sandbox exports no HOME of its own, so $HOME is the real one.
		function esc(t) {
			sub(/^["\047]/, "", t)
			if (t ~ /^[\/~]/)           return 1
			if (t ~ /^\$HOME(\/|"|$)/)  return 1
			if (t ~ /^\$\{HOME\}/)      return 1
			return 0
		}
		{
			cmd = ""; n = split($0, t, /[ \t]+/)
			for (i = 1; i <= n; i++) {
				tok = t[i]
				if (tok == "|" || tok == ";" || tok == "&&" || tok == "||") { cmd = ""; continue }
				if (cmd == "") {
					cmd = tok
					if (banned[cmd])                    { print "y"; exit }
					# `find` deletes only with -delete, `sed` writes only with -i;
					# either makes the command a writer for this line
					if (cmd == "find" && index($0, "-delete")) writer["find"] = 1
					if (cmd == "sed"  && $0 ~ /(^|[ \t])-i/)  writer["sed"] = 1
					if (sig[cmd] && t[i+1] != "-l")     { print "y"; exit }
					# bare mount only lists; give it any argument and it
					# rearranges the live tree
					if (cmd == "mount" && t[i+1] != "" && t[i+1] !~ /^(\||;|&&|\|\|)$/) \
						{ print "y"; exit }
					continue
				}

				# a wrapped command becomes the command
				if (wrapper[cmd]) { w2 = tok; sub(/^["\047]/, "", w2)
				                    if (writer[w2] || banned[w2] || sig[w2]) { cmd = w2; if (banned[cmd]) { print "y"; exit } ; continue } }
				# cd out of the tree, and everything after it is out too
				if (cmd == "cd" && esc(tok))        { print "y"; exit }

				# ip reads freely (addr, route, -o link); its mutating verbs
				# reconfigure the live machine and must never run
				if (cmd == "ip" && tok ~ /^(add|del|delete|set|flush|replace|change)$/) \
					{ print "y"; exit }

				# a redirect target outside the tree, however it is spelled
				if (tok ~ /^>>?$/) { if (esc(t[i+1])) { print "y"; exit } ; continue }
				if (tok ~ /^>>?./) { rest = tok; sub(/^>>?/, "", rest)
				                     if (esc(rest)) { print "y"; exit } ; continue }

				# dd names its output with an operand, not an argument, so a
				# path check that only looks at bare tokens misses of=/dev/sda
				if (cmd == "dd" && tok ~ /^of=./) { rest = tok; sub(/^of=/, "", rest)
				                                    if (esc(rest)) { print "y"; exit } }

				# an escaping path handed to something that writes
				if (writer[cmd] && esc(tok))  { print "y"; exit }
				if (tok ~ /(^|\/)\.\.(\/|$)/) { print "y"; exit }
			}
		}
	' | grep -q y
}

# run ANSWER -- stdout+stderr of the answer, executed in a fresh sandbox.
# HOME and TMPDIR point INTO the tree: ~ and mktemp land where the answer
# lives, and under the drop the real home is not the answer's to touch anyway.
run_answer() {
	sandbox_reset || return 1
	( cd "$SANDBOX" 2>/dev/null || exit 1
	  # a wrong answer that blocks on stdin would hang the lesson
	  # shellcheck disable=SC2086
	  HOME="$SANDBOX" TMPDIR="$SANDBOX" timeout 5 $DROP "$SHELLBIN" -c "$1" </dev/null 2>&1 )
}

# ---- the verdict ----------------------------------------------------------

# check_state SPEC -- did the answer leave the tree in the right shape?
# `cp a b` prints nothing, so output cannot judge it; what it DID is the whole
# point. four forms, which between them cover every mutating command xos has:
#   exists:PATH        the path is there afterwards
#   gone:PATH          the path is not
#   match:PATH:ERE     the path is there and its contents match
#   mode:PATH:OCTAL    the path is there and carries exactly these bits
check_state() {
	case "$1" in
		exists:*) [ -e "$SANDBOX/${1#exists:}" ] ;;
		gone:*)   [ ! -e "$SANDBOX/${1#gone:}" ] ;;
		match:*)  _r=${1#match:}; _p=${_r%%:*}; _e=${_r#*:}
		          [ -e "$SANDBOX/$_p" ] && grep -qE -- "$_e" "$SANDBOX/$_p" 2>/dev/null ;;
		mode:*)   _r=${1#mode:}; _p=${_r%%:*}; _m=${_r#*:}
		          [ "$(stat -c %a "$SANDBOX/$_p" 2>/dev/null)" = "$_m" ] ;;
		*)        return 1 ;;
	esac
}

# correct GIVEN -- $Q_ANSWERS holds the listed answers, one per line.
# $Q_OUT, when set, is an ERE the answer's real output must match.
# $Q_STATE, when set, is what the tree must look like afterwards.
# $Q_STATUS, when set, is the exit code the answer must leave behind.
correct() {
	_given=$(printf '%s\n' "$1" | norm)
	[ -n "$_given" ] || return 1

	# tier 1: does it match something we listed?
	printf '%s\n' "$Q_ANSWERS" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		[ "$(printf '%s\n' "$_a" | norm)" = "$_given" ] && exit 9
	done
	[ $? -eq 9 ] && return 0

	# tier 2: it is not one we listed. run it and see if it is right anyway --
	# but do not accept an answer that produces the right output by a route that
	# is not what the question teaches. `echo 10` prints 10, but it is not
	# counting lines, so it must not pass a wc question. requiring the taught
	# command kills that cheat while still accepting every honest form:
	# `wc -l f`, `wc -l < f`, `cat f | wc -l` all use wc. grammar questions
	# (Q_REF is the shell itself) have no single command to require, so they
	# fall back to their listed forms.
	[ -n "${Q_OUT:-}" ] || [ -n "${Q_STATE:-}" ] || [ -n "${Q_STATUS:-}" ] \
		|| [ "${Q_CMP:-}" = ref ] || return 1
	# build the tree if this process has not yet. this used to test a flag
	# only selftest ever set, so in a real session tier 2 never ran: every
	# unlisted-but-correct answer was wrong until the coach happened to build
	# the sandbox on a miss, and the boss, daily and gauntlet never did.
	sandbox_reset || return 1
	printf '%s\n' "$1" | unsafe && return 1
	case "${Q_REF:-}" in
		''|sh|ash) : ;;   # grammar/builtin question: no one command to demand
		*) printf '%s\n' "$1" | answer_cmds | grep -qxF -- "$Q_REF" || return 1 ;;
	esac

	_got=$(run_answer "$_given"); _rc=$?; SANDBOX_DIRTY=1
	[ -z "${Q_OUT:-}" ]    || printf '%s\n' "$_got" | grep -qE -- "$Q_OUT" || return 1
	[ -z "${Q_STATE:-}" ]  || check_state "$Q_STATE" || return 1
	# status: judges the exit code -- the only observable a bare [ ... ] or
	# grep -q has. run_answer surfaces the answer's own status because the
	# subshell ends with it.
	[ -z "${Q_STATUS:-}" ] || [ "$_rc" = "$Q_STATUS" ] || return 1

	# cmp: ref -- the strictest tier, for questions whose out: shape alone is
	# gameable: `grep -c WARN` prints the same ^[0-9]+$ shape as the
	# `grep -c ERROR` the question asked for, and both invoke grep. deriving
	# the wanted output by running the question's own first answer against the
	# same seeded tree closes that: only the right computation prints it.
	if [ "${Q_CMP:-}" = ref ]; then
		_want=$(run_answer "$(printf '%s\n' "$Q_ANSWERS" | head -1 | norm)"); SANDBOX_DIRTY=1
		[ "$_got" = "$_want" ] || return 1
	fi
	return 0
}
