# lint -- the authoring ledger: reported here, never gated here. hint
# coverage, wording variety, execution-grading reach and prompt completeness
# are judgment calls, and a hard gate on them would breed filler. the numbers
# print beside the gates so drift is visible instead of silent. the one
# adjacent hard rule lives in selftest: an ungraded block must say why
# (see the reason list below), so "ungraded" always means "decided", never
# "forgotten".
#
# scope rules, so each number means one thing:
#   hintless        levels and missions. gauntlet stages are hintless by
#                   design (no hints under the clock).
#   single-phrasing levels only. missions and chains are fixed narrative,
#                   one voice on purpose.
#   ungraded        levels and missions: a block with no out:/state:/cmp:/
#                   status: falls back to string-matching its listed answers -- the
#                   listed-answer-quiz failure grade's notes warn about.
#                   chains are always reference-graded, never ungraded.
#   unnamed-token   any @token@ an answer needs that neither the question,
#                   its setup, nor its hint mentions: the learner cannot
#                   derive it from what is on screen. a {a|b|c} branch is
#                   shown ALONE, so a token only one branch names counts as
#                   unnamed -- the roll may never show that branch.
#   unnamed-word    the rule at its last level down, for UNGRADED blocks only.
#                   an ungraded block is string-matched against its listed
#                   answers, so every plain word the answer types -- the
#                   message logger sends, the word an echo branch prints, the
#                   filesystem type mount is told -- is part of the answer and
#                   must be on the card. graded blocks are exempt: there the
#                   output is judged, so any honest route to it passes and
#                   dictating the words would be reading the answer out.
#   unnamed-literal same rule one level down, for the constants an answer
#                   types: a path, a filename, a value like hmac-sha256.
#                   flags, their attached values, quoted sed/awk programs and
#                   /dev/null and friends are not counted -- dictating those
#                   would be reading the answer out. a path counts as named
#                   when an ancestor directory and every segment below it are
#                   on screen, and a why: conceptual block is exempt: there
#                   the words of the answer ARE the knowledge under test.
#                   `learn lint -vv` prints each one with its prompt.
#
# an ungraded block carries a why: line naming the reason it stays on string
# matching -- selftest fails any that has neither a grading field nor a why:.
# the closed reason list (unknown kinds fail selftest too, so the ledger
# cannot rot into prose):
#   live-net        needs a network, a resolver, or a peer
#   live-hw         reads hardware, the kernel log, or the live machine
#   root            needs root or real block devices
#   interactive     an editor, pager, multiplexer, or stdin conversation
#   conceptual      a one-word knowledge answer; string match IS the grader
#   fixture-cost    gradable in principle; the fixture is not worth its weight
#   primitive-cost  gradable in principle; the grader feature is not worth its weight
lint() {
	awk -v verbose="${1:-}" '
		function cls(f) {
			if (f ~ /chains$/) return "chain"
			if (f ~ /scenarios\//) return "scn"
			return "lvl"
		}
		function toks(s, dst) {
			while (match(s, /@[a-z0-9]+@/)) {
				dst[substr(s, RSTART, RLENGTH)] = 1
				s = substr(s, RSTART + RLENGTH)
			}
		}
		# a literal is an ARGUMENT the answer types that a learner cannot
		# derive from prose: a path, a filename with an extension, a
		# hyphenated value like hmac-sha256. flags, their attached values,
		# quoted sed/awk programs and the always-available character devices
		# are not literals -- naming those in a prompt would be dictation.
		function lits(s, dst,   n, i, w, parts) {
			gsub(/'"'"'[^'"'"']*'"'"'/, " ", s)
			gsub(/"[^"]*"/, " ", s)
			gsub(/[|&;<>()]/, " ", s)
			n = split(s, parts, /[ \t]+/)
			for (i = 1; i <= n; i++) {
				w = parts[i]
				if (w ~ /^-/) continue                  # a flag, and its value
				if (index(w, "$" "{")) continue         # a shell expansion
				if (w ~ /^[0-9a-fA-F:]*::[0-9a-fA-F:]*$/) { dst[w] = 1; continue }  # an ipv6 address
				if (w ~ /[%+]/) continue                # a format string
				sub(/^[a-z]+:\/\//, "", w)              # scheme: host and path stay
				sub(/^\.\//, "", w)                     # ./script is script
				sub(/^[^A-Za-z0-9\/$@]+/, "", w)
				sub(/[,.:\/]+$/, "", w)
				if (index(w, "=")) sub(/^[^=]*=/, "", w)
				if (w == "") continue
				if (w !~ /[.\/-]/) continue
				if (w ~ /^[a-z]+$/) continue
				if (w ~ /^[A-Za-z0-9]-[A-Za-z0-9]$/) continue   # a tr range
				if (w ~ /^\/dev\/(null|zero|urandom|stdin|stdout)$/) continue
				dst[w] = 1
			}
		}
		# words -- the plain words an answer passes as ARGUMENTS: the
		# message logger logs, the word an echo prints, the type mount is
		# given. a command word is not one (naming it would be dictation),
		# nor is a flag or the value attached to one.
		function words(s, dst,   n, i, tok, cmd, prev, parts) {
			n = split(s, parts, /[ \t]+/); cmd = ""; prev = 0
			for (i = 1; i <= n; i++) {
				tok = parts[i]
				if (tok ~ /^[|;&(){}]+$/ || tok == "&&" || tok == "||") { cmd = ""; continue }
				if (tok ~ /^(then|else|elif|fi|do|done|case|esac|in)$/) { cmd = ""; continue }
				if (cmd == "") { cmd = tok; continue }
				if (tok ~ /^-/) { prev = 1; continue }   # a flag
				if (prev)      { prev = 0; continue }    # and its value
				# a wrapper runs what follows it: that is a command, not an argument
				if (tok ~ /^(env|timeout|xargs|nohup|setsid|watch|flock|sh|ash|chroot)$/) { cmd = ""; continue }
				gsub(/^['\''"]|['\''"]$/, "", tok)
				if (tok ~ /^[a-z][a-z0-9]*$/) dst[tok] = 1
			}
		}
		# named -- is this literal on screen? a trailing glob is not part of
		# the name, and a path counts as named when its directory and its
		# leaf are both there: the learner can put those back together.
		function named(w, ctx,   d, i, j, n, ok, seg) {
			sub(/\/\*$/, "", w)
			if (index(ctx, w)) return 1
			# user@host is named when both halves are: nobody has to be told
			# that dbclient wants them joined by an @.
			if (w ~ /^[A-Za-z0-9_.-]+@[A-Za-z0-9_.@-]+$/) {
				i = index(w, "@")
				if (index(ctx, substr(w, 1, i - 1)) && index(ctx, substr(w, i + 1)))
					return 1
			}
			# a @token@ segment belongs to the unnamed-token metric, not to
			# this one -- drop those and judge what is left. $HOME/irc/@host@/in
			# is named by "$HOME/irc" plus "in", the two parts an author writes.
			gsub(/\/@[a-z0-9]+@/, "", w)
			if (w == "" || w == "/") return 1
			if (index(ctx, w)) return 1
			# otherwise walk the prefixes: the literal is named when some
			# ancestor directory is on screen and every segment below it is
			# too. that is a path the learner can assemble, not one they had
			# to already know.
			n = split(w, seg, "/")
			for (i = n - 1; i >= 1; i--) {
				d = seg[1]
				for (j = 2; j <= i; j++) d = d "/" seg[j]
				if (d == "" || !index(ctx, d)) continue
				ok = 1
				for (j = i + 1; j <= n; j++) if (!index(ctx, seg[j])) ok = 0
				if (ok) return 1
			}
			return 0
		}
		# inevery TOKEN, QLINE -- is the token on the card whichever {a|b|c}
		# branch is rolled? outside the braces it always is; inside, only if
		# every branch carries it. a branch is shown alone, so a token only
		# one branch names is a token the learner may never see.
		function inevery(t, qq,   a, b, rest, n, i, br) {
			a = index(qq, "{"); b = index(qq, "}")
			if (a == 0 || b < a) return index(qq, t) > 0
			rest = substr(qq, 1, a - 1) substr(qq, b + 1)
			if (index(rest, t)) return 1
			n = split(substr(qq, a + 1, b - a - 1), br, "|")
			for (i = 1; i <= n; i++) if (!index(br[i], t)) return 0
			return 1
		}
		function flushblk(   k, t) {
			if (!inblk) return
			total++; ft[bf]++
			k = cls(bf)
			if (!hashint && k != "chain") { nohint++; fh[bf]++ }
			if (k == "lvl" && q !~ /%[a-z]+%/ && q !~ /\{[^{}]*\|/) { novary++; fv[bf]++ }
			if (!graded && k != "chain") { nograde++; fg[bf]++; if (haswhy) explained++ }
			# an out: with fewer than four literal characters once the regex
			# metacharacters are gone (. ^/ Mem [0-9] ^[0-9]+$) is matched by
			# the bare command, or by any count, as often as by the flag the
			# question teaches; it counts as graded and asserts nothing.
			# state:/cmp:/status: make a block strong whatever its out: says.
			if (weak && !strong && k != "chain") { nweak++; fw2[bf]++ }
			for (t in atok) if (!(t in qtok) && !inevery(t, q)) { nounnamed++; fu[bf]++; break }
			# same idea one level down: a literal the answer types that the
			# prompt, its setup and its hint never name is not merely vague,
			# it is unanswerable. a conceptual block is exempt -- there the
			# words of the answer ARE the knowledge being tested.
			# a word an ungraded answer types, named nowhere on the card. the
			# q half honours the branch rule -- a word only one {a|b|c} branch
			# names is a word the roll may never show.
			if (!graded && !conceptual && k != "chain") {
				bad = ""
				for (t in aword)
					if (t != refcmd && !index(tolower(ctxq), t) && !inevery(t, tolower(q)))
						bad = bad (bad ? "," : "") t
				if (bad != "") {
					noword++; fx[bf]++
					if (verbose == "-vv")
						printf "  %s: word %s\n    %s\n", bf, bad, q > "/dev/stderr"
				}
			}
			if (!conceptual) {
				bad = ""
				for (t in alit) if (!named(t, ctxs)) bad = bad (bad ? "," : "") t
				if (bad != "") {
					nolit++; fl[bf]++
					if (verbose == "-vv")
						printf "  %s: %s\n    %s\n", bf, bad, q > "/dev/stderr"
				}
			}
			inblk = 0; delete atok; delete qtok; delete alit; delete aword
		}
		# bf pins the block to the file it came from: at FNR==1 awk has already
		# advanced FILENAME, so flushing by FILENAME charges each file
		# closing block to the next file in the glob
		FNR == 1 { flushblk() }
		/^---$/  { flushblk(); inblk = 1; bf = FILENAME; hashint = 0; graded = 0; haswhy = 0; weak = 0; strong = 0; q = ""; ctxs = ""; ctxq = ""; refcmd = ""; firsta = ""; conceptual = 0; next }
		inblk && /^hint:/ { hashint = 1 }
		inblk && /^why:/  { haswhy = 1 }
		inblk && /^(out|state|cmp|status):/ { graded = 1 }
		inblk && /^(state|cmp|status):/ { strong = 1 }
		inblk && /^out: / { o = $0; sub(/^out: /, "", o); gsub(/[][^$()*+?.|\\{}]/, "", o); if (length(o) < 4) weak = 1 }
		inblk && /^q: / && q == "" { q = $0 }
		inblk && /^(setup|hint):/ { toks($0, qtok) }
		inblk && /^a: / { toks($0, atok) }
		inblk && /^why: conceptual$/ { conceptual = 1 }
		inblk && /^(q|setup|hint|teach): / { ctxs = ctxs " " substr($0, index($0, ":") + 2) }
		# ctxq drops the q: the setup and hint are always on screen, while a
		# {a|b|c} question shows one branch, judged by inevery instead.
		inblk && /^(setup|hint|teach): / { ctxq = ctxq " " substr($0, index($0, ":") + 2) }
		inblk && /^ref: / { refcmd = substr($0, 6); sub(/ .*/, "", refcmd) }
		inblk && /^a: / && firsta == "" { firsta = substr($0, 4); lits(firsta, alit); words(firsta, aword) }
		END {
			flushblk()
			if (verbose == "-v")
				for (f in ft) {
					n = split(f, p, "/")
					printf "  %-24s %3d questions  %3d hintless  %3d single-phrasing  %3d ungraded  %3d weak-out  %3d unnamed-token  %3d unnamed-literal  %3d unnamed-word\n", \
						p[n], ft[f], fh[f] + 0, fv[f] + 0, fg[f] + 0, fw2[f] + 0, fu[f] + 0, fl[f] + 0, fx[f] + 0
				}
			printf "learn: lint: %d questions, %d without a hint, %d with a single phrasing, %d ungraded (%d explained), %d weak out:, %d with an unnamed token, %d with an unnamed literal, %d with an unnamed word\n", \
				total, nohint, novary, nograde, explained + 0, nweak + 0, nounnamed, nolit + 0, noword + 0
		}
	' "$LEVELS"/* "$SCENARIOS"/* "$CHAINS"
}

# ---- macro grammar --------------------------------------------------------
#
# a phrase macro is only a macro if EVERY member fits the sentence. the way it
# stops being one is a particle: "%turn% on vi keybindings" renders "convert on
# vi keybindings", "%count% up from 1 to 10" renders "add up up from 1 to 10".
# the verb in those sentences is phrasal or causative and belongs to exactly
# one member, so the card must say it outright. this catches the shape, not
# every wrong pairing -- grammar is still read by hand, member by member.
#
# macro_particle -- prints every prompt whose macro is followed by a particle.
macro_particle() {
	grep -nE '^q: %[a-z]+% (on|off|up|out|in|into|back|down|over|away|through) ' \
		"$LEVELS"/* "$SCENARIOS"/* "$CHAINS" 2>/dev/null |
		sed 's/^/  /'
}

# ---- prompt width ---------------------------------------------------------
#
# a question that wraps costs the reference panel a row and reads as a
# paragraph instead of an instruction. the width that matters is the WIDEST a
# prompt can render: the longest {a|b|c} branch, the longest %macro% synonym
# and the longest value in whatever pool each @token@ draws from. the map from
# token to pool comes from roll itself, via token_pools in ctx, so a new
# token is measured the day it is added.
#
# qwidth_over MAX -- prints every prompt whose widest rendering exceeds MAX.
qwidth_over() {
	local max=${1:-76}
	token_pools > "$TMP/qwidth.map"
	awk -v max="$max" -v map="$TMP/qwidth.map" -v pools="$POOLS" \
	    -v phr="$ROOT/phrases" '
		function longest(file,   l, best) {
			best = ""
			while ((getline l < file) > 0) {
				sub(/[ \t]+$/, "", l)
				if (l == "" || l ~ /^#/) continue
				if (length(l) > length(best)) best = l
			}
			close(file)
			return best
		}
		BEGIN {
			# token -> the widest value its pool can hold. the map comes from
			# roll itself, via token_pools in ctx -- never a second list here.
			while ((getline l < map) > 0) {
				split(l, kv, " ")
				W[kv[1]] = length(longest(pools "/" kv[2]))
			}
			close(map)
			# the numeric tokens are not pooled: two digits is the widest roll
			W["n"] = 2; W["n3"] = 2
			# %macro% -> its longest member, from "name = one | two | three"
			while ((getline l < phr) > 0) {
				if (l ~ /^#/ || l !~ /=/) continue
				name = l; sub(/[ \t]*=.*/, "", name); gsub(/[ \t]/, "", name)
				rest = l; sub(/^[^=]*=[ \t]*/, "", rest)
				n = split(rest, m, "|")
				best = ""
				for (i = 1; i <= n; i++) {
					gsub(/^[ \t]+|[ \t]+$/, "", m[i])
					if (length(m[i]) > length(best)) best = m[i]
				}
				P[name] = best
			}
		}
		function widest(s,   out, i, n, br, b, best, open, depth, start) {
			# {a|b|c} -> the longest branch, innermost first
			while ((start = index(s, "{")) > 0) {
				depth = 0
				for (i = start; i <= length(s); i++) {
					c = substr(s, i, 1)
					if (c == "{") { depth++; if (depth == 1) start = i }
					else if (c == "}") { depth--; if (depth == 0) break }
				}
				if (depth != 0) break
				br = substr(s, start + 1, i - start - 1)
				if (index(br, "{") > 0) { start = index(br, "{") + start; continue }
				n = split(br, b, "|"); best = ""
				for (j = 1; j <= n; j++) if (length(b[j]) > length(best)) best = b[j]
				s = substr(s, 1, start - 1) best substr(s, i + 1)
			}
			return s
		}
		/^q: / {
			# expand BEFORE collapsing {a|b|c}: the longest branch as typed is
			# not the widest one rendered -- a short branch holding @log@ beats
			# a long one holding none, and picking the wrong branch here let a
			# card sit six columns over the gate unnoticed.
			s = substr($0, 4)
			while (match(s, /%[a-z_]+%/)) {
				k = substr(s, RSTART + 1, RLENGTH - 2)
				s = substr(s, 1, RSTART - 1) (k in P ? P[k] : k) substr(s, RSTART + RLENGTH)
			}
			while (match(s, /@[a-z0-9]+@/)) {
				k = substr(s, RSTART + 1, RLENGTH - 2)
				pad = ""
				for (i = 0; i < (k in W ? W[k] : 8); i++) pad = pad "x"
				s = substr(s, 1, RSTART - 1) pad substr(s, RSTART + RLENGTH)
			}
			s = widest(s)
			if (length(s) > max)
				printf "  %s:%d  %d cols\n", FILENAME, FNR, length(s)
		}
	' "$LEVELS"/* "$SCENARIOS"/* "$CHAINS" 2>/dev/null
}

# ---- cmp: ref against a moving target -------------------------------------
#
# cmp: ref grades by running the first listed answer and comparing the
# learner's output to it. that is only sound when the two runs see the same
# world. reading the image's own files is fine -- they are read-only and
# identical on every boot -- but a command whose output changes between two
# consecutive runs makes the gate fail at random, on a busy machine, hours
# after the change that "caused" it. this has bitten twice: a mount-option
# question that raced another process mounting something, and a socket list.
#
# cmpref_moving -- prints every cmp: ref block whose answer cannot repeat.
cmpref_moving() {
	awk '
		function flush(   a) {
			if (inblk && cmp && ans != "") {
				a = ans
				# commands that report what the machine is doing right now
				if (a ~ /(^|[ |;&(])(netstat|ps|top|free|uptime|date|dmesg|pgrep|pidof|lsof|fuser)([ |;&)]|$)/)
					printf "  %s: cmp: ref over live state -- %s\n", bf, a
				# /proc/mounts is only steady if the answer pins one mount;
				# scanning every row races anything that mounts or unmounts
				else if (a ~ /\/proc\/mounts/ && a !~ /\$2[ ]*==[ ]*"\/"/ && a !~ /" \/ "/)
					printf "  %s: cmp: ref over every mount -- %s\n", bf, a
			}
			inblk = 0; cmp = 0; ans = ""
		}
		FNR == 1 { flush() }
		/^---$/  { flush(); inblk = 1; bf = FILENAME; next }
		inblk && /^cmp: ref/ { cmp = 1 }
		inblk && /^a: / && ans == "" { ans = $0; sub(/^a: /, "", ans) }
		END { flush() }
	' "$LEVELS"/* "$SCENARIOS"/* "$CHAINS" 2>/dev/null
}

# ---- spelling folds --------------------------------------------------------
#
# grade's flagnorm reduces every spelling of a command to one key, so `tar xzf`
# and `tar -zxf` meet. that is only safe while no two DIFFERENT commands reduce
# to the same key -- one collision and a wrong answer starts passing.
#
# foldcollide -- prints every group of distinct listed answers sharing a key.
# answers on the same card are meant to be the same command, so those are the
# collisions the fold exists to make; any other group is a bug in the fold.
foldcollide() {
	awk 'FNR == 1 { blk = 0 } /^---$/ { blk++ }
	     /^a: / { a = $0; sub(/^a: /, "", a); print FILENAME "#" blk "\t" a }' \
		"$LEVELS"/* "$SCENARIOS"/* "$CHAINS" 2>/dev/null | sort -u > "$TMP/fold.raw"
	cut -f2 "$TMP/fold.raw" | flagnorm > "$TMP/fold.key"
	paste "$TMP/fold.key" "$TMP/fold.raw" | sort | awk -F'\t' '
		{ key = $1; card = $2; ans = $3
		  if (key != last) { report(); last = key; n = 0; delete cs; delete as }
		  cs[++n] = card; as[n] = ans }
		END { report() }
		function report(   i, same) {
			if (n < 2) return
			# the same answer drilled on two cards is not a collision, and
			# neither is a card listing two spellings on purpose -- the fold
			# exists to make those meet. only two DIFFERENT commands landing
			# on one key is a bug.
			same = 1
			for (i = 2; i <= n; i++) if (as[i] != as[1]) same = 0
			if (same) return
			same = 1
			for (i = 2; i <= n; i++) if (cs[i] != cs[1]) same = 0
			if (same) return
			printf "  two commands fold to one key:\n"
			for (i = 1; i <= n; i++) printf "    %s  %s\n", cs[i], as[i]
		}'
}

# ---- a flag's value is a constant, not dictation ---------------------------
#
# lint's named() deliberately exempts flags and the values attached to them:
# naming a flag in a prompt is dictation. its VALUE is not. `ping -c 3 -q @ip@`
# behind "ping @ip@ quietly, summary only" cannot be answered -- nothing on the
# card says three, and the arping run beside it wants -c 1 without saying one.
# these blocks are graded by string match, so an unnamed value is not vague, it
# is unanswerable. that hole is what let a whole ping level through.
#
# unnamed_value -- prints every ungraded block whose answer passes a value no
# prompt, setup or hint names. flagnorm marks a value with \001, so a flag
# that merely looks like one (-type, -maxdepth) is never mistaken for one. a
# spelled-out small number counts as naming it: "three times" names 3.
unnamed_value() {
	awk 'FNR == 1 { flush() }
	     /^---$/ { flush(); inblk = 1; bf = FILENAME; next }
	     inblk && /^q: / && q == "" { q = substr($0, 4); ql = FNR }
	     inblk && /^a: / && a == "" { a = substr($0, 4) }
	     inblk && /^(setup|hint): / { ctx = ctx " " substr($0, index($0, ":") + 2) }
	     inblk && /^(out|state|cmp|status): / { graded = 1 }
	     inblk && /^why: conceptual$/ { conceptual = 1 }
	     inblk && /^ref: / { rc = substr($0, 6); sub(/ .*/, "", rc) }
	     END { flush() }
	     function flush() {
	         if (inblk && q != "" && !graded && !conceptual)
	             printf "%s:%d\t%s\t%s\t%s\t%s\n", bf, ql, ctx, q, a, rc
	         inblk = 0; q = ""; a = ""; ctx = ""; graded = 0; conceptual = 0; rc = ""
	     }' "$LEVELS"/* "$SCENARIOS"/* 2>/dev/null > "$TMP/uv.raw"
	cut -f4 "$TMP/uv.raw" | flagnorm > "$TMP/uv.key"
	paste "$TMP/uv.raw" "$TMP/uv.key" | awk -F'\t' -v ref="$REF" '
		BEGIN { split("zero one two three four five six seven eight nine ten", W, " ")
		        for (i in W) NUM[W[i]] = i - 1 }
		# a value only one {a|b|c} branch names is one the roll may never show
		function inevery(t, qq,   a, b, rest, n, i, br) {
			a = index(qq, "{"); b = index(qq, "}")
			if (a == 0 || b < a) return index(qq, t) > 0
			rest = substr(qq, 1, a - 1) substr(qq, b + 1)
			if (index(rest, t)) return 1
			n = split(substr(qq, a + 1, b - a - 1), br, "|")
			for (i = 1; i <= n; i++) if (!index(br[i], t)) return 0
			return 1
		}
		# a default documented on the ref page for this command is on
		# screen: the card opens that page on Tab. -p PORT (default 6667)
		# is knowledge the learner can reach; a count an author picked is not.
		function inref(v, c,   f, l) {
			if (c == "") return 0
			if (!(c in refseen)) {
				refseen[c] = ""
				f = ref "/" (c == "." ? "dot" : c)
				while ((getline l < f) > 0) refseen[c] = refseen[c] " " l
				close(f)
			}
			return refseen[c] ~ ("default[^A-Za-z0-9]*" v "([^A-Za-z0-9]|$)")
		}
		function named(v, ctx, q, rc,   w) {
			if (index(ctx, v) || inevery(v, q)) return 1
			for (w in NUM) if (NUM[w] == v && (index(ctx, w) || inevery(w, q))) return 1
			return inref(v, rc)
		}
		{
			n = split($6, t, " "); bad = ""
			for (i = 1; i <= n; i++) {
				p = index(t[i], "\001"); if (p == 0) continue
				v = substr(t[i], p + 1)
				if (v == "" || v ~ /^@/ || v ~ /^[$]/) continue      # a token or a shell expansion
				gsub(/^['\''"]|['\''"]$/, "", v)
				if (v != "" && !named(v, $2, $3, $5))
					bad = bad (bad ? ", " : "") substr(t[i], 1, p - 1) " " v
			}
			if (bad != "") printf "  %s: answer needs %s, named nowhere on the card\n    %s\n", $1, bad, $4
		}'
}
