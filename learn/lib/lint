# lint -- the authoring ledger: reported here, never gated here. hint
# coverage, wording variety, execution-grading reach and prompt completeness
# are judgment calls, and a hard gate on them would breed filler. the numbers
# print beside the gates so drift is visible instead of silent. the one
# adjacent hard rule lives in selftest: an ungraded block must say why
# (see the reason list below), so "ungraded" always means "decided", never
# "forgotten".
#
# scope rules, so each number means one thing:
#   hintless        levels and missions. gauntlet stages are hintless by
#                   design (no hints under the clock).
#   single-phrasing levels only. missions and chains are fixed narrative,
#                   one voice on purpose.
#   ungraded        levels and missions: a block with no out:/state:/cmp:/
#                   status: falls back to string-matching its listed answers -- the
#                   listed-answer-quiz failure grade's notes warn about.
#                   chains are always reference-graded, never ungraded.
#   unnamed-token   any @token@ an answer needs that neither the question,
#                   its setup, nor its hint mentions: the learner cannot
#                   derive it from what is on screen.
#
# an ungraded block carries a why: line naming the reason it stays on string
# matching -- selftest fails any that has neither a grading field nor a why:.
# the closed reason list (unknown kinds fail selftest too, so the ledger
# cannot rot into prose):
#   live-net        needs a network, a resolver, or a peer
#   live-hw         reads hardware, the kernel log, or the live machine
#   root            needs root or real block devices
#   interactive     an editor, pager, multiplexer, or stdin conversation
#   conceptual      a one-word knowledge answer; string match IS the grader
#   fixture-cost    gradable in principle; the fixture is not worth its weight
#   primitive-cost  gradable in principle; the grader feature is not worth its weight
lint() {
	awk -v verbose="${1:-}" '
		function cls(f) {
			if (f ~ /chains$/) return "chain"
			if (f ~ /scenarios\//) return "scn"
			return "lvl"
		}
		function toks(s, dst) {
			while (match(s, /@[a-z0-9]+@/)) {
				dst[substr(s, RSTART, RLENGTH)] = 1
				s = substr(s, RSTART + RLENGTH)
			}
		}
		function flushblk(   k, t) {
			if (!inblk) return
			total++; ft[bf]++
			k = cls(bf)
			if (!hashint && k != "chain") { nohint++; fh[bf]++ }
			if (k == "lvl" && q !~ /%[a-z]+%/ && q !~ /\{[^{}]*\|/) { novary++; fv[bf]++ }
			if (!graded && k != "chain") { nograde++; fg[bf]++; if (haswhy) explained++ }
			# an out: with fewer than four literal characters once the regex
			# metacharacters are gone (. ^/ Mem [0-9] ^[0-9]+$) is matched by
			# the bare command, or by any count, as often as by the flag the
			# question teaches; it counts as graded and asserts nothing.
			# state:/cmp:/status: make a block strong whatever its out: says.
			if (weak && !strong && k != "chain") { nweak++; fw2[bf]++ }
			for (t in atok) if (!(t in qtok)) { nounnamed++; fu[bf]++; break }
			inblk = 0; delete atok; delete qtok
		}
		# bf pins the block to the file it came from: at FNR==1 awk has already
		# advanced FILENAME, so flushing by FILENAME charges each file
		# closing block to the next file in the glob
		FNR == 1 { flushblk() }
		/^---$/  { flushblk(); inblk = 1; bf = FILENAME; hashint = 0; graded = 0; haswhy = 0; weak = 0; strong = 0; q = ""; next }
		inblk && /^hint:/ { hashint = 1 }
		inblk && /^why:/  { haswhy = 1 }
		inblk && /^(out|state|cmp|status):/ { graded = 1 }
		inblk && /^(state|cmp|status):/ { strong = 1 }
		inblk && /^out: / { o = $0; sub(/^out: /, "", o); gsub(/[][^$()*+?.|\\{}]/, "", o); if (length(o) < 4) weak = 1 }
		inblk && /^q: / && q == "" { q = $0 }
		inblk && /^(q|setup|hint):/ { toks($0, qtok) }
		inblk && /^a: / { toks($0, atok) }
		END {
			flushblk()
			if (verbose == "-v")
				for (f in ft) {
					n = split(f, p, "/")
					printf "  %-24s %3d questions  %3d hintless  %3d single-phrasing  %3d ungraded  %3d weak-out  %3d unnamed-token\n", \
						p[n], ft[f], fh[f] + 0, fv[f] + 0, fg[f] + 0, fw2[f] + 0, fu[f] + 0
				}
			printf "learn: lint: %d questions, %d without a hint, %d with a single phrasing, %d ungraded (%d explained), %d weak out:, %d with an unnamed token\n", \
				total, nohint, novary, nograde, explained + 0, nweak + 0, nounnamed
		}
	' "$LEVELS"/* "$SCENARIOS"/* "$CHAINS"
}

# ---- prompt width ---------------------------------------------------------
#
# a question that wraps costs the reference panel a row and reads as a
# paragraph instead of an instruction. the width that matters is the WIDEST a
# prompt can render: the longest {a|b|c} branch, the longest %macro% synonym
# and the longest value in whatever pool each @token@ draws from. the map from
# token to pool is read out of lib/ctx rather than restated here, so a new
# token is measured the day it is added.
#
# qwidth_over MAX -- prints every prompt whose widest rendering exceeds MAX.
qwidth_over() {
	local max=${1:-76}
	awk -v max="$max" -v ctx="$ROOT/lib/ctx" -v pools="$POOLS" \
	    -v phr="$ROOT/phrases" '
		function longest(file,   l, best) {
			best = ""
			while ((getline l < file) > 0) {
				sub(/[ \t]+$/, "", l)
				if (l == "" || l ~ /^#/) continue
				if (length(l) > length(best)) best = l
			}
			close(file)
			return best
		}
		BEGIN {
			# token -> pool, straight out of the roll: "pick logs; sub log ..."
			while ((getline l < ctx) > 0) {
				if (l !~ /pick2?[ \t]/) continue
				if (!match(l, /pick2?[ \t]+[A-Za-z0-9._]+/)) continue
				p = substr(l, RSTART, RLENGTH); sub(/pick2?[ \t]+/, "", p)
				n = split(l, part, ";")
				for (i = 1; i <= n; i++)
					if (match(part[i], /sub[ \t]+[a-z0-9]+/)) {
						t = substr(part[i], RSTART, RLENGTH); sub(/sub[ \t]+/, "", t)
						W[t] = length(longest(pools "/" p))
					}
			}
			# the numeric tokens are not pooled: two digits is the widest roll
			W["n"] = 2; W["n3"] = 2
			# %macro% -> its longest member, from "name = one | two | three"
			while ((getline l < phr) > 0) {
				if (l ~ /^#/ || l !~ /=/) continue
				name = l; sub(/[ \t]*=.*/, "", name); gsub(/[ \t]/, "", name)
				rest = l; sub(/^[^=]*=[ \t]*/, "", rest)
				n = split(rest, m, "|")
				best = ""
				for (i = 1; i <= n; i++) {
					gsub(/^[ \t]+|[ \t]+$/, "", m[i])
					if (length(m[i]) > length(best)) best = m[i]
				}
				P[name] = best
			}
		}
		function widest(s,   out, i, n, br, b, best, open, depth, start) {
			# {a|b|c} -> the longest branch, innermost first
			while ((start = index(s, "{")) > 0) {
				depth = 0
				for (i = start; i <= length(s); i++) {
					c = substr(s, i, 1)
					if (c == "{") { depth++; if (depth == 1) start = i }
					else if (c == "}") { depth--; if (depth == 0) break }
				}
				if (depth != 0) break
				br = substr(s, start + 1, i - start - 1)
				if (index(br, "{") > 0) { start = index(br, "{") + start; continue }
				n = split(br, b, "|"); best = ""
				for (j = 1; j <= n; j++) if (length(b[j]) > length(best)) best = b[j]
				s = substr(s, 1, start - 1) best substr(s, i + 1)
			}
			return s
		}
		/^q: / {
			s = widest(substr($0, 4))
			while (match(s, /%[a-z_]+%/)) {
				k = substr(s, RSTART + 1, RLENGTH - 2)
				s = substr(s, 1, RSTART - 1) (k in P ? P[k] : k) substr(s, RSTART + RLENGTH)
			}
			while (match(s, /@[a-z0-9]+@/)) {
				k = substr(s, RSTART + 1, RLENGTH - 2)
				pad = ""
				for (i = 0; i < (k in W ? W[k] : 8); i++) pad = pad "x"
				s = substr(s, 1, RSTART - 1) pad substr(s, RSTART + RLENGTH)
			}
			if (length(s) > max)
				printf "  %s:%d  %d cols\n", FILENAME, FNR, length(s)
		}
	' "$LEVELS"/* "$SCENARIOS"/* "$ROOT/chains" 2>/dev/null
}
