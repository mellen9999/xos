# projects -- write a program, not a line.
#
# every other card in the corpus is answered with ONE line. that is the right
# shape for a flag and the wrong shape for the thing flags are for: 916 of the
# corpus's answers are a single command, and a learner who has held all thirty
# levels can still not sit down and write a script. a project is the missing
# half -- a written spec, a file you author in the editor the curriculum
# already taught, and hidden cases that run it.
#
# no boss and no clock. a boss is five recalls in thirty seconds each, which is
# the correct test for "do you still know -n" and a meaningless one for "can
# you write this" -- so a project is not a card either: it is done or it is
# not, recorded in its own ledger, and it never enters the review pool. what
# you would re-do is the writing, and re-doing writing is not repetition.
#
# a project is graded the way `cmp: ref` grades a line, one rung up: the
# reference solution runs the same hidden cases against the same seeded tree,
# and your program has to print what it prints and exit how it exits. so any
# honest implementation passes and there is nothing to guess about the author.

PROJECTS="$ROOT/projects"
PRJ_DONE="$STATE/projects"
PRJ_INDEX="$TMP/prj.index"

project_ids() { ls -1 "$PROJECTS" 2>/dev/null | sort; }
prj_path()    { echo "$PROJECTS/$1"; }
prj_field()   { blk_field "$(prj_path "$1")" "$2"; }
prj_index()   { blk_index "$PROJECTS" "$PRJ_INDEX"; }
prj_nq()      { prj_index; awk -F'\t' -v i="$1" '$1 == i { print $3; exit }' "$PRJ_INDEX"; }
prj_after()   { prj_index; awk -F'\t' -v i="$1" '$1 == i { if ($2 != "-") print $2; exit }' "$PRJ_INDEX"; }

prj_unlocked() { local a; a=$(prj_after "$1"); [ -n "$a" ] || return 0; level_is_passed "$a"; }

# asked on every menu draw -- one walk of the index, no fork per project.
projects_any_unlocked() {
	local _id _a _nq ps
	prj_index; ps=$(passed_set)
	while IFS='	' read -r _id _a _nq _rest; do
		gate_open "$_a" "$ps" && return 0
	done < "$PRJ_INDEX"
	return 1
}

# the ledger is one line per finished program, "id/index". a project is not a
# card: there is no tier to hold and nothing to decay, so `passed` is the
# precedent here, not `cards` -- a thing you did, kept.
prj_is_done() { grep -qxF -- "$1/$2" "$PRJ_DONE" 2>/dev/null; }
prj_mark()    { prj_is_done "$1" "$2" || { mkdir -p "$STATE" 2>/dev/null; echo "$1/$2" >> "$PRJ_DONE" 2>/dev/null; }; }
# the ledger is "id/index" a line, so counting one project's finished programs
# is one pass over it and the index -- the old loop asked the project file how
# many blocks it had ONCE PER CASE, a fork apiece, on every menu draw. the
# index supplies that count now, and it is still a cap: a case dropped from a
# project leaves its line in the ledger, and 5/3 done is not a thing to print.
prj_ndone()   {
	prj_index
	awk -v p="$1" -v ix="$PRJ_INDEX" '
		FILENAME == ix { if (index($0, p "\t") == 1) { split($0, f, "\t"); nq = f[3] + 0 }; next }
		{ n = split($0, g, "/"); i = g[2] + 0
		  if (n == 2 && g[1] == p && i >= 1 && i <= nq) c++ }
		END { print c + 0 }
	' "$PRJ_INDEX" "$PRJ_DONE" 2>/dev/null || echo 0
}

# prj_announce LEVEL -- name every project that level's fall just opened.
# the mirror of scn_announce, and for the same reason: a thing that unlocks
# silently is a thing nobody finds.
prj_announce() {
	local pid n=0 a _nq name
	prj_index
	while IFS='	' read -r pid a _nq name; do
		[ "$a" = "$1" ] || continue
		n=$((n + 1)); ok "project unlocked -- $name"
	done < "$PRJ_INDEX"
	[ "$n" -gt 0 ] || return 1
	note "press w at the menu to write $([ "$n" -gt 1 ] && echo them || echo it)."
	return 0
}

# prj_flow -- c text is written in paragraphs, so it is reflowed to the
# screen (c_reflow); a script project's text keeps its lines.
prj_flow() { if [ "$PRJ_LANG" = c ]; then c_reflow; else cat; fi; }

# ---- running a program ----------------------------------------------------

# prj_run WORKFILE NAME CASE -- one case, against a freshly built tree.
#
# the tree is rebuilt for EVERY run, both the learner's and the reference's: a
# program that writes, deletes or appends leaves a different world behind it,
# and a reference run that inherited that world would be grading the learner's
# side effects instead of the reference's output. the working copy lives
# outside the sandbox for the same reason -- the first rebuild would delete it.
prj_run() {
	SANDBOX_DIRTY=1
	sandbox_reset || return 1
	cp "$1" "$SANDBOX/$2" 2>/dev/null || return 1
	chmod 0644 "$SANDBOX/$2" 2>/dev/null
	# shellcheck disable=SC2086
	# its own session, killed whole after (c_run says why): a stage the
	# program left running would hold this output pipe open forever.
	( cd "$SANDBOX" 2>/dev/null || exit 1
	  HOME="$SANDBOX" TMPDIR="$SANDBOX" setsid timeout 5 $DROP "$SHELLBIN" -c "$3" </dev/null 2>&1 &
	  p=$!; wait "$p"; r=$?
	  kill -9 -- "-$p" 2>/dev/null
	  exit "$r" )
}

# prj_grade WORKFILE -- 0 when every case matches the reference.
# on a miss PRJ_CASE/PRJ_GOT/PRJ_WANT name the first one that did not, which is
# the whole of the feedback: which input broke it, and what came out instead.
PRJ_CASE= PRJ_GOT= PRJ_WANT=
prj_grade() {
	local work=$1 name=${Q_FILE:-answer.sh} ref="$TMP/prj.ref" c got want gs ws
	PRJ_CASE= PRJ_GOT= PRJ_WANT= PRJ_CERR= PRJ_GS= PRJ_WS= PRJ_NO=0
	[ -n "$Q_CASES" ] || return 1
	printf '%s\n' "$Q_PROG" > "$ref" || return 1
	printf '%s\n' "$Q_CASES" | grep . > "$TMP/prj.cases"
	PRJ_NC=$(awk 'END { print NR }' "$TMP/prj.cases")
	# a tree that cannot be built fails both sides identically, and identical
	# reads as a pass: say so instead of grading against nothing.
	SANDBOX_DIRTY=1
	sandbox_reset || { PRJ_CASE="(sandbox)"; PRJ_GOT="learn cannot build the tree cases run in"; return 1; }
	# c compiles both sides once, the learner's last so C_LINE is theirs. a
	# program that does not build is its own outcome, not a case that differed.
	if [ "$PRJ_LANG" = c ]; then
		c_build "$ref" ref   || { PRJ_CASE="(the reference)"; PRJ_CERR=$C_ERR; return 1; }
		c_build "$work" work || { PRJ_CASE="(compile)"; PRJ_CERR=$C_ERR; return 1; }
	fi
	while IFS= read -r c <&4; do
		[ -n "$c" ] || continue
		PRJ_NO=$((PRJ_NO + 1))
		if [ "$PRJ_LANG" = c ]; then
			got=$(c_run work "$c"); gs=$?
			want=$(c_run ref "$c"); ws=$?
		else
			got=$(prj_run "$work" "$name" "$c"); gs=$?
			want=$(prj_run "$ref"  "$name" "$c"); ws=$?
		fi
		[ "$got" = "$want" ] && [ "$gs" = "$ws" ] && continue
		PRJ_CASE=$c; PRJ_GOT=$got; PRJ_WANT=$want; PRJ_GS=$gs; PRJ_WS=$ws
		return 1
	done 4< "$TMP/prj.cases"
	[ -z "$PRJ_CASE" ]
}

# prj_cases_bite WORKFILE -- true when an EMPTY program fails at least one
# case. a spec is only a spec if something can fail it: without this a project
# whose cases all print nothing would pass for anyone who saved a blank file,
# and the build would call it taught. the `necessity` auditor asks the same
# question of a flag; this asks it of a whole program.
prj_cases_bite() {
	local empty="$TMP/prj.empty"
	if [ "$PRJ_LANG" = c ]; then printf 'int main(void)\n{\n\treturn 0;\n}\n' > "$empty"
	else printf '#!/bin/sh\n' > "$empty"; fi
	prj_grade "$empty" && return 1
	return 0
}

# ---- the interaction ------------------------------------------------------

# one project step: read the spec, write the file, run it, read what broke.
# the editor is the shipped vi, not a second editor built into learn -- level
# 29 teaches that one and it is the one you would have on a machine you were
# handed. learn hands the terminal over the way playground does and takes it
# back the same way.
ask_program() {
	local path=$1 idx=$2 pid=$3 name work k rc missed
	q_load "$path" "$idx" || return 1
	name=${Q_FILE:-answer.sh}
	# keyed by file too: a bare index handed unit 02's first program the code
	# written for unit 01's first program.
	work="$TMP/prj.work.$PRJ_LANG.$pid.$idx"
	# a c program is longer than a script and is yours: it lives with the
	# ledger (persistent when $STATE is on p3), so leaving mid-program or
	# rebooting keeps it, and every finished one stays readable afterwards.
	if [ "$PRJ_LANG" = c ]; then
		mkdir -p "$C_WORK" 2>/dev/null
		work="$C_WORK/$pid.$name"
	fi
	C_LINE=""
	if [ -f "$work" ]; then :
	elif [ "$PRJ_LANG" = c ]; then c_starter > "$work"
	else printf '%s\n' "${Q_START:-#!/bin/sh}" > "$work"; fi

	printf '  %s\n\n' "$(printf '%s' "$Q_PROMPT_HI" | hi_expand)"
	[ -n "$Q_SPEC" ] && { printf '%s\n' "$Q_SPEC" | prj_flow | say; echo; }
	if [ "$PRJ_LANG" = c ]; then
		note "$name compiles and runs when you leave vi."
		note "vi: i types, esc stops, :wq saves and quits"
	else
		note "you are writing $name.  it is run for you when you leave the editor."
	fi

	missed=0
	while :; do
		rule
		if [ "$PRJ_LANG" = c ]; then
			# one key a job; d only once there is a miss to look at
			# two short rows: a phone's terminal is narrow
			printf '  %se%s edit   %sr%s run    %st%s try    %sh%s hint   %ss%s spec\n' \
				"$C$B" "$N" "$C$B" "$N" "$C$B" "$N" "$C$B" "$N" "$C$B" "$N"
			printf '  %sl%s lesson %sa%s answer %sn%s new  ' "$C$B" "$N" "$C$B" "$N" "$C$B" "$N"
			[ "$missed" = 1 ] && printf ' %sd%s diff ' "$C$B" "$N"
			printf ' %sq%s quit\n' "$C$B" "$N"
		else
			printf '  %se%s edit   %sr%s run it   %sa%s show the answer   %sq%s leave\n' \
				"$C$B" "$N" "$C$B" "$N" "$C$B" "$N" "$C$B" "$N"
		fi
		printf '  %schoose%s ' "$D" "$N"
		IFS= read -rsn1 k 2>/dev/null || return 2
		echo
		case "$PRJ_LANG$k" in
			ch)  rule; printf 'hint: %s\n' "$Q_HINT" | c_reflow | say; continue ;;
			cs)  rule; printf '  %s\n\n' "$(printf '%s' "$Q_PROMPT_HI" | hi_expand)"
			     printf '%s\n' "$Q_SPEC" | c_reflow | say; continue ;;
			cl)  cls; prj_field "$pid" intro | c_reflow | say | c_page
			     [ $? = 3 ] || pause_card; cls; continue ;;
			cd)  [ "$missed" = 1 ] && { cls; c_full; cls; c_miss; }; continue ;;
			ct)  rule; c_try "$work" work; continue ;;
			cn)  rule
			     printf '  %sstart %s over? yours is kept as %s.prev [y/N]%s ' "$Y" "$name" "$name" "$N"
			     IFS= read -rsn1 k 2>/dev/null; echo
			     case "$k" in y|Y) ;; *) continue ;; esac
			     cp "$work" "$work.prev" 2>/dev/null && c_starter > "$work" \
				     && { C_LINE=""; missed=0; ok "a fresh $name -- e to write it."; } \
				     || no "cannot write $work"
			     continue ;;
			ca)  rule
			     printf '  %sshow the reference? try a hint first. [y/N]%s ' "$Y" "$N"
			     IFS= read -rsn1 k 2>/dev/null; echo
			     case "$k" in y|Y) ;; *) continue ;; esac
			     { echo "  the reference -- yours does not have to look like it."; echo
			       printf '%s\n' "$Q_PROG" | sed 's/^/    /'; } | c_page
			     [ $? = 3 ] || pause_card
			     continue ;;
		esac
		case "$k" in
			e|'')  prj_edit "$work" "$name" "$C_LINE" || continue ;;
			r)     ;;
			a)     rule
			       note "the reference solution -- yours does not have to look like it."
			       printf '%s\n' "$Q_PROG" | sed 's/^/    /'
			       return 1 ;;
			q|"$E_EOT") return 2 ;;
			*)     continue ;;
		esac
		rule
		note "$([ "$PRJ_LANG" = c ] && echo "compiling, then running" || echo running) $(printf '%s\n' "$Q_CASES" | grep -c .) case(s)..."
		prj_grade "$work"; rc=$?
		if [ "$PRJ_LANG" = c ] && [ -z "$PRJ_CERR" ] && [ -n "${C_WARN:-}" ]; then
			note "it compiles, with warnings -- not errors here, but fix them:"
			printf '%s\n' "$C_WARN" | wrap $(( COLS - 6 )) | sed 's/^/    /'
		fi
		if [ "$rc" = 0 ]; then
			ok "every case matches -- $name is done."
			prj_mark "$pid" "$idx"
			return 0
		fi
		if [ "$PRJ_CASE" = "(sandbox)" ]; then
			no "$PRJ_GOT -- not your program; try again, or restart learn."
			continue
		fi
		if [ "$PRJ_CASE" = "(the reference)" ]; then
			no "the reference program does not build here -- a corpus bug, not yours:"
			printf '%s\n' "$PRJ_CERR" | sed 's/^/    /'
			return 1
		fi
		if [ -n "$PRJ_CERR" ]; then
			c_cerr "$PRJ_CERR"
			continue
		fi
		C_LINE=""
		if [ "$PRJ_LANG" = c ]; then
			missed=1
			c_miss
			continue
		fi
		no "a case did not match"
		_c_row case "$PRJ_CASE"
		_c_row yours  "$(_c_line "$PRJ_GOT")"
		_c_row wanted "$(_c_line "$PRJ_WANT")"
	done
}

# prj_edit WORK NAME [LINE] -- hand the terminal to vi on a copy in the sandbox, so
# the file sits next to the fixtures it is written against, and take the saved
# buffer back out. the copy is read back rather than edited in place because
# every run rebuilds the tree underneath it.
prj_edit() {
	local work=$1 name=$2 line=${3:-} tty_ rc
	SANDBOX_DIRTY=1
	sandbox_reset || { no "cannot build the sandbox"; return 1; }
	cp "$work" "$SANDBOX/$name" 2>/dev/null || return 1
	# the copy is made by learn (root, on the stick) and edited by vi under
	# the drop: without this nobody could not write it back, and vi opened
	# every program [Readonly]. the tree is private, so 0666 costs nothing.
	chmod 0666 "$SANDBOX/$name" 2>/dev/null
	tty_=$(stty -g 2>/dev/null) || tty_=
	[ -n "$tty_" ] && stty sane 2>/dev/null
	# shellcheck disable=SC2086
	( cd "$SANDBOX" 2>/dev/null || exit 1
	  if [ -n "$line" ]; then
		HOME="$SANDBOX" TMPDIR="$SANDBOX" $DROP "$SHELLBIN" -c 'vi -c "$2" "$1"' _ "$name" "$line"
	  else
		HOME="$SANDBOX" TMPDIR="$SANDBOX" $DROP "$SHELLBIN" -c 'vi "$1"' _ "$name"
	  fi ); rc=$?
	[ -n "$tty_" ] && stty "$tty_" 2>/dev/null
	# no vi is not an edit: grading the untouched file would report "your
	# program is wrong" about a program nobody got to write.
	[ "$rc" = 127 ] && { no "there is no vi on PATH to write it in"; return 1; }
	cp "$SANDBOX/$name" "$work" 2>/dev/null
	cls
}

# a project file: every program in it, in the order it was written.
run_project() {
	local pid=$1 nq i rc done_ all
	nq=$(prj_nq "$pid")
	[ "${nq:-0}" -gt 0 ] || { note "project '$pid' is empty"; return 0; }

	cls
	hdr "$(prj_field "$pid" name)" "$([ "$PRJ_LANG" = c ] && echo lesson || echo project)  ${nq} program(s)"
	prj_field "$pid" intro | prj_flow | say | c_page
	case $? in
		2) return 2 ;;
		3) ;;
		*) pause_card || return 2 ;;
	esac

	MODE=learn
	# pick up at the first program not yet written, and step over the written
	# ones after it too: coming back to a unit used to start it over, then
	# walked into programs already done. all written at the start -> the whole
	# unit again, as practice.
	i=1; all=0
	while [ "$i" -le "$nq" ] && prj_is_done "$pid" "$i"; do i=$((i + 1)); done
	[ "$i" -le "$nq" ] || { i=1; all=1; }
	while [ "$i" -le "$nq" ]; do
		cls
		statusbar "$(prj_field "$pid" name)" "$([ "$PRJ_LANG" = c ] && echo c || echo project)" "$i" "$nq" ""
		ask_program "$(prj_path "$pid")" "$i" "$pid"; rc=$?
		[ "$rc" = 2 ] && return 2
		i=$((i + 1))
		[ "$all" = 1 ] || while [ "$i" -le "$nq" ] && prj_is_done "$pid" "$i"; do i=$((i + 1)); done
		pause_card || return 2
	done

	cls
	rule
	done_=$(prj_ndone "$pid")
	if [ "$done_" -ge "$nq" ]; then ok "$(prj_field "$pid" name) -- written."
	else no "$(prj_field "$pid" name) -- $done_ of $nq. come back to it."; fi
	# on the ladder (c_continue) the next unit opens after this key
	[ -n "${C_CHAIN:-}" ] && note "enter: the next unit.  q: stop here."
	pause_card
}

projects_menu() {
	local pid n=0 pick a nq name ps
	cls
	hdr "${1:-projects}" "${2:-write a program against a spec}"
	prj_index; ps=$(passed_set)
	while IFS='	' read -r pid a nq name; do
		n=$((n + 1))
		if gate_open "$a" "$ps"; then
			_mi "$n" "$name" "$(prj_ndone "$pid")/$nq"
		else
			_mi_off "$n" "$name" "  (unlocks after $a)"
		fi
	done < "$PRJ_INDEX"
	[ "$n" -gt 0 ] || { note "no projects yet"; pause_card; return 0; }
	printf '\n  %snumber (enter to go back):%s ' "$D" "$N"
	IFS= read -r pick 2>/dev/null || return 0
	[ -n "$pick" ] || return 0
	pid=$(project_ids | sed -n "${pick}p")
	if [ -z "$pid" ]; then no "no such project"; pause_card
	elif prj_unlocked "$pid"; then run_project "$pid"
	else no "locked -- beat $(prj_after "$pid") first."; pause_card; fi
}

# ---- the build's view -----------------------------------------------------

# prj_check -- every project block, held to what a project has to be. run by
# selftest, so G25 owns it.
#
# the two that matter are not "is it well formed":
#
#   the reference is DETERMINISTIC -- grading it against itself runs the same
#   program twice on two freshly built trees and demands the same bytes. a
#   reference that reads the clock, the process table or the network passes
#   once and fails the learner at random hours later, which is the exact bug
#   cmpref_moving exists to stop one rung down.
#
#   the cases BITE -- an empty program must fail at least one of them. a spec
#   nothing can fail is not a spec, and without this a project whose every
#   case prints nothing would be handed to a learner who saved a blank file.
prj_check() {
	local pid path nq i bad=0 lbl
	for pid in $(project_ids); do
		path=$(prj_path "$pid")
		nq=$(prj_nq "$pid")
		[ "$(prj_field "$pid" name)" ] || { echo "FAIL $pid: no name:" >&2; bad=$((bad + 1)); }
		[ "$(prj_after "$pid")" ] || { echo "FAIL $pid: no after: -- a project with no gate is one nobody reaches in order" >&2; bad=$((bad + 1)); }
		level_path "$(prj_after "$pid")" >/dev/null 2>&1 && [ -f "$(level_path "$(prj_after "$pid")")" ] \
			|| { echo "FAIL $pid: after: '$(prj_after "$pid")' is not a level" >&2; bad=$((bad + 1)); }
		[ "${nq:-0}" -gt 0 ] || { echo "FAIL $pid: no programs" >&2; bad=$((bad + 1)); continue; }
		i=1
		while [ "$i" -le "$nq" ]; do
			lbl="$pid#$i"
			if ! q_load "$path" "$i"; then
				echo "FAIL $lbl: will not load" >&2; bad=$((bad + 1)); i=$((i + 1)); continue
			fi
			[ -n "$Q_SPEC" ]  || { echo "FAIL $lbl: no spec: -- there is nothing to write against" >&2; bad=$((bad + 1)); }
			[ -n "$Q_FILE" ]  || { echo "FAIL $lbl: no file: -- the prompt cannot say what to write" >&2; bad=$((bad + 1)); }
			[ -n "$Q_PROG" ]  || { echo "FAIL $lbl: no prog:" >&2; bad=$((bad + 1)); }
			[ -n "$Q_CASES" ] || { echo "FAIL $lbl: no case:" >&2; bad=$((bad + 1)); }
			case "$Q_FILE" in
				*/*|'') echo "FAIL $lbl: file: '$Q_FILE' must be a bare name in the tree" >&2; bad=$((bad + 1)) ;;
			esac
			# an @token@ the roll does not define survives rendering and becomes
			# a literal filename nothing made. both sides then fail the same way
			# and the case passes while testing nothing -- @log2@ costs a whole
			# case in silence, which is exactly the shape st_block already
			# refuses one rung down.
			case "$Q_SPEC$Q_PROG$Q_CASES$Q_START$Q_PROMPT" in
				*@*@*) echo "FAIL $lbl: an @token@ was never rendered -- the roll has no such name" >&2
				       bad=$((bad + 1)) ;;
			esac
			# the prompt has to name the file, the way a level prompt has to
			# name its command: a spec that never says what to save is an
			# unanswerable question, not a hard one.
			case "$Q_PROMPT $Q_SPEC" in
				*"$Q_FILE"*) ;;
				*) echo "FAIL $lbl: neither q: nor spec: names $Q_FILE" >&2; bad=$((bad + 1)) ;;
			esac
			# every case has to invoke the file, or it is testing something else
			printf '%s\n' "$Q_CASES" | grep -q . && {
				if printf '%s\n' "$Q_CASES" | grep -vq -- "$Q_FILE"; then
					echo "FAIL $lbl: a case: never runs $Q_FILE" >&2; bad=$((bad + 1))
				fi
			}
			[ -n "$Q_PROG" ] && [ -n "$Q_CASES" ] && {
				printf '%s\n' "$Q_PROG" > "$TMP/prj.self"
				prj_grade "$TMP/prj.self" || {
					echo "FAIL $lbl: the reference does not reproduce itself -- case '$PRJ_CASE' printed '$PRJ_GOT' then '$PRJ_WANT'" >&2
					bad=$((bad + 1))
				}
				prj_cases_bite || {
					echo "FAIL $lbl: an empty program passes every case -- the cases test nothing" >&2
					bad=$((bad + 1))
				}
			}
			i=$((i + 1))
		done
	done
	return "$bad"
}
