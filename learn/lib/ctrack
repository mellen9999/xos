# ctrack -- the c track: read a lesson, write the program in vi, and it is
# compiled and run against a reference the moment you leave the editor.
#
# it is the projects engine, not a second one. a unit file under c/ has the
# exact shape of a project file -- an intro, then programs with a spec, a
# reference and hidden cases -- so c_enter points the projects globals at c/
# and its own ledger, sets PRJ_LANG=c, and run_project / projects_menu /
# prj_grade do the rest. the only things c adds are the ones a script never
# needed: a compile step, a compile error as its own outcome, and somewhere
# the binary is allowed to execute.
#
# THE COMPILER IS NOT IN THE IMAGE, on purpose. the signed root ships no cc;
# the arsenal carries tcc + a musl sysroot on p3, and p3 and /tmp are noexec,
# so both the compiler and every program it builds run through xexec's
# write-once exec surface. on a build host the tree's arsenal/cc (or failing
# that the host's own cc) runs directly. c_tools picks, in that order, and a
# machine with none says how to get one instead of failing at the first case.
#
# a case names the program as a shell function -- `hello`, `echo 3 | sum` --
# because `./hello` cannot work on xos: the sandbox is noexec. the function is
# the same everywhere and hides which route reaches the binary.
#
# the learner's program never runs as root. under xexec the staged `run`
# drops to nobody (DROP) after setting its limits; the case line around it is
# corpus, signed with the image, and is what runs as the caller.

CUNITS="$ROOT/c"
C_DONE="$STATE/c"
C_WORK="$STATE/c-work"
C_INDEX="$TMP/c.index"
# c11, -Wall is fatal: the track teaches warning-clean c, and the reference for
# every program is held to stricter than this at build time (c_check). the bar
# is the same on every compiler -- tcc knows little past -Wall, so a gcc or a
# clang (a phone's) runs -Wextra -pedantic as a second, non-fatal pass whose
# warnings are shown, never a wall the stick would not have put up.
C_FLAGS="-std=c11 -Wall -Werror"
C_LINT=""
CC_CMD="" CC_RUN="" CC_WHY=""
PRJ_LANG=sh
C_LINE=""

# c_tools -- resolve the compiler and the runner once. 0 when there is a cc.
c_tools() {
	[ -n "$CC_CMD" ] && return 0
	if [ -n "${LEARN_CC:-}" ]; then
		CC_CMD=$LEARN_CC; CC_RUN=${LEARN_RUN:-}
	elif [ -f "$HOME/tools/xexec" ] && [ -f "$HOME/tools/cc/cc" ]; then
		CC_CMD="sh $HOME/tools/xexec -t $HOME/tools/cc cc"
		CC_RUN="sh $HOME/tools/xexec -t"
	elif command -v cc >/dev/null 2>&1; then
		CC_CMD=cc
	else
		CC_WHY="no c compiler. on xos: stage the arsenal (sh arsenal/install.sh) so ~/tools/cc exists. on a pc: install gcc, or run learn/install.sh after building arsenal/cc."
		return 1
	fi
	case "$($CC_CMD -v 2>&1 | head -1)" in
		*tcc*) ;;
		*) C_LINT="-std=c11 -Wall -Wextra -pedantic -fsyntax-only" ;;
	esac
	return 0
}

# c_fn FILE -- the shell name a case calls the program by: hello.c -> hello.
c_fn() { echo "${1%.c}"; }

# c_reflow -- a lesson's lines joined back into paragraphs, for say or wrap
# to break at the screen's width: they are written at 70 columns, and cut
# again at a phone's 52 every other line came out a stub. a line joins the
# one before it only when that one ran long (the author wrapped it); a short
# line is a break they meant -- a list of cases, an example. a blank line,
# code (indented), a `- ` item and a line that is one `literal` stand alone.
c_reflow() {
	awk '
		/^$/ || /^[ \t]/ || /^- / || /^`[^`]*`[.,;]?$/ { if (p != "") print p; p = ""; print; n = 0; next }
		{ if (p != "" && n >= 45) p = p " " $0; else { if (p != "") print p; p = $0 }; n = length($0) }
		END { if (p != "") print p }
	'
}

# c_starter -- what vi opens on the first visit: the task as a comment, so it
# is still on screen once the lesson has scrolled away, then the given start
# (or the smallest program that compiles).
c_starter() {
	printf '/* %s\n *\n' "$Q_PROMPT"
	# wrapped to the screen: busybox vi does not wrap a long line, it cuts it
	printf '%s\n' "$Q_SPEC" | c_reflow | tr -d '`' | wrap $(( COLS < 76 ? COLS - 6 : 70 )) \
		| sed -e 's/^/ * /' -e 's/ *$//'
	printf ' */\n\n'
	if [ -n "$Q_START" ]; then printf '%s\n' "$Q_START"
	else printf '#include <stdio.h>\n\nint main(void)\n{\n\treturn 0;\n}\n'; fi
}

# c_build SRC TAG -- compile SRC as $Q_FILE into $TMP/c.stage.TAG/prog beside
# its `run`. on failure C_ERR holds the compiler's first lines and C_LINE the
# first line it complained about.
c_build() {
	local src=$1 stage="$TMP/c.stage.$2" bd="$TMP/c.build" fn
	C_ERR="" C_LINE="" C_WARN=""
	fn=$(c_fn "$Q_FILE")
	c_tools || { C_ERR=$CC_WHY; return 1; }
	# the same bytes built once a session: the reference is rebuilt on every
	# submit otherwise, and on the stick each build stages a 38MB compiler.
	if [ -s "$stage/prog" ] && [ -x "$stage/run" ] && cmp -s "$src" "$stage/src" \
	   && [ "$(cat "$stage/name" 2>/dev/null)" = "$Q_FILE" ]; then
		C_WARN=$(cat "$stage/warn" 2>/dev/null); return 0
	fi
	rm -rf "$stage" "$bd"; mkdir -p "$stage" "$bd" || return 1
	cp "$src" "$bd/$Q_FILE" || return 1
	# shellcheck disable=SC2086
	if ! ( cd "$bd" && $CC_CMD $C_FLAGS -o "$stage/prog" "$Q_FILE" ) > "$TMP/c.err" 2>&1 \
	   || [ ! -s "$stage/prog" ]; then
		# the message lines only: gcc and clang draw the line and a caret
		# under it, which a narrow screen wraps into noise -- and `e` puts
		# you on that line anyway. a compiler that says nothing in that
		# shape keeps its raw output.
		C_ERR=$(grep -E ':[0-9]+(:[0-9]+)?: (fatal )?(error|warning):' "$TMP/c.err" | head -6)
		[ -n "$C_ERR" ] || C_ERR=$(grep . "$TMP/c.err" | head -10)
		[ -n "$C_ERR" ] || C_ERR="the compiler failed and said nothing"
		C_LINE=$(sed -n "s/^[^:]*$Q_FILE:\([0-9][0-9]*\):.*/\1/p" "$TMP/c.err" | head -1)
		return 1
	fi
	# the limits sit inside `run`, after the exec surface is built and before the
	# program starts: cpu, wall clock, memory and output size, so an infinite
	# loop, a sleep or a printf in a loop ends the case instead of the session.
	# processes too, for the fork lessons: RLIMIT_NPROC counts every process
	# the uid owns, so as nobody (the stick) 64 is the program's own budget,
	# and as yourself (a pc) it is what you already run plus headroom -- a fork
	# bomb then fails with EAGAIN instead of taking the machine.
	# the limit counts THREADS (a browser alone is hundreds), and it is counted
	# when the case runs, not when this was built -- the box moves in between.
	{
		echo '#!/bin/sh'
		if [ -n "$DROP" ]; then echo 'ulimit -u 64 2>/dev/null'
		else echo 'ulimit -u $(( $(ls -ldn /proc/[0-9]*/task/[0-9]* 2>/dev/null | awk -v u="$(id -u)" '"'"'$3 == u'"'"' | wc -l) + 512 )) 2>/dev/null'; fi
		# memory is capped on the heap (-d), not the address space (-v): an
		# android libc reserves gigabytes it never touches, and under -v every
		# program died before main.
		# output: 2MB, so a program meant to write a lot (a case piping it to
		# `wc -c`) is graded on all of it, and a runaway still ends there.
		echo 'ulimit -t 3 2>/dev/null; ulimit -d 262144 2>/dev/null; ulimit -f 4096 2>/dev/null'
		echo '[ -n "${C_TMPDIR:-}" ] && TMPDIR=$C_TMPDIR && export TMPDIR'
		# try (C_TTY): a run by hand, in the foreground, on the terminal.
		# learn and every shell under it IGNORE ctrl-c meanwhile (c_try says
		# why), so the program starts through `intdfl`, which puts SIGINT
		# back to default for it alone: ctrl-c stops the program and nothing
		# else. after it, the sweep: as nobody, everything nobody owns;
		# otherwise every process still carrying the mark the program was
		# started with -- a child it forked and left running. its stderr is
		# on fd 4, from the caller.
		echo 'if [ -n "${C_TTY:-}" ]; then'
		echo '	m=try.$$.x; i=${0%/*}/intdfl; [ -x "$i" ] || i='
		echo "	C_MARK=\$m PATH=\"\${0%/*}:\$PATH\" timeout \${C_TO:-4} $DROP \$i $fn \"\$@\" 2>&4 4>&-; r=\$?"
		if [ -n "$DROP" ]; then echo "	$DROP kill -9 -1 2>/dev/null"
		else echo '	for e in $(grep -l "C_MARK=$m" /proc/[0-9]*/environ 2>/dev/null); do e=${e#/proc/}; kill -9 "${e%/environ}" 2>/dev/null; done'; fi
		echo '	exit $r'
		echo 'fi'
		# its own session (setsid), killed whole afterwards: a child it forked
		# and left behind would otherwise outlive the case and spend the next
		# run's process budget. as nobody, every process nobody still owns goes
		# too -- that catches a child that started a session of its own. stdin
		# is handed over by name: a background job's is /dev/null otherwise.
		# the program's stderr is handed over by name too, and this shell's
		# own goes to /dev/null: it reports a job the limits killed with
		# its pid, and a pid on stderr would make every such case differ.
		echo 'exec 3<&0 4>&2 2>/dev/null'
		echo "PATH=\"\${0%/*}:\$PATH\" setsid timeout 4 $DROP $fn \"\$@\" <&3 2>&4 3<&- 4>&- &"
		echo 'p=$!; wait $p; r=$?'
		echo 'kill -9 -- -$p 2>/dev/null'
		[ -n "$DROP" ] && echo "$DROP kill -9 -1 2>/dev/null"
		echo 'exit $r'
	} > "$stage/run"
	chmod 0755 "$stage/run" "$stage/prog" 2>/dev/null
	# the program runs by its own name, found first on PATH, so argv[0] is
	# `sum` and not a path into learn's $TMP -- the lessons teach that
	# argv[0] is the name, and `usage: %s` is how every c program says it.
	ln -sf prog "$stage/$fn" 2>/dev/null
	cp "$src" "$stage/src" 2>/dev/null
	printf '%s\n' "$Q_FILE" > "$stage/name"
	if [ -n "$C_LINT" ]; then
		# shellcheck disable=SC2086
		( cd "$bd" && $CC_CMD $C_LINT "$Q_FILE" ) 2>&1 | grep 'warning:' | head -6 > "$stage/warn"
		C_WARN=$(cat "$stage/warn")
	fi
	# under the drop nobody must be able to reach the binary on the host route
	chmod 0755 "$stage" 2>/dev/null
	return 0
}

# c_prelude TAG [tty] -- the shell function a case calls the program through. its
# output goes via files so `ulimit -f` caps it and a case's own pipes and
# `echo $?` see the program's status, not a pipe's. stdout and stderr go to
# two files and come back out on their own streams, stdout first: which
# stream a line went to is graded, and the order the two interleave in --
# buffering, not the program -- can no longer decide a case.
# with tty it is a run by hand instead: straight to the terminal, longer
# clock, and the runner's own noise (xexec's) kept off the screen.
c_prelude() {
	local stage="$TMP/c.stage.$1" out="$TMP/c.out.$1" fn via
	fn=$(c_fn "$Q_FILE")
	# the exec surface is mounted under learn's own $TMP, not the tree's:
	# a .xexec.RANDOM dir in the cwd would be a different name for the
	# learner's run and the reference's, and a program that lists its
	# directory would never match. without xexec it is learn's own shell,
	# not whatever sh is: a phone's is dash, which has no `ulimit -u`, and
	# the run script is written for ash.
	if [ -n "$CC_RUN" ]; then via="C_TMPDIR=\$TMPDIR TMPDIR=\"$TMP\" $CC_RUN \"$stage\" run"
	else via="\"$SHELLBIN\" \"$stage/run\""; fi
	if [ "${2:-}" = tty ]; then
		printf '%s() { C_TTY=1 C_TO=300 %s "$@" 4>&2 2>/dev/null; }\n' "$fn" "$via"
	else
		printf '%s() { %s "$@" > "%s" 2> "%s.e"; _r=$?; head -c 2097152 "%s"; head -c 65536 "%s.e" >&2; return $_r; }\n' \
			"$fn" "$via" "$out" "$out" "$out" "$out"
	fi
}

# c_tree -- the tree a case runs in, fresh: built once, kept aside, and
# copied back for every run after. every case runs twice (yours, then the
# reference) on a clean tree, and on a phone one build is over two seconds
# -- a grade of eight cases sat for forty. a copy is milliseconds. cp -a
# keeps owners and times, so under the drop it is still all nobody's.
c_tree() {
	local snap="$TMP/c.tree"
	if [ -d "$snap" ] && [ "$(cat "$snap.seed" 2>/dev/null)" = "${FX_SEED:-0}" ] \
	   && rm -rf "$SANDBOX" && cp -a "$snap" "$SANDBOX"; then
		SANDBOX_OK=1 SANDBOX_DIRTY=1
		return 0
	fi
	SANDBOX_DIRTY=1
	sandbox_reset || return 1
	rm -rf "$snap" "$snap.seed"
	cp -a "$SANDBOX" "$snap" && echo "${FX_SEED:-0}" > "$snap.seed"
	SANDBOX_DIRTY=1
	return 0
}

# c_run TAG CASE -- one case, against a freshly built tree, like prj_run. the
# shell is NOT dropped here: on xos it has to mount the exec surface, and what
# it runs is the corpus's case line -- the program inside drops itself.
#
# the case shell gets a session of its own and the whole session dies after:
# timeout kills only the shell, and a pipeline stage it forked -- `yes` under
# a parent that ignores SIGPIPE, as git does for a pre-push hook -- would
# spin on, orphaned, holding the output pipe this reads, forever.
#
# what the case printed comes back as its stdout, then -- only when there is
# any -- a `--- stderr ---` line and its stderr: both streams are compared.
c_run() {
	local o="$TMP/c.case.o" e="$TMP/c.case.e" r
	c_tree || return 1
	( cd "$SANDBOX" 2>/dev/null || exit 1
	  HOME="$SANDBOX" TMPDIR="$SANDBOX" setsid timeout 10 "$SHELLBIN" -c "$(c_prelude "$1")
$2" </dev/null > "$o" 2> "$e" &
	  p=$!; wait "$p"; r=$?
	  kill -9 -- "-$p" 2>/dev/null
	  exit "$r" ); r=$?
	head -c 2097152 "$o"
	if [ -s "$e" ]; then
		[ -s "$o" ] && [ -n "$(tail -c 1 "$o")" ] && echo
		echo '--- stderr ---'
		head -c 65536 "$e"
	fi
	return "$r"
}

# c_page -- page stdin a screen at a time: space/j/enter on, k/b back, q done.
# returns 3 when it paged (the reader already pressed through the end, so the
# caller's own "enter to go on" would be a second press for nothing).
# a lesson is longer than a card, and a vt320 has 24 rows. the text arrives on
# stdin, so the keys come from the terminal itself.
c_page() {
	local f="$TMP/c.page" n rows top k
	cat > "$f"
	n=$(awk 'END { print NR }' "$f")
	rows=$(( ${TERM_LINES:-24} - 3 ))
	if [ ! -t 1 ] || ! : < /dev/tty 2>/dev/null || [ "$n" -le "$rows" ]; then
		cat "$f"; return 0
	fi
	top=1
	while :; do
		cls
		sed -n "${top},$((top + rows - 1))p" "$f"
		printf '\n  %s%s-%s of %s   space more  k back  q done%s ' "$D" "$top" \
			"$(( top + rows - 1 > n ? n : top + rows - 1 ))" "$n" "$N"
		IFS= read -rsn1 k < /dev/tty 2>/dev/null || return 2
		case "$k" in
			q|Q) echo; return 3 ;;
			k|b) top=$(( top - rows )); [ "$top" -ge 1 ] || top=1 ;;
			*)   [ $(( top + rows )) -le "$n" ] || { echo; return 3; }
			     top=$(( top + rows )) ;;
		esac
	done
}

# c_miss -- the last miss, said the way it is found: which case, the first line
# that differs (quoted, so a trailing space shows), and the exit status when it
# differs -- a status-only miss used to print two identical-looking outputs.
c_miss() {
	local g="$TMP/c.got" w="$TMP/c.want" d n y x cut=$(( COLS > 34 ? COLS - 14 : 20 ))
	no "case $PRJ_NO of $PRJ_NC did not match"
	_c_row case "$PRJ_CASE"
	if [ "$PRJ_GOT" = "$PRJ_WANT" ]; then
		note "the output matches -- only the exit status differs."
	else
		printf '%s\n' "$PRJ_GOT" > "$g"; printf '%s\n' "$PRJ_WANT" > "$w"
		[ -n "$PRJ_GOT" ] || : > "$g"; [ -n "$PRJ_WANT" ] || : > "$w"
		d=$(awk -v g="$g" -v w="$w" 'BEGIN {
			while ((getline l < g) > 0) a[++na] = l
			while ((getline l < w) > 0) b[++nb] = l
			n = na > nb ? na : nb
			for (i = 1; i <= n; i++) if (i > na || i > nb || a[i] != b[i]) {
				print i; print (i > na ? "\001" : a[i]); print (i > nb ? "\001" : b[i]); exit }
		}')
		n=$(printf '%s\n' "$d" | sed -n 1p)
		y=$(printf '%s\n' "$d" | sed -n 2p)
		x=$(printf '%s\n' "$d" | sed -n 3p)
		_c_row line "$n"
		if [ "$y" = "$(printf '\001')" ]; then _c_row yours "(your output ends before this line)"
		else _c_row yours "'$(printf '%s' "$y" | cut -c1-$cut)'"; fi
		if [ "$x" = "$(printf '\001')" ]; then _c_row wanted "(nothing more -- yours goes on)"
		else _c_row wanted "'$(printf '%s' "$x" | cut -c1-$cut)'"; fi
	fi
	if [ "$PRJ_GS" != "$PRJ_WS" ]; then
		_c_row exit "yours $(c_status "$PRJ_GS")"
		_c_row ''     "wanted $(c_status "$PRJ_WS")"
	fi
	# the right words on the wrong stream reads as a strange diff; say it
	if [ "$PRJ_GOT" != "$PRJ_WANT" ] && [ "$(printf '%s\n' "$PRJ_GOT" | grep -vxF -- '--- stderr ---' | sort)" = \
	     "$(printf '%s\n' "$PRJ_WANT" | grep -vxF -- '--- stderr ---' | sort)" ]; then
		note "right lines, wrong stream: stdout vs stderr."
	fi
}

# c_full -- both outputs of the last miss, whole, through the pager.
c_full() {
	{
		echo "  case: $PRJ_CASE"
		echo
		echo "  yours (exit $(c_status "$PRJ_GS")):"
		printf '%s\n' "$PRJ_GOT" | sed 's/^/    /'
		echo
		echo "  wanted (exit $(c_status "$PRJ_WS")):"
		printf '%s\n' "$PRJ_WANT" | sed 's/^/    /'
	} | c_page
	[ $? = 3 ] || pause_card
}

# c_status N -- an exit status, and what a beginner needs told about it: past
# 128 the program did not exit, a signal ended it, and 139 is a number nobody
# reads as "your pointer was bad".
c_status() {
	case "$1" in
		130) echo "$1 -- stopped with ctrl-c" ;;
		134) echo "$1 -- aborted: an assert failed, or abort()" ;;
		136) echo "$1 -- crashed: divide by zero?" ;;
		137|143|152) echo "$1 -- killed: it ran too long (an endless loop?)" ;;
		139) echo "$1 -- crashed: a bad pointer (segfault)" ;;
		*) echo "$1" ;;
	esac
}

# c_cerr ERR -- a compile error, wrapped (never cut), and the way to it.
c_cerr() {
	no "it does not compile"
	printf '%s\n' "$1" | wrap $(( COLS - 6 )) | sed 's/^/    /'
	[ -n "$C_LINE" ] && note "e opens vi on line $C_LINE."
	return 0
}

# c_intdfl -- build, once a session, the few lines that let ctrl-c reach a
# program run by hand: SIGINT back to default, then exec the program. 0 when
# it is there; without it a try still runs, ctrl-c just does not stop it.
c_intdfl() {
	[ -x "$TMP/c.intdfl" ] && return 0
	printf '%s\n' '#define _POSIX_C_SOURCE 200809L' '#include <signal.h>' '#include <unistd.h>' '' \
		'int main(int argc, char **argv)' '{' '	if (argc < 2)' '		return 127;' \
		'	signal(SIGINT, SIG_DFL);' '	execvp(argv[1], argv + 1);' '	return 127;' '}' > "$TMP/c.intdfl.c"
	# shellcheck disable=SC2086
	( cd "$TMP" && $CC_CMD -std=c11 -o "$TMP/c.intdfl" c.intdfl.c ) > /dev/null 2>&1
	chmod 0755 "$TMP/c.intdfl" 2>/dev/null
	[ -x "$TMP/c.intdfl" ]
}

# c_try SRC TAG -- run a program by hand: a line typed the way a case is
# written (`hello a b`, `echo 3 | sum`), from the tree's directory, with the
# keyboard as its input and the screen as its output. nothing is graded --
# this is for watching what it does. ctrl-c stops the program, not learn.
c_try() {
	local src=$1 tag=$2 fn line tty_ r
	fn=$(c_fn "$Q_FILE")
	c_build "$src" "$tag" || { c_cerr "$C_ERR"; return 1; }
	C_LINE=""
	note "enter: run $fn.  or a line, as in a case:"
	note "  $fn a b     echo 3 | $fn"
	printf '  %s$%s ' "$W" "$N"
	IFS= read -r line 2>/dev/null || return 0
	[ -n "$line" ] || line=$fn
	c_tree || { no "cannot build the sandbox"; return 1; }
	note "ctrl-d ends its input, ctrl-c stops it."
	rule
	tty_=$(stty -g 2>/dev/null) || tty_=
	[ -n "$tty_" ] && stty sane 2>/dev/null
	# ctrl-c is IGNORED here, not caught: busybox ash (1.38) never clears
	# the flag a caught signal sets, and every `read` after one spins on it
	# -- the menus would hang. an ignored signal stays ignored down the
	# whole tree, so intdfl hands the program its default back.
	c_intdfl && cp "$TMP/c.intdfl" "$TMP/c.stage.$tag/intdfl" 2>/dev/null
	trap '' INT
	HOME="$SANDBOX" TMPDIR="$SANDBOX" "$SHELLBIN" -c "cd \"\$1\" || exit 1
$(c_prelude "$tag" tty)
$line" _ "$SANDBOX"; r=$?
	trap on_int INT
	[ -n "$tty_" ] && stty "$tty_" 2>/dev/null
	SANDBOX_DIRTY=1
	[ "$r" = 130 ] && echo   # the ^C the terminal echoed has no newline
	rule
	note "exit $(c_status "$r")"
	return 0
}

c_enter() {
	_C_P=$PROJECTS _C_D=$PRJ_DONE _C_I=$PRJ_INDEX
	PROJECTS=$CUNITS PRJ_DONE=$C_DONE PRJ_INDEX=$C_INDEX PRJ_LANG=c
}
c_leave() { PROJECTS=$_C_P PRJ_DONE=$_C_D PRJ_INDEX=$_C_I PRJ_LANG=sh; }

c_ids() { ls -1 "$CUNITS" 2>/dev/null | sort; }

# c_row NUM NAME DONE TOTAL -- one menu cell, 36 columns wide.
c_row() {
	local mark=" " col=$W
	[ "$3" -ge "$4" ] && { mark="+"; col=$G; }
	printf '%s%3s%s %s%-22.22s%s %s%s %s/%s%s' "$C$B" "$1" "$N" "$col" "$2" "$N" \
		"$D" "$mark" "$3" "$4" "$N"
}

# c_units -- every unit, any order: all are open from the start -- the first
# one teaches the four vi keys it needs, so nothing gates it. numbers are the
# units' own (0 is the first), the same ones `learn c N` takes, and enter goes
# on with the first unit not yet finished. thirty units do not fit a 24-row
# terminal in one column. runs inside c_enter.
c_units() {
	local pid a nq name n d next rows two pick i
	while :; do
		prj_index
		n=$(awk 'END { print NR }' "$PRJ_INDEX")
		rows=$(( ${TERM_LINES:-24} - 7 ))
		two=0; [ "$n" -gt "$rows" ] && [ "${TERM_COLS:-80}" -ge 76 ] && two=1
		next=""; i=0
		cls
		hdr "units" "any one, in any order"
		while IFS='	' read -r pid a nq name; do
			d=$(prj_ndone "$pid")
			[ -z "$next" ] && [ "$d" -lt "$nq" ] && next=$pid
			i=$((i + 1))
			printf '  '; c_row "$(level_no "$pid")" "$name" "$d" "$nq"
			if [ "$two" = 1 ] && [ $((i % 2)) = 1 ]; then printf '   '; else echo; fi
		done < "$PRJ_INDEX"
		[ $((i % 2)) = 1 ] && [ "$two" = 1 ] && echo
		echo
		if [ -n "$next" ]; then
			printf '  %senter%s go on: %s\n' "$C$B" "$N" "$(prj_field "$next" name)"
			printf '  %snumber%s a unit   %sq%s back\n' "$C$B" "$N" "$C$B" "$N"
		else
			ok "every unit written. the track is yours."
			printf '  %snumber%s a unit   %sq%s back\n' "$C$B" "$N" "$C$B" "$N"
		fi
		printf '  %schoose%s ' "$D" "$N"
		IFS= read -r pick 2>/dev/null || break
		case "$pick" in
			q|Q|:q) break ;;
			'') [ -n "$next" ] && run_project "$next" ;;
			*[!0-9]*) ;;
			*) pid=$(c_ids | grep "^0*$pick-" | head -1)
			   if [ -n "$pid" ]; then run_project "$pid"; else no "no unit $pick"; pause_card; fi ;;
		esac
	done
}

# c_tally -- "done total units_done units next": programs written of all, units
# finished of all, and the first unit with a program left ("-" when none).
# one awk over the index and the ledger; runs inside c_enter.
c_tally() {
	local led=$C_DONE
	[ -f "$led" ] || led=/dev/null
	prj_index
	awk -v ix="$PRJ_INDEX" '
		FILENAME == ix { split($0, f, "\t"); o[++u] = f[1]; nq[f[1]] = f[3] + 0; t += f[3]; next }
		{ n = split($0, g, "/"); i = g[2] + 0
		  if (n == 2 && (g[1] in nq) && i >= 1 && i <= nq[g[1]] && !seen[$0]++) { d++; dd[g[1]]++ } }
		END { nx = "-"
		      for (k = 1; k <= u; k++) if (dd[o[k]] >= nq[o[k]]) ud++; else if (nx == "-") nx = o[k]
		      print d + 0, t + 0, ud + 0, u + 0, nx }
	' "$PRJ_INDEX" "$led" 2>/dev/null
}

# c_continue -- the ladder: the first unit with a program left, then the next,
# until you quit or none is left. a unit that comes back unfinished without a
# quit (a program it could not grade) is not walked into again.
c_continue() {
	local d t ud u nx last="" rc
	while :; do
		read -r d t ud u nx <<-EOF
		$(c_tally)
		EOF
		[ "${nx:--}" = - ] && { cls; ok "every unit written. the track is yours."; pause_card; return 0; }
		[ "$nx" = "$last" ] && return 0
		last=$nx
		C_CHAIN=1; run_project "$nx"; rc=$?; C_CHAIN=
		[ "$rc" = 2 ] && return 0
	done
}

# c_home -- `learn c` and the C key: the track's own home, in the shape of
# learn's menu. one key a mode, and every mode comes back here.
c_home() {
	local k d t ud u nx
	c_tools || { no "$CC_WHY"; pause_card; return 0; }
	c_enter
	while :; do
		read -r d t ud u nx <<-EOF
		$(c_tally)
		EOF
		cls
		hdr "learn c" "modern c, written in vi"
		printf '  '; bar "${d:-0}" "${t:-1}" 20
		printf ' %s%s/%s programs  %s/%s units%s\n\n' "$D" "$d" "$t" "$ud" "$u" "$N"
		if [ "${nx:--}" = - ]; then _mi_off c continue "every unit written"
		elif [ "${d:-0}" = 0 ]; then _mi c start "unit 0, your first program"
		else _mi c continue "$(printf 'unit %s %s' "$(level_no "$nx")" "$(prj_field "$nx" name)" \
			| cut -c1-$(( COLS - 22 )))"; fi
		_mi u units    "any unit, any order"
		_mi p scratch  "a .c to try anything in"
		_mi f find     "which lesson says a word"
		_mi h help     "the keys, and vi"
		_mi q back     ""
		rule
		printf '  %schoose%s ' "$D" "$N"
		IFS= read -rsn1 k 2>/dev/null || break
		echo
		case "$k" in
			c|'') [ "${nx:--}" = - ] || c_continue ;;
			u) c_units ;;
			p) c_scratch ;;
			f) cls; printf '  %sfind which word?%s ' "$W" "$N"
			   IFS= read -r k 2>/dev/null || continue
			   [ -n "$k" ] && { cls; c_find "$k"; } ;;
			h|'?') cls; c_help ;;
			q|Q|"$E_EOT") break ;;
		esac
	done
	c_leave
}

# c_scratch -- a file of your own, never graded: write anything, leave vi, and
# it compiles and runs by hand -- the playground's job, for c. it is kept, so
# an experiment survives a reboot.
c_scratch() {
	local work="$C_WORK/scratch.c" k Q_FILE=scratch.c
	mkdir -p "$C_WORK" 2>/dev/null
	[ -f "$work" ] || printf '#include <stdio.h>\n\nint main(void)\n{\n\tprintf("hello\\n");\n\treturn 0;\n}\n' > "$work"
	C_LINE=""
	cls
	hdr "scratch" "scratch.c -- not graded, kept"
	note "try anything. leave vi and it compiles and runs."
	while :; do
		rule
		printf '  %se%s edit   %st%s try it   %sq%s back\n' "$C$B" "$N" "$C$B" "$N" "$C$B" "$N"
		printf '  %schoose%s ' "$D" "$N"
		IFS= read -rsn1 k 2>/dev/null || break
		echo
		case "$k" in
			e|'') prj_edit "$work" scratch.c "$C_LINE" && c_try "$work" scratch ;;
			t) c_try "$work" scratch ;;
			q|Q|"$E_EOT") break ;;
		esac
	done
}

# c_find WORD -- the units whose lesson or tasks say WORD, each with its first
# two lines that do, so "where was malloc" has an answer on one screen.
# `learn c -k WORD` from the shell.
c_find() {
	local hits
	hits=$(awk -v w="$1" -v cut=$(( COLS - 6 )) -v b="$B" -v n0="$N" -v d="$D" '
		function flush() { if (c) { printf "  %s%s%s  %s(%d line%s)%s\n%s", b, head, n0, d, c, c == 1 ? "" : "s", n0, body } }
		FNR == 1 { flush(); id = FILENAME; sub(/.*\//, "", id); n = id; sub(/-.*/, "", n); sub(/^0/, "", n)
		           head = "unit " n; c = 0; body = "" }
		/^name: / && FNR < 3 { head = head "  " substr($0, 7) }
		/^(intro|spec|q): / && index(tolower($0), tolower(w)) {
			t = $0; sub(/^[a-z]+: */, "", t); gsub(/`/, "", t)
			if (++c <= 2) body = body "    " substr(t, 1, cut) "\n"
		}
		END { flush() }
	' "$CUNITS"/*)
	if [ -z "$hits" ]; then
		no "no lesson says '$1'"; pause_card; return 0
	fi
	{ note "lessons that say '$1' -- learn c N opens one"; echo
	  printf '%s\n' "$hits"; } | c_page
	[ $? = 3 ] || pause_card
}

# c_help -- the keys, and the vi a beginner needs: busybox vi is the editor
# here, and being stuck in it is the first wall anyone hits.
c_help() {
	# headers yellow, keys cyan, words plain: the same marks the menus use
	_ch() { printf '\n  %s%s%s\n' "$Y$B" "$1" "$N"; }
	_ck() {
		printf '    %s%-7s%s %-16s' "$C$B" "$1" "$N" "$2"
		[ -n "${3:-}" ] && printf ' %s%-4s%s %s' "$C$B" "$3" "$N" "$4"
		echo
	}
	{
		_ch "how it goes"
		printf '    %s\n' "each unit is a lesson, then programs to write." \
			"a program opens in vi with its task as a comment" \
			"at the top. write it, save and quit (:wq) and it" \
			"compiles and runs against hidden cases at once." \
			"your code is saved: leave any time, come back."
		_ch "on a program"
		_ck e "edit it again"  r "run the cases"
		_ck t "try it by hand" h "a hint"
		_ck s "the task again" l "the lesson again"
		_ck d "full diff"      a "the answer"
		_ck n "start it over"  q "back, code kept"
		_ch "vi"
		_ck i "start typing"   esc "stop typing"
		_ck a "type after"     o "new line below"
		_ck "h j k l" "left down up right"
		_ck "w b" "word on, back"  '0 $' "line start, end"
		_ck "gg G" "top, bottom"   :12 "go to line 12"
		_ck /word "find it"        n "find again"
		_ck x "delete a char"      dd "delete the line"
		_ck u "undo"               p "paste"
		_ck :w "save"              :wq "save and quit"
		_ck :q! "quit, dropping changes"
		echo
		printf '  %slearn c N opens unit N. learn c -k WORD finds one.%s\n' "$D" "$N"
	} | c_page
	[ $? = 3 ] || pause_card
}

c_unit() {
	local id
	c_tools || { no "$CC_WHY"; return 1; }
	id=$(c_ids | grep "^0*$1-" | head -1)
	[ -n "$id" ] || id=$(c_ids | grep -xF -- "$1")
	[ -n "$id" ] || die "no c unit $1"
	c_enter; run_project "$id"; c_leave
}

# c_lint -- what holds for every unit without a compiler: run by selftest
# (G25), whose PATH is the image and has none.
c_lint() {
	local pid path nq i bad=0 lbl fn seen=""
	c_enter
	for pid in $(project_ids); do
		path=$(prj_path "$pid"); nq=$(prj_nq "$pid")
		[ "$(prj_field "$pid" name)" ]  || { echo "FAIL c/$pid: no name:" >&2; bad=$((bad + 1)); }
		[ "$(prj_field "$pid" intro)" ] || { echo "FAIL c/$pid: no intro: -- the lesson is the point" >&2; bad=$((bad + 1)); }
		[ "${nq:-0}" -gt 0 ] || { echo "FAIL c/$pid: no programs" >&2; bad=$((bad + 1)); continue; }
		i=1
		while [ "$i" -le "$nq" ]; do
			lbl="c/$pid#$i"
			if ! q_load "$path" "$i"; then
				echo "FAIL $lbl: will not load" >&2; bad=$((bad + 1)); i=$((i + 1)); continue
			fi
			[ -n "$Q_SPEC" ]  || { echo "FAIL $lbl: no spec:" >&2; bad=$((bad + 1)); }
			[ -n "$Q_PROG" ]  || { echo "FAIL $lbl: no prog:" >&2; bad=$((bad + 1)); }
			[ -n "$Q_CASES" ] || { echo "FAIL $lbl: no case:" >&2; bad=$((bad + 1)); }
			[ -n "$Q_HINT" ]  || { echo "FAIL $lbl: no hint:" >&2; bad=$((bad + 1)); }
			# the file is a function name in every case, so it must be one -- and
			# must not shadow an applet a case leans on (wc.c would make `wc`
			# the learner's program in every pipe after it).
			fn=$(c_fn "$Q_FILE")
			case "$Q_FILE" in
				[a-z]*.c) ;;
				*) echo "FAIL $lbl: file: '$Q_FILE' must be a lowercase NAME.c" >&2; bad=$((bad + 1)) ;;
			esac
			case "$fn" in
				*[!a-z0-9_]*) echo "FAIL $lbl: '$fn' is not a shell function name" >&2; bad=$((bad + 1)) ;;
				prog|run|src|warn|name|intdfl|scratch) echo "FAIL $lbl: '$fn' is a name the runner's own directory uses" >&2; bad=$((bad + 1)) ;;
			esac
			command -v "$fn" >/dev/null 2>&1 \
				&& { echo "FAIL $lbl: '$fn' shadows a command on PATH" >&2; bad=$((bad + 1)); }
			case "$Q_PROMPT $Q_SPEC" in
				*"$Q_FILE"*) ;;
				*) echo "FAIL $lbl: neither q: nor spec: names $Q_FILE" >&2; bad=$((bad + 1)) ;;
			esac
			if printf '%s\n' "$Q_CASES" | grep -vqw -- "$fn"; then
				echo "FAIL $lbl: a case: never runs $fn" >&2; bad=$((bad + 1))
			fi
			case "$Q_SPEC$Q_PROG$Q_CASES$Q_START$Q_PROMPT" in
				*@*@*) echo "FAIL $lbl: an @token@ was never rendered" >&2; bad=$((bad + 1)) ;;
			esac
			# the spec becomes the starter's top comment: a comment marker in it
			# ends that comment early and the starter does not compile.
			case "$Q_PROMPT$Q_SPEC" in
				*'*/'*|*'/*'*) echo "FAIL $lbl: q: or spec: holds a comment marker -- the starter would not compile" >&2; bad=$((bad + 1)) ;;
			esac
			# one name, one program: the ledger and the learner's memory both key
			# on it, and two hello.c in two units is two lessons arguing.
			case " $seen " in
				*" $fn "*) echo "FAIL $lbl: $Q_FILE is already a program in an earlier unit" >&2; bad=$((bad + 1)) ;;
			esac
			seen="$seen $fn"
			i=$((i + 1))
		done
	done
	c_leave
	return "$bad"
}

# c_strict SRC LABEL -- SRC through every compiler in C_STRICT, a ;-separated
# list (gcc for the build, clang too where it exists: it is the cc a phone's
# termux grades with). returns how many refused it.
c_strict() {
	local cmd n=0 IFS=';'
	for cmd in ${C_STRICT:-}; do
		IFS=' '
		cp "$1" "$TMP/c.strict.c"
		# shellcheck disable=SC2086
		$cmd -o /dev/null "$TMP/c.strict.c" > "$TMP/c.err" 2>&1 \
			|| { echo "FAIL $2 fails '$cmd':" >&2; sed 's/^/    /' "$TMP/c.err" >&2; n=$((n + 1)); }
	done
	return "$n"
}

# c_check -- the compiled half: every reference builds under C_FLAGS, then
# again under STRICT (the build passes gcc's -std=c11 -Wall -Wextra -pedantic
# -Werror) so a reference that only tcc accepts is caught; it reproduces
# itself; an empty main fails a case; and the starter vi opens on compiles
# under both.
c_check() {
	local pid path nq i bad=0 lbl
	c_tools || { echo "FAIL c: $CC_WHY" >&2; return 1; }
	c_lint || bad=$((bad + $?))
	c_enter
	for pid in $(project_ids); do
		path=$(prj_path "$pid"); nq=$(prj_nq "$pid"); i=1
		while [ "$i" -le "${nq:-0}" ]; do
			lbl="c/$pid#$i"
			q_load "$path" "$i" || { i=$((i + 1)); continue; }
			printf '%s\n' "$Q_PROG" > "$TMP/c.self"
			c_strict "$TMP/c.self" "$lbl: reference" || bad=$((bad + $?))
			if ! prj_grade "$TMP/c.self"; then
				if [ -n "$PRJ_CERR" ]; then echo "FAIL $lbl: reference does not compile:" >&2
					printf '%s\n' "$PRJ_CERR" | sed 's/^/    /' >&2
				else echo "FAIL $lbl: reference does not reproduce itself -- '$PRJ_CASE': got '$PRJ_GOT' want '$PRJ_WANT'" >&2; fi
				bad=$((bad + 1))
			fi
			prj_cases_bite || { echo "FAIL $lbl: an empty main passes every case" >&2; bad=$((bad + 1)); }
			# the starter is the first thing vi shows: it compiles under the
			# strict pass too, or a host-cc learner meets an error they never wrote.
			c_starter > "$TMP/c.start"
			c_build "$TMP/c.start" start || { echo "FAIL $lbl: the starter does not compile: $C_ERR" >&2; bad=$((bad + 1)); }
			c_strict "$TMP/c.start" "$lbl: the starter" || bad=$((bad + $?))
			i=$((i + 1))
		done
	done
	c_leave
	return "$bad"
}
