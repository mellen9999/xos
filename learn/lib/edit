# edit -- a vi-mode line editor for learn's answer prompt, so answering a
# question feels like a real shell: history with k/j, motions with h l w b 0 $,
# edits with x dd i a A I, insert mode for typing. the same keys the curriculum
# teaches for vi, at the prompt you use to answer questions about vi.
#
# ash has no ${var:off:len}, so the cursor is modelled as two strings -- L
# (everything before the cursor) and R (the char under it and after). every
# operation is then pure POSIX parameter expansion, no forks per keystroke:
#   insert c   L="$L$c"
#   backspace  L="${L%?}"
#   left       last char of L moves to the front of R
#   right      first char of R moves to the end of L
# the whole line is "$L$R"; the cursor sits between them.
#
# the redraw is wrap-aware: a line longer than the terminal occupies several
# rows, and _ED_ROW remembers which row the cursor was left on so the next
# redraw climbs back to the first one before reprinting. without it a
# backspace on a wrapped line left the tail of the old row on screen and
# parked the cursor a row off.
#
# not a tty (the build's automated runs, any pipe) falls straight back to a
# plain read, so nothing here can break a headless learn.

E_ESC=$(printf '\033'); E_DEL=$(printf '\177'); E_BS=$(printf '\010')
E_TAB=$(printf '\011'); E_EOT=$(printf '\004')
# history lives beside cards/passed -- persistent when $STATE is (p3 up),
# tmpfs when it is not -- so the EXIT trap wiping $TMP never touches it.
EDIT_HIST="${EDIT_HIST:-$STATE/answers}"
# last deleted/yanked text, for p / P -- a global (not a read_line local) so a
# yank survives across questions. must exist before the first p/P: under
# set -u an unset read crashes the lesson mid-question.
YANK=

# redraw: reprint the line after the prompt, clear to end, park the cursor. the
# whole repaint is wrapped in one synchronised-output frame so a remote terminal
# never shows a half-drawn line mid-keystroke.
_ED_ROW=0
_ed_draw() {   # $1 prompt  $2 L  $3 R   (the prompt is 2 cells wide: "$ ")
	local _w=${COLS:-80} _p _t _prow _erow
	[ "$_w" -gt 0 ] 2>/dev/null || _w=80
	_p=$(( 2 + ${#2} ))            # cell index of the cursor (0-based)
	_t=$(( 2 + ${#2} + ${#3} ))    # cells the whole line occupies
	printf '%s' "$SYNC_BEG"
	# climb to the line's first row, reprint it all, clear whatever is below
	[ "$_ED_ROW" -gt 0 ] && printf '\033[%dA' "$_ED_ROW"
	printf '\r%s%s%s\033[J' "$1" "$2" "$3"
	# the print left the cursor after the last cell: on row (t-1)/w. with
	# nothing right of the cursor that IS the cursor; otherwise climb to the
	# row of cell p and step right to its column.
	_erow=$(( (_t - 1) / _w ))
	if [ -n "$3" ]; then
		_prow=$(( _p / _w ))
		[ "$_erow" -gt "$_prow" ] && printf '\033[%dA' $(( _erow - _prow ))
		printf '\r'
		[ $(( _p % _w )) -gt 0 ] && printf '\033[%dC' $(( _p % _w ))
		_ED_ROW=$_prow
	else
		_ED_ROW=$_erow
	fi
	printf '%s' "$SYNC_END"
}

# last char of a string, via expansion only
_ed_last() { _r=${1#"${1%?}"}; }
# first char of a string
_ed_first() { _r=${1%"${1#?}"}; }

read_line() {   # $1 = prompt; sets REPLY_LINE, returns 1 on EOF/quit-signal
	local prompt="${1:-}" L="" R="" mode=insert c c2 c3 _r _pc _quit=
	if [ ! -t 0 ]; then
		IFS= read -r REPLY_LINE || return 1
		return 0
	fi

	local hn hi
	hn=$([ -f "$EDIT_HIST" ] && grep -c '' "$EDIT_HIST" 2>/dev/null || echo 0)
	# the history is unbounded otherwise, and every arrow-up costs a sed over
	# it: keep the last thousand, trimmed once it runs two hundred over
	if [ "$hn" -gt 1200 ]; then
		tail -n 1000 "$EDIT_HIST" > "$EDIT_HIST.tmp.$$" 2>/dev/null \
			&& mv "$EDIT_HIST.tmp.$$" "$EDIT_HIST" 2>/dev/null && hn=1000
	fi
	hi=$hn   # index one past the newest entry == the fresh line being typed
	_ED_ROW=0

	# the prompt colour tracks the mode, the way cmdchamp's does: white while you
	# type, red the instant you drop to normal mode, so the mode is legible
	# without a separate indicator. PROMPT_INS/NORM come from ui, where the red
	# global is not shadowed by this function's R (the right-of-cursor buffer).
	# a variable, not a $(...): that was a fork per keystroke in the file
	# whose header promises none
	_ed_pr() { if [ "$mode" = normal ]; then _pr="$PROMPT_NORM"; else _pr="$PROMPT_INS"; fi; }
	local _pr

	_ed_pr; _ed_draw "$_pr" "$L" "$R"
	while :; do
		IFS= read -rsn1 c || { printf '\n'; REPLY_LINE="$L$R"; return 1; }
		[ -z "$c" ] && break   # Enter (read strips the newline -> empty)

		case "$c" in
		"$E_ESC")
			# distinguish a bare ESC (enter normal mode) from an arrow sequence
			# ESC [ X. ash read -t is integer-seconds -- too coarse to race the
			# terminal -- so read the next byte BLOCKING. a real arrow sends its
			# bytes back to back, so [ arrives at once; a human pressing ESC then
			# a command has that command arrive as the next byte, and we run it.
			IFS= read -rsn1 c2 2>/dev/null
			if [ "$c2" = "[" ]; then
				IFS= read -rsn1 c3 2>/dev/null
				case "$c3" in
					A) _ed_hist_prev ;;
					B) _ed_hist_next ;;
					C) [ -n "$R" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
					D) [ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; } ;;
				esac
			else
				mode=normal
				# vi convention: the cursor rests on a character, not past the end
				[ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; }
				if [ -z "$c2" ]; then
					break            # ESC then Enter -> submit
				else
					_ed_normal "$c2"  # ESC then a command -> run it now
				fi
			fi
			;;
		"$E_EOT")
			# Ctrl-D quits the prompt from either mode, the way it does in
			# cmdchamp. raw read delivers it as a byte, not EOF, so it has to
			# be caught by hand; a blank line is returned and nothing graded.
			printf '\n'; REPLY_LINE=""; return 1
			;;
		"$E_DEL"|"$E_BS")
			[ -n "$L" ] && L="${L%?}"
			;;
		"$E_TAB")
			# Tab: the reference panel, without abandoning what you typed --
			# the page scrolls past, the question and your line are reprinted.
			# learn mode only, same as typing man; the clock modes get nothing.
			if [ "${MODE:-}" = learn ] && command -v ref_panel >/dev/null; then
				printf '\n'
				ref_panel "$(printf '%s\n' "${Q_ANSWERS:-}" | head -1)"
				printf '  %s%s%s\n' "$W" "$Q_PROMPT" "$N"
				_ED_ROW=0
			fi
			;;
		*)
			if [ "$mode" = insert ]; then
				L="$L$c"
			else
				_ed_normal "$c"
			fi
			;;
		esac
		# normal-mode q sets this (cmdchamp binds q to quit); honour it here,
		# where a return actually leaves read_line.
		[ -n "$_quit" ] && { printf '\n'; REPLY_LINE=""; return 1; }
		_ed_pr; _ed_draw "$_pr" "$L" "$R"
	done

	printf '\n'
	REPLY_LINE="$L$R"
	# history: skip blanks and immediate repeats
	if [ -n "$REPLY_LINE" ]; then
		[ "$(tail -1 "$EDIT_HIST" 2>/dev/null)" = "$REPLY_LINE" ] \
			|| printf '%s\n' "$REPLY_LINE" >> "$EDIT_HIST" 2>/dev/null
	fi
	return 0
}

# vi normal-mode dispatch. L and R are the caller's locals (same function scope
# via the shell's dynamic scoping when called from read_line).
# YANK holds the last deleted/yanked text, for p / P.
_ed_normal() {   # $1 = key
	local _k="$1" _c
	case "$_k" in
		"$E_EOT") _quit=1 ;;     # Ctrl-D quits, as in cmdchamp; read_line acts on it
		q) [ "${Q_REF:-}" = vi ] || _quit=1 ;;   # q too -- except in the vi level, where q is an answer
		h) [ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; } ;;
		l|' ') [ "${R#?}" != "" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
		0|^) R="$L$R"; L="" ;;
		'$') L="$L$R"; R=""; [ -n "$L" ] && { _ed_last "$L"; R="$_r"; L="${L%?}"; } ;;
		x) [ -n "$R" ] && { _ed_first "$R"; YANK="$_r"; R="${R#?}"; }
		   [ -z "$R" ] && [ -n "$L" ] && { _ed_last "$L"; R="$_r"; L="${L%?}"; } ;;
		X) [ -n "$L" ] && { _ed_last "$L"; YANK="$_r"; L="${L%?}"; } ;;
		i) mode=insert ;;
		a) mode=insert; [ -n "$R" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
		A) mode=insert; L="$L$R"; R="" ;;
		I) mode=insert; R="$L$R"; L="" ;;
		s) [ -n "$R" ] && { _ed_first "$R"; YANK="$_r"; R="${R#?}"; }; mode=insert ;;
		r) IFS= read -rsn1 _c 2>/dev/null; [ -n "$R" ] && [ -n "$_c" ] && R="$_c${R#?}" ;;
		'~') if [ -n "$R" ]; then
		        _ed_first "$R"
		        _c=$(printf '%s' "$_r" | tr 'a-zA-Z' 'A-Za-z')
		        L="$L$_c"; R="${R#?}"
		     fi ;;
		w|W) _ed_word_fwd ;;
		e|E) _ed_word_end ;;
		b|B) _ed_word_back ;;
		p) [ -n "$YANK" ] && { L="$L$(printf '%s' "$R" | cut -c1)$YANK"; R="${R#?}"; } ;;
		P) [ -n "$YANK" ] && L="$L$YANK" ;;
		D) YANK="$R"; R="" ;;
		C) YANK="$R"; R=""; mode=insert ;;
		d) IFS= read -rsn1 c2 2>/dev/null
		   case "$c2" in
		     d) YANK="$L$R"; L=""; R="" ;;
		     '$') YANK="$R"; R="" ;;
		     0) YANK="$L"; L="" ;;
		     w|W) _ed_del_word_fwd ;;
		     b|B) _ed_del_word_back ;;
		   esac ;;
		c) IFS= read -rsn1 c2 2>/dev/null
		   case "$c2" in
		     c) YANK="$L$R"; L=""; R=""; mode=insert ;;
		     '$') YANK="$R"; R=""; mode=insert ;;
		     w|W) _ed_del_word_fwd; mode=insert ;;
		   esac ;;
	esac
}

# move cursor to the end of the current/next word
_ed_word_end() {
	local line="$L$R" p=${#L} n; n=${#line}
	p=$((p+1))
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p+1)); done
	while [ "$((p+1))" -lt "$n" ] && [ "$(_ed_at "$line" "$((p+1))")" != " " ]; do p=$((p+1)); done
	_ed_split "$line" "$p"
}
# delete from cursor to start of next word (dw)
_ed_del_word_fwd() {
	local start="$L"
	_ed_word_fwd            # advances L past the word+spaces
	YANK=${L#"$start"}      # the text that was jumped over
	L="$start"             # cursor back where it was; that text is now gone
}
_ed_del_word_back() {
	local end="$L$R" endlen=${#R} oldl=${#L}
	_ed_word_back
	# oldl is where the cursor WAS; if word_back did not move it (cursor
	# already at the start of the line), there is nothing behind it to yank --
	# a no-op, not whatever an inverted cut -c range happens to do
	if [ "${#L}" -lt "$oldl" ]; then
		YANK=$(printf '%s' "$L$R" | cut -c$(( ${#L} + 1 ))-"$oldl" 2>/dev/null)
	else
		YANK=""
	fi
	R=$(printf '%s' "$end" | cut -c$(( ${#end} - endlen + 1 ))- 2>/dev/null)
}

# word motions: whole line is "$L$R", cursor position is ${#L}
_ed_word_fwd() {
	local line="$L$R" p=${#L} n
	n=${#line}
	# skip current word chars, then spaces
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" != " " ]; do p=$((p+1)); done
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p+1)); done
	_ed_split "$line" "$p"
}
_ed_word_back() {
	local line="$L$R" p=${#L}
	[ "$p" -gt 0 ] && p=$((p-1))
	while [ "$p" -gt 0 ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p-1)); done
	while [ "$p" -gt 0 ] && [ "$(_ed_at "$line" "$((p-1))")" != " " ]; do p=$((p-1)); done
	_ed_split "$line" "$p"
}
# char at index (fork, only on w/b which are rare)
_ed_at() { printf '%s' "$1" | cut -c$(( $2 + 1 )); }
# split line at index into L / R
_ed_split() {
	local line="$1" p="$2"
	L=$(printf '%s' "$line" | cut -c1-"$p" 2>/dev/null); [ "$p" = 0 ] && L=""
	R=$(printf '%s' "$line" | cut -c$(( p + 1 ))- 2>/dev/null)
}

_ed_hist_prev() {
	[ "$hi" -gt 0 ] || return
	hi=$((hi - 1))
	local e; e=$(sed -n "$((hi + 1))p" "$EDIT_HIST" 2>/dev/null)
	L="$e"; R=""
}
_ed_hist_next() {
	[ "$hi" -lt "$hn" ] || return
	hi=$((hi + 1))
	if [ "$hi" -ge "$hn" ]; then L=""; R="";
	else L=$(sed -n "$((hi + 1))p" "$EDIT_HIST" 2>/dev/null); R=""; fi
}
