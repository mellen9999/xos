# edit -- a vi-mode line editor for learn's answer prompt, so answering a
# question feels like a real shell: history with k/j, motions with h l w b 0 $,
# edits with x dd i a A I, insert mode for typing. the same keys the curriculum
# teaches for vi, at the prompt you use to answer questions about vi.
#
# ash has no ${var:off:len}, so the cursor is modelled as two strings -- L
# (everything before the cursor) and R (the char under it and after). every
# operation is then pure POSIX parameter expansion, no forks per keystroke:
#   insert c   L="$L$c"
#   backspace  L="${L%?}"
#   left       last char of L moves to the front of R
#   right      first char of R moves to the end of L
# the whole line is "$L$R"; the cursor sits between them.
#
# the redraw is wrap-aware: a line longer than the terminal occupies several
# rows, and _ED_ROW remembers which row the cursor was left on so the next
# redraw climbs back to the first one before reprinting. without it a
# backspace on a wrapped line left the tail of the old row on screen and
# parked the cursor a row off.
#
# not a tty (the build's automated runs, any pipe) falls straight back to a
# plain read, so nothing here can break a headless learn.

E_ESC=$(printf '\033'); E_DEL=$(printf '\177'); E_BS=$(printf '\010')
E_TAB=$(printf '\011'); E_EOT=$(printf '\004')
# history lives beside cards/passed -- persistent when $STATE is (p3 up),
# tmpfs when it is not -- so the EXIT trap wiping $TMP never touches it.
EDIT_HIST="${EDIT_HIST:-$STATE/answers}"
# last deleted/yanked text, for p / P -- a global (not a read_line local) so a
# yank survives across questions. must exist before the first p/P: under
# set -u an unset read crashes the lesson mid-question.
YANK=
# the reference panel, when Tab has opened it: the rendered page, the number of
# terminal rows it fills, and how many rows the answer line filled when it was
# last painted -- while that number holds, the panel below has not moved and
# does not need repainting. globals for the same reason YANK is one: set -u,
# and the redraw and the toggle both read them.
ED_PANEL= ED_PANEL_ROWS=0 ED_LROWS=0
# ED_OPEN names the panel the learner has open (ref | hint | empty). it outlives
# the meta round-trips within one question, so a hint or reference stays up while
# you keep typing; ED_ROWS_USED is how many rows the finished line took, so the
# caller can wipe a ?/skip echo instead of letting it walk the prompt downscreen.
ED_OPEN= ED_ROWS_USED=0

# redraw: reprint the line after the prompt, clear to end, park the cursor. the
# whole repaint is wrapped in one synchronised-output frame so a remote terminal
# never shows a half-drawn line mid-keystroke.
_ED_ROW=0
_ed_draw() {   # $1 prompt  $2 L  $3 R   (the prompt is 2 cells wide: "$ ")
	local _w=${TERM_COLS:-80} _p _t _prow _erow _lr _col0=
	[ "$_w" -gt 0 ] 2>/dev/null || _w=80
	_p=$(( 2 + ${#2} ))            # cell index of the cursor (0-based)
	_t=$(( 2 + ${#2} + ${#3} ))    # cells the whole line occupies
	printf '%s' "$SYNC_BEG"
	# climb to the line's first row and reprint it all
	[ "$_ED_ROW" -gt 0 ] && printf '\033[%dA' "$_ED_ROW"
	printf '\r%s%s%s' "$1" "$2" "$3"
	_erow=$(( (_t - 1) / _w ))
	_lr=$(( _erow + 1 ))
	if [ -z "$ED_PANEL" ]; then
		printf '\033[J'
	elif [ "$_lr" = "$ED_LROWS" ]; then
		# the line still fills the same rows, so the panel under it has not
		# moved: clear this row alone and leave the panel where it is. that
		# is what makes a keystroke with the panel open cost what one
		# without it costs -- nothing is redrawn but the line.
		printf '\033[K'
	else
		# the line took a row, or gave one back: the panel moves with it.
		# every move here is relative, so if the panel runs past the bottom
		# and the terminal scrolls, the climb still lands on the line --
		# only what was above it scrolls away.
		printf '\033[J\n%s\033[%dA\r' "$ED_PANEL" "$ED_PANEL_ROWS"
		ED_LROWS=$_lr
		_col0=1                # cursor is at column 0 now, not after the line
	fi
	# with nothing right of the cursor the end of the line IS the cursor;
	# otherwise climb to the row of cell p and step right to its column.
	if [ -n "$3" ]; then
		_prow=$(( _p / _w ))
		[ "$_erow" -gt "$_prow" ] && printf '\033[%dA' $(( _erow - _prow ))
		printf '\r'
		[ $(( _p % _w )) -gt 0 ] && printf '\033[%dC' $(( _p % _w ))
		_ED_ROW=$_prow
	else
		[ -n "$_col0" ] && [ $(( _t - _erow * _w )) -gt 0 ] \
			&& printf '\033[%dC' $(( _t - _erow * _w ))
		_ED_ROW=$_erow
	fi
	printf '%s' "$SYNC_END"
}

# last char of a string, via expansion only
_ed_last() { _r=${1#"${1%?}"}; }
# first char of a string
_ed_first() { _r=${1%"${1#?}"}; }

# fit a rendered page into the rows the panel is allowed: prints the row count
# it ends up filling, then the text. a page longer than that is cut and the cut
# is named -- "12 more lines -- learn ref ls" -- because a reference that
# quietly stops three flags short of the one you needed is worse than no panel.
#
# rows, not lines: colour escapes take up no cells and a line wider than the
# terminal wraps onto further ones. get that count wrong and closing the panel
# climbs to the wrong row and eats the question. one awk, once per open --
# never per keystroke.
_ed_panel_fit() {   # $1 width  $2 max rows  $3 marker prefix  $4 marker suffix
	awk -v w="$1" -v max="$2" -v pre="$3" -v post="$4" -v e="$E_ESC" '
		function rw(s,   t, n) {
			t = s; gsub(e "\\[[0-9;?]*[A-Za-z]", "", t); n = length(t)
			return int((n > 0 ? n - 1 : 0) / w) + 1
		}
		{ l[NR] = $0; r[NR] = rw($0); tot += r[NR] }
		END {
			if (tot <= max) {
				print tot
				for (i = 1; i <= NR; i++) print l[i]
				exit
			}
			# the rows the marker needs are reserved before the cut, measured
			# on the widest number it could carry -- reserving a flat one row
			# let a marker that wrapped push the panel a row past its budget,
			# and a panel a row taller than it claims closes onto the question.
			mr = rw(sprintf("%s%d more lines -- learn ref %s", pre, NR, post))
			used = 0; out = ""
			for (i = 1; i <= NR; i++) {
				if (used + r[i] + mr > max) break
				out = out l[i] "\n"; used += r[i]
			}
			m = sprintf("%s%d more lines -- learn ref %s", pre, NR - i + 1, post)
			print used + rw(m)
			printf "%s%s\n", out, m
		}'
}

# Tab: the reference opens under the answer line, and Tab again takes it away.
# the question, the answer line, what you have typed and the cursor all stay on
# the row they were on -- nothing moves but what appears below.
#
# nothing is drawn here. the toggle only says what the panel is, and the redraw
# puts it on the screen: closing sets it empty and the redraw's clear-to-end-of-
# screen takes it off again. one place paints, so the panel and the cursor can
# never disagree about where the line ends.
_ed_panel_load() {
	local fit lrows max w=${TERM_COLS:-80} src suf
	ED_LROWS=0        # nothing painted yet: the redraw must draw it in full
	# closed, or a clock mode that has no panel at all: leave the region empty
	# and the redraw's clear-to-end-of-screen takes whatever was there off.
	[ -n "$ED_OPEN" ] && [ "${MODE:-}" = learn ] \
		|| { ED_PANEL= ED_PANEL_ROWS=0 ED_OPEN=; return 0; }
	lrows=$(( (2 + ${#L} + ${#R}) / w + 1 ))
	# what is left of the screen under the answer line, once the block above it
	# has its own: a status bar, the question, the affordance line and the blank
	# a setup blurb sometimes adds -- eight rows covers that with one to spare
	# for the answer line taking a row while the panel is open. getting it wrong
	# costs the question its place on the screen, never the redraw its footing.
	max=$(( ${TERM_LINES:-24} - lrows - 8 ))
	[ "$max" -ge 3 ] || max=3
	# one region, two sources: Tab fills it with the reference, ? with the hint.
	# opening one closes the other, and neither ever scrolls the question off the
	# top the way a printed note does -- the redraw owns the region absolutely.
	case "$ED_OPEN" in
		ref)
			command -v ref_panel_text >/dev/null \
				|| { ED_PANEL= ED_PANEL_ROWS=0 ED_OPEN=; return 0; }
			src=$(ref_panel_text "$(printf '%s\n' "${Q_ANSWERS:-}" | head -1)")
			suf="${Q_REF:-}$N" ;;
		hint)
			src=${Q_HINT:-}
			[ -n "$src" ] || src="no hint for this one -- Tab for the reference"
			suf="hint$N" ;;
	esac
	fit=$(printf '%s\n' "$src" | _ed_panel_fit "$w" "$max" "  $D" "$suf")
	# the row count is the first line; the panel is the rest
	ED_PANEL=${fit#*"$NL"}
	[ -n "$ED_PANEL" ] || { ED_PANEL_ROWS=0; return 0; }
	ED_PANEL_ROWS=${fit%%"$NL"*}
	return 0
}

read_line() {   # sets REPLY_LINE, returns 1 on EOF/quit-signal
	local L="" R="" mode=insert c c2 c3 _r _pc _quit= _pm _bk
	if [ ! -t 0 ]; then
		IFS= read -r REPLY_LINE || return 1
		return 0
	fi

	local hn hi
	hn=$([ -f "$EDIT_HIST" ] && grep -c '' "$EDIT_HIST" 2>/dev/null || echo 0)
	# the history is unbounded otherwise, and every arrow-up costs a sed over
	# it: keep the last thousand, trimmed once it runs two hundred over
	if [ "$hn" -gt 1200 ]; then
		tail -n 1000 "$EDIT_HIST" > "$EDIT_HIST.tmp.$$" 2>/dev/null \
			&& mv "$EDIT_HIST.tmp.$$" "$EDIT_HIST" 2>/dev/null && hn=1000
	fi
	hi=$hn   # index one past the newest entry == the fresh line being typed
	_ED_ROW=0
	# a new question cleared the screen; within a question ED_OPEN carries which
	# panel (if any) the learner has open across its meta round-trips, so a hint
	# or reference reopened here is the one they left up, not a blank slate.
	_ed_panel_load

	# the prompt colour tracks the mode, the way cmdchamp's does: white while you
	# type, red the instant you drop to normal mode, so the mode is legible
	# without a separate indicator. PROMPT_INS/NORM come from ui, where the red
	# global is not shadowed by this function's R (the right-of-cursor buffer).
	# a variable, not a $(...): that was a fork per keystroke in the file
	# whose header promises none
	_ed_pr() { if [ "$mode" = normal ]; then _pr="$PROMPT_NORM"; else _pr="$PROMPT_INS"; fi; }
	local _pr

	# leaving the prompt: take the panel off the screen and park at the end of
	# the line, so the newline steps past all of it. without the park, a
	# newline from a cursor sitting mid-way through a wrapped line lands on
	# the line's own tail and the verdict is printed over it.
	_ed_leave() {
		local _w=${TERM_COLS:-80}; [ "$_w" -gt 0 ] 2>/dev/null || _w=80
		# how many rows the finished line occupied: a caller re-asking after a
		# ?/skip/blank submit climbs back over exactly these and clears, so the
		# echo does not push the prompt a line downscreen every time.
		ED_ROWS_USED=$(( (2 + ${#L} + ${#R}) / _w + 1 ))
		ED_PANEL= ED_PANEL_ROWS=0 ED_LROWS=0
		_ed_pr; _ed_draw "$_pr" "$L$R" ""
		printf '\n'
	}

	_ed_pr; _ed_draw "$_pr" "$L" "$R"
	while :; do
		IFS= read -rsn1 c || { _ed_leave; REPLY_LINE="$L$R"; return 1; }
		[ -z "$c" ] && break   # Enter (read strips the newline -> empty)

		case "$c" in
		"$E_ESC")
			# an arrow key sends ESC [ X; a bare Esc means normal mode. ash
			# read -t is integer-seconds, too coarse to race the terminal, so
			# the next byte is read BLOCKING -- which for a bare Esc is the next
			# keypress, and waiting until then to redden the prompt made normal
			# mode look like it had not engaged. so switch and repaint NOW, then
			# read: if the byte turns out to be [ (an arrow, its bytes arriving
			# back to back) we were not really changing mode and undo it, fast
			# enough that the prompt never visibly flickers.
			_pm=$mode
			if [ "$mode" = insert ]; then
				mode=normal
				# vi convention: the cursor rests on a character, not past the end
				_bk=""; [ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; _bk=1; }
			fi
			_ed_pr; _ed_draw "$_pr" "$L" "$R"
			IFS= read -rsn1 c2 2>/dev/null
			if [ "$c2" = "[" ]; then
				# an arrow: it changes no mode. put back the optimistic switch.
				if [ "$_pm" = insert ]; then
					mode=insert
					[ -n "$_bk" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; }
				fi
				IFS= read -rsn1 c3 2>/dev/null
				case "$c3" in
					A) _ed_hist_prev ;;
					B) _ed_hist_next ;;
					C) [ -n "$R" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
					D) [ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; } ;;
				esac
			elif [ -z "$c2" ]; then
				break                 # Esc then Enter -> submit (now in normal mode)
			else
				_ed_normal "$c2"      # Esc then a command -> run it now
			fi
			;;
		"$E_EOT")
			# Ctrl-D quits the prompt from either mode, the way it does in
			# cmdchamp. raw read delivers it as a byte, not EOF, so it has to
			# be caught by hand; a blank line is returned and nothing graded.
			_ed_leave; REPLY_LINE=""; return 1
			;;
		"$E_DEL"|"$E_BS")
			[ -n "$L" ] && L="${L%?}"
			;;
		"$E_TAB")
			# learn mode only; the clock modes never reach the editor. toggle the
			# reference, and if the hint was the one showing this replaces it.
			if [ "$ED_OPEN" = ref ]; then ED_OPEN=; else ED_OPEN=ref; fi
			_ed_panel_load
			;;
		*)
			if [ "$mode" = insert ]; then
				L="$L$c"
			else
				_ed_normal "$c"
			fi
			;;
		esac
		# normal-mode q sets this (cmdchamp binds q to quit); honour it here,
		# where a return actually leaves read_line.
		[ -n "$_quit" ] && { _ed_leave; REPLY_LINE=""; return 1; }
		_ed_pr; _ed_draw "$_pr" "$L" "$R"
	done

	_ed_leave
	REPLY_LINE="$L$R"
	# history: skip blanks and immediate repeats
	if [ -n "$REPLY_LINE" ]; then
		[ "$(tail -1 "$EDIT_HIST" 2>/dev/null)" = "$REPLY_LINE" ] \
			|| printf '%s\n' "$REPLY_LINE" >> "$EDIT_HIST" 2>/dev/null
	fi
	return 0
}

# vi normal-mode dispatch. L and R are the caller's locals (same function scope
# via the shell's dynamic scoping when called from read_line).
# YANK holds the last deleted/yanked text, for p / P.
_ed_normal() {   # $1 = key
	local _k="$1" _c
	case "$_k" in
		"$E_EOT") _quit=1 ;;     # Ctrl-D quits, as in cmdchamp; read_line acts on it
		h) [ -n "$L" ] && { _ed_last "$L"; R="$_r$R"; L="${L%?}"; } ;;
		l|' ') [ "${R#?}" != "" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
		0|^) R="$L$R"; L="" ;;
		'$') L="$L$R"; R=""; [ -n "$L" ] && { _ed_last "$L"; R="$_r"; L="${L%?}"; } ;;
		x) [ -n "$R" ] && { _ed_first "$R"; YANK="$_r"; R="${R#?}"; }
		   [ -z "$R" ] && [ -n "$L" ] && { _ed_last "$L"; R="$_r"; L="${L%?}"; } ;;
		X) [ -n "$L" ] && { _ed_last "$L"; YANK="$_r"; L="${L%?}"; } ;;
		i) mode=insert ;;
		a) mode=insert; [ -n "$R" ] && { _ed_first "$R"; L="$L$_r"; R="${R#?}"; } ;;
		A) mode=insert; L="$L$R"; R="" ;;
		I) mode=insert; R="$L$R"; L="" ;;
		s) [ -n "$R" ] && { _ed_first "$R"; YANK="$_r"; R="${R#?}"; }; mode=insert ;;
		r) IFS= read -rsn1 _c 2>/dev/null; [ -n "$R" ] && [ -n "$_c" ] && R="$_c${R#?}" ;;
		'~') if [ -n "$R" ]; then
		        _ed_first "$R"
		        _c=$(printf '%s' "$_r" | tr 'a-zA-Z' 'A-Za-z')
		        L="$L$_c"; R="${R#?}"
		     fi ;;
		w|W) _ed_word_fwd ;;
		e|E) _ed_word_end ;;
		b|B) _ed_word_back ;;
		p) [ -n "$YANK" ] && { L="$L$(printf '%s' "$R" | cut -c1)$YANK"; R="${R#?}"; } ;;
		P) [ -n "$YANK" ] && L="$L$YANK" ;;
		D) YANK="$R"; R="" ;;
		C) YANK="$R"; R=""; mode=insert ;;
		d) IFS= read -rsn1 c2 2>/dev/null
		   case "$c2" in
		     d) YANK="$L$R"; L=""; R="" ;;
		     '$') YANK="$R"; R="" ;;
		     0) YANK="$L"; L="" ;;
		     w|W) _ed_del_word_fwd ;;
		     b|B) _ed_del_word_back ;;
		   esac ;;
		c) IFS= read -rsn1 c2 2>/dev/null
		   case "$c2" in
		     c) YANK="$L$R"; L=""; R=""; mode=insert ;;
		     '$') YANK="$R"; R=""; mode=insert ;;
		     w|W) _ed_del_word_fwd; mode=insert ;;
		   esac ;;
	esac
}

# move cursor to the end of the current/next word
_ed_word_end() {
	local line="$L$R" p=${#L} n; n=${#line}
	p=$((p+1))
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p+1)); done
	while [ "$((p+1))" -lt "$n" ] && [ "$(_ed_at "$line" "$((p+1))")" != " " ]; do p=$((p+1)); done
	_ed_split "$line" "$p"
}
# delete from cursor to start of next word (dw)
_ed_del_word_fwd() {
	local start="$L"
	_ed_word_fwd            # advances L past the word+spaces
	YANK=${L#"$start"}      # the text that was jumped over
	L="$start"             # cursor back where it was; that text is now gone
}
_ed_del_word_back() {
	local end="$L$R" endlen=${#R} oldl=${#L}
	_ed_word_back
	# oldl is where the cursor WAS; if word_back did not move it (cursor
	# already at the start of the line), there is nothing behind it to yank --
	# a no-op, not whatever an inverted cut -c range happens to do
	if [ "${#L}" -lt "$oldl" ]; then
		YANK=$(printf '%s' "$L$R" | cut -c$(( ${#L} + 1 ))-"$oldl" 2>/dev/null)
	else
		YANK=""
	fi
	R=$(printf '%s' "$end" | cut -c$(( ${#end} - endlen + 1 ))- 2>/dev/null)
}

# word motions: whole line is "$L$R", cursor position is ${#L}
_ed_word_fwd() {
	local line="$L$R" p=${#L} n
	n=${#line}
	# skip current word chars, then spaces
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" != " " ]; do p=$((p+1)); done
	while [ "$p" -lt "$n" ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p+1)); done
	_ed_split "$line" "$p"
}
_ed_word_back() {
	local line="$L$R" p=${#L}
	[ "$p" -gt 0 ] && p=$((p-1))
	while [ "$p" -gt 0 ] && [ "$(_ed_at "$line" "$p")" = " " ]; do p=$((p-1)); done
	while [ "$p" -gt 0 ] && [ "$(_ed_at "$line" "$((p-1))")" != " " ]; do p=$((p-1)); done
	_ed_split "$line" "$p"
}
# char at index (fork, only on w/b which are rare)
_ed_at() { printf '%s' "$1" | cut -c$(( $2 + 1 )); }
# split line at index into L / R
_ed_split() {
	local line="$1" p="$2"
	L=$(printf '%s' "$line" | cut -c1-"$p" 2>/dev/null); [ "$p" = 0 ] && L=""
	R=$(printf '%s' "$line" | cut -c$(( p + 1 ))- 2>/dev/null)
}

_ed_hist_prev() {
	[ "$hi" -gt 0 ] || return
	hi=$((hi - 1))
	local e; e=$(sed -n "$((hi + 1))p" "$EDIT_HIST" 2>/dev/null)
	L="$e"; R=""
}
_ed_hist_next() {
	[ "$hi" -lt "$hn" ] || return
	hi=$((hi + 1))
	if [ "$hi" -ge "$hn" ]; then L=""; R="";
	else L=$(sed -n "$((hi + 1))p" "$EDIT_HIST" 2>/dev/null); R=""; fi
}
