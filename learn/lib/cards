# cards -- what you know, and when you last proved it.
#
# every distinct prompt is a card with a tier: 0 unseen, 1 learning, 2 mastered.
# correct promotes one tier, wrong demotes one. a card promotes at most once per
# session, so mastery costs two sittings and cannot be farmed in one.
#
# a card unseen for 30 days decays a tier. that is the difference between a
# score and a skill: the number goes down when you stop, because so does the
# skill. tier 0 is forgotten -- the card leaves the file entirely.
#
# storage is one line per card, "key<TAB>tier<TAB>stamp", in a file on p3 when
# p3 is unlocked and in tmpfs when it is not. no arrays: awk owns the file.
# the separator is a tab and not a space because the key is a whole question
# template -- it is full of spaces, and splitting on them silently truncated
# every lookup to the first word.

CARDS="$STATE/cards"
# not $TMP/seen -- order() owns that name for its introduced-commands ledger,
# and a long-lived process (review, challenge) runs both code paths.
SESSION_SEEN="$TMP/session"
DECAY_DAYS=30

cards_init() {
	mkdir -p "$STATE" 2>/dev/null || :
	: > "$SESSION_SEEN"
	[ -f "$CARDS" ] || : > "$CARDS" 2>/dev/null || :
}

# every rewrite of the card file goes through a same-directory rename (a cp
# or a cross-device mv is a truncate followed by a write, and the tether can
# cut power between the two) and under a lock (two consoles each running
# learn used to rewrite the whole file from their own copy, last one wins).
# flock is a shipped applet; where it is missing the rename alone still holds.
#
# the braces are load-bearing: a redirection on a bare `exec` applies to the
# SHELL, permanently. `exec 8>>f 2>/dev/null` sent this process's stderr to
# /dev/null for the rest of its life -- every die, every selftest FAIL line,
# gone from the first lock onward, leaving a bad count with no reason beside
# it. inside a group the redirection lasts only as long as the group.
_cards_lock()   { { exec 8>>"$CARDS.lock"; } 2>/dev/null && flock -x 8 2>/dev/null; :; }
_cards_unlock() { flock -u 8 2>/dev/null; { exec 8>&-; } 2>/dev/null; :; }

# a card is keyed by the TEMPLATE, not the rendered prompt. the roll changes
# the filenames every time; what you are learning is the shape of the question,
# so `list %dir% in long format` is one card however it renders.
card_key() { printf '%s/%s#%s' "$1" "$2" "$3" | tr -d '\t'; }

card_tier() {
	[ -f "$CARDS" ] || { echo 0; return; }
	awk -F'\t' -v k="$1" '$1 == k { print $2; found = 1; exit } END { if (!found) print 0 }' "$CARDS"
}

card_set() {
	local tmp="$CARDS.tmp.$$"
	[ -f "$CARDS" ] || : > "$CARDS"
	_cards_lock
	awk -F'\t' -v OFS='\t' -v k="$1" -v t="$2" -v s="$3" '
		$1 == k { next }
		{ print }
		END { if (t > 0) print k, t, s }
	' "$CARDS" > "$tmp" 2>/dev/null && mv "$tmp" "$CARDS" 2>/dev/null || rm -f "$tmp" 2>/dev/null
	_cards_unlock
}

now() { date +%s; }

# card_grade KEY RIGHT -- promote or demote, at most one promotion per session
card_grade() {
	local k=$1 right=$2 t
	t=$(card_tier "$k")
	if [ "$right" = 1 ]; then
		grep -qxF -- "$k" "$SESSION_SEEN" 2>/dev/null && return 0
		echo "$k" >> "$SESSION_SEEN"
		[ "$t" -lt 2 ] && t=$((t + 1))
	else
		[ "$t" -gt 0 ] && t=$((t - 1))
	fi
	card_set "$k" "$t" "$(now)"
}

# cards_decay -- run once at startup. a tier that has not been proved in
# DECAY_DAYS drops by one; a card that drops to 0 is dropped from the file.
cards_decay() {
	[ -s "$CARDS" ] || return 0
	local tmp="$CARDS.tmp.$$" cutoff n
	n=$(now)
	cutoff=$(( n - DECAY_DAYS * 86400 ))
	_cards_lock
	# stamp the decay time: re-emitting the old timestamp decayed the same
	# stale card again on every launch instead of once per DECAY_DAYS.
	awk -F'\t' -v OFS='\t' -v c="$cutoff" -v n="$n" '
		{ t = $2; ts = $3; if ($3 < c) { t = t - 1; ts = n } if (t > 0) print $1, t, ts }
	' "$CARDS" > "$tmp" 2>/dev/null && mv "$tmp" "$CARDS" 2>/dev/null || rm -f "$tmp" 2>/dev/null
	_cards_unlock
}

# weakest first: lowest tier, then longest unproved. the tier is already
# field 2 of every line -- sorting on it directly beats a card_tier lookup
# per line (that early version forked an awk for every card).
cards_sort_weak() {
	sort -t "$(printf '\t')" -k2,2n -k3,3n
}

# ---- held: mastery that is current, not remembered ------------------------
#
# a level is PASSED the moment its boss falls, once, for good. that is a
# record of something you did and it is never taken back. HELD is the other
# question -- do you still have it -- and it is the one "completed the
# curriculum" should have been asking all along: beat thirty bosses once,
# let every card rot to tier 0, and the banner still called you done.
#
# held_scan -- "<level-id> <mastered> <cards>" per level, one pass.
#
# the card key is <level-id>/<block-index>#<raw q: template> (card_key), and
# the block index is positional. a q: reworded, or a card inserted rather
# than appended, leaves a key no block answers to. those orphans are skipped
# at read but stats counted them by key PREFIX, which is how a level could
# report 35/33 -- and why a prefix count can never decide held. so the key is
# rebuilt from the level file and joined against the ledger. an orphan then
# contributes to neither side, which is the only reading under which
# mastered == cards means what it says.
held_scan() {
	awk -F'\t' '
		function flush() {
			if (blk > 0) {
				nq[id]++
				k = id "/" blk "#" q; gsub(/\t/, "", k)
				if (tier[k] == 2) m[id]++
			}
			q = ""
		}
		NR == FNR { tier[$1] = $2; next }
		FNR == 1  { flush(); n = split(FILENAME, p, "/"); id = p[n]; blk = 0 }
		/^---$/   { flush(); blk++; next }
		/^q:/     { if (q == "") { t = $0; sub(/^q: ?/, "", t); q = t } }
		END       { flush(); for (i in nq) print i, m[i] + 0, nq[i] }
	' "$CARDS" "$LEVELS"/* 2>/dev/null
}

# held_ids -- the levels whose every card is at tier 2 right now. cards_decay
# has already run at startup, so the tiers this reads are current by the time
# anything asks.
held_ids()      { held_scan | awk '$3 > 0 && $2 == $3 { print $1 }' | sort; }
level_is_held() { held_ids | grep -qxF -- "$1"; }
