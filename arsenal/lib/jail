# jail -- containment for the graded arsenal. base learn grades by RUNNING what
# you type and stays safe by dropping the answer to user `nobody` in a throwaway
# tree: root owns everything the answer must not touch, so plain file permissions
# refuse it. the xos stick console is root too, so the same wall works here -- the
# one extra job is that arsenal answers invoke CARRIED tools, which live on noexec
# p3. so the jail stages those tools onto an exec tmpfs, remounts it READ-ONLY
# (write-once -- the level-29 W^X contract holds), and runs the typed answer as
# nobody against a nobody-owned scratch. nobody can exec the staged tools and can
# write only its own scratch; the real encrypted home, the keys and the loot are
# root-owned and untouchable.
#
# on a normal-user dev host there is no root to drop from and no mount: the jail
# degrades to a plain scratch dir run as the current user -- exactly the DROP=""
# path base learn takes on its build host. real containment is proven on the
# stick (root), and on any root host via the selftest.
#
# proven 2026-09-23 on real root: a destructive typed answer cannot read or
# delete a root-owned secret, cannot write the read-only exec surface, and can
# write only its scratch; a staged static binary executes as nobody.

# the privilege-drop, chosen once. busybox ships setuidgid; util-linux setpriv
# and runit chpst are the fallbacks a dev host is likely to have.
JAIL_DROP=""
if [ "$(id -u 2>/dev/null)" = 0 ] && id nobody >/dev/null 2>&1; then
	if   command -v setuidgid >/dev/null 2>&1; then JAIL_DROP="setuidgid nobody"
	elif command -v setpriv   >/dev/null 2>&1; then JAIL_DROP="setpriv --reuid nobody --regid nobody --clear-groups"
	elif command -v chpst     >/dev/null 2>&1; then JAIL_DROP="chpst -u nobody"
	fi
fi

JAIL_BASE=""; JAIL_EXEC=""; JAIL_SCRATCH=""; JAIL_MOUNTED=0

# tree_spec NAME -- for a tool that ships as a directory tree (an interpreter +
# its stdlib + .so's, not one static binary), print "ENTRY|SHIM...": the path to
# run RELATIVE to the staged tree, and the command name(s) to expose on the jail
# PATH for it. this is the same tree-vs-binary knowledge arsenal's runline() holds
# for xexec (arsenal:24-35) -- the jail is a ported-apart lib and cannot source
# the launcher, so the handful of carried trees are named here too. empty = not a
# tree (stage as a single binary). only trees with a SAFE, target-free invocation
# are run-graded; sqlmap/impacket ride the python tree but need a live target, so
# they stay recognition-only and are not listed.
tree_spec() {
	case "$1" in
		python) echo "bin/python3|python python3" ;;
		cc)     echo "cc|cc" ;;
		*)      echo "" ;;
	esac
}

# jail_init [TOOL_PATH...] -- stand the jail up once. stages each tool onto an exec
# tmpfs (when root) and remounts it read-only; makes a nobody-owned scratch. a path
# to a regular file stages as a single binary; a path to a DIRECTORY stages as a
# tree (cp -a) and gets shim(s) on PATH per tree_spec -- so `python3 -c ...` runs
# the carried interpreter off the read-only surface exactly as a static tool does,
# nobody-dropped, W^X intact. safe to call with no tools (a file-only lesson needs
# none). staging a tree the host does not carry is a silent no-op (its card is then
# skipped by selftest, run recognition-only in a real session).
jail_init() {
	JAIL_BASE=$(mktemp -d "${TMPDIR:-/tmp}/arsjail.XXXXXX") || return 1
	chmod 755 "$JAIL_BASE"
	JAIL_EXEC="$JAIL_BASE/bin"; JAIL_SCRATCH="$JAIL_BASE/work"
	mkdir -p "$JAIL_EXEC" "$JAIL_SCRATCH"
	# size the exec tmpfs to the tools it must hold + margin: a single arsenal
	# binary can be 130+MB (nuclei) and a python tree ~280MB, and a fixed cap
	# silently truncated the copy so a late tool never staged and its card failed.
	# tmpfs size is a LIMIT, not a reservation -- only the bytes actually copied
	# cost RAM. 32MB floor + margin; a tree is measured whole with du.
	_sz=32
	for _t in "$@"; do
		if   [ -f "$_t" ]; then _sz=$(( _sz + ( $(wc -c < "$_t" 2>/dev/null || echo 0) / 1048576 ) + 1 ))
		elif [ -d "$_t" ]; then _sz=$(( _sz + ( $(du -sk "$_t" 2>/dev/null | cut -f1 || echo 0) / 1024 ) + 8 ))
		fi
	done
	if [ -n "$JAIL_DROP" ]; then
		mount -t tmpfs -o nosuid,nodev,size="${_sz}m" tmpfs "$JAIL_EXEC" 2>/dev/null && JAIL_MOUNTED=1
	fi
	for _t in "$@"; do
		_b=$(basename "$_t")
		if [ -f "$_t" ]; then
			cp "$_t" "$JAIL_EXEC/$_b" 2>/dev/null && chmod 755 "$JAIL_EXEC/$_b" \
				|| { echo "jail: failed to stage $_b" >&2; }
		elif [ -d "$_t" ]; then
			# a tree: copy it whole, then drop a shim per name it answers to. the
			# shim execs the real entrypoint by its absolute staged path, so the
			# interpreter derives its prefix from where it actually lives (a symlink
			# would break python's sys.prefix). skipped if this host lacks a spec.
			_spec=$(tree_spec "$_b"); [ -n "$_spec" ] || continue
			# stage under a hidden name so the tree dir never collides with a shim
			# of the same name (python tree vs the `python` shim, cc vs `cc`). PATH
			# lookup finds the shim files and ignores the dir.
			mkdir -p "$JAIL_EXEC/.$_b" && cp -a "$_t/." "$JAIL_EXEC/.$_b/" 2>/dev/null \
				|| { echo "jail: failed to stage tree $_b" >&2; continue; }
			_entry=${_spec%|*}; _shims=${_spec#*|}
			for _s in $_shims; do
				printf '#!/bin/sh\nexec "%s" "$@"\n' "$JAIL_EXEC/.$_b/$_entry" > "$JAIL_EXEC/$_s" \
					&& chmod 755 "$JAIL_EXEC/$_s" || echo "jail: failed to shim $_s" >&2
			done
		fi
	done
	# write-once -> W^X: the exec surface is read-only for the rest of the session.
	[ "$JAIL_MOUNTED" = 1 ] && mount -t tmpfs -o remount,ro,nosuid,nodev tmpfs "$JAIL_EXEC" 2>/dev/null
	[ -n "$JAIL_DROP" ] && chown nobody "$JAIL_SCRATCH" 2>/dev/null
	return 0
}

# jail_run ANSWER [SEEDFN] -- reset the scratch, optionally seed it (SEEDFN runs
# as root before the drop, cwd = the scratch), then run ANSWER as nobody inside
# it with the staged tools on PATH. prints combined stdout+stderr. a wrong answer
# that blocks on stdin can't hang the lesson (</dev/null, timeout).
jail_run() {
	_ans=$1; _seed=${2:-}
	rm -rf "$JAIL_SCRATCH" 2>/dev/null; mkdir -p "$JAIL_SCRATCH"
	[ -n "$_seed" ] && ( cd "$JAIL_SCRATCH" 2>/dev/null && "$_seed" )
	[ -n "$JAIL_DROP" ] && chown -R nobody "$JAIL_SCRATCH" 2>/dev/null
	( cd "$JAIL_SCRATCH" 2>/dev/null || exit 1
	  # shellcheck disable=SC2086
	  PATH="$JAIL_EXEC:$PATH" HOME="$JAIL_SCRATCH" TMPDIR="$JAIL_SCRATCH" \
	    timeout 10 $JAIL_DROP "${SHELLBIN:-/bin/sh}" -c "$_ans" </dev/null 2>&1 )
}

# jail_scratch -- absolute path of the writable scratch, for state: assertions.
jail_scratch() { printf '%s' "$JAIL_SCRATCH"; }

jail_teardown() {
	[ "$JAIL_MOUNTED" = 1 ] && umount -l "$JAIL_EXEC" 2>/dev/null
	[ -n "$JAIL_BASE" ] && rm -rf "$JAIL_BASE" 2>/dev/null
	JAIL_BASE=""; JAIL_MOUNTED=0
}
