     let mut file_count: usize = 0;
+    // Results still owed by worker threads: incremented when a job is handed to
+    // the pool, decremented when its result is received. The pool's own
+    // active_count() counts only jobs a worker has already dequeued, so a job
+    // still sitting in the pool's queue -- or a result sent after the worker
+    // went idle -- was invisible to the main loop, which then exited early and
+    // reported "Analyzed 0 files" with exit status 0 (ReFirmLabs/binwalk#971).
+    let mut pending_results: usize = 0;
     let run_time = time::Instant::now();
     let mut last_progress_interval = time::Instant::now();
 
@@ -148,7 +155,7 @@ fn main() {
      * Main loop.
      * Loop until all pending thread jobs are complete and there are no more files in the queue.
      */
-    while !target_files.is_empty() || workers.active_count() > 0 {
+    while !target_files.is_empty() || pending_results > 0 {
         // If there are files waiting to be analyzed and there is at least one free thread in the pool
         if !target_files.is_empty() && workers.active_count() < workers.max_count() {
             // Get the next file path from the target_files queue
@@ -164,6 +171,7 @@ fn main() {
                 cliargs.extract,
                 worker_tx.clone(),
             );
+            pending_results += 1;
         }
 
         // Don't spin CPU cycles if there is no backlog of files to analyze
@@ -187,6 +195,7 @@ fn main() {
         if let Ok(results) = worker_rx.try_recv() {
             // Keep a tally of how many files have been analyzed
             file_count += 1;
+            pending_results -= 1;
 
             // Log analysis results to JSON file
             json::log(&cliargs.log, json::JSONType::Analysis(results.clone()));
