#!/bin/sh
# xexec -- run carried code from an ephemeral exec surface that exists only
# while it runs. carried on p3 (encrypted, noexec) alongside the tools it
# launches; NOT part of the signed root, so the image's "nothing writable is
# executable" proof (learn 29) stays literally true.
#
#   sh ~/tools/xexec ~/tools/nmap -sn 10.0.0.0/24        # one static binary
#   sh ~/tools/xexec -t ~/tools/python bin/python3 x.py  # a whole tree
#
# noexec on p3 blocks execve on a file, so a carried binary cannot run and a
# python .so cannot be dlopen'd. `sh xexec` itself is fine -- the shell only
# READS the script. xexec stages what needs to execute onto a fresh exec tmpfs,
# flips it read-only (write-once: nothing new can be dropped in and run), runs
# it, and tears the mount down on exit. no writable+executable surface ever
# persists, and none survives between runs.
#
# -t DIR ENTRY: copy the whole DIR (an interpreter + its stdlib + .so's, say)
# onto the exec surface and run DIR-relative ENTRY there -- the tree mode that
# makes a carried python work. plain form copies a single binary. root required
# (mounting is); the console session is root.
set -u

die() { printf 'xexec: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || die "must be root (mounting the exec surface needs it)"
# the stick has no terminfo db: the carried ncurses tools (testdisk, photorec,
# dvtm) read the entries shipped beside this script. a caller's own wins.
case "$0" in */*) _here=${0%/*} ;; *) _here=. ;; esac
if [ -z "${TERMINFO:-}${TERMINFO_DIRS:-}" ] && [ -d "$_here/terminfo" ]; then
	TERMINFO_DIRS=$(cd "$_here/terminfo" && pwd) && export TERMINFO_DIRS
fi
# the stick ships no CA store, and python's static OpenSSL (sqlmap, impacket)
# looks for /etc/ssl/cert.pem which the signed root does not have -- so HTTPS
# and LDAPS verify fails and --insecure becomes the only way through. point the
# standard trust-store env at the bundle carried beside this script so TLS
# verifies. each var guarded on its OWN: a caller who set only CURL_CA_BUNDLE (an
# intercept proxy CA, say) must keep it, not have it clobbered. (Go tools carry
# their own roots.)
if [ -f "$_here/cacert.pem" ]; then
	_ca=$(cd "$_here" && pwd)/cacert.pem
	if [ -z "${SSL_CERT_FILE:-}" ];     then SSL_CERT_FILE=$_ca;     export SSL_CERT_FILE;     fi
	if [ -z "${CURL_CA_BUNDLE:-}" ];    then CURL_CA_BUNDLE=$_ca;    export CURL_CA_BUNDLE;    fi
	if [ -z "${REQUESTS_CA_BUNDLE:-}" ]; then REQUESTS_CA_BUNDLE=$_ca; export REQUESTS_CA_BUNDLE; fi
fi
# nmap reads its whole data set from $NMAPDIR: the service/port-frequency table
# (default top-1000 selection), nmap-service-probes (-sV), nmap-os-db +
# nmap-mac-prefixes (-O), and scripts/ + nselib/ + nse_main.lua (NSE --script).
# the stick carries them as a tree beside this script; without it those scans
# degrade or error (they found the data only on a dev host's /usr/share/nmap).
# caller wins.
if [ -z "${NMAPDIR:-}" ] && [ -d "$_here/nmapdata" ]; then
	NMAPDIR=$(cd "$_here/nmapdata" && pwd) && export NMAPDIR
fi
# libmagic auto-probes $HOME/.magic.mgc, but xexec may run with HOME=/root while
# provision dropped the db in the stick's own home -- so `file` would silently
# fall back to an empty magic set. point MAGIC at the carried db explicitly.
if [ -z "${MAGIC:-}" ] && [ -f "${HOME:-}/.magic.mgc" ]; then
	MAGIC="$HOME/.magic.mgc"; export MAGIC
fi

tree=0
if [ "${1:-}" = "-t" ]; then
	tree=1; shift
	[ "$#" -ge 2 ] || die "usage: xexec -t <dir> <relative-entrypoint> [args...]"
	src=$1; entry=$2; shift 2
	[ -d "$src" ] || die "no such dir: $src"
	# the entry runs from the SEALED copy, so it must name a path inside it:
	# a leading / or a .. would run something outside the surface this exists
	# to confine, with the surface's name on it.
	case "/$entry/" in */../*|//*) die "entrypoint must be a plain path inside $src (no leading / or ..)" ;; esac
	[ -f "$src/$entry" ] || die "no entrypoint $entry under $src"
else
	[ "$#" -ge 1 ] || die "usage: xexec <binary> [args...]   |   xexec -t <dir> <entry> [args...]"
	src=$1; shift
	[ -f "$src" ] || die "no such binary: $src"
fi

mp=$(mktemp -d "${TMPDIR:-/tmp}/.xexec.XXXXXX") || die "cannot make a mountpoint"
# a child the tool left behind keeps the surface busy; detach it then (the
# mount goes when the last user exits) and say so if even that fails -- an
# exec surface that quietly outlives its run is the one thing this must not do.
cleanup() {
	umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null \
		|| printf 'xexec: WARNING: exec surface %s is still mounted\n' "$mp" >&2
	rmdir "$mp" 2>/dev/null
}
trap cleanup EXIT INT TERM

# exec, but nosuid+nodev, size-capped so a runaway cannot eat RAM. a tree may
# be large (a python is ~100MB), so the cap scales to the payload plus slack.
cap=256
if [ "$tree" = 1 ]; then
	kb=$(du -sk "$src" 2>/dev/null | cut -f1); cap=$(( ${kb:-0} / 1024 + 128 ))
fi
mount -t tmpfs -o "nosuid,nodev,size=${cap}m" tmpfs "$mp" || die "cannot mount exec surface"

if [ "$tree" = 1 ]; then
	cp -a "$src/." "$mp/" || die "cannot stage tree"
	run="$mp/$entry"
else
	base=$(basename "$src")
	cp "$src" "$mp/$base" || die "cannot stage $base"
	chmod 0755 "$mp/$base" || die "cannot make $base runnable"
	run="$mp/$base"
fi

# write-once done: drop write, keep exec. the -t tmpfs ... tmpfs form is the one
# busybox mount and util-linux both honour for a tmpfs remount; a bare
# `-o remount,ro MP` fails under busybox.
mount -t tmpfs -o remount,ro,nosuid,nodev tmpfs "$mp" \
	|| die "cannot seal the exec surface read-only"

# a carried tree may ship the musl dynamic loader -- the python does: it is
# DYNAMIC against /lib/ld-musl-x86_64.so.1 and python-build-standalone does not
# bundle it. the fort deliberately has no /lib (and the kernel ships
# CONFIG_NAMESPACES=n, so there is no mount namespace to hide it in), so provide
# the loader GLOBALLY at /lib on an exec surface -- once, idempotent, left ro for
# the session so concurrent and repeat runs share it. the SIGNED image still
# carries no loader (only an empty /lib mountpoint), so its "no ld-musl"
# invariant holds; this surface is RAM-only and appears solely while the arsenal
# is in use. without it python (and sqlmap/impacket, which re-exec it) cannot
# execve at all on real hardware.
if [ "$tree" = 1 ] && [ -f "$mp/lib/ld-musl-x86_64.so.1" ] && [ ! -e /lib/ld-musl-x86_64.so.1 ]; then
	mount -t tmpfs -o nosuid,nodev,size=4m tmpfs /lib 2>/dev/null \
		&& cp "$mp/lib/ld-musl-x86_64.so.1" /lib/ld-musl-x86_64.so.1 \
		&& mount -t tmpfs -o remount,ro,nosuid,nodev,size=4m tmpfs /lib 2>/dev/null \
		|| die "cannot provide the musl loader at /lib"
fi

"$run" "$@"
rc=$?
exit "$rc"
