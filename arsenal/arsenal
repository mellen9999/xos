#!/bin/sh
# arsenal -- list what the arsenal can actually DO. run it on xos to see every
# carried tool, one line each, with how to run it. reads ~/tools/ (the truth: what
# is really here), annotates from arsenal-catalog, and cross-checks arsenal.lock so
# a tool that is attested-but-missing or present-but-unattested shows LOUD instead
# of hiding. p3 is noexec, so invoke as `sh ~/tools/arsenal` (or the `arsenal`
# shell alias provisioning installs).
#
# WHY THIS EXISTS: a capability nobody can find is the same as not having it. links,
# mutool, kiwix, frotz -- all were invisible until you already knew the name. this
# is the index so you don't have to.
set -u
T="${XOS_TOOLS:-$HOME/tools}"
[ -d "$T" ] || T=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)   # run from inside the dir
CAT="$T/arsenal-catalog"
LOCK="$T/arsenal.lock"
PLAY="$T/arsenal-playbook"

desc() {  # one-line description for $1 from the catalog, or a blank
  [ -f "$CAT" ] || { echo ""; return; }
  awk -F'\t' -v n="$1" '$1==n{ $1=""; sub(/^\t/,""); print; found=1 } END{ if(!found) print "" }' "$CAT"
}

# how a tool is invoked through xexec -- a static binary vs a python tree.
runform() {
  case "$1" in
    impacket) echo "sh ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/impacket/<tool>.py" ;;
    sqlmap)   echo "sh ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/sqlmap/sqlmap.py" ;;
    python)   echo "sh ~/tools/xexec -t ~/tools/python bin/python3" ;;
    cc)       echo "sh ~/tools/xexec -t ~/tools/cc cc" ;;
    atlas)    echo "sh ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/atlas" ;;
    view)     echo "sh ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/view" ;;
    qr)       echo "sh ~/tools/qr" ;;   # wraps qrencode through xexec itself -- no tree, no manual wrap
    *)        echo "sh ~/tools/xexec $1" ;;
  esac
}

show_chains() {  # the mission workflows, tools wired end-to-end
  [ -f "$PLAY" ] || { echo "no playbook at $PLAY -- run arsenal/provision.sh" >&2; return 1; }
  printf '=== arsenal chains ===  learn one end-to-end, not tool-by-tool\n'
  awk '
    /^# ==== TOOLS/ { exit }
    /^# ==== CHAINS/ { on=1; next }
    !on { next }
    /^:/ { line=$0; sub(/^:/,"",line); n=line; sub(/[ \t].*/,"",n)
           tag=line; sub(/^[^ \t]+[ \t]+/,"",tag)
           printf "\n-- %s --  %s\n", n, tag; next }
    /^\t/ { sub(/^\t/,"  "); print }
  ' "$PLAY"
  printf '\none tool: sh ~/tools/arsenal <name>\n'
}

show_tool() {  # one tool's canonical recipes
  [ -f "$PLAY" ] || { echo "no playbook at $PLAY -- run arsenal/provision.sh" >&2; return 1; }
  run=$(runform "$1")
  printf '%s -- %s\n' "$1" "$(desc "$1")"
  printf 'run:  %s ARGS\n\n' "$run"
  got=$(awk -F'\t' -v n="$1" '$1==n{ print "  "$2 }' "$PLAY")
  if [ -n "$got" ]; then printf '%s\n' "$got"
  else printf '  (no recipe yet -- try  %s -h)\n' "$run"; fi
}

case "${1:-}" in
  chains)  show_chains; exit $? ;;
  learn)   shift; exec sh "$T/learn" "$@" ;;    # the graded, from-zero school
  "")      ;;                                  # no arg -> the full listing below
  -h|--help) printf 'usage: arsenal            list every tool\n       arsenal learn      the graded, from-zero school\n       arsenal chains     the mission workflows\n       arsenal <tool>     that tool'\''s recipes\n'; exit 0 ;;
  *)       show_tool "$1"; exit $? ;;
esac

printf '=== xos arsenal ===  run:  ~/tools/xexec <name> [args]\n'
printf 'how to use it:  arsenal <name> (recipes)   arsenal chains (workflows)\n\n'
present=""
for f in "$T"/*; do
  [ -e "$f" ] || continue
  b=$(basename "$f")
  case "$b" in arsenal|arsenal.lock|arsenal-catalog|arsenal-playbook|xexec|learn|lib|pools|levels|phrases|atlas|view|canvas.py|qr) continue ;; esac
  present="$present $b "
  d=$(desc "$b")
  [ -n "$d" ] || d="(no description -- present, unattested by catalog)"
  printf '  %-13s %s\n' "$b" "$d"
done
[ -n "$present" ] || printf '  (nothing in %s -- run arsenal/provision.sh)\n' "$T"

# integrity: anything in the lock that is NOT on disk is a LOUD miss, not a shrug.
if [ -f "$LOCK" ]; then
  miss=""
  while read -r name _rest; do
    case "$name" in ''|'#'*) continue ;; esac
    # file's magic db rides beside file but installs to $HOME/.magic.mgc (where
    # libmagic auto-discovers it), not into tools/, so check it there.
    [ "$name" = file.mgc ] && { [ -f "$(dirname "$T")/.magic.mgc" ] || miss="$miss $name"; continue; }
    case "$present" in *" $name "*) ;; *) miss="$miss $name" ;; esac
  done < "$LOCK"
  [ -n "$miss" ] && printf '\n  ! attested in arsenal.lock but MISSING here:%s\n' "$miss"
fi

# python tools are pure .py run BY the carried interpreter: xexec stages the
# python tree (with its .so, incl impacket's deps) onto the exec surface, then
# runs the script off p3. the generic `xexec <name>` line above does not fit
# them, so spell the tree form out.
if [ -d "$T/python" ]; then
  printf '\npython tools (run via the carried interpreter):\n'
  [ -d "$T/sqlmap" ]   && printf '  sqlmap    ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/sqlmap/sqlmap.py -u TARGET\n'
  [ -d "$T/impacket" ] && printf '  impacket  ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/impacket/secretsdump.py -h   (70 tools in ~/tools/impacket/)\n'
fi

printf '\nreaders (offline knowledge):\n'
printf '  kiwix-serve  serve zims:  ~/tools/xexec kiwix-serve --port 8080 /run/media/*/XOS-KNOW/zim/*.zim  -> links http://localhost:8080\n'
printf '  mutool       read a pdf:  ~/tools/xexec mutool draw -F txt FILE.pdf | less\n'
printf '  links        browse the served zim or any html/http\n'
printf '  frotz        play interactive fiction:  ~/tools/xexec frotz /run/media/*/XOS-KNOW/games/if/spider-and-web.z5\n'
printf '  atlas        the world in characters:  ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/atlas\n'
printf '  view         a picture or pdf page in characters:  ~/tools/xexec -t ~/tools/python bin/python3 ~/tools/view FILE\n'

# wordlists/ and docs/ ride beside tools/ on p3, staged by build-wordlists.sh
# and build-docs.sh (never auto-populated like tools/ is from a lock, since
# these are optional). same loud-miss philosophy as the tool check above: a
# lock with nothing behind it is a bigger problem than no lock at all.
P3="$(dirname "$T")"
report_staged() {  # $1 label  $2 dir  $3 lock basename  $4 build script
  d="$2"; lock="$d/$3"
  has=""
  for e in "$d"/*; do
    [ -e "$e" ] || continue
    [ "$(basename "$e")" = "$3" ] && continue   # the lock itself doesn't count as content
    has=1; break
  done
  if [ -n "$has" ]; then
    printf '\n%s (%s):\n' "$1" "$(du -sh "$d" 2>/dev/null | cut -f1)"
    return 0
  elif [ -f "$lock" ]; then
    printf '\n%s:\n  ! %s present but %s is empty -- re-run arsenal/%s\n' "$1" "$3" "$d" "$4"
  fi
  return 1
}

if report_staged wordlists "$P3/wordlists" wordlists.lock build-wordlists.sh; then
  W="$P3/wordlists"
  printf '  ffuf -w %s/Discovery/Web-Content/common.txt -u https://TARGET/FUZZ\n' "$W"
  printf '  hydra -P %s/rockyou.txt ssh://TARGET\n' "$W"
fi

if report_staged docs "$P3/docs" docs.lock build-docs.sh; then
  D="$P3/docs"
  printf '  searchsploit <term>                     (%s/exploitdb)\n' "$D"
  printf '  man -M %s/man-pages-*/ <page>\n' "$D"
  printf '  grep -ril "<topic>" %s/rfcs/\n' "$D"
fi
