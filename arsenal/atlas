#!/usr/bin/env python3
# atlas -- offline vector map viewer. renders natural earth coastlines,
# borders, rivers, lakes and named places as CHARACTERS: braille subpixels
# where the terminal has utf8, '#' where it does not, down to a real vt320
# with zero CSI escapes. no raster, no tiles, no third-party library --
# xos is text-first with a serial console, so the map is text too.
#
# tier ladder mirrors learn/lib/ui's _ui_tier exactly (colour/mono/none by
# TERM, NO_COLOR, tty-ness) plus a second, separate question ui does not have
# to ask: whether the terminal is utf8, which is what braille needs. a real
# vt320 is mono AND not utf8 -- that combination is the whole reason this file
# has an ascii floor and not just a fallback string.
#
# data: $XOS_MAPS (default the XOS-KNOW stick's maps/), staged + pinned by
# arsenal/build-maps.sh. see arsenal/maps.lock for what is on the stick.
#
# tier detection, the palette and the subpixel canvas are the shared engine
# in xrender.py (also used by `view`) -- this file is geojson, projection,
# layers, cities/labels and the interactive loop, all of it map-specific.
import argparse, glob, gzip, json, os, sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from xrender import detect_tier, detect_utf8, Pal, Canvas

# --------------------------------------------------------------- data -----
def maps_dir():
    env = os.environ.get("XOS_MAPS")
    if env:
        return env
    for cand in sorted(glob.glob("/run/media/*/XOS-KNOW/maps")):
        if os.path.isdir(cand):
            return cand
    return "/run/media/*/XOS-KNOW/maps"

LAYER_FILES = {
    "coastline": "ne_{res}_coastline.geojson",
    "countries": "ne_{res}_admin_0_countries.geojson",
    "rivers":    "ne_{res}_rivers_lake_centerlines.geojson",
    "lakes":     "ne_{res}_lakes.geojson",
    "places":    "ne_{res}_populated_places.geojson",
}

_cache = {}
def load_layer(data_dir, res, layer):
    key = (res, layer)
    if key in _cache:
        return _cache[key]
    base = os.path.join(data_dir, LAYER_FILES[layer].format(res=res))
    for path in (base + ".gz", base):
        if os.path.exists(path):
            opener = gzip.open if path.endswith(".gz") else open
            with opener(path, "rt", encoding="utf-8") as f:
                d = json.load(f)
            _cache[key] = d["features"]
            return _cache[key]
    _cache[key] = []
    return []

def lines_of(features):  # LineString/MultiLineString -> list of coord lists
    out = []
    for f in features:
        g = f.get("geometry") or {}
        t, c = g.get("type"), g.get("coordinates")
        if t == "LineString":
            out.append(c)
        elif t == "MultiLineString":
            out.extend(c)
    return out

def rings_of(features):  # Polygon/MultiPolygon -> list of closed rings
    out = []
    for f in features:
        g = f.get("geometry") or {}
        t, c = g.get("type"), g.get("coordinates")
        if t == "Polygon":
            out.extend(c)
        elif t == "MultiPolygon":
            for poly in c:
                out.extend(poly)
    return out

def points_of(features):  # Point -> [(name, lon, lat, scalerank), ...]
    out = []
    for f in features:
        g = f.get("geometry") or {}
        if g.get("type") != "Point":
            continue
        lon, lat = g["coordinates"][0], g["coordinates"][1]
        p = f.get("properties") or {}
        name = p.get("NAMEASCII") or p.get("NAME") or ""
        rank = p.get("SCALERANK")
        if rank is None:
            rank = 9
        out.append((name, lon, lat, int(rank)))
    return out

def pick_res(bbox):
    w, s, e, n = bbox
    return "50m" if max(e - w, n - s) <= 25 else "110m"

# ------------------------------------------------------------ rendering ---
# priority, low to high -- a subpixel touched by two layers is coloured/typed
# by the more important one, but its BIT is set either way (braille shape is
# never lost to priority, only the character/colour choice is). keys are
# 1-based: 0 is Canvas's own "untouched" sentinel.
LAYER_KEY = {"border": 1, "water": 2, "coast": 3}
ASCII_CH  = {1: ".", 2: "~", 3: "#"}

def render(data_dir, cols, rows, bbox, tier, utf8):
    w0, s0, e0, n0 = bbox
    braille = utf8 and tier in ("mono", "colour")
    canvas = Canvas(cols, rows, braille)

    def project(lon, lat):
        x = (lon - w0) / (e0 - w0) * (canvas.W - 1)
        y = (n0 - lat) / (n0 - s0) * (canvas.H - 1)
        return x, y

    def draw_lines(coord_lists, key):
        for coords in coord_lists:
            for a, b in zip(coords, coords[1:]):
                (x0, y0), (x1, y1) = project(*a), project(*b)
                canvas.line(x0, y0, x1, y1, key)

    res = pick_res(bbox)
    draw_lines(rings_of(load_layer(data_dir, res, "countries")), LAYER_KEY["border"])
    draw_lines(lines_of(load_layer(data_dir, res, "rivers")), LAYER_KEY["water"])
    draw_lines(rings_of(load_layer(data_dir, res, "lakes")), LAYER_KEY["water"])
    draw_lines(lines_of(load_layer(data_dir, res, "coastline")), LAYER_KEY["coast"])

    pal = Pal(tier)
    layer_colour = {LAYER_KEY["border"]: pal.BORDER, LAYER_KEY["water"]: pal.WATER, LAYER_KEY["coast"]: pal.LAND}
    canvas.pack(ASCII_CH, layer_colour)
    grid, cell_colour = canvas.grid, canvas.cell_colour

    # cities: a final overlay pass, own glyph, never mixed into the line grid.
    span = max(e0 - w0, n0 - s0)
    max_rank = 2 if span > 120 else 4 if span > 60 else 6 if span > 20 else 9
    places = [p for p in points_of(load_layer(data_dir, res, "places"))
              if w0 <= p[1] <= e0 and s0 <= p[2] <= n0 and p[3] <= max_rank]
    places.sort(key=lambda p: p[3])
    seen_cells = set()
    marks = []  # (row, col, name)
    for name, lon, lat, rank in places:
        x = (lon - w0) / (e0 - w0) * (cols - 1)
        y = (n0 - lat) / (n0 - s0) * (rows - 1)
        cx, cy = int(x), int(y)
        if not (0 <= cx < cols and 0 <= cy < rows) or (cy, cx) in seen_cells:
            continue
        seen_cells.add((cy, cx))
        grid[cy][cx] = "+"
        cell_colour[cy][cx] = pal.MARK
        marks.append((cy, cx, name))

    # labels, budgeted: one to the right of its marker, only if it fits and
    # does not collide with a cell already written by a line or another label.
    written = {(r, c) for r in range(rows) for c in range(cols) if grid[r][c] != " "}
    for cy, cx, name in marks:
        start = cx + 1
        if start >= cols or not name:
            continue
        room = cols - start
        text = name if len(name) <= room else name[: max(room - 1, 0)]
        if not text or any((cy, start + k) in written and grid[cy][start + k] != " "
                            for k in range(len(text))):
            continue
        for k, ch in enumerate(text):
            grid[cy][start + k] = ch
            cell_colour[cy][start + k] = pal.CITY
            written.add((cy, start + k))

    return canvas.to_text(tier, pal.N)

# --------------------------------------------------------------- status ---
def status_line(center, span, tier, utf8, cols):
    lon, lat = center
    glyphs = "braille" if utf8 and tier in ("mono", "colour") else "ascii"
    s = f"atlas  {lon:.1f},{lat:.1f}  span {span:.0f}d  tier {tier}/{glyphs}"
    return s[:cols]

# ------------------------------------------------------------ interactive -
def term_speed(fd):
    try:
        import termios
        attrs = termios.tcgetattr(fd)
        ospeed = attrs[5]
        table = {}
        for n in (0, 50, 75, 110, 134, 150, 200, 300, 600, 1200, 1800, 2400,
                  4800, 9600, 19200, 38400, 57600, 115200, 230400):
            name = "B" + str(n)
            if hasattr(termios, name):
                table[getattr(termios, name)] = n
        return table.get(ospeed, 38400)
    except Exception:
        return 38400

def clamp(v, lo, hi):
    return max(lo, min(hi, v))

def bbox_from(center, span_lon, span_lat):
    lon, lat = center
    return (clamp(lon - span_lon / 2, -180, 180), clamp(lat - span_lat / 2, -90, 90),
            clamp(lon + span_lon / 2, -180, 180), clamp(lat + span_lat / 2, -90, 90))

def find_place(data_dir, query):
    query = query.strip().lower()
    if not query:
        return []
    hits = []
    for res in ("50m", "110m"):
        for name, lon, lat, rank in points_of(load_layer(data_dir, res, "places")):
            if query in name.lower():
                hits.append((name, lon, lat))
        if hits:
            break
    hits.sort(key=lambda h: (len(h[0]), h[0]))
    return hits

def interactive(data_dir, tier, utf8, csi):
    import termios, tty, select
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    slow = term_speed(fd) <= 19200
    cols, rows = 80, 24
    try:
        sz = os.get_terminal_size()
        cols, rows = min(sz.columns, 80), min(sz.lines - 1, 23)
    except OSError:
        pass
    center = [0.0, 20.0]
    span_lon, span_lat = 360.0, 156.0
    matches, match_i, query = [], -1, ""
    help_on = False

    def clear():
        if not csi:
            sys.stdout.write("\033H\033J")  # vt50/52 pre-ANSI clear
        else:
            sys.stdout.write("\033[H\033[2J")

    def draw():
        clear()
        bbox = bbox_from(center, span_lon, span_lat)
        if help_on:
            body = ("h/j/k/l pan   +/- zoom   / search   n/N next/prev match\n"
                    "g lon,lat goto   r reset   ? toggle help   q quit\n" + " " * cols)
            rows_shown = min(rows, body.count("\n") + 1)
            sys.stdout.write(body)
        else:
            sys.stdout.write(render(data_dir, cols, rows - 1, bbox, tier, utf8))
        sys.stdout.write("\n" + status_line(tuple(center), max(span_lon, span_lat), tier, utf8, cols))
        sys.stdout.flush()

    tty.setraw(fd)
    try:
        draw()
        while True:
            r, _, _ = select.select([fd], [], [], 1.0)
            if not r:
                continue
            ch = os.read(fd, 1).decode(errors="ignore")
            if ch == "q":
                break
            elif ch in "hjkl" or ch in ("\x1b",):
                if ch == "\x1b":
                    rest = os.read(fd, 2).decode(errors="ignore")
                    ch = {"[D": "h", "[B": "j", "[A": "k", "[C": "l"}.get(rest, "")
                step_lon, step_lat = span_lon * 0.2, span_lat * 0.2
                if ch == "h": center[0] = clamp(center[0] - step_lon, -180, 180)
                elif ch == "l": center[0] = clamp(center[0] + step_lon, -180, 180)
                elif ch == "k": center[1] = clamp(center[1] + step_lat, -90, 90)
                elif ch == "j": center[1] = clamp(center[1] - step_lat, -90, 90)
                else: continue
            elif ch in ("+", "="):
                span_lon, span_lat = max(span_lon * 0.6, 1.0), max(span_lat * 0.6, 0.5)
            elif ch in ("-", "_"):
                span_lon, span_lat = min(span_lon / 0.6, 360.0), min(span_lat / 0.6, 170.0)
            elif ch == "r":
                center, span_lon, span_lat = [0.0, 20.0], 360.0, 156.0
            elif ch == "?":
                help_on = not help_on
            elif ch == "/":
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
                sys.stdout.write("\n"); sys.stdout.flush()
                query = input("search: ")
                tty.setraw(fd)
                matches = find_place(data_dir, query)
                match_i = 0 if matches else -1
                if match_i >= 0:
                    center = [matches[0][1], matches[0][2]]
                    span_lon, span_lat = 20.0, 12.0
            elif ch in ("n", "N") and matches:
                match_i = (match_i + (1 if ch == "n" else -1)) % len(matches)
                center = [matches[match_i][1], matches[match_i][2]]
            elif ch == "g":
                termios.tcsetattr(fd, termios.TCSADRAIN, old)
                sys.stdout.write("\n"); sys.stdout.flush()
                try:
                    raw = input("goto lon,lat: ")
                    lon_s, lat_s = raw.split(",")
                    center = [clamp(float(lon_s), -180, 180), clamp(float(lat_s), -90, 90)]
                except (ValueError, EOFError):
                    pass
                tty.setraw(fd)
            else:
                continue
            # a slow line pays for every redraw in visible time: drain any
            # keys queued up behind this one (a held-down pan key, e.g.) and
            # only draw once the queue is empty, instead of once per key.
            if slow:
                while select.select([fd], [], [], 0)[0]:
                    os.read(fd, 1)
            draw()
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        sys.stdout.write("\n")

# ------------------------------------------------------------------ main --
def main():
    ap = argparse.ArgumentParser(prog="atlas", description="offline vector map viewer")
    ap.add_argument("place", nargs="?", help="centre on this place name")
    ap.add_argument("--render", action="store_true", help="single headless render to stdout")
    ap.add_argument("--cols", type=int, default=78)
    ap.add_argument("--rows", type=int, default=22)
    ap.add_argument("--bbox", help="W,S,E,N")
    ap.add_argument("--tier", choices=["auto", "none", "mono", "colour"], default="auto")
    grp = ap.add_mutually_exclusive_group()
    grp.add_argument("--utf8", dest="utf8", action="store_true", default=None)
    grp.add_argument("--no-utf8", dest="utf8", action="store_false")
    args = ap.parse_args()

    data_dir = maps_dir()
    if not os.path.isdir(data_dir):
        print(f"no map data -- run build-maps.sh (looked in {data_dir})", file=sys.stderr)
        return 1

    is_tty = sys.stdout.isatty()
    if args.tier == "auto":
        tier, csi = detect_tier(os.environ.get("TERM", "dumb"), bool(os.environ.get("NO_COLOR")), is_tty)
    else:
        tier, csi = args.tier, args.tier != "none"
    utf8 = args.utf8 if args.utf8 is not None else detect_utf8(os.environ)

    center = (0.0, 20.0)
    span = (360.0, 156.0)
    if args.place:
        hits = find_place(data_dir, args.place)
        if hits:
            center = (hits[0][1], hits[0][2])
            span = (20.0, 12.0)
        else:
            print(f"atlas: no place matching {args.place!r}", file=sys.stderr)

    if args.bbox:
        try:
            w, s, e, n = (float(v) for v in args.bbox.split(","))
            bbox = (w, s, e, n)
        except ValueError:
            print("atlas: --bbox wants W,S,E,N", file=sys.stderr)
            return 1
    else:
        bbox = bbox_from(center, *span)

    if args.render or not is_tty:
        shown_center = ((bbox[0] + bbox[2]) / 2, (bbox[1] + bbox[3]) / 2)
        print(render(data_dir, args.cols, args.rows, bbox, tier, utf8))
        print(status_line(shown_center, max(bbox[2] - bbox[0], bbox[3] - bbox[1]), tier, utf8, args.cols))
        return 0

    interactive(data_dir, tier, utf8, csi)
    return 0

if __name__ == "__main__":
    sys.exit(main())
