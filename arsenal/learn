#!/bin/sh
# learn -- the graded arsenal school: SRS cards, three-tier grading (text match /
# run-and-judge / state), answers run inside the jail (lib/jail) instead of base
# learn's nobody-sandbox. reuses base learn's engine where the shape is identical
# (blk_load, ask, run_level, boss_round -- see the fort's learn/learn) and drops
# what the fort has and p3 does not: no vi-mode line editor (lib/edit is fort-only)
# so input is a plain read, and a miss is graded and revealed at once rather than
# held open for retries -- as base learn's boss mode already does.
#
#   arsenal learn              the first mission
#   arsenal learn 04-web       that mission by name
#   arsenal learn 4            that mission by number
#   arsenal learn selftest     prove every card (runs each answer)
set -u

AROOT="${ARSENAL_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}"
ROOT="$AROOT"                 # lib/ctx reads pools/phrases off $ROOT, not $AROOT
REF="$AROOT/ref"              # may not exist yet -- flagnorm degrades gracefully
LEVELS="$AROOT/levels"
SHELLBIN=/bin/sh
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/arsenal-learn"
CARDS="$STATE/cards"
# which bosses have actually fallen (resume reads this to find the next
# mission), the mid-mission place ledger (one file per level), and the daily
# streak. same shapes as the fort's; see the ported helpers below.
PASSED="$STATE/passed"
INPROG="$STATE/inprogress"
DAILY="$STATE/daily"

die() { echo "learn: $*" >&2; exit 1; }

mkdir -p "$STATE" 2>/dev/null || die "cannot create $STATE"
mkdir -p "$LEVELS" 2>/dev/null || die "cannot create $LEVELS"

TMP=$(mktemp -d "${TMPDIR:-/tmp}/arslearn.XXXXXX") || die "cannot create tmp"
cleanup() {
	jail_teardown 2>/dev/null
	lab_down 2>/dev/null
	rm -rf "$TMP" 2>/dev/null
}
trap cleanup EXIT
trap '[ -t 0 ] && stty sane 2>/dev/null; cleanup; trap - EXIT; exit 130' INT
trap 'cleanup; trap - EXIT; exit 143' TERM

for _l in ui ctx cards coach jail grade lab; do
	[ -f "$AROOT/lib/$_l" ] || die "missing lib/$_l"
	. "$AROOT/lib/$_l"
done

ctx_init
cards_init
# rehome before decay (a reworded/moved card gets its review row back before
# the calendar erodes anything), then erode what has gone stale. no migrate:
# arsenal has no older on-disk schema to replay. matches learn/learn's launch.
cards_rehome
cards_decay

# where carried tool binaries live: on the stick they are in ~/tools (installed
# by provision), on a dev host they are staged in ~/.local/share/xos-arsenal.
# ARSENAL_BIN overrides. tool_path resolves a tool name to a binary, searching
# those and finally $PATH (so a busybox stand-in resolves in the sample level).
ARSENAL_BIN="${ARSENAL_BIN:-$HOME/tools:$HOME/.local/share/xos-arsenal}"
tool_path() {
	local d
	IFS=:
	for d in $ARSENAL_BIN; do
		[ -x "$d/$1" ] && { printf '%s\n' "$d/$1"; unset IFS; return 0; }
	done
	unset IFS
	command -v "$1" 2>/dev/null
}

# level_jail ID -- (re)build the jail for a level: tear the previous one down,
# resolve the level's `tools:` names to binaries, stage them onto the read-only
# exec tmpfs, and rebind SANDBOX to the fresh scratch. a level with no tools:
# stages nothing (busybox applets on PATH still work). lib/grade's check_state
# reads $SANDBOX; lib/jail calls the same tree $JAIL_SCRATCH -- binding here is
# the one introduction the two ported-apart libs need.
level_jail() {
	local t paths="" p spec
	jail_teardown 2>/dev/null
	lab_down 2>/dev/null
	# JAIL_MISSING names the level's tools: that this host has no binary for.
	# the stick (provision stages all of them) leaves it empty and selftest runs
	# every card for real; a dev host missing a carried tool cannot run-grade the
	# cards that use it, so selftest notes+skips those rather than failing on an
	# absence that is not a card bug. see selftest_graded's tier-2 block.
	JAIL_MISSING=""
	for t in $(level_field "$1" tools); do
		if p=$(tool_path "$t") && [ -n "$p" ]; then paths="$paths $p"
		else
			# a missing tree tool is invoked in cards by its shim name(s), not the
			# tools: name (python -> python3), so record those too or selftest's
			# absent-tool skip would miss them and FAIL on a host without the tree.
			spec=$(tree_spec "$t"); [ -n "$spec" ] && t="$t ${spec#*|}"
			JAIL_MISSING="$JAIL_MISSING $t"
		fi
	done
	# shellcheck disable=SC2086
	jail_init $paths || die "jail_init failed for $1"
	SANDBOX=$(jail_scratch)
	# stand up the loopback targets this level asks for (lab: web auth).
	# shellcheck disable=SC2086
	lab_ensure $(level_field "$1" lab) || note "lab: a target for $1 did not come up"
}

MODE=learn

# ---- levels -----------------------------------------------------------------
# the same header + `---`-block grammar as learn/levels/*, minus the fields
# only base learn's projects/scenarios ever used.
level_path()  { echo "$LEVELS/$1"; }
level_ids()   { ls -1 "$LEVELS" 2>/dev/null | sort; }
blk_field()   { sed -n "/^---$/q; s/^$2: \{0,1\}//p" "$1" 2>/dev/null; }   # FILE KEY
blocks_nq()   { awk '/^---$/ { c++ } END { print c + 0 }' "$1" 2>/dev/null; }
level_field() { blk_field "$(level_path "$1")" "$2"; }
level_nq()    { blocks_nq "$(level_path "$1")"; }
level_no()    { _n=${1%%-*}; echo "${_n#0}"; }

# resolve_level ARG -- a level id as typed ("01-recon"), or a bare number
# ("1") matched against the zero-padded prefix. echoes the id, or nothing.
resolve_level() {
	[ -f "$LEVELS/$1" ] && { printf '%s\n' "$1"; return 0; }
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	level_ids | grep "^$(printf '%02d' "$1")-" | head -1
}

# ---- progress ledgers -------------------------------------------------------
# ported from learn/learn: the passed ledger (which bosses have fallen) and the
# in-progress ledger (the cards a half-finished mission still owes). arsenal has
# no placement/act/scenario layer, so those halves are dropped -- everything
# below reads only $PASSED/$INPROG/$STATE and level_path/level_nq, all bound
# above. every write is a same-directory rename: the tether can cut power
# between a truncate and a write, and a half-written ledger is worse than none.
_ledger_add() { # FILE ID
	mkdir -p "$STATE" 2>/dev/null || return 0
	{ cat "$1" 2>/dev/null; echo "$2"; } | sort -u > "$1.tmp.$$" 2>/dev/null \
		&& mv "$1.tmp.$$" "$1" 2>/dev/null || rm -f "$1.tmp.$$" 2>/dev/null
	return 0
}
level_passed()    { _ledger_add "$PASSED" "$1"; inprog_clear "$1"; }
level_is_passed() { grep -qxF -- "$1" "$PASSED" 2>/dev/null; }
# the first mission whose boss has not yet fallen -- where a bare `arsenal
# learn` resumes, instead of always restarting at 01.
resume_target()   { for _id in $(level_ids); do level_is_passed "$_id" || { printf '%s\n' "$_id"; return 0; }; done; return 1; }

# one file per level, holding the cards it still owes you: quitting a mission
# mid-way used to reshuffle and re-ask the whole thing next run. one line,
# rewritten after each answer: <fingerprint> <right> <answered> <cards to ask>...
_inprog_file() { printf '%s.%s\n' "$INPROG" "$1"; }
# the level's CONTENT, not its name: an edited level renumbers its cards, and
# resuming into the old numbering would ask a card the file no longer has.
level_fp() { md5sum 2>/dev/null < "$(level_path "$1")" | cut -d' ' -f1; }
inprog_save() { # ID FP RIGHT ANSWERED REMAINING...
	local f; f=$(_inprog_file "$1"); shift
	mkdir -p "$STATE" 2>/dev/null || return 0
	printf '%s\n' "$*" > "$f.tmp.$$" 2>/dev/null \
		&& mv "$f.tmp.$$" "$f" 2>/dev/null || rm -f "$f.tmp.$$" 2>/dev/null
	return 0
}
inprog_clear() { rm -f "$(_inprog_file "$1")" 2>/dev/null; return 0; }
# sets INPROG_LEFT/RIGHT/DONE, or returns 1 with nothing to resume. every field
# is proved before any of it is believed -- a truncated, stale or hand-edited
# place starts the level over rather than indexing past its end.
inprog_load() { # ID FP NQ
	INPROG_LEFT=""; INPROG_RIGHT=0; INPROG_DONE=0
	local id=$1 fp=$2 nq=$3 f line n
	f=$(_inprog_file "$id")
	[ -f "$f" ] || return 1
	IFS= read -r line < "$f" 2>/dev/null || line=""
	set -f; set -- $line; set +f
	# three fields is a whole record: fingerprint, right, answered, nothing
	# owed -- the place a learner standing at the boss is in, and it has to load
	# or walking away from a boss costs the mission.
	[ $# -ge 3 ] && [ "$1" = "$fp" ] || { inprog_clear "$id"; return 1; }
	case "$2$3" in *[!0-9]*) inprog_clear "$id"; return 1 ;; esac
	INPROG_RIGHT=$2; INPROG_DONE=$3
	shift 3
	[ $(($# + INPROG_DONE)) -eq "$nq" ] && [ "$INPROG_RIGHT" -le "$INPROG_DONE" ] \
		|| { inprog_clear "$id"; return 1; }
	for n; do
		case "$n" in *[!0-9]*) inprog_clear "$id"; return 1 ;; esac
		[ "$n" -ge 1 ] && [ "$n" -le "$nq" ] || { inprog_clear "$id"; return 1; }
	done
	INPROG_LEFT="$*"
	return 0
}

# blk_load FILE INDEX -- ported from learn/learn:405 (blk_load). fills
# Q_ANSWERS/Q_OUT/Q_STATE/Q_STATUS/Q_REF/Q_CMP/Q_HINT/Q_PROMPT the same way;
# Q_TPL/Q_PROMPT_HI are the unrendered template and the marked-up render,
# same roles as the fort. dropped: Q_REFS/Q_SETUP/Q_PREDICT and every
# project: field -- nothing here uses them yet.
#
# added: Q_SEED and the SEEDFN wiring (not in base learn -- base learn's
# fixtures build one generic pool-driven tree for every question; arsenal's
# jail has no such tree, so a card that needs one describes it itself). a
# `seed:` line is shell code, rendered with render_tokens (no {a|b|c} pick,
# no HI marks -- it is never shown, only run), and every seed: line in a
# block joins into one script, same way multiple brief: lines join into one
# paragraph. blk_load wraps that script in a shell function and points the
# global SEEDFN at it; jail_run (lib/jail) already knows how to call SEEDFN
# -- runs it as root, before the drop, cwd = the scratch -- so this is pure
# wiring, no change to jail or grade. a card with no seed: sets SEEDFN empty,
# which jail_run also already treats as "nothing to seed".
blk_load() {
	local blk seed
	roll
	seed=$(( RANDOM + $2 ))

	blk="$TMP/blk"
	awk -v n="$2" 'BEGIN { c = 0 } /^---$/ { c++; next } c == n' "$1" > "$blk"

	Q_TPL=$(sed -n 's/^q: \{0,1\}//p' "$blk")
	Q_PROMPT_HI=$(printf '%s\n' "$Q_TPL" | fence | render_named "$seed")
	Q_PROMPT=$(printf '%s\n' "$Q_PROMPT_HI" | hi_strip | lit_strip)
	Q_ANSWERS=$(sed -n 's/^a: \{0,1\}//p' "$blk" | render "$seed")
	Q_OUT=$(sed -n 's/^out: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	Q_STATE=$(sed -n 's/^state: \{0,1\}//p' "$blk" | render "$seed" | head -1)
	Q_STATUS=$(sed -n 's/^status: \{0,1\}//p' "$blk" | head -1)
	Q_REF=$(sed -n 's/^ref: \{0,1\}//p' "$blk" | head -1)
	Q_CMP=$(sed -n 's/^cmp: \{0,1\}//p' "$blk" | head -1)
	Q_HINT=$(sed -n 's/^hint: \{0,1\}//p' "$blk" | render_named "$seed" | head -1)

	Q_SEED=$(sed -n 's/^seed: \{0,1\}//p' "$blk" | render_tokens)

	# inject the live lab address. the servers get a fresh loopback port each
	# run, so the target can only be a token the card carries -- @url@/@port@ for
	# the web target, @aurl@/@aport@ for the auth target -- filled here from the
	# lab vars (empty when no lab is up; a non-lab card has no such token, so
	# this is a no-op for it). # is the sed delimiter: a url has slashes.
	_ls="s#@weburl@#${LAB_URL}#g;s#@authurl@#${LAB_AURL}#g;s#@webport@#${LAB_PORT}#g;s#@authport@#${LAB_APORT}#g"
	Q_PROMPT_HI=$(printf '%s' "$Q_PROMPT_HI" | sed "$_ls")
	Q_PROMPT=$(printf '%s' "$Q_PROMPT" | sed "$_ls")
	Q_ANSWERS=$(printf '%s\n' "$Q_ANSWERS" | sed "$_ls")
	Q_OUT=$(printf '%s' "$Q_OUT" | sed "$_ls")
	Q_HINT=$(printf '%s' "$Q_HINT" | sed "$_ls")
	Q_SEED=$(printf '%s' "$Q_SEED" | sed "$_ls")

	if [ -n "$Q_SEED" ]; then
		eval "_card_seed() {
$Q_SEED
}"
		SEEDFN=_card_seed
	else
		SEEDFN=
	fi

	[ -n "$Q_PROMPT" ]
}

# ---- the question loop --------------------------------------------------
# ported from learn/learn:481 (ask), cut down to one attempt per card: no vi
# editor here (lib/edit is fort-only), so there is no in-place "wipe the wrong
# line and try again" -- a miss is graded, diagnosed and revealed immediately,
# same as base learn's boss/daily modes already do on a miss. `?`/`hint`
# before answering still opens the hint line; there is no reference panel
# (REF may not exist for arsenal yet).
ask() {   # ask LEVEL INDEX ; returns 0 right, 1 wrong, 2 quit
	local key input rc _m
	blk_load "$(level_path "$1")" "$2" || return 1
	key=$(card_key "$1" "$2" "$Q_TPL")

	printf '  %s\n' "$(printf '%s' "$Q_PROMPT_HI" | hi_expand | lit_expand)"
	[ "$MODE" = learn ] && note "? hint"

	while :; do
		printf '%s%s%s ' "$W" "$PROMPT_CH" "$N"
		if [ "$MODE" = boss ]; then
			IFS= read -r -t "$BOSS_LIMIT" input; rc=$?
			if [ "$rc" != 0 ]; then
				echo
				no "out of time."
				reveal "$(printf '%s\n' "$Q_ANSWERS" | head -1)"
				card_grade "$key" 0
				return 1
			fi
		else
			IFS= read -r input || return 2
		fi

		case "$input" in
			quit) return 2 ;;
			'')   continue ;;
			'?'|hint)
				if [ "$MODE" != learn ]; then
					note "no hints under the clock."
				elif [ -n "${Q_HINT:-}" ]; then
					note "$(printf '%s' "$Q_HINT" | hi_expand "$D")"
				else
					note "no hint for this one."
				fi
				continue ;;
		esac
		break
	done

	if correct "$input"; then
		card_grade "$key" 1
		# the card's SRS mastery after this pass -- NOT which grading tier it took.
		# 2 = mastered (held), 1 = learning, 0/unseen = just start.
		case $(card_tier "$key") in
			2) _m="  ${D}mastered${N}" ;;
			1) _m="  ${D}learning${N}" ;;
			*) _m= ;;
		esac
		ok "correct${_m}"
		[ "$MODE" = learn ] && coach_right "$input" 2>/dev/null
		return 0
	fi

	card_grade "$key" 0
	no "wrong"
	[ "$MODE" = learn ] && coach_miss "$input" 2>/dev/null
	reveal "$(printf '%s\n' "$Q_ANSWERS" | head -1)"
	return 1
}

# pick COUNT distinct numbers from 1..MAX, in random order -- verbatim from
# learn/learn:642.
shuffle_n() {
	seq 1 "$1" | awk -v s="$RANDOM" 'BEGIN { srand(s) } { print rand() "\t" $0 }' |
		sort -n | cut -f2 | head -n "$2"
}

boss_limit() { echo $(( 30 + $(level_no "$1") / 3 )); }

# boss_round ID -- five questions from the level just finished, no hints,
# four of five to pass. ported from learn/learn:651, cut down the same way
# ask() was: no splash-screen clock ticker (that lives in lib/edit), just a
# plain timed read per question via ask()'s own boss branch.
boss_round() {
	local id=$1 bname nq n right=0 asked=0 rc k=0
	bname=$(level_field "$id" boss)
	nq=$(level_nq "$id")
	[ -n "$bname" ] || { note "level $id has no boss -- skipping"; return 0; }
	[ "$nq" -ge 5 ] || { note "level $id has $nq questions -- a boss needs 5"; return 0; }

	BOSS_LIMIT=$(boss_limit "$id")
	cls
	hdr "BOSS: $bname" "no hints  ${BOSS_LIMIT}s each  pass: 4 of 5"
	level_field "$id" flavor | say
	pause_card || return 2

	MODE=boss
	for n in $(shuffle_n "$nq" 5); do
		k=$((k + 1))
		cls
		statusbar "BOSS: $bname" "no hints" "$k" 5 "$right"
		ask "$id" "$n"; rc=$?
		[ "$rc" = 2 ] && { MODE=learn; return 2; }
		[ "$rc" = 0 ] && right=$((right + 1))
		asked=$((asked + 1))
		pause_card || { MODE=learn; return 2; }
	done
	MODE=learn

	cls
	if [ "$right" -ge 4 ]; then
		statusbar "BOSS: $bname" "defeated" "$right" 5 ""
		printf '\n  %s%s falls.%s  %s of %s.\n' "$G$B" "$bname" "$N" "$right" "$asked"
		return 0
	fi
	statusbar "BOSS: $bname" "held" "$right" 5 ""
	no "$bname holds. $right of 5 -- need 4."
	return 1
}

# run_level ID -- ported from learn/learn:707, cut down: no act overlay, no
# scenario/project unlocks (arsenal has none). the in-progress ledger and the
# boss-fall -> passed write ARE kept: a half-finished mission resumes at the
# cards it still owes, and a mission whose boss falls is recorded so a bare
# `arsenal learn` moves on to the next one.
run_level() {
	local id=$1 nq i k right=0 total=0 rc lname lsub fp order rest
	nq=$(level_nq "$id")
	[ "$nq" -gt 0 ] || { note "level $id has no questions yet"; return 0; }
	lname=$(level_field "$id" name)
	lsub="level $(level_no "$id")"
	fp=$(level_fp "$id")
	level_jail "$id"

	# a resumed mission keeps its order and its score and goes straight to the
	# cards still owed; a fresh one shuffles and teaches the brief first.
	if inprog_load "$id" "$fp" "$nq"; then
		order=$INPROG_LEFT; right=$INPROG_RIGHT; total=$INPROG_DONE
		lsub="$lsub  resumed"
	else
		cls
		hdr "$lname" "$lsub  ${nq} questions"
		level_field "$id" brief | say
		pause_card || return 2
		order=$(shuffle_n "$nq" "$nq")
	fi
	k=$total
	inprog_save "$id" "$fp" "$right" "$total" $order

	while :; do
		set -f; set -- $order; set +f
		[ $# -gt 0 ] || break
		i=$1; shift; rest="$*"
		k=$((k + 1))
		cls
		statusbar "$lname" "$lsub" "$k" "$nq" "$right"
		ask "$id" "$i"; rc=$?
		# quitting mid-card leaves it owed: the place on disk still has it at
		# the head, because it was never answered.
		[ "$rc" = 2 ] && return 2
		[ "$rc" = 0 ] && right=$((right + 1))
		total=$((total + 1))
		order=$rest
		inprog_save "$id" "$fp" "$right" "$total" $order
		pause_card || return 2
	done
	# keep the record in its terminal shape -- everything answered, nothing
	# owed -- so a boss walked away from resumes AT the boss, not the whole
	# mission. level_passed (on a win) is the only thing that clears it.
	inprog_save "$id" "$fp" "$right" "$total"

	cls
	statusbar "$lname" "$lsub" "$total" "$nq" "$right"
	printf '\n  %s%s/%s%s\n' "$B" "$right" "$total" "$N"
	echo

	boss_round "$id"; rc=$?
	[ "$rc" = 0 ] && level_passed "$id"
	return "$rc"
}

# review [N] -- the due cards (soonest first), or the weakest when nothing is
# due, N at a time. ported from learn/learn:852, minus the scenario branch:
# every arsenal key is a plain <level>/<idx>#<template>. the one thing base
# learn's review never had to do -- restage the jail when the queue crosses
# into a new level -- arsenal must, because a level's tools are staged once per
# level, not per answer; without it a run-graded card from one mission would be
# judged in another mission's jail.
review() {
	local n=${1:-20} line key lvl rest idx rc sub=due nc k=0 seenlvl=
	[ -s "$CARDS" ] || { note "no cards yet -- answer some missions first"; return 0; }
	cards_due | head -n "$n" > "$TMP/rev"
	nc=$(grep -c . "$TMP/rev")
	if [ "$nc" -eq 0 ]; then
		sub=weakest
		note "nothing due -- the weakest cards instead."
		cards_sort_weak < "$CARDS" | head -n "$n" > "$TMP/rev"
		nc=$(grep -c . "$TMP/rev")
	fi
	[ "$nc" -gt 0 ] || { note "nothing to review."; return 0; }
	# the list is read on fd 3 because ask() owns stdin.
	while IFS= read -r line <&3; do
		key=$(printf '%s\n' "$line" | cut -f1)
		lvl=${key%%/*}; rest=${key#*/}; idx=${rest%%#*}
		[ -f "$(level_path "$lvl")" ] || continue
		# a card whose template no longer matches its block is stale -- the file
		# was edited since. skip it rather than ask the wrong thing. rebuild the
		# key through card_key and compare whole keys: the stored tpl is already
		# card_key's backtick/tab-stripped form, so comparing Q_TPL raw would
		# call every marked-up card stale and skip it. (only Q_TPL is read here,
		# which is roll-independent, so the pre-jail load is safe.)
		blk_load "$(level_path "$lvl")" "$idx" >/dev/null 2>&1 || continue
		[ "$(card_key "$lvl" "$idx" "$Q_TPL")" = "$key" ] || continue
		# restage the jail on entering a new level (see the header note).
		[ "$lvl" = "$seenlvl" ] || { level_jail "$lvl"; seenlvl=$lvl; }
		k=$((k + 1))
		cls
		statusbar "review" "$sub" "$k" "$nc" ""
		ask "$lvl" "$idx"; rc=$?
		[ "$rc" = 2 ] && return 0
		pause_card || return 0
	done 3< "$TMP/rev"
}

# daily -- one card from the top third of the curriculum, under boss rules (no
# hints, the clock), the same one for everybody on a given UTC day. ported from
# learn/learn:944; keeps the day-streak ledger. like review it stages the jail
# itself -- nothing upstream did.
daily() {
	local day nl lo lvl nq idx rc
	# label and seed must agree on "today": date +%s is UTC seconds regardless
	# of TZ, so the label goes UTC too or the same-one-everywhere claim breaks
	# for anyone west of UTC after 5pm.
	day=$(date -u +%Y-%m-%d 2>/dev/null || echo today)
	RANDOM=$(( $(date +%s 2>/dev/null || echo 0) / 86400 ))
	nl=$(level_ids | grep -c .)
	[ "$nl" -gt 0 ] || { no "no missions yet."; return 1; }
	lo=$(( nl * 2 / 3 ))
	# draw in THIS shell: a subshell re-seeds RANDOM from its own pid.
	rnd $(( nl - lo )); lvl=$(level_ids | sed -n "$(( lo + REPLY + 1 ))p")
	nq=$(level_nq "$lvl")
	[ "$nq" -gt 0 ] || { no "no daily today: $lvl has no questions."; return 1; }
	rnd "$nq"; idx=$((REPLY + 1))
	BOSS_LIMIT=$(boss_limit "$lvl")
	level_jail "$lvl"
	cls
	statusbar "daily" "$day  no hints" 1 1 ""
	MODE=boss
	ask "$lvl" "$idx"; rc=$?
	MODE=learn
	[ "$rc" = 2 ] && return 0
	# a persistent day-streak, keyed on the UTC day NUMBER so there is no
	# date-string math. the first daily of a new day advances or breaks it;
	# re-opening the same day just shows what stands.
	local dnum lastd dstreak dbest
	dnum=$(( $(date +%s 2>/dev/null || echo 0) / 86400 ))
	[ -f "$DAILY" ] && read -r lastd dstreak dbest < "$DAILY" 2>/dev/null || true
	lastd=${lastd:-0}; dstreak=${dstreak:-0}; dbest=${dbest:-0}
	if [ "$lastd" != "$dnum" ]; then
		if [ "$rc" = 0 ]; then
			[ "$lastd" = "$((dnum - 1))" ] && dstreak=$((dstreak + 1)) || dstreak=1
		else
			dstreak=0
		fi
		[ "$dstreak" -gt "$dbest" ] && dbest=$dstreak
		mkdir -p "$STATE" 2>/dev/null || true
		printf '%s %s %s\n' "$dnum" "$dstreak" "$dbest" > "$DAILY.tmp.$$" 2>/dev/null \
			&& mv "$DAILY.tmp.$$" "$DAILY" 2>/dev/null || rm -f "$DAILY.tmp.$$" 2>/dev/null
	fi
	rule
	printf '  %sdaily %s%s  %s%s\n' "$B" "$day" "$N" \
		"$([ "$rc" = 0 ] && echo correct || echo wrong)" \
		"$([ "$dstreak" -ge 2 ] && printf '  %s%s-day streak%s' "$G" "$dstreak" "$N")"
	pause_card || return 0
}

# selftest -- the authoring net. for every card: it renders, it has an answer
# and a hint, and its OWN first listed answer grades correct (so a broken
# out:/state:/seed/ref is caught the moment it is written). bosses are unique and
# a bossed level has >=5 questions. tier-2 cards run their answer -- as nobody on
# the stick (root), as the current user on a dev host (JAIL_DROP=""); either way
# the output/state is judged, so a card that cannot pass itself fails the build.
# runs nothing interactive.
selftest_graded() {
	local id nq i first bad=0 b bosses="" total _skip _m
	for id in $(level_ids); do
		nq=$(level_nq "$id")
		[ "$nq" -gt 0 ] || { echo "FAIL $id: no questions"; bad=$((bad + 1)); continue; }
		b=$(level_field "$id" boss)
		[ -n "$b" ] || { echo "FAIL $id: no boss"; bad=$((bad + 1)); }
		case " $bosses " in *" $b "*) echo "FAIL $id: duplicate boss '$b'"; bad=$((bad + 1)) ;; esac
		bosses="$bosses $b"
		[ "$nq" -ge 5 ] || echo "note $id: $nq question(s) -- a boss needs 5"
		level_jail "$id"
		i=1
		while [ "$i" -le "$nq" ]; do
			if ! blk_load "$(level_path "$id")" "$i"; then
				echo "FAIL $id/$i: blk_load"; bad=$((bad + 1)); i=$((i + 1)); continue
			fi
			[ -n "$Q_ANSWERS" ] || { echo "FAIL $id/$i: no answer"; bad=$((bad + 1)); }
			[ -n "$Q_HINT" ]    || { echo "FAIL $id/$i: no hint"; bad=$((bad + 1)); }
			first=$(printf '%s\n' "$Q_ANSWERS" | head -1)
			# self-consistency: the listed answer must grade correct (tier 1 path
			# + the anti-cheat: proves ref: names a command the answer invokes).
			if [ -n "$first" ] && ! correct "$first"; then
				echo "FAIL $id/$i: own answer does not grade correct -- '$first'"; bad=$((bad + 1))
			fi
			# tier-2 TRUTH: a listed answer matches tier 1 by text alone, so that
			# never exercises out:/state:/tools. run the answer for real and hold
			# its observable against the assertion -- this is what proves the
			# fixture seed, the staged tool and the regex are actually right.
			_skip=""
			for _m in ${JAIL_MISSING:-}; do
				case " $first " in *" $_m "*|*"/$_m "*|*"$_m;"*|*"$_m|"*) _skip=$_m ;; esac
			done
			if [ -n "${Q_OUT:-}${Q_STATE:-}${Q_STATUS:-}" ] && [ -n "$first" ] && [ -n "$_skip" ]; then
				echo "note $id/$i: skip run-grade -- '$_skip' not on this host"
			elif [ -n "${Q_OUT:-}${Q_STATE:-}${Q_STATUS:-}" ] && [ -n "$first" ]; then
				_g=$(run_answer "$first"); _rc=$?
				[ -z "${Q_OUT:-}" ]    || printf '%s\n' "$_g" | grep -qE -- "$Q_OUT" \
					|| { echo "FAIL $id/$i: out:/$Q_OUT/ does not match what '$first' prints"; bad=$((bad + 1)); }
				[ -z "${Q_STATE:-}" ]  || check_state "$Q_STATE" "$_g" \
					|| { echo "FAIL $id/$i: state:$Q_STATE not true after '$first'"; bad=$((bad + 1)); }
				[ -z "${Q_STATUS:-}" ] || [ "$_rc" = "$Q_STATUS" ] \
					|| { echo "FAIL $id/$i: status:$Q_STATUS but '$first' exited $_rc"; bad=$((bad + 1)); }
			fi
			i=$((i + 1))
		done
	done
	# ---- the SRS wiring, not just card content -------------------------------
	# the ledger these missions write must also be READ back: promoted, decayed,
	# queued, rehomed, resumed. base learn proves this in its own selftest;
	# arsenal wires the same engine, so it proves it the same way, in isolated
	# state, so a broken launch hook or a lost resume fails the build too.
	local _n _was _tab _first _fp _nq _rem _i _k
	_n=$(now); _tab=$(printf '\t')
	( CARDS="$TMP/sc"; SESSION_SEEN="$TMP/ss"; : > "$CARDS"; : > "$SESSION_SEEN"
	  # mastery is two sittings, and a mastered card is not due today
	  card_grade k 1; : > "$SESSION_SEEN"; card_grade k 1
	  [ "$(cut -f2 "$CARDS")" = 2 ] || exit 1
	  [ "$(cards_ndue)" = 0 ]       || exit 1
	  # a row long past due by more than the grace window loses a rung, once
	  printf 'k\t2\t%s\t%s\t7\t2\t0\n' "$_n" "$((_n - 30 * 86400))" > "$CARDS"
	  cards_decay; [ "$(cut -f2 "$CARDS")" = 1 ] || exit 1
	  _was=$(cat "$CARDS"); cards_decay; [ "$(cat "$CARDS")" = "$_was" ] || exit 1
	) || { echo "FAIL srs: grade/decay/ndue"; bad=$((bad + 1)); }

	# cards_rehome carries a moved card's reviews to its new block/template.
	( STATE="$TMP/rst"; ROOT="$TMP/rhm"; LEVELS="$ROOT/levels"; KEYS="$TMP/rhm.keys"
	  CARDS="$STATE/cards"; mkdir -p "$STATE" "$LEVELS"; rm -f "$KEYS"
	  printf 'name: t\n---\nq: alpha\n---\nq: `beta` new\n---\nq: held\n' > "$LEVELS/zz-t"
	  printf '# c\nzz-t\tbeta old\tbeta new\n' > "$ROOT/rekeys"
	  printf 'zz-t/9#alpha\t2\t1\nzz-t/8#beta old\t1\t1\n' > "$CARDS"
	  cards_rehome
	  grep -q "^zz-t/1#alpha${_tab}2${_tab}1$" "$CARDS" || exit 1
	  grep -q "^zz-t/2#beta new${_tab}1${_tab}1$" "$CARDS" || exit 1
	) || { echo "FAIL srs: cards_rehome"; bad=$((bad + 1)); }

	# the in-progress ledger round-trips, and resume_target skips a passed level.
	_first=$(level_ids | head -1)
	if [ -n "$_first" ]; then
		_fp=$(level_fp "$_first"); _nq=$(level_nq "$_first")
		_rem=$(seq 2 "$_nq" | tr '\n' ' ')
		( STATE="$TMP/rest"; PASSED="$STATE/passed"; INPROG="$STATE/inprogress"; mkdir -p "$STATE"
		  # shellcheck disable=SC2086
		  inprog_save "$_first" "$_fp" 1 1 $_rem
		  inprog_load "$_first" "$_fp" "$_nq" || exit 1
		  [ "$INPROG_RIGHT" = 1 ] && [ "$INPROG_DONE" = 1 ] || exit 1
		  level_passed "$_first"
		  [ ! -f "$INPROG.$_first" ] || exit 1            # passing clears the place
		  [ "$(resume_target)" != "$_first" ] || exit 1   # and resume moves past it
		) || { echo "FAIL srs: inprog/resume round-trip"; bad=$((bad + 1)); }

		# review must ASK a marked-up card, not skip it as stale. the stored key
		# is card_key's backtick-stripped form, so a raw-template compare would
		# call every ``name``-marked card stale. seed a due row for a real
		# backtick card and prove review renders it (the '? hint' line only
		# prints once a card is on screen).
		_i=1
		while [ "$_i" -le "$_nq" ]; do
			blk_load "$(level_path "$_first")" "$_i" >/dev/null 2>&1 && case "$Q_TPL" in *'`'*) break ;; esac
			_i=$((_i + 1))
		done
		if [ "$_i" -le "$_nq" ]; then
			( STATE="$TMP/revst"; CARDS="$STATE/cards"; SESSION_SEEN="$TMP/revst.seen"; mkdir -p "$STATE"
			  _k=$(card_key "$_first" "$_i" "$Q_TPL")
			  printf '%s\t1\t%s\t%s\t1\t1\t0\n' "$_k" "$(now)" "$(( $(now) - 86400 ))" > "$CARDS"
			  printf 'quit\n' | review 1 2>&1 | grep -q '? hint'
			) || { echo "FAIL srs: review skips a backtick card (stale-check too strict)"; bad=$((bad + 1)); }
		fi
	fi

	total=$(level_ids | grep -c .)
	echo "selftest: $total level(s), $bad problem(s)"
	[ "$bad" = 0 ]
}

# lint -- the authoring ledger, reported never gated (a hard gate on wording
# breeds filler, same call base learn made). single-phrasing and same-words say
# whether a card can be memorised as a fixed string; unnamed-token whether the
# answer needs a @token@ the prompt never shows (a lab @...port@ counts as named
# when its @...url@ sibling is, since the url embeds the port); ungraded counts
# the recognition-only cards (no safe local target), hintless the ones with no
# hint. runs nothing, reads only the level files.
lint_report() {
	awk '
		function norm(b,  x){ x=b; gsub(/`[^`]*`/,"",x); gsub(/@[a-z]+@/,"",x); gsub(/%[a-z]+%/,"",x); gsub(/[^a-zA-Z ]/," ",x); return tolower(x) }
		function named(tk, q, hint,  sib){
			if(index(q,tk)||index(hint,tk)) return 1
			if(tk ~ /port@$/){ sib=tk; sub(/port@$/,"url@",sib); if(index(q,sib)||index(hint,sib)) return 1 }
			return 0
		}
		BEGIN{ RS="\n---\n" }
		/(^|\n)q:/{
			q=""; a=""; hint=""; graded=0
			n=split($0,L,"\n")
			for(i=1;i<=n;i++){
				if(L[i]~/^q: /){ t=L[i]; sub(/^q: ?/,"",t); q=(q==""?t:q" "t) }
				else if(L[i]~/^a: /&&a==""){ a=L[i]; sub(/^a: ?/,"",a) }
				else if(L[i]~/^hint:/)hint=L[i]
				else if(L[i]~/^(out|state|status):/)graded=1
			}
			if(q=="")next
			cards++
			if(hint=="")hl++
			if(!graded)ung++
			if(q !~ /\{[^{}]*\|[^{}]*\}/)single++
			line=q
			while(match(line,/\{[^{}]*\|[^{}]*\}/)){ inner=substr(line,RSTART+1,RLENGTH-2); line=substr(line,RSTART+RLENGTH)
				nb=split(inner,br,"|")
				for(i=1;i<nb;i++)for(j=i+1;j<=nb;j++){
					delete S; np=split(norm(br[j]),P," "); for(x=1;x<=np;x++)if(P[x]!="")S[P[x]]=1
					c=0;t=0; na=split(norm(br[i]),A," "); for(x=1;x<=na;x++)if(A[x]!=""){t++; if(A[x] in S)c++}
					if(t>0 && c/t>=0.75){ sw++; break }
				}
			}
			s=a; delete atok
			while(match(s,/@[a-z]+@/)){ tk=substr(s,RSTART,RLENGTH); s=substr(s,RSTART+RLENGTH); if(!named(tk,q,hint))atok[tk]=1 }
			for(tk in atok)ut++
		}
		END{ printf "arsenal lint: %d cards, %d single-phrasing, %d same-words, %d unnamed-token, %d ungraded, %d hintless\n", cards, single+0, sw+0, ut+0, ung+0, hl+0 }
	' "$LEVELS"/*
}

main() {
	local arg=${1:-} lvl rc ndue
	case "$arg" in
		selftest) selftest_graded; exit $? ;;
		list)     level_ids; exit 0 ;;
		lint)     lint_report; exit 0 ;;
		review)   shift; review "${1:-20}"; exit $? ;;
		daily)    daily; exit $? ;;
	esac
	if [ -z "$arg" ]; then
		# bare `arsenal learn` resumes at the first mission whose boss has not
		# fallen, not always the first one.
		lvl=$(resume_target) || lvl=$(level_ids | head -1)
	else
		lvl=$(resolve_level "$arg")
	fi
	[ -n "$lvl" ] && [ -f "$LEVELS/$lvl" ] || die "no such level: ${arg:-<none, and none found under $LEVELS>}"
	run_level "$lvl"; rc=$?
	# the due queue, surfaced where a returning learner will see it: after the
	# mission, below the boss screen, so the mastery labels connect to something.
	ndue=$(cards_ndue)
	[ "${ndue:-0}" -gt 0 ] && printf '  %s%s due%s -- %sarsenal learn review%s\n' "$D" "$ndue" "$N" "$W" "$N"
	return "$rc"
}

main "$@"
