ash sh
ls cat cp mv rm mkdir rmdir ln
mount umount
echo printf test test1 true false busybox
grep sed awk cut sort uniq head tail wc tr
vi
ps kill sleep uname free df du
chmod date stty mktemp touch dirname basename id env
dd sync stat find xargs
dmesg halt poweroff reboot
clear reset
setsid cttyhack
ip ifconfig route udhcpc ping wget nc hostname netstat traceroute nslookup
# offense/recovery, all inside the one already-gated static busybox (max
# capability per byte, no new pinned source, no new trust surface).
arp arping telnet tftp ftpget ftpput
sha256sum sha512sum sha1sum md5sum cksum base64
tar gzip gunzip zcat bzip2 bunzip2 unzip
fdisk blkid findfs losetup blockdev
hexdump od strings cmp diff less tee
top pgrep pkill watch timeout nohup flock
seq tac split readlink realpath which whoami tty mkfifo nproc
# reconnaissance: knowing the machine you plugged into. lspci/lsusb name its
# hardware, lsof/pstree/pidof/fuser/pmap/pwdx map what is running, ipcalc does
# subnet math, ping6/traceroute6 reach ipv6 hosts, microcom talks to a serial
# console when ethernet is dead, hexedit patches bytes we can currently only
# read. free -- all already inside the one static busybox.
lspci lsusb lsof pstree pidof fuser pmap pwdx
ipcalc ping6 traceroute6 microcom hexedit killall logger
# making filesystems: xos could image and read disks but not format one, which
# is half a tool. mke2fs also lets xos provision its own p3 state partition.
mke2fs mkdosfs
# least privilege: learn runs every answer as nobody through this, so a typo
# in a lesson meets file permissions instead of the encrypted state partition.
setuidgid
# reading what the stick could not open: the kernel and every doc tarball ship
# as .xz, so xz/unxz/xzcat close a real functional hole. chroot enters and
# repairs a rootfs recovered over the usb path; lsblk is the one clear tree of
# what is actually attached, where fdisk/blkid only answer about one device.
xz unxz xzcat chroot lsblk
# forensics on a mounted host: nsenter/unshare step into its namespaces,
# chattr/lsattr read and clear the immutable bit, cpio opens an initramfs,
# devmem reads physical memory when nothing higher-level can.
nsenter unshare chattr lsattr cpio devmem
# trace-free by hand: shred overwrites a file on p3 or an attached disk;
# script/scriptreplay record an engagement to loot as a replayable typescript.
shred script scriptreplay
# the field: loadkmap/dumpkmap for a non-us keyboard, hwclock to set the clock
# from the rtc so tls certificate validity holds before any network exists.
loadkmap dumpkmap hwclock
# disk work the usb-forensics path needs: blkdiscard wipes an ssd, partprobe
# re-reads a table fdisk just changed, mountpoint tests a mount from a script,
# lsscsi names the scsi/usb devices, fallocate/truncate size a file or an image.
blkdiscard partprobe mountpoint lsscsi fallocate truncate
